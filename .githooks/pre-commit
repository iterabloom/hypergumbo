#!/usr/bin/env bash
# Pre-commit hook: Run linting, security, and freshness checks before committing
#
# This hook runs:
# - Ruff: Python linting (pycodestyle, pyflakes, security rules)
# - Bandit: Security-focused static analysis
# - yamllint: YAML syntax validation
# - Schema check: Verify docs/schema.json is up-to-date with dataclasses
#
# To bypass this hook (not recommended): git commit --no-verify

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Block direct commits to protected branches (dev, main)
current_branch=$(git branch --show-current 2>/dev/null || true)
if [[ "$current_branch" == "dev" || "$current_branch" == "main" ]]; then
    echo ""
    echo -e "${RED}========================================================${NC}"
    echo -e "${RED}  BLOCKED: Direct commit to protected branch '$current_branch'${NC}"
    echo -e "${RED}========================================================${NC}"
    echo ""
    echo -e "${YELLOW}  Create a feature branch first:${NC}"
    echo ""
    echo "    git stash"
    echo "    git checkout -b <author>/feat/<description>"
    echo "    git stash pop"
    echo ""
    echo "  To bypass (not recommended): git commit --no-verify"
    echo ""
    exit 1
fi

# Block production code changes while a bakeoff is running.
# Editable install means the Python interpreter uses whatever's checked out.
# Modifying source files mid-bakeoff corrupts the running analysis.
#
# "Production code" = packages/*/src/**/*.py and scripts/*.
# Non-production (docs, tests, tracker, .ci, configs) is always allowed.
# Character class trick prevents pgrep from matching itself.
_bakeoff_pids=$(pgrep -f '[s]cripts/bakeoff' 2>/dev/null || true)
if [[ -n "$_bakeoff_pids" ]]; then
    # Check if any staged files are production code
    _staged_prod=$(git diff --cached --name-only | grep -E '^(packages/[^/]+/src/|scripts/)' | grep -v -E '^scripts/(tracker|bakeoff)' || true)
    if [[ -n "$_staged_prod" ]]; then
        echo ""
        echo -e "${RED}========================================================${NC}"
        echo -e "${RED}  BLOCKED: Bakeoff is running (PIDs: ${_bakeoff_pids//$'\n'/, })${NC}"
        echo -e "${RED}========================================================${NC}"
        echo ""
        echo -e "${YELLOW}  Cannot commit production code while bakeoff is active.${NC}"
        echo -e "${YELLOW}  The editable install means your changes would affect${NC}"
        echo -e "${YELLOW}  the running analysis.${NC}"
        echo ""
        echo "  Blocked files:"
        echo "$_staged_prod" | sed 's/^/    /'
        echo ""
        echo "  Options:"
        echo "    1. Wait for bakeoff to finish"
        echo "    2. Stash changes: git stash"
        echo "    3. Commit only non-production files"
        echo ""
        exit 1
    fi
fi

echo "🔍 Running pre-commit checks..."

# Require ruff
if ! command -v ruff &> /dev/null; then
    echo -e "${RED}✗ ruff not installed${NC}"
    echo "  Install with: pip install ruff"
    exit 1
fi

# Require bandit
if ! command -v bandit &> /dev/null; then
    echo -e "${RED}✗ bandit not installed${NC}"
    echo "  Install with: pip install bandit"
    exit 1
fi

# Run tracker validation (full cross-file: catches cycles, dangling refs, etc.)
echo -n "  Tracker (schema)... "
if [ -d ".agent/tracker" ] && command -v scripts/tracker &> /dev/null; then
    STAGED_TRACKER=$(git diff --cached --name-only -- '.agent/tracker/.ops/*.ops' '.agent/tracker-workspace/.ops/*.ops' '.agent/tracker-workspace/stealth/*.ops' 2>/dev/null || true)
    if [ -n "$STAGED_TRACKER" ]; then
        if scripts/tracker validate 2>/dev/null; then
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
            echo ""
            scripts/tracker validate 2>&1 | grep -i "error\|cycle\|dangling" || true
            echo -e "${RED}Tracker validation failed. Fix issues before committing.${NC}"
            exit 1
        fi
    else
        echo -e "${YELLOW}skipped (no tracker files staged)${NC}"
    fi
else
    echo -e "${YELLOW}skipped (no tracker)${NC}"
fi

# Run ruff - check packages/ if available, otherwise src/
echo -n "  Ruff (linting)... "
if [ -d "packages/hypergumbo-core" ]; then
    RUFF_PATHS="packages/*/src packages/*/tests"
else
    RUFF_PATHS="src/ tests/"
fi
if ruff check --no-cache $RUFF_PATHS --quiet 2>/dev/null; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo ""
    echo -e "${RED}Ruff found issues:${NC}"
    ruff check --no-cache $RUFF_PATHS
    exit 1
fi

# Run bandit - check packages/ if available, otherwise src/
echo -n "  Bandit (security)... "
if [ -d "packages/hypergumbo-core" ]; then
    BANDIT_PATH="packages/*/src"
else
    BANDIT_PATH="src/"
fi
if bandit -r $BANDIT_PATH -c pyproject.toml --quiet 2>/dev/null; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo ""
    echo -e "${RED}Bandit found security issues:${NC}"
    bandit -r $BANDIT_PATH -c pyproject.toml
    exit 1
fi

# Run yamllint (optional - skip if not installed)
echo -n "  yamllint (YAML syntax)... "
if command -v yamllint &> /dev/null; then
    # Check packages/ structure first, fallback to legacy src/
    FRAMEWORKS_DIR="packages/hypergumbo-core/src/hypergumbo_core/frameworks"
    if [ ! -d "$FRAMEWORKS_DIR" ]; then
        FRAMEWORKS_DIR="src/hypergumbo/frameworks"
    fi
    if [ -d "$FRAMEWORKS_DIR" ] && yamllint -c .yamllint.yaml "$FRAMEWORKS_DIR" 2>/dev/null; then
        echo -e "${GREEN}✓${NC}"
    elif [ ! -d "$FRAMEWORKS_DIR" ]; then
        echo -e "${YELLOW}skipped (no frameworks dir)${NC}"
    else
        echo -e "${RED}✗${NC}"
        echo ""
        echo -e "${RED}yamllint found issues:${NC}"
        yamllint -c .yamllint.yaml "$FRAMEWORKS_DIR"
        exit 1
    fi
else
    echo -e "${YELLOW}skipped (not installed)${NC}"
fi

# Check schema freshness (fast check - just JSON comparison)
echo -n "  Schema (freshness)... "
if ./scripts/generate-schema --check >/dev/null 2>&1; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo ""
    echo -e "${RED}Schema is out of date. Run:${NC}"
    echo "  ./scripts/generate-schema"
    exit 1
fi

# Check README sync (meta-package must match root)
echo -n "  README sync... "
if [ -f "packages/hypergumbo/README.md" ] && [ -f "README.md" ]; then
    if diff -q README.md packages/hypergumbo/README.md >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC}"
    else
        echo -e "${RED}✗${NC}"
        echo ""
        echo -e "${RED}Meta-package README differs from root README. Run:${NC}"
        echo "  cp README.md packages/hypergumbo/README.md"
        exit 1
    fi
else
    echo -e "${YELLOW}skipped (files not found)${NC}"
fi

# Check affected-tests.txt manifest mode (must not be full-suite for CI)
echo -n "  Test manifest... "
MANIFEST=".ci/affected-tests.txt"
if [ -f "$MANIFEST" ]; then
    # Check if manifest is being staged for commit
    if git diff --cached --name-only | grep -q "^\.ci/affected-tests\.txt$"; then
        # Check if it's full-suite mode (CI has 5-minute timeout, can't handle full-suite)
        if grep -q "^# Mode: full-suite" "$MANIFEST"; then
            echo -e "${RED}✗${NC}"
            echo ""
            echo -e "${RED}Manifest is full-suite mode, which will fail CI (5-minute timeout).${NC}"
            echo -e "${RED}Re-run tests without --full flag to generate a targeted manifest:${NC}"
            echo "  pytest  # without --full"
            exit 1
        else
            echo -e "${GREEN}✓${NC}"
        fi
    else
        echo -e "${YELLOW}skipped (not staged)${NC}"
    fi
else
    echo -e "${YELLOW}skipped (no manifest)${NC}"
fi

echo -e "${GREEN}✅ Pre-commit checks passed${NC}"

#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# reference-transaction hook: self-heal dropped tracker ops after a ref update.
#
# Pending tracker .ops live in the git working tree until auto-sync commits them;
# the out-of-repo journal (hypergumbo_tracker.journal) is their durable write-ahead
# log. A working-tree-rewriting ref update can drop those uncommitted .ops:
#   * git reset --hard <commit>  — resets the worktree, THEN updates the ref
#   * git checkout <branch>      — updates the worktree, THEN updates HEAD
# In both, git rewrites the worktree BEFORE the ref transaction commits, so this
# hook — firing on the "committed" state — runs AFTER the ops are dropped and can
# restore them. It calls `tracker recover`, which union-restores journalled ops
# back into the worktree .ops files. Idempotent: a no-op when nothing was lost
# (recover does no git operation, so it never re-fires this hook).
#
# Best-effort and non-blocking by construction:
#   * acts only on the "committed" state (skips "prepared" / "aborted");
#   * degrades silently when the tracker CLI is absent (fresh clones before
#     `pip install -e packages/hypergumbo-tracker`);
#   * always exits 0 — it must never be able to fail the git operation it rides on.
#
# Known gaps (covered by the durable journal + a manual `tracker recover`, NOT by
# this hook): `git clean` and `git stash` do not update refs, so they do not fire
# this hook; after `rm -rf .git` recovery waits until the repo is re-init'd or
# re-cloned (the journal data is still safe, keyed by the toplevel's abspath).

state="$1"
[[ "$state" == "committed" ]] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[[ -n "$root" ]] || exit 0
cd "$root" || exit 0

# Skip while the tracker's own git operations are in progress. do_sync (sync.py)
# and auto-pr set this marker around their fetch + fast-forward, which reconcile
# pending .ops from working-tree into committed state. A concurrent recover would
# restore a journalled-but-uncommitted op as an UNTRACKED file mid-merge — and
# `git merge --ff-only` itself re-fires this hook (via its ORIG_HEAD write) right
# before its overwrite check, so the restored untracked file aborts the very
# fast-forward that was about to commit it. The marker excludes the tracker's own
# reconciliation while still self-healing a user-initiated reset --hard/checkout
# (which never set it).
if [[ -f .git/tracker-recover-disabled ]]; then
  exit 0
fi

# Skip CONSTRUCTIVE/reconciling operations that bring ops rather than drop them.
# recover would restore a journalled-but-uncommitted op as an UNTRACKED file
# mid-operation and abort the merge/ff that is about to commit it; these
# operations never drop pending working-tree ops, so there is nothing to recover.
# reset --hard and checkout update local refs with no merge/pull/rebase reflog
# action (and a non-remote ref), so they fall through and still self-heal.
#   * merge / pull / rebase — named by GIT_REFLOG_ACTION (covers `git pull`).
case "${GIT_REFLOG_ACTION:-}" in
  merge*|pull*|rebase*) exit 0 ;;
esac
#   * fetch — updates ONLY remote-tracking refs. The transaction's ref list is on
#     stdin (`<old> <new> <ref>` per line); if every updated ref is remote-tracking
#     this is a fetch, so skip. (No stdin / a local ref → fall through and recover.)
only_remote=1
saw_ref=0
while read -r _old _new _refname; do
  [[ -z "${_refname:-}" ]] && continue
  saw_ref=1
  case "$_refname" in
    refs/remotes/*) ;;
    *) only_remote=0 ;;
  esac
done
if [[ "$saw_ref" == 1 && "$only_remote" == 1 ]]; then
  exit 0
fi

# Only when this repo ships the tracker wrapper (this hook is hypergumbo's own).
if [[ -x ./scripts/tracker ]]; then
  ./scripts/tracker recover >/dev/null 2>&1 || true
fi
exit 0

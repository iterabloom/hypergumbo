#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Pre-push hook: Prevent accidental pushes to protected branches (dev, main)
#
# Git invokes pre-push with the remote name and URL as arguments, and feeds
# lines of the form:
#   <local ref> <local sha> <remote ref> <remote sha>
# on stdin. We check each line's remote ref against a list of protected
# branch patterns.
#
# To bypass this hook (not recommended): git push --no-verify

set -euo pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Protected branch patterns (bare names, matched against the ref suffix)
PROTECTED_BRANCHES="main dev"

remote="$1"
url="$2"

# Failover remote verification (INV-bifud)
# During CI failover, selfh is the authoritative remote. Pushing to origin
# would target a stale Codeberg mirror, wasting CI cycles and causing
# divergence. Block all pushes to origin when failover is active.
git_dir="${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null || true)}"
if [[ -n "$git_dir" && -f "$git_dir/CI_FAILOVER_ACTIVE" && "$remote" == "origin" ]]; then
    echo ""
    echo -e "${RED}========================================================${NC}"
    echo -e "${RED}  BLOCKED: Push to 'origin' during CI failover${NC}"
    echo -e "${RED}========================================================${NC}"
    echo ""
    echo -e "${YELLOW}  CI failover is active — 'selfh' is the authoritative remote.${NC}"
    echo -e "${YELLOW}  Pushing to 'origin' targets a stale mirror and will cause divergence.${NC}"
    echo ""
    echo "  Use selfh instead:"
    echo ""
    echo "    git push selfh HEAD"
    echo "    ./scripts/auto-pr   (auto-detects authoritative remote)"
    echo ""
    exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    # Extract the branch name from the remote ref (e.g., refs/heads/dev -> dev)
    branch="${remote_ref#refs/heads/}"

    for protected in $PROTECTED_BRANCHES; do
        if [[ "$branch" == "$protected" ]]; then
            echo ""
            echo -e "${RED}========================================================${NC}"
            echo -e "${RED}  BLOCKED: Direct push to protected branch '$protected'${NC}"
            echo -e "${RED}========================================================${NC}"
            echo ""
            echo -e "${YELLOW}  Protected branches (dev, main) require a PR-based workflow.${NC}"
            echo ""
            echo "  Instead, use a feature branch:"
            echo ""
            echo "    git checkout -b <author>/feat/<description>"
            echo "    git push origin HEAD"
            echo "    ./scripts/auto-pr"
            echo ""
            echo "  To bypass (not recommended): git push --no-verify"
            echo ""
            exit 1
        fi
    done

    # Warn if workspace tracker files are being pushed to upstream remote
    if [[ "$remote" == "upstream" ]]; then
        # Use the zero sha for new branches (no remote_sha yet)
        zero="0000000000000000000000000000000000000000"
        diff_base="${remote_sha}"
        if [[ "$diff_base" == "$zero" ]]; then
            diff_base="upstream/dev"
        fi
        workspace_files=$(git diff --name-only "$diff_base" "$local_sha" -- '.agent/tracker-workspace/' 2>/dev/null || true)
        if [[ -n "$workspace_files" ]]; then
            echo ""
            echo -e "${YELLOW}WARNING: Pushing workspace tracker files to upstream${NC}"
            echo "  Use ./scripts/contribute to exclude workspace from upstream PRs"
            echo ""
        fi
    fi
done

exit 0

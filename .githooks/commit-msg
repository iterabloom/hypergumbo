#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# commit-msg: scrub vendor self-attribution out of a commit message.
#
# The MATCHING, the phrase selection and the body sweep all live in
# brand-scrub.sh, which this hook sources. They used to live here, which meant
# they protected exactly one channel -- a commit message -- while PR titles,
# PR bodies and PR comments reached the forge with no scrub at all. Extracting
# them is what lets one pattern list govern every channel (WI-sidot). What
# remains in this file is the part that is genuinely specific to a COMMIT
# MESSAGE: splitting it into subject / body / trailers, and the trailer rules.
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  echo "commit-msg hook: missing commit message file path" >&2
  exit 1
fi

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=.githooks/brand-scrub.sh
if [[ ! -r "$hook_dir/brand-scrub.sh" ]]; then
  echo "commit-msg hook: brand-scrub.sh not found beside the hook" >&2
  exit 1
fi
source "$hook_dir/brand-scrub.sh"
bs_init "${HOOK_BRANDS_FILE:-$hook_dir/brand-patterns.txt}" \
        "${HOOK_PHRASES_FILE:-$hook_dir/absurd-phrases.txt}"
brand_re="$BS_BRAND_RE"

# -----------------------------
# Read message into array (one entry per line) - bash 3 compatible
# -----------------------------
lines=()
while IFS= read -r line || [[ -n "$line" ]]; do
  lines+=( "$line" )
done < "$msg_file"
n=${#lines[@]}

# ---- Trailer detection (robust to trailing blank lines) ----
last=$n
while (( last > 0 )) && [[ -z "${lines[$((last-1))]}" ]]; do
  ((last--))
done

trailer_re='^[A-Za-z0-9][A-Za-z0-9-]*: '
trailer_start=$((last+1))

i=$last
while (( i >= 1 )); do
  line="${lines[$((i-1))]}"
  [[ -z "$line" ]] && break
  if [[ "$line" =~ $trailer_re ]]; then
    trailer_start=$i
    ((i--))
    continue
  fi
  break
done

# ---- Split: subject + body + trailers ----
subject_line=""
body_lines=()
trailers=()

if (( n > 0 )); then
  subject_line="${lines[0]}"
fi

body_end=$((trailer_start-1))

if (( body_end > 1 )); then
  body_lines=( "${lines[@]:1:$((body_end-1))}" )
fi

if (( trailer_start <= last )); then
  len=$(( last - trailer_start + 1 ))
  trailers=( "${lines[@]:$((trailer_start-1)):$len}" )
fi

# ---- Case-insensitive brand matching in bash ----
# LOAD-BEARING for the `case` statement in the trailer loop below, which is
# why it is set here rather than inside a helper: `case` honours nocasematch
# too, and this history carries BOTH `Co-authored-by` and `Co-Authored-By`.
nocase_was_enabled=0
if shopt -q nocasematch; then nocase_was_enabled=1; fi
shopt -s nocasematch

# ---- Phrase selection (keyed; outsiders can't reproduce without the key) ----
replacement_out="$(bs_pick_phrase "$subject_line")"
replacement_in="$(bs_slugify "$replacement_out")"

# 0) Scrub the SUBJECT line if it contains a brand (do NOT remove the subject)
if [[ "$subject_line" =~ $brand_re ]]; then
  subject_line="$(bs_replace_ci "$replacement_out" "$subject_line")"
fi

# 1) Remove ONLY body lines containing the brands, and ONLY inside the scan
#    window: the first and last HOOK_BODY_SCAN_WINDOW lines of the BODY.
#
#    WHY A WINDOW. The pattern list contains ordinary English words -- Nova,
#    Titan, Granite, Arctic, Falcon, Phi, Aya, GLM -- and a body hit DELETES THE
#    WHOLE LINE with no marker, so a false positive is silent and unrecoverable.
#    This is not hypothetical here: `falcon` is a web framework this project
#    SUPPORTS (it ships falcon.yaml and lists it beside django/flask/fastapi),
#    so an ordinary commit about the falcon analyzer lost a body line.
#
#    Vendor self-attribution clusters at the two ends -- the subject (line 1)
#    and the trailers -- while the middle of a long body is ordinary technical
#    prose. Both ends are ALWAYS scanned: the subject and the trailers are
#    handled by their own passes below and above, unconditionally, and are not
#    subject to this window. It narrows only the body sweep.
#
#    A body of <= 2*window lines is fully covered (the two ends overlap), so
#    this changes nothing for short messages. Only a long body has an unscanned
#    middle. That is a deliberate coverage-for-precision trade, made because a
#    silent deletion costs more here than a missed mid-body brand.
filtered_body=()
if (( ${#body_lines[@]} > 0 )); then
  swept="$(bs_scrub_body "$(printf '%s\n' "${body_lines[@]}")")"
  if [[ -n "$swept" ]]; then
    while IFS= read -r l; do
      filtered_body+=( "$l" )
    done <<< "$swept"
  fi
fi

out_body=( "$subject_line" )
if (( ${#filtered_body[@]} > 0 )); then
  out_body+=( "${filtered_body[@]}" )
fi

# Trim trailing blank lines in body (bash 3 safe: no negative indices)
while (( ${#out_body[@]} > 0 )); do
  last_idx=$(( ${#out_body[@]} - 1 ))
  [[ -z "${out_body[$last_idx]}" ]] || break
  unset "out_body[$last_idx]"
done

# 2) Rewrite ANY trailer value:
#    - replace brands anywhere in the value (case-insensitive, global)
#    - outside <...>: replacement_out (human-readable)
#    - inside  <...>: replacement_in  (slug-ish for emails/domains)

rewrite_trailer_value_smartass() {
  local v="$1"

  # Store regex in variable to prevent glob expansion of [^<] and [^>]
  local identity_re='^([^<]*)<([^>]*)>(.*)$'

  # If the value follows the standard "Name <Email>" format:
  if [[ "$v" =~ $identity_re ]]; then
    # We ignore the original name and email entirely.
    # We construct a new identity using the slugified phrase + the static domain.
    # Preserve any trailing garbage/comments if they existed (BASH_REMATCH[3]).
    printf '%s <%s@racialcapitalism.isbad>%s' \
      "$replacement_out" \
      "$replacement_in" \
      "${BASH_REMATCH[3]}"
  else
    # Fallback: If it's not a standard identity line (e.g. "Closes: #123"),
    # just output the absurd phrase.
    printf '%s' "$replacement_out"
  fi
}

out_trailers=()
for t in "${trailers[@]}"; do
  if [[ "$t" =~ ^([A-Za-z0-9][A-Za-z0-9-]*:)([[:space:]]*)(.*)$ ]]; then
    key="${BASH_REMATCH[1]}"
    ws="${BASH_REMATCH[2]}"
    val="${BASH_REMATCH[3]}"

    # A brand in the KEY used to pass through untouched: only $val was tested,
    # and ${key}${ws}${val} put the key back verbatim. The scrub removed the
    # half that IMPLIES a vendor (a hostname in the value) and preserved the
    # half that NAMES one -- e.g. `Claude-Session:`, on 13 commits and growing,
    # because the harness appends that trailer to every agent commit.
    key_branded=0
    case "$key" in
      # git-semantic keys. `git interpret-trailers`, %(trailers:key=...) and DCO
      # validation all key off the exact token, so these are never renamed even
      # if a future brand pattern collides with one.
      Signed-off-by:|Co-authored-by:|Co-committed-by:) ;;
      # `if`, NOT `[[ ... ]] && key_branded=1`. The && form returns 1 when the
      # key is clean, `case` returns its arm's status, and under `set -e` that
      # is an exit 1 if this block is ever the last command in a function or
      # script. Inert where it sits today; a landmine if it is ever moved.
      *) if [[ "$key" =~ $brand_re ]]; then key_branded=1; fi ;;
    esac

    if (( key_branded )); then
      key="Racial-Capitalism-Is-Bad:"
      # The value goes too, UNCONDITIONALLY -- even when it carries no brand of
      # its own. A vendor-named key means the whole trailer is vendor
      # provenance, and a scrubbed key over an intact value would still publish
      # the session id it points at. rewrite_trailer_value_smartass discards the
      # original either way (identity shape is rebuilt; anything else is
      # replaced wholesale), so no separate branch is needed.
      val="$(rewrite_trailer_value_smartass "$val")"
    elif [[ "$val" =~ $brand_re ]]; then
      val="$(rewrite_trailer_value_smartass "$val")"
    fi
    t="${key}${ws}${val}"
  fi
  out_trailers+=( "$t" )
done

if (( nocase_was_enabled == 0 )); then
  shopt -u nocasematch
fi

# ---- Write back: body + blank line + trailers ----
{
  if (( ${#out_body[@]} > 0 )); then
    printf "%s\n" "${out_body[@]}"
  fi

  if (( ${#out_trailers[@]} > 0 )); then
    printf "\n"
    printf "%s\n" "${out_trailers[@]}"
  fi
} > "$msg_file"

# DCO Check
if ! grep -q "^Signed-off-by: " "$msg_file"; then
  echo "Error: DCO Sign-off missing." >&2
  echo "Please commit with 'git commit -s' or add 'Signed-off-by: Name <email>'." >&2
  exit 1
fi

kinds:
  invariant:
    prefix: INV
    allowed_statuses: [satisfied, pending_validation, violated, needs_human_review, deleted]
    deprecated_statuses: [holding]
    description: "Discovered invariant with root cause analysis"
    fields_schema:
      statement:
        type: text
        required: true
        description: "The invariant being tracked"
      root_cause:
        type: text
        required: true
        description: "Why the invariant was violated"
      fix:
        type: text
        description: "How the root cause was addressed"
      verification:
        type: text
        description: "How the fix was verified across languages/constructs"
      regression_tests:
        type: list
        description: "Test cases that guard against recurrence"
      scope:
        type: text
        description: "Which languages/constructs are affected"
      progress_pct:
        type: integer
        min: 0
        max: 100
        description: "Percentage of affected scope addressed"
  meta_invariant:
    prefix: META
    allowed_statuses: [satisfied, pending_validation, violated, needs_human_review, deleted]
    deprecated_statuses: [holding]
    description: "A meta-invariant tracking cross-language coverage"
    fields_schema:
      statement:
        type: text
        required: true
        description: "The cross-cutting invariant"
      languages_done:
        type: list
        description: "Languages where the invariant holds"
      languages_remaining:
        type: list
        description: "Languages not yet checked or fixed"
      progress_pct:
        type: integer
        min: 0
        max: 100
        description: "Percentage of languages addressed"
  work_item:
    prefix: WI
    description: "A work item"
statuses:
  - todo_hard
  - todo_soft
  - in_progress
  - needs_human_review
  - holding
  - satisfied
  - pending_validation
  - violated
  - done
  - wont_do
  - deleted
stop_hook:
  blocking_statuses:
    - todo_hard
    - todo_soft
    - violated
    - pending_validation
  resolved_statuses:
    - done
    - wont_do
    - deleted
    - satisfied
    - holding
  human_only_statuses:
    - deleted
  # Sentinel directories for circuit breaker progress detection.
  # The circuit breaker hashes file modification times in these directories
  # (excluding dotfiles) to detect whether real work product changed between
  # stop events.  If files here changed, the agent made progress regardless
  # of whether the tracker was updated.
  progress_sentinel_dirs:
    - packages/
    - docs/
    - scripts/
    - ~/hypergumbo_lab_notebook/

  # Process-aware pause (WI-varid).  When the stop hook fires and a
  # "watched" long-running command is alive, the hook polls inline until
  # that process finishes (emitting a dot per poll to stderr) instead of
  # the previous unconditional 150s blanket pause.  Watched commands are
  # those where the agent is genuinely blocked (waiting for pass/fail or
  # for a CI poll); intentionally excluded are bakeoffs and ci-debug,
  # where the agent is meant to be doing pipeline-overlap work in
  # parallel rather than idly waiting.
  #
  # If this list is omitted or empty, the bash defaults baked into
  # stop_logic.sh apply (same five entries below).
  watched_process_patterns:
    - pytest
    - python -m pytest
    - smart-test
    - bash ./scripts/auto-pr
    - bash ./scripts/merge-pr
  watched_poll_seconds: 3
  watched_max_wait_seconds: 1800

  # awaits_bakeoff_validation backlog nudge (WI-dolil slice 3).
  # When items carrying the `awaits_bakeoff_validation` tag accumulate
  # beyond `threshold` AND the most recent DEEP bakeoff cycle's
  # `state.json` is older than `stale_cycle_hours`, the stop hook
  # appends a short nudge section to the guidance file encouraging a
  # DEEP cycle. If this block or its keys are omitted, the defaults
  # (threshold=5, stale_cycle_hours=72) in awaits_bakeoff_nudge.py
  # apply. The count uses the same `blocking_statuses` set above.
  awaits_bakeoff_validation_nudge:
    threshold: 5
    stale_cycle_hours: 72
# Fundamental Concept Audit cadence: the session-start hook
# (.agent/hooks/_shared/check_audit_cadence.py) reads this to decide
# whether to surface a "time for a conceptual audit" reminder. When
# development commits since the last recorded audit (excluding tracker
# auto-syncs) exceed `commit_threshold`, the hook prints a soft nudge
# the agent forwards to the human. Threshold default of 72 derives from
# median ADR-to-ADR cadence (~4.5 calendar days) × audit-target-cadence
# (~2× ADR rate ⇒ ~3 days) × empirical commits/calendar-day (~22) ≈ 66,
# rounded up. Tune up if the prompt fatigues; tune down if conceptual
# leaks slip through unaudited. Missing key falls back to the same
# default in the hook itself.
concept_audit:
  commit_threshold: 72
well_known_tags:
  - developer_experience
  - bakeoff_infrastructure
  - ci_infrastructure
actor_resolution:
  agent_usernames:
    - "*_agent"
lamport_branches:
  - dev
  - main

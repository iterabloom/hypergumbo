kinds:
  invariant:
    prefix: INV
    allowed_statuses: [satisfied, pending_validation, violated, needs_human_review, deleted]
    deprecated_statuses: [holding]
    description: "Discovered invariant with root cause analysis"
    fields_schema:
      statement:
        type: text
        required: true
        description: "The invariant being tracked"
      root_cause:
        type: text
        required: true
        description: "Why the invariant was violated"
      fix:
        type: text
        description: "How the root cause was addressed"
      verification:
        type: text
        description: "How the fix was verified across languages/constructs"
      regression_tests:
        type: list
        description: "Test cases that guard against recurrence"
      scope:
        type: text
        description: "Which languages/constructs are affected"
      progress_pct:
        type: integer
        min: 0
        max: 100
        description: "Percentage of affected scope addressed"
  meta_invariant:
    prefix: META
    allowed_statuses: [satisfied, pending_validation, violated, needs_human_review, deleted]
    deprecated_statuses: [holding]
    description: "A meta-invariant tracking cross-language coverage"
    fields_schema:
      statement:
        type: text
        required: true
        description: "The cross-cutting invariant"
      languages_done:
        type: list
        description: "Languages where the invariant holds"
      languages_remaining:
        type: list
        description: "Languages not yet checked or fixed"
      progress_pct:
        type: integer
        min: 0
        max: 100
        description: "Percentage of languages addressed"
  work_item:
    prefix: WI
    description: "A work item"
statuses:
  - todo_hard
  - todo_soft
  - in_progress
  - needs_human_review
  - holding
  - satisfied
  - pending_validation
  - violated
  - done
  - wont_do
  - deleted
stop_hook:
  blocking_statuses:
    - todo_hard
    - todo_soft
    - violated
    - pending_validation
  resolved_statuses:
    - done
    - wont_do
    - deleted
    - satisfied
    - holding
  human_only_statuses:
    - deleted
  # Sentinel directories for circuit breaker progress detection.
  # The circuit breaker hashes file modification times in these directories
  # (excluding dotfiles) to detect whether real work product changed between
  # stop events.  If files here changed, the agent made progress regardless
  # of whether the tracker was updated.
  progress_sentinel_dirs:
    - packages/
    - docs/
    - scripts/
    - ~/hypergumbo_lab_notebook/
well_known_tags:
  - developer_experience
  - bakeoff_infrastructure
  - ci_infrastructure
actor_resolution:
  agent_usernames:
    - "*_agent"
lamport_branches:
  - dev
  - main

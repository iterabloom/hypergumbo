  data:  # d156
    kind: work_item  # d156
    title: "HIGH_RISK_PRIMITIVES drift guard Part 2: subprocess-kind catalog entries missing from frozenset"  # d156
    status: todo_hard  # d156
    priority: 4  # d156
    parent:  # d156
    tags:  # d156

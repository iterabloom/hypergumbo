  data:  # f2fe
    kind: invariant  # f2fe
    title: "Go field-chain and chained-return-type receiver arms bind the first global candidate for a bare Type.Method key, whatever its package"  # f2fe
    status: violated  # f2fe
    priority: 3  # f2fe
    parent:  # f2fe
    tags:  # f2fe
    - analysis_quality  # f2fe

  data:  # 788c
    kind: invariant  # 788c
    title: "No unified visibility axis across language-specific modifier emissions"  # 788c
    status: violated  # 788c
    priority: 2  # 788c
    parent:  # 788c
    tags:  # 788c
    - dogfood_corpus_20260528  # 788c

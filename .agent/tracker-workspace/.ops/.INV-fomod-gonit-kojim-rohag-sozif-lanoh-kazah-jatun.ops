    kind: invariant  # ebe1
    title: "INV: Framework detection from file-structure signatures (autoload + manifest-silent + no imports case)"  # ebe1
    status: violated  # ebe1
    priority: 4  # ebe1
    parent:  # ebe1
    tags:  # ebe1

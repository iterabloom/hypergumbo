    kind: work_item  # e6a4
    title: "IR: introduce external boundary nodes for calls/imports to unresolved targets"  # e6a4
    status: todo_hard  # e6a4
    priority: 1  # e6a4
    parent:  # e6a4
    tags:  # e6a4

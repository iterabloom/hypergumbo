    kind: work_item  # e47d
    title: "c: bare send/recv never reach the catalogue -- ambiguous_names with no module slot from #include; 156 of 324 corpus socket sites classify as nothing (INV-linub's class in C)"  # e47d
    status: todo_hard  # e47d
    priority: 2  # e47d
    parent:  # e47d
    tags:  # e47d
    - taint  # e47d
    - catalogue  # e47d

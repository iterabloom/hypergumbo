  data:  # 2609
    kind: invariant  # 2609
    title: "runtime-cli-no-network is false as written: the first sketch after install-embeddings downloads both embedding models from huggingface.co (install-embeddings never fetches them)"  # 2609
    status: violated  # 2609
    priority: 2  # 2609
    parent:  # 2609
    tags:  # 2609
    - security  # 2609

    kind: work_item  # 90d6
    title: "smart-test: select from the stored graph when it is at most 93 commits old, and fall back to a fresh analysis otherwise (plan step 1c)"  # 90d6
    status: todo_hard  # 90d6
    priority: 2  # 90d6
    parent:  # 90d6
    tags:  # 90d6
    - smart_test  # 90d6

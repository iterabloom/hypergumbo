    kind: work_item  # 919e
    title: "inheritance linker binds a dotted external Python base by its last segment (unittest.TestCase -> Django's own TestCase), closing an inheritance cycle that disables every MRO walk under Django's test hierarchy"  # 919e
    status: todo_hard  # 919e
    priority: 2  # 919e
    parent:  # 919e
    tags:  # 919e

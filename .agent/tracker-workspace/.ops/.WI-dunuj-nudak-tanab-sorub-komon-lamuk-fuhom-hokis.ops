    kind: work_item  # 965b
    title: "yaml_ansible never reads a playbook outside root / Ansible-named dirs (24 unclaimed playbooks: ceph 22, qemu 2)"  # 965b
    status: todo_hard  # 965b
    priority: 3  # 965b
    parent:  # 965b

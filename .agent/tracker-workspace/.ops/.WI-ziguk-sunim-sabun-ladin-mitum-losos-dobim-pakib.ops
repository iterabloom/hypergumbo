    kind: work_item  # b60f
    title: "pre-commit hook reports a freshness check that could not run as 'out of date' (generate-schema imports from a src/ that no longer exists)"  # b60f
    status: in_progress  # b60f
    priority: 3  # b60f
    parent:  # b60f
    tags:  # b60f

  data:  # 6ea3
    kind: invariant  # 6ea3
    title: "Taint primitive kind is asserted by name and never checked against semantics (5 languages measured)"  # 6ea3
    status: violated  # 6ea3
    priority: 1  # 6ea3
    parent:  # 6ea3
    tags:  # 6ea3
    - taint  # 6ea3

    kind: work_item  # 5528
    title: "Go linker: hashicorp/memberlist cluster delegate callbacks"  # 5528
    status: todo_soft  # 5528
    priority: 3  # 5528
    parent: WI-juhov-pisup-gumit-filan-puhon-kavof-govad-dikuf  # 5528
    tags:  # 5528
    - linker_gap  # 5528
    - cross_language_linkers  # 5528

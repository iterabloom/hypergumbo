    kind: work_item  # e196
    title: "read subcommands: silent rc=0 'No X found' on wrong-shape input (missing schema_version/nodes keys); 4 of 6 subcommands affected; cache resolver shares the gap"  # e196
    status: todo_hard  # e196
    priority: 2  # e196
    parent: WI-himas-gohif-luroj-gilip-sudad-zalis-ravur-pidal  # e196
    tags:  # e196

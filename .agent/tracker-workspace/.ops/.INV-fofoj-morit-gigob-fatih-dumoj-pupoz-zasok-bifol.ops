    kind: invariant  # 396a
    title: "A catalogued primitive whose call site is not a function application emits no matchable edge: haskell zero-arg IO actions and java's System.in attribute are rowed but unreachable"  # 396a
    status: violated  # 396a
    priority: 1  # 396a
    parent:  # 396a

  data:  # a937
    kind: invariant  # a937
    title: "swift: an imported C function whose name is UpperCamelCase is read as a constructor, so a FUNCTION name reaches the module slot"  # a937
    status: violated  # a937
    priority: 4  # a937
    parent:  # a937
    tags:  # a937
    - swift  # a937
    - analyzer  # a937
    - module_key  # a937

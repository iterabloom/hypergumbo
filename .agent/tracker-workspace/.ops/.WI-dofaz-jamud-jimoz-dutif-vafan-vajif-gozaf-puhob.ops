    kind: work_item  # 8bbb
    title: "Detect orphaned tracker-sync PRs at auto-pr post-success (forgejo-api.sh helper + warning)"  # 8bbb
    status: needs_human_review  # 8bbb
    priority: 1  # 8bbb

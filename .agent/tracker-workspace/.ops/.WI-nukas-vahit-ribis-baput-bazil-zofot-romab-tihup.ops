    kind: work_item  # 2818
    title: "profile.py module_importers fallback parses a symbol-id path with a bare split(':')[1]"  # 2818
    status: todo_soft  # 2818
    priority: 3  # 2818
    parent:  # 2818
    tags:  # 2818
    - analysis_quality  # 2818

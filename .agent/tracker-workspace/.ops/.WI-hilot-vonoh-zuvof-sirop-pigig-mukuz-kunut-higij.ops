    kind: work_item  # 2aae
    title: "cpp: a C header spelled the C++ way (<cstdlib>, <cstdio>, <cstring>) matches no C catalogue row, so getenv/fopen/printf in such a file classify as nothing"  # 2aae
    status: todo_hard  # 2aae
    priority: 3  # 2aae
    parent:  # 2aae

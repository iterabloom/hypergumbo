    kind: work_item  # 35ef
    title: "ruby, php and elixir emit no module-level variable symbol, so a binding has nothing to carry constructed_from (or resolve against)"  # 35ef
    status: todo_hard  # 35ef
    priority: 2  # 35ef
    parent:  # 35ef

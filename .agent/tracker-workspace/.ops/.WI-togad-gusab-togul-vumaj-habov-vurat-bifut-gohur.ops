    kind: work_item  # 4ae2
    title: "The consuming pass should stamp the stub it derived its resolution from, so §14 stops re-deriving supersession by name-and-line collision"  # 4ae2
    status: todo_soft  # 4ae2
    priority: 2  # 4ae2
    parent:  # 4ae2

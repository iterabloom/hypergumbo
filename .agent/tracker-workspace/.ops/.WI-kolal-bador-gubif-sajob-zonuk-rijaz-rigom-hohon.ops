    kind: work_item  # 9993
    title: "compact subcommand: --max-symbols selection violates containment monotonicity across budgets"  # 9993
    status: todo_hard  # 9993
    priority: 1  # 9993
    parent: INV-fanur-bumod-kopoj-gafar-nirat-bifig-mubov-fadik  # 9993
    tags:  # 9993

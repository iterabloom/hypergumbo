    kind: work_item  # 647f
    title: "nim: a call inside an exported proc (proc a*) emits no call edge; _find_enclosing_proc_nim misses the exported_symbol name (INV-bisom residual)"  # 647f
    status: todo_hard  # 647f
    priority: 2  # 647f
    parent:  # 647f
    tags:  # 647f

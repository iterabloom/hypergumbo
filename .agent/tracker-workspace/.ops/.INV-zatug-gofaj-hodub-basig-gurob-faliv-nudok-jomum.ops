    kind: invariant  # 6eb7
    title: "Self-tree validation ratchet is breached on dev by a pre-existing cross_field|info:9 cell; the hard full-suite gate step is red"  # 6eb7
    status: violated  # 6eb7
    priority: 2  # 6eb7

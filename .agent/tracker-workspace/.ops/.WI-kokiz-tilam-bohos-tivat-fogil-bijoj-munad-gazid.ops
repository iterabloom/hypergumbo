    kind: work_item  # edff
    title: "Merge pass at the top of Phase C: fold two producers' records for one declaration into one Symbol, new id, edges rewired, no-op for a single producer (ADR-0057 ruling 3)"  # edff
    status: todo_hard  # edff
    priority: 2  # edff
    parent:  # edff
    tags:  # edff
    - scip  # edff
    - multi_fidelity  # edff

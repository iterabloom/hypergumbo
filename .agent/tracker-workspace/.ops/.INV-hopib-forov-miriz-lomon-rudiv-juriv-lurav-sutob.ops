  data:  # be44
    kind: invariant  # be44
    title: "A taint sink primitive that names a stream OBJECT can match a non-call use, making the record uncheckable against its own claim (sys.stderr as a print(file=) keyword)"  # be44
    status: violated  # be44
    priority: 4  # be44
    parent:  # be44
    tags:  # be44

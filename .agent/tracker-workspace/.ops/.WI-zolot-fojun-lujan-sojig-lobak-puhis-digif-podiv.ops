    kind: work_item  # 08d0
    title: "WebSocket linker does not bridge TS client at /ws to Python handler at /ws (cross-language gap on hypergumbo itself)"  # 08d0
    status: todo_hard  # 08d0
    priority: 3  # 08d0
    parent:  # 08d0
    tags:  # 08d0
    - self_analysis  # 08d0
    - dogfooding  # 08d0

    kind: work_item  # 2ccf
    title: "python fully-dotted module calls resolve to a phantom: import pkg_b.sub.deep; pkg_b.sub.deep.deep_fn() calls an external_symbol although deep_fn is defined in the tree"  # 2ccf
    status: todo_hard  # 2ccf
    priority: 2  # 2ccf

    kind: work_item  # 2dfa
    title: "cobol PERFORM/CALL edges replace make_unresolved_edge's meta wholesale, dropping callee_name; INV-hazov rule 3 cannot see a helper construction"  # 2dfa
    status: todo_hard  # 2dfa
    priority: 3  # 2dfa
    parent:  # 2dfa

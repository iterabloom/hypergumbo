    kind: work_item  # 6d98
    title: "swift: bare self.<method>() and deeper self.a.b chains carry no receiver type (496 sites; bare-self fills NO module slot and perturbs method_call_recovery)"  # 6d98
    status: todo_hard  # 6d98
    priority: 3  # 6d98
    parent:  # 6d98
    tags:  # 6d98

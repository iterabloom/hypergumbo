  data:  # 58a7
    kind: invariant  # 58a7
    title: "META: No spec-vs-data validator stage exists in the pipeline (super-META, peer)"  # 58a7
    status: violated  # 58a7
    priority: 2  # 58a7
    parent:  # 58a7
    tags:  # 58a7

  data:  # bef8
    kind: work_item  # bef8
    title: "Sketch Configuration: the hybrid extractor's redundancy filter tests each line alone, so the semantic block loses its file headings, keeps their quotes unattributed and leaves blank separator lines"  # bef8
    status: todo_hard  # bef8
    priority: 4  # bef8
    parent:  # bef8
    tags:  # bef8
    - outside_reader_review_20261113  # bef8

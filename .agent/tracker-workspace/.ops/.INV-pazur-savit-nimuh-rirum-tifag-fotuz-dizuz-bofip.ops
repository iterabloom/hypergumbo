  data:  # 7b9d
    kind: invariant  # 7b9d
    title: "Tiered behavior maps: nodes_summary reports pre-shrink counts, contradicts on-disk nodes/edges arrays"  # 7b9d
    status: violated  # 7b9d
    priority: 2  # 7b9d
    parent:  # 7b9d
    tags:  # 7b9d
    - dogfooding  # 7b9d

    kind: work_item  # 64aa
    title: "verify-claims: unknown boundary axis value (network/process/banana/...) silently confirms must_not_exist; SECURITY-RELEVANT false-positive"  # 64aa
    status: todo_hard  # 64aa
    priority: 1  # 64aa
    parent: INV-murig-kanin-junur-tazot-gifin-hijad-momuf-bukoj  # 64aa

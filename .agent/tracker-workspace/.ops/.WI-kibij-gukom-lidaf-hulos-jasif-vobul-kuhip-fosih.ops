    kind: work_item  # 1767
    title: "elixir: Phoenix route markers ignore the enclosing scope prefix (scope \"/admin\" + get \"/users\" -> /users, not /admin/users)"  # 1767
    status: todo_hard  # 1767
    priority: 2  # 1767

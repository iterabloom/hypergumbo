    kind: invariant  # 846c
    title: "scala.io.StdIn.readLine is catalogued ipc_recv but unreachable: emitted as a hint-less ambiguous short name (INV-linub class for scala)"  # 846c
    status: violated  # 846c
    priority: 2  # 846c
    parent:  # 846c
    tags:  # 846c
    - taint  # 846c
    - io_boundary  # 846c

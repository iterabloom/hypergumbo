  data:  # ad44
    kind: invariant  # ad44
    title: "AMB-METHOD: Method calls with 3+ ambiguous receiver types must not produce resolved edges"  # ad44
    status: todo_hard  # ad44
    priority: 2  # ad44
    parent:  # ad44
    tags: []  # ad44
    before: []  # ad44
    duplicate_of: []  # ad44
    not_duplicate_of: []  # ad44
    pr_ref:  # ad44
    justification:  # ad44
    description: "Cross-language invariant. Go fixed in PR #1261. Same pattern exists in PHP, Java, Ruby, C#, Kotlin, Groovy, Dart. Next step: factor ambiguity guard into ListNameResolver (symbol_resolution.py) to protect all languages."  # ad44
    fields:  # ad44
      statement: "Method/member-function calls with ambiguous receiver types (3+ candidates) must not produce resolved call edges."  # ad44
      root_cause: "Fallback resolution (ListNameResolver or local_symbols) picks an arbitrary candidate when receiver type cannot be inferred, producing false-positive edges for common method names like Get, Set, String, Close."  # ad44

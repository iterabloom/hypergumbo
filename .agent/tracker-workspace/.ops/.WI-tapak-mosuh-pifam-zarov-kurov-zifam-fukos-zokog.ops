    kind: work_item  # 3b7c
    title: "mypy: adopt NewType for identifier types (StableId, NodeId, EdgeId, ConfigFingerprint)"  # 3b7c
    status: todo_soft  # 3b7c
    priority: 3  # 3b7c
    parent:  # 3b7c
    tags:  # 3b7c

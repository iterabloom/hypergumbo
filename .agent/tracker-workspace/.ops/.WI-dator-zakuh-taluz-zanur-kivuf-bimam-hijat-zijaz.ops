  data:  # fc25
    kind: work_item  # fc25
    title: "Setup: inject managed tracker-governance block into AGENTS.md"  # fc25
    status: needs_human_review  # fc25
    priority: 2  # fc25
    parent:  # fc25
    tags:  # fc25
    - tracker  # fc25

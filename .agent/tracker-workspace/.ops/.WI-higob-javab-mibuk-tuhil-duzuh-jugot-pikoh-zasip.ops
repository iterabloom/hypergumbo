  data:  # a15c
    kind: work_item  # a15c
    title: "INV-dihos Phase 6: Return-Type Registry consumer for Swift + ObjC (never scheduled; 100 + 123 method-kind io rows have no consumer to feed; swift first needs INV-kotob)"  # a15c
    status: todo_hard  # a15c
    priority: 4  # a15c
    parent: INV-dihos-razov-momat-runoh-mohov-zumop-mivar-nijog  # a15c
    tags:  # a15c
    - analysis_quality  # a15c
    - io_boundary  # a15c

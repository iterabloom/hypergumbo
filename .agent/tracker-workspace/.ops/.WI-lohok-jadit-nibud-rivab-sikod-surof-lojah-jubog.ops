    kind: work_item  # 5b81
    title: "Rails (and likely other autoload-by-convention frameworks) demoted to dev_frameworks because refine_frameworks requires explicit import edges"  # 5b81
    status: todo_hard  # 5b81
    priority: 2  # 5b81
    parent:  # 5b81

    kind: work_item  # fd15
    title: "Build SymbolByName helper (Path B-thin); migrate verilog (closes INV-paroh); optional retrofit of 4-6 audit-cohort sites"  # fd15
    status: todo_soft  # fd15
    priority: 3  # fd15
    parent: INV-fosab-tijim-jival-hilof-halaz-divin-pakot-jigub  # fd15
    tags:  # fd15

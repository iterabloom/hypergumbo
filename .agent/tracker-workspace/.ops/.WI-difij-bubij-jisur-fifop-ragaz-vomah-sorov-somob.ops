    kind: work_item  # d689
    title: "Tracker auto-sync can produce empty-diff commits and stale PRs"  # d689
    status: todo_soft  # d689
    priority: 4  # d689
    parent:  # d689
    tags:  # d689
    - ci_infrastructure  # d689

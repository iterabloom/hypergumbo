    title: "_CONTAINER_KINDS includes undocumented 7th kind 'file' beyond spec's 6"  # dc0a
    status: todo_hard  # dc0a
    priority: 1  # dc0a
    parent:  # dc0a
    tags:  # dc0a
    - dogfood_tranch_03  # dc0a

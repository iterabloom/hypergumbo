    kind: work_item  # 1e5f
    title: "WI-bare-promote: extend WI-palol promote phase to bare-name patterns via compound-import-required gate"  # 1e5f
    status: todo_hard  # 1e5f
    priority: 3  # 1e5f
    parent:  # 1e5f

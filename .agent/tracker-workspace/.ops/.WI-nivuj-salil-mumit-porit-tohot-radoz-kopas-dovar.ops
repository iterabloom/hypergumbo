    kind: work_item  # 8383
    title: "Tiered/compact projection node selection is PYTHONHASHSEED-dependent (frontier tie-break)"  # 8383
    status: todo_hard  # 8383
    priority: 2  # 8383
    parent:  # 8383
    tags:  # 8383

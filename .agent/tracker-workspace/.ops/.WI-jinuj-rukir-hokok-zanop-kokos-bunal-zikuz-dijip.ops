    kind: work_item  # 2c83
    title: "axis_drift collects only string-literal SETS, so dict/tuple/derived consumers of every axis are invisible to all four drift linters"  # 2c83
    status: todo_hard  # 2c83
    priority: 2  # 2c83
    parent:  # 2c83
    tags:  # 2c83
    - axis  # 2c83

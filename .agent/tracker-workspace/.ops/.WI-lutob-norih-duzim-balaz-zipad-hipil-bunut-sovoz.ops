    kind: work_item  # bafb
    title: "csharp/solidity/wgsl emit shape_id=None on 100% of body-bearing symbols (analyze()-override bypasses base-class stamp loop)"  # bafb
    status: todo_hard  # bafb
    priority: 2  # bafb

    kind: work_item  # ac42
    title: "A Cargo [[bin]] target declaration is typed as a 'calls' edge whose language is toml, and there is no toml catalogue, so every rust binary crate is withheld"  # ac42
    status: todo_hard  # ac42
    priority: 1  # ac42
    parent:  # ac42
    tags:  # ac42
    - io_boundary  # ac42
    - verify_claims  # ac42

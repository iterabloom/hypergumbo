  data:  # 2e6b
    kind: invariant  # 2e6b
    title: "auto-pr's git-note body preservation never reaches the remote: the pre-push DCO gate applies to refs/notes, which can never carry a sign-off"  # 2e6b
    status: violated  # 2e6b
    priority: 2  # 2e6b
    parent:  # 2e6b
    tags:  # 2e6b

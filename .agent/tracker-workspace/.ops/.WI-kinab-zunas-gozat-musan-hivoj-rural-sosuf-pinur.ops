    kind: work_item  # 03d3
    title: "htrac-frontend: @xyflow/react read-only graph of isbefore/parent edges from the live Y.Doc, with awareness highlights"  # 03d3
    status: todo_soft  # 03d3
    priority: 4  # 03d3
    parent:  # 03d3
    tags:  # 03d3

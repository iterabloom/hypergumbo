  data:  # e9bd
    kind: work_item  # e9bd
    title: "WI-mafik Phase 2 — long-tail analyzer dst_ref adoption (umbrella)"  # e9bd
    status: needs_human_review  # e9bd
    priority: 4  # e9bd
    parent:  # e9bd
    tags:  # e9bd
    - analysis_quality  # e9bd

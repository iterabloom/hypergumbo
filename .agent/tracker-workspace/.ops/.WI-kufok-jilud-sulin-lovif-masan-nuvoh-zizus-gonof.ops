    kind: work_item  # a83d
    title: "Django ORM instance-write re-key is confined to a BARE-NAME receiver: self.order.save() never reaches the catalogue (~1,110 pretix sites)"  # a83d
    status: todo_hard  # a83d
    priority: 3  # a83d
    parent:  # a83d
    tags:  # a83d
    - taint  # a83d

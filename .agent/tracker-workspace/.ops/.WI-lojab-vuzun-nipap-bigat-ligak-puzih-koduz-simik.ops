    kind: work_item  # 6e5f
    title: "puppet: include / require edges start at the manifest file, not the class whose body holds the statement, so class-to-class dependencies are lost"  # 6e5f
    status: todo_hard  # 6e5f
    priority: 3  # 6e5f

    kind: work_item  # 21b5
    title: "dead-code-maybe default --seeds entrypoints flags 89.6% of production functions"  # 21b5
    status: todo_hard  # 21b5
    priority: 1  # 21b5
    parent:  # 21b5
    tags:  # 21b5
    - dogfood_tranch_03  # 21b5

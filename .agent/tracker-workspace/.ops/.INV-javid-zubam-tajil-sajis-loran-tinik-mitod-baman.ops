    kind: invariant  # 108f
    title: "Go semantic import versioning defeats package-alias derivation: a /vN import binds the alias 'vN' and every call on that package falls to the external placeholder"  # 108f
    status: violated  # 108f
    priority: 1  # 108f
    parent:  # 108f
    tags:  # 108f
    - go  # 108f
    - analysis_quality  # 108f
    - call_graph  # 108f

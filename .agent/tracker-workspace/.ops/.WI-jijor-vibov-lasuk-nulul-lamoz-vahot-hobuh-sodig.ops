    kind: work_item  # 6385
    title: "wire validate_pass_dependencies as a FALSIFICATION DETECTOR (not a gate): report passes that emitted output despite an unsatisfied depends_on conjunct"  # 6385
    status: todo_hard  # 6385
    priority: 3  # 6385
    parent:  # 6385
    tags:  # 6385

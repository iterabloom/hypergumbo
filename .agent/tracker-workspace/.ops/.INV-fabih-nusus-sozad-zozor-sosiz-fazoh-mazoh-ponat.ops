  data:  # a053
    kind: invariant  # a053
    title: "Members of nested same-name owners (scala/kotlin/csharp/swift methods, fields, classes) hash the nearest owner only: deleting an earlier outer type moves survivors' stable_ids"  # a053
    status: violated  # a053
    priority: 2  # a053
    parent:  # a053
    tags:  # a053
    - schema  # a053
    - analysis_quality  # a053
    isbefore: []  # a053

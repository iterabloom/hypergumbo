  data:  # 460c
    kind: invariant  # 460c
    title: "Markdown analyzer extraction is incomplete in two complementary ways"  # 460c
    status: violated  # 460c
    priority: 1  # 460c
    parent:  # 460c
    tags:  # 460c
    - dogfood_corpus_20260528  # 460c

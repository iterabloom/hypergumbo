    kind: invariant  # d8bf
    title: "Solidity emits contract members as kind=function, so 2,025 members per repo are invisible to every consumer keyed on kind==method"  # d8bf
    status: violated  # d8bf
    priority: 1  # d8bf
    parent:  # d8bf

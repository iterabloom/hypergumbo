    kind: invariant  # a5b7
    title: "Handler-slice filename collision: route-symbol overwrites function-symbol slice"  # a5b7
    status: violated  # a5b7
    priority: 1  # a5b7
    parent:  # a5b7
    tags:  # a5b7

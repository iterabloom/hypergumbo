    kind: work_item  # f235
    title: "python analyzer splits `from pkg import submodule; submodule.fn()` as module=pkg name=submodule.fn, so the conventional catalogue shape cannot match it (blocks defusedcsv)"  # f235
    status: todo_hard  # f235
    priority: 2  # f235
    parent:  # f235
    tags:  # f235
    - analysis_quality  # f235

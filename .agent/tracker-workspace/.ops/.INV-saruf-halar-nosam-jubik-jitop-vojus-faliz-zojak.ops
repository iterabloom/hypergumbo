    title: "a filtered file's own node is removed but its out-edges survive, so boundary synthesis mints an external_symbol SOURCE for in-tree code (knex lib/dialects/index.js beside index.ts: 27 edges)"  # ddd8
    status: violated  # ddd8
    priority: 3  # ddd8

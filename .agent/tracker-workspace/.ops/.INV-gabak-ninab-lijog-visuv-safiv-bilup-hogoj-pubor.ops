    kind: invariant  # 33c4
    title: "Edge.origin carries the BACKEND name for the SCIP arms and the PASS name for every other producer, so a registry join needs two vocabularies"  # 33c4
    status: violated  # 33c4
    priority: 2  # 33c4
    parent:  # 33c4
    tags:  # 33c4

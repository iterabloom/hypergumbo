    kind: work_item  # b4d4
    title: "TypeScript DDG spec covers only function_declaration; class methods excluded to avoid duplicating the analyzer kind-slot decision"  # b4d4
    status: todo_hard  # b4d4
    priority: 3  # b4d4
    parent:  # b4d4

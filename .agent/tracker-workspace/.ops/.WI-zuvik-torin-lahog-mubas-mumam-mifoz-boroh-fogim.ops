- op: discuss  # 45f4
  at: '2026-03-08T08:46:15Z'  # 45f4
  by: agent  # 45f4
  actor: jgstern_agent  # 45f4
  clock: 4  # 45f4
  nonce: 45f4  # 45f4
  message: "Fixed in PR #2013. _handle_dot_call() now checks if module name (or alias expansion) is a known module prefix before using NameResolver. External modules skip to unresolved edge, preventing bare-name false positives."  # 45f4

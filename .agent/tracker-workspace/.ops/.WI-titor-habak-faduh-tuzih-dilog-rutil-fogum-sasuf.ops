    title: "INV-dihos Phase 3: Return-Type Registry for Rust + C++ + Scala"  # fc96
    status: todo_soft  # fc96
    priority: 3  # fc96
    parent:  # fc96
    tags:  # fc96
    - analysis_quality  # fc96
    - cross_language_linkers  # fc96

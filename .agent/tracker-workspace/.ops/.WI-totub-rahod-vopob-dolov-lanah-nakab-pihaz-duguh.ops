    kind: work_item  # de50
    title: "Gate question for WI-burud: do proc-macro-expanded symbols surface via 'rust-analyzer scip' (default flags)?"  # de50
    status: todo_soft  # de50
    priority: 4  # de50
    parent:  # de50

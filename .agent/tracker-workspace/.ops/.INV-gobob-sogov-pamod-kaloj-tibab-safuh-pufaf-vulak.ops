    kind: invariant  # 8b35
    title: "verify-claims accepts unknown constraint.boundary values as silently 'confirmed'"  # 8b35
    status: violated  # 8b35
    priority: 2  # 8b35
    parent:  # 8b35
    tags:  # 8b35
    - dogfooding  # 8b35
    - pass8  # 8b35

  data:  # c7fe
    kind: invariant  # c7fe
    title: "Mass mislabeling of read operations as write in an access-mode field"  # c7fe
    status: violated  # c7fe
    priority: 1  # c7fe
    parent:  # c7fe
    tags:  # c7fe
    - dogfood_corpus_20260528  # c7fe

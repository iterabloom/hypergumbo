    kind: invariant  # 36a8
    title: "commit-msg scrubbed trailer VALUES only, so a vendor-named trailer KEY passed through verbatim on every agent commit"  # 36a8
    status: violated  # 36a8
    priority: 2  # 36a8
    parent:  # 36a8

    kind: work_item  # 1c49
    title: "a closure inside a method gets no Site-1 enclosing_class hint and no Django-oracle enclosing class, so its inherited self.m() / self.save() is never resolved or typed"  # 1c49
    status: todo_hard  # 1c49
    priority: 3  # 1c49

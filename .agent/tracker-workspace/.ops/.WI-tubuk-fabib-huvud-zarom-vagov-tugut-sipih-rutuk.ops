    kind: work_item  # 0238
    title: "Stop-hook: detect in-flight background tasks and add task-aware guidance"  # 0238
    status: needs_human_review  # 0238
    priority: 3  # 0238
    parent:  # 0238
    tags:  # 0238
    - bf4oxh91w_investigation  # 0238

    kind: invariant  # 25d8
    title: "swift Process row catalogues no LAUNCH (run/launch/Process.run/launchedProcess produce no chain) while wait/terminate/interrupt report as subprocess; objc lacks NSTask.launchedTaskWithLaunchPath:arguments:"  # 25d8
    status: violated  # 25d8
    priority: 2  # 25d8
    parent:  # 25d8

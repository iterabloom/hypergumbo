    title: "annotation-convention linker scans a file once per path spelling (relative vs absolute Symbol.path) and mints every @hg: directive twice -> duplicate node ids in survey output"  # a05b
    status: todo_hard  # a05b
    priority: 3  # a05b
    parent:  # a05b

    kind: work_item  # 2322
    title: "fingerprint field declared but null on 99.7% of nodes (32163/32253) and 100% of analysis_runs (133/133); only manifest-parsing analyzers populate it"  # 2322
    status: todo_hard  # 2322
    priority: 3  # 2322
    parent:  # 2322
    tags:  # 2322
    - schema  # 2322
    - identity  # 2322
    - docs  # 2322

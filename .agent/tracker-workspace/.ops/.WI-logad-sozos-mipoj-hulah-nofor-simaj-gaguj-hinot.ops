  data:  # 5b56
    kind: work_item  # 5b56
    title: "Entrypoint confidence-tier table (spec §887-893) omits library_export base (44% of EPs) and the script/SPA tiers"  # 5b56
    status: todo_hard  # 5b56
    priority: 2  # 5b56
    parent:  # 5b56
    tags:  # 5b56

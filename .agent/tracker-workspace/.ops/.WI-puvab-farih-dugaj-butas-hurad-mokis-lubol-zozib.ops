    title: "Bakeoff: tier-filter diagnostic should use exclude_tests=False to be informative"  # 42d1
    status: todo_soft  # 42d1
    priority: 3  # 42d1
    parent:  # 42d1
    tags:  # 42d1
    - bakeoff_infrastructure  # 42d1

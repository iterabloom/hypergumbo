  data:  # e4d7
    kind: invariant  # e4d7
    title: "META: File-set membership claims must reconcile across passes (or explain divergence)"  # e4d7
    status: violated  # e4d7
    priority: 2  # e4d7
    parent:  # e4d7
    tags:  # e4d7
    - analysis_quality  # e4d7

    kind: work_item  # 9ad9
    title: "Go analyzer: populate access_mode on calls edges via Tier 1 dataflow path (parallel to Python WI-zobid)"  # 9ad9
    status: todo_hard  # 9ad9
    priority: 2  # 9ad9
    parent:  # 9ad9
    tags:  # 9ad9
    - analysis_quality  # 9ad9

    kind: work_item  # ff7f
    title: "io-boundaries text vs JSON 9.3x headline IO total discrepancy from undisclosed suppression"  # ff7f
    status: todo_hard  # ff7f
    priority: 1  # ff7f
    parent:  # ff7f
    tags:  # ff7f
    - dogfood_tranch_03  # ff7f

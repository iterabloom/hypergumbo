    kind: work_item  # a3f8
    title: "Kotlin analyzer emits ZERO type symbols when a file has 2+ bodied type declarations; first method is re-emitted as a top-level function"  # a3f8
    status: todo_hard  # a3f8
    priority: 1  # a3f8

    kind: invariant  # 3694
    title: "subprocess.Popen(tainted) verifies CLEAN while subprocess.run(tainted) verifies VIOLATED: instantiates is absent from TAINT_CALL_EDGE_TYPES"  # 3694
    status: violated  # 3694

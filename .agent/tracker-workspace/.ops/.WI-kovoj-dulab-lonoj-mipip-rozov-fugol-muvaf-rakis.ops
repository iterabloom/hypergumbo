    kind: work_item  # f3a5
    title: "Parallel measurement agents silently truncate their cohort on ENOSPC — a shrunken denominator looks identical to a full one"  # f3a5
    status: todo_hard  # f3a5
    priority: 3  # f3a5
    parent:  # f3a5

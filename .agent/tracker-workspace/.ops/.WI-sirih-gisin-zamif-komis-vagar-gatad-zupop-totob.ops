    kind: work_item  # 2e2f
    title: "Edge has two unique-id fields (id, edge_key) with semantic separation documented only in ir.py docstring, not in spec.md or consumer-facing materials"  # 2e2f
    status: todo_hard  # 2e2f
    priority: 4  # 2e2f

    kind: invariant  # 96ad
    title: "smart-test silently runs NOTHING and exits 0 when given explicit targets (or --full) on a clean tree, so verifying merged work reads as success"  # 96ad
    status: violated  # 96ad
    priority: 2  # 96ad
    parent:  # 96ad

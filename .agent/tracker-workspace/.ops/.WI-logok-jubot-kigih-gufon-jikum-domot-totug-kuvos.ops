    kind: work_item  # f5d6
    title: "Annotation convention for custom pub/sub and dispatch hints (@hg:publishes / @hg:subscribes)"  # f5d6
    status: todo_soft  # f5d6
    priority: 1  # f5d6
    parent:  # f5d6

    kind: invariant  # 94d2
    title: "PlazaFlow readiness: cross-linker integration in polyglot projects"  # 94d2
    status: needs_human_review  # 94d2
    priority: 2  # 94d2
    parent: META-migil-nahuh-hahus-gosok-dujag-zabig-gafil-vonit  # 94d2
    tags:  # 94d2
    - plazaflow  # 94d2
    - integration  # 94d2

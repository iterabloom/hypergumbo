  data:  # 01ff
    kind: work_item  # 01ff
    title: "metrics.languages.<lang>.nodes aggregates synthetic linker-emitted language=None nodes into specific languages; total exceeds Σ(node.language) by 262"  # 01ff
    status: todo_hard  # 01ff
    priority: 3  # 01ff
    parent: INV-luhur-sital-lonar-tagiv-kuzab-mokol-jikot-fosug  # 01ff
    tags:  # 01ff

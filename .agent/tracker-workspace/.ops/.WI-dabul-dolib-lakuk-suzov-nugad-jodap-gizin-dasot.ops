    kind: work_item  # 8389
    title: "llvm_ir: which callee a call binds depends on file order when one file declares @f and another defines it (the registry is last-wins by name)"  # 8389
    status: todo_hard  # 8389
    priority: 3  # 8389
    parent:  # 8389
    tags:  # 8389
    - docstring_audit  # 8389

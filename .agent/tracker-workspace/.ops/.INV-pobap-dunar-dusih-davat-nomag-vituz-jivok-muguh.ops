    kind: invariant  # ae61
    title: "Hack analyzer skips <?hh-header .php files: HackAnalyzer discovery uses only *.hack/*.hh, so find_hack_files' PHP sniffing is dead code"  # ae61
    status: violated  # ae61
    priority: 2  # ae61
    parent:  # ae61
    tags:  # ae61
    - docstring_audit  # ae61

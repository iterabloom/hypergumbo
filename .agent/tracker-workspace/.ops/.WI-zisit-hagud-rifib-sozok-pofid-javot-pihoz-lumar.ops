  data:  # 8426
    kind: work_item  # 8426
    title: "Broaden find_axis_drift scope to include scripts/ and .agent/ (not just packages/)"  # 8426
    status: todo_soft  # 8426
    priority: 4  # 8426
    parent:  # 8426
    tags:  # 8426

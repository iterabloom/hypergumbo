    fields:  # e9be
      statement: "56 DRF router.register(...) viewset registrations produce 0 ViewSet-targeted routes and include(router.urls) resolves to django:unknown (pretix); Django REST Framework router/viewset routing is not modeled."  # e9be
      root_cause: "The Django route model does not understand DRF router.register() plus include(router.urls) indirection, which generates viewset routes dynamically at runtime rather than via explicit path() calls."  # e9be

    kind: work_item  # 2427
    title: "Jackson/JavaBean serialization linker: link @JsonProperty + getX/setX accessors to their JSON serialization call-sites"  # 2427
    status: todo_soft  # 2427
    priority: 2  # 2427
    parent:  # 2427
    tags:  # 2427

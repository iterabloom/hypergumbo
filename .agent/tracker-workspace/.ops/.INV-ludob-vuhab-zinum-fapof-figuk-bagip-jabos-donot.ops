    kind: invariant  # 872a
    title: "explain 'Calls'/'Called by' sections include non-call edges (contains, instantiates) — section headers misleadingly type-uniform"  # 872a
    status: violated  # 872a
    priority: 2  # 872a
    parent:  # 872a
    tags:  # 872a

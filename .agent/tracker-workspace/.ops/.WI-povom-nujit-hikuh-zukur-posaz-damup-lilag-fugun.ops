    kind: work_item  # b5d1
    title: "in-process pub/sub is rowed ipc_send: objc NSNotificationCenter post*, swift NotificationCenter.post cross no process boundary (audit-findings 0021)"  # b5d1
    status: todo_hard  # b5d1
    priority: 3  # b5d1

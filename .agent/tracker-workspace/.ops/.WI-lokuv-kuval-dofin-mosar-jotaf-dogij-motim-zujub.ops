    kind: work_item  # c84b
    title: "Reconcile 419 drift entries between io_primitives write-side and taint_sinks catalogs (WI-hizik follow-up)"  # c84b
    status: needs_human_review  # c84b
    priority: 2  # c84b
    parent:  # c84b

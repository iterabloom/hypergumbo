    kind: work_item  # e0c3
    title: "captured docstrings not surfaced by agent-facing commands: explain never reads .docstring; sketch renders path not summary"  # e0c3
    status: todo_hard  # e0c3
    priority: 2  # e0c3
    parent:  # e0c3

    kind: work_item  # 6e1a
    title: "schema.json types Symbol.language as required non-nullable string; 262 substrate nodes emit null → whole-doc validation fails"  # 6e1a
    status: todo_hard  # 6e1a
    priority: 0  # 6e1a
    parent:  # 6e1a
    tags:  # 6e1a

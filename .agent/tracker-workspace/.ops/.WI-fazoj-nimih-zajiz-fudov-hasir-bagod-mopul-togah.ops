    kind: work_item  # bd3b
    title: "Handler slices route-keyed not handler-keyed; 7/8 degenerate 1n/0e"  # bd3b
    status: todo_hard  # bd3b
    priority: 1  # bd3b
    parent: INV-nubub-davag-vihut-zurib-kunuf-nukub-tidab-dogig  # bd3b

    kind: work_item  # fc34
    title: "tracker reconcile: one command for flush + fast-forward + journal restore; deprecate the bare recover"  # fc34
    status: todo_hard  # fc34
    priority: 2  # fc34
    parent:  # fc34
    tags:  # fc34

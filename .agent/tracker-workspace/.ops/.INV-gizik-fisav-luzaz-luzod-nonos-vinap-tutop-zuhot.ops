  data:  # 2ecd
    kind: invariant  # 2ecd
    title: "Per-pass timer and file-counter not updated for passes that consume the intermediate representation"  # 2ecd
    status: violated  # 2ecd
    priority: 1  # 2ecd
    parent:  # 2ecd
    tags:  # 2ecd

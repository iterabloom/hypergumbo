    kind: work_item  # 4f2c
    title: "metrics.languages.<lang>.files = 0 for all 18 language entries; per-language file rollup unpopulated"  # 4f2c
    status: todo_hard  # 4f2c
    priority: 2  # 4f2c
    parent: INV-luhur-sital-lonar-tagiv-kuzab-mokol-jikot-fosug  # 4f2c

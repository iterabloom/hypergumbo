    kind: work_item  # 96b4
    title: "run crashes on unreadable file: uncaught PermissionError aborts whole run, no output JSON (§17 violated)"  # 96b4
    status: todo_hard  # 96b4
    priority: 0  # 96b4
    parent:  # 96b4
    tags:  # 96b4
    - dogfood_tranch_04  # 96b4

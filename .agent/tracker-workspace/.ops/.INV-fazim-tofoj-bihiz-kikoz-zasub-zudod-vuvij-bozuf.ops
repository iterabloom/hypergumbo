    title: "Go marks an external instance-method call is_resolved=True on an 'external'/'unresolved' dst, routing it into the ungated hits[0] bare-name fallback and bypassing the F3 gate"  # c6bd
    status: violated  # c6bd
    priority: 1  # c6bd
    parent:  # c6bd
    tags:  # c6bd
    - taint  # c6bd
    - go  # c6bd
    - io_boundary  # c6bd

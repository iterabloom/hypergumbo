    kind: work_item  # de03
    title: "PlazaFlow readiness: multi-WASM module boundary quality"  # de03
    status: needs_human_review  # de03
    priority: 3  # de03
    parent: META-migil-nahuh-hahus-gosok-dujag-zabig-gafil-vonit  # de03

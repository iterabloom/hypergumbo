    kind: invariant  # 577d
    title: "Results cache does not invalidate on tree-sitter grammar upgrade (analyzer_identity omits grammar versions)"  # 577d
    status: violated  # 577d
    priority: 2  # 577d
    parent:  # 577d
    tags:  # 577d

    kind: work_item  # e6ab
    title: "Tracker auto-sync: failed push should not discard local ops files"  # e6ab
    status: todo_hard  # e6ab
    priority: 1  # e6ab
    parent:  # e6ab
    tags:  # e6ab
    - ci_infrastructure  # e6ab
    before: []  # e6ab

    kind: work_item  # aae3
    title: "go_cobra_linker misses package-var-assigned cobra.Command literals"  # aae3
    status: todo_soft  # aae3
    priority: 3  # aae3
    parent:  # aae3
    tags:  # aae3
    - linker_gap  # aae3

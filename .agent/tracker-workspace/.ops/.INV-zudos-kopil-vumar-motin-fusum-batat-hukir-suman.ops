    kind: invariant  # d44d
    title: "js: 'process' is missing from JS_KNOWN_GLOBALS, so process.on is unreachable in the require-less spelling that Node code actually uses"  # d44d
    status: violated  # d44d
    priority: 2  # d44d
    parent:  # d44d
    tags:  # d44d
    - catalogue  # d44d

    kind: work_item  # a446
    title: "fish, hack, D and bitbake start edges at a hand-built file id (fish:<path>:file:, d:<path>:file:, bitbake:<path>), not make_file_id's node"  # a446
    status: todo_hard  # a446
    priority: 3  # a446
    parent:  # a446
    tags:  # a446
    - docstring_audit  # a446

  data:  # e783
    kind: invariant  # e783
    title: "cpp joins every #include into one comma-separated module slot, so C++'s entire stdlib I/O surface misses the catalogue (6 of 86 matched on whisper.cpp)"  # e783
    status: violated  # e783
    priority: 1  # e783
    parent:  # e783

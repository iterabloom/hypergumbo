    title: "Agent-supervisor meta-circuit-breaker: short-window detection, chain tracking, backoff, kill switch"  # 17f4
    status: todo_soft  # 17f4
    priority: 2  # 17f4
    parent: WI-razub-duluf-nobun-rulit-dapam-jipal-dafud-nahob  # 17f4

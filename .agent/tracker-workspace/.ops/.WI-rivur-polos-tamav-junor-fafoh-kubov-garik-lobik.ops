    title: "Five misdeclarations found by the WI-hazop census that are NOT deferred crossings: gethostname as net_recv, removeObserver/os.wait* as ipc_recv, sqlite3 backup as db_read, ets.info as db_read"  # 8ad1
    status: todo_hard  # 8ad1
    priority: 3  # 8ad1
    parent:  # 8ad1
    tags:  # 8ad1

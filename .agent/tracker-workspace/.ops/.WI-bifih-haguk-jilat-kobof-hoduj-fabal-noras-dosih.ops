    kind: work_item  # a3b7
    title: "Python analyzer lacks explicit stdlib catalog: 4477 imports resolve as 'unresolved'"  # a3b7
    status: todo_hard  # a3b7
    priority: 3  # a3b7
    parent:  # a3b7
    tags:  # a3b7
    - dogfooding  # a3b7
    - pass10  # a3b7

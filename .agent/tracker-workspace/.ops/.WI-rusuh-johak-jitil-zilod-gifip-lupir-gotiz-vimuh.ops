    kind: work_item  # 3c17
    title: "Audit: route_handler linker single-value symbol_by_name primary index (BUG-04/05 shape)"  # 3c17
    status: todo_hard  # 3c17
    priority: 2  # 3c17
    parent:  # 3c17
    tags:  # 3c17

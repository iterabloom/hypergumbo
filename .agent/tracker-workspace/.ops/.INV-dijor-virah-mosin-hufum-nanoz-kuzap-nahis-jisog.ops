    kind: invariant  # db96
    title: "_module_matches arm 3 has no capitalisation test, so a catalogue module ending in a TYPE matches a bare receiver-variable hint: sops classifies a CLI flag read as net_send"  # db96
    status: violated  # db96
    priority: 2  # db96

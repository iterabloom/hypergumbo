    kind: invariant  # 8a3b
    title: "yjsDocId metadata in SpatialObjects must become document_references edges"  # 8a3b
    status: violated  # 8a3b
    priority: 4  # 8a3b
    parent: META-sulor-nulit-birav-sikav-zihuh-povis-kavis-fojut  # 8a3b
    tags:  # 8a3b
    - plazaflow  # 8a3b

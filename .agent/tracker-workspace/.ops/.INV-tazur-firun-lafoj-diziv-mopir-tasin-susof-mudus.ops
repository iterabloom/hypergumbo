    kind: invariant  # 3b38
    title: "smart-test: a deleted test file stays in the targeted selection and the run collects 0 items yet reports green coverage"  # 3b38
    status: violated  # 3b38
    priority: 2  # 3b38
    parent:  # 3b38
    tags:  # 3b38

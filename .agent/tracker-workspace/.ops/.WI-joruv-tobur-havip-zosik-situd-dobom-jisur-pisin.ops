    title: "Taint findings drop the matched catalog entry's module, so a correct match cannot be verified by lookup (INV-karud's residual 13)"  # 8d1f
    status: todo_hard  # 8d1f
    priority: 2  # 8d1f
    parent:  # 8d1f

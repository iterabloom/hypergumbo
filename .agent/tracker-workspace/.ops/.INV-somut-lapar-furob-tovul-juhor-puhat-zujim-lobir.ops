  data:  # 237f
    kind: invariant  # 237f
    title: "META(sub-A): verify-claims silent-confirm verdict fall-through"  # 237f
    status: violated  # 237f
    priority: 1  # 237f
    parent: INV-fabov-kapit-mupit-tigoz-lurol-mulus-jivik-kajun  # 237f
    tags:  # 237f
    - dogfood_corpus_20260528  # 237f
    - dogfood_umbrella  # 237f
    - dogfood_severity_significant  # 237f

    kind: work_item  # 2166
    title: "A subprocess primitive that RETURNS the child's output is also an untrusted_input source, and the WI-jupaf re-key left that half unlabelled"  # 2166
    status: todo_hard  # 2166
    priority: 2  # 2166
    parent:  # 2166
    tags:  # 2166
    - io_boundary  # 2166

    kind: work_item  # 8ec0
    title: "Convention-based view-template linker for Django"  # 8ec0
    status: needs_human_review  # 8ec0
    priority: 3  # 8ec0
    parent:  # 8ec0
    tags:  # 8ec0
    - framework_dispatch_linkers  # 8ec0

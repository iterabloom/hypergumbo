    kind: work_item  # eeff
    title: "34 emitted Edge.meta keys are unregistered though axis_meta_keys claims exhaustiveness — 2 of them (enclosing_class, inherited_field_receiver; 158,375 edges) are written by make_unresolved_edge itself"  # eeff
    status: todo_hard  # eeff
    priority: 3  # eeff
    parent:  # eeff

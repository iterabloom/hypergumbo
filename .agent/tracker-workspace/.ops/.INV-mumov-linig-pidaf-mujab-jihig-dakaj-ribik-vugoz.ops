  data:  # 7495
    kind: invariant  # 7495
    title: "MEASURE FIRST: Python analyzer emits ZERO call edges for attribute-chain receivers (obj.related.create()), so an all-attr-chain function has NO sink edge and its flow is never reported"  # 7495
    status: violated  # 7495
    priority: 1  # 7495
    parent:  # 7495
    tags:  # 7495
    - taint  # 7495
    - python  # 7495
    - analyzer  # 7495

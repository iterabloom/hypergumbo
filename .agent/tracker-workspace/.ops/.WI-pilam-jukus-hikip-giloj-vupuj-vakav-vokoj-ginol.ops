  data:  # 96fa
    kind: work_item  # 96fa
    title: "Generalize find_axis_drift to multiple axis-bearing fields (currently hardcoded to *EDGE_TYPE* substring)"  # 96fa
    status: todo_soft  # 96fa
    priority: 4  # 96fa
    parent:  # 96fa
    tags:  # 96fa
    - concept_audit  # 96fa

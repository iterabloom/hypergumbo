    kind: work_item  # 9076
    title: "Edge has two unique-id fields (id + edge_key); semantic difference not documented, naming diverges from Symbol's id/stable_id convention"  # 9076
    status: todo_soft  # 9076
    priority: 3  # 9076
    parent:  # 9076
    tags:  # 9076
    - pass22  # 9076

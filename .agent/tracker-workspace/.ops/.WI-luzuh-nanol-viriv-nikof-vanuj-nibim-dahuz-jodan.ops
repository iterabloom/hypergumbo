  data:  # 3baa
    kind: work_item  # 3baa
    title: "Replace schema-conformance gate's self-analysis run with a schema-rule-driven fixture corpus"  # 3baa
    status: todo_hard  # 3baa
    priority: 3  # 3baa
    parent:  # 3baa
    tags:  # 3baa
    - ci_infrastructure  # 3baa
    - perf  # 3baa

    kind: invariant  # 2add
    title: "META: Passes execute and consume resources but emit no edges, with no activation gate"  # 2add
    status: violated  # 2add
    priority: 2  # 2add
    parent:  # 2add
    tags:  # 2add
    - dogfood_corpus_20260528  # 2add

    kind: work_item  # 88e8
    title: "Rust implements-edge linker: kind disambiguation + cross-language gating (UAT BUG-03)"  # 88e8
    status: todo_hard  # 88e8
    priority: 3  # 88e8
    parent:  # 88e8

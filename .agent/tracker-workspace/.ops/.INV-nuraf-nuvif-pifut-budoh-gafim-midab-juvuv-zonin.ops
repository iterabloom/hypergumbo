  data:  # a71d
    kind: invariant  # a71d
    title: "dependency linker: partial-requirement warning counts resolved first-party Python imports as 'third-party' (regression from WI-juzaj, PR #1511)"  # a71d
    status: violated  # a71d
    priority: 3  # a71d
    parent:  # a71d
    tags:  # a71d
    - linkers  # a71d

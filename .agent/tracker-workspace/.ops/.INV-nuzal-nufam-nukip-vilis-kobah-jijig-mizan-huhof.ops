    kind: invariant  # 91c5
    title: "edge.provenance dict empty on 100% of edges; node.quality and edge.quality also universally empty"  # 91c5
    status: violated  # 91c5
    priority: 1  # 91c5
    parent:  # 91c5
    tags:  # 91c5
    - dogfooding  # 91c5

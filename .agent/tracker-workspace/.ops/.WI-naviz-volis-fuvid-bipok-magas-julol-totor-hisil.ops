    title: "python: qualified_name of a nested class's member keeps only the nearest class (B.go, not A.B.go)"  # 6fd0
    status: todo_hard  # 6fd0
    priority: 4  # 6fd0
    parent:  # 6fd0
    tags:  # 6fd0
    - analysis_quality  # 6fd0
    isbefore: []  # 6fd0

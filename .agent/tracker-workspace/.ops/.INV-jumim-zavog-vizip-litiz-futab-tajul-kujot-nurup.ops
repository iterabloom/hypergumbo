    kind: invariant  # abd2
    title: "sketch --input ignores cached test-file info and re-walks filesystem via _analyze_test_files (causes 60+ sec wall-clock on populated repos)"  # abd2
    status: violated  # abd2
    priority: 2  # abd2
    parent:  # abd2
    tags:  # abd2

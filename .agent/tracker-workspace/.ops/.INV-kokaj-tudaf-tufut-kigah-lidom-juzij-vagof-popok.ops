    title: "Apply file-canonical rule to js_ts/bash/perl/php/powershell — cross-language sibling of INV-hojus"  # b365
    status: violated  # b365
    priority: 3  # b365
    parent: INV-dajaf-sibav-fadaj-rubip-zoguh-puraf-fisid-huvov  # b365
    tags:  # b365

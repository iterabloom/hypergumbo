    kind: work_item  # bf3d
    title: "JS/TS DDG never walks binding-named callables (arrow functions, function expressions): 7,415 of 11,600 dash.js functions"  # bf3d
    status: todo_hard  # bf3d
    priority: 3  # bf3d

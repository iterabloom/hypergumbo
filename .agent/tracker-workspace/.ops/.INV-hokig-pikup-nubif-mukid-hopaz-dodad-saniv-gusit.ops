    kind: invariant  # 2718
    title: "profile.languages and analyzer pass disagree on file count (10 vs 41 bash files on self-analysis) due to inconsistent exclude policy"  # 2718
    status: violated  # 2718
    priority: 2  # 2718
    parent:  # 2718

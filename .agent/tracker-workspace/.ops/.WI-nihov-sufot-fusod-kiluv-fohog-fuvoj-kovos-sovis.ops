    kind: work_item  # 6e9e
    title: "node-http createServer: aliased import, receiver-text match, require form; alias detection re-demotes vite's API"  # 6e9e
    status: todo_soft  # 6e9e
    priority: 3  # 6e9e
    parent:  # 6e9e

    title: "mypy: adopt @override decorator usage; enable explicit-override error code"  # 1db5
    status: todo_soft  # 1db5
    priority: 4  # 1db5
    parent:  # 1db5
    tags:  # 1db5
    - mypy_adoption  # 1db5
    - developer_experience  # 1db5

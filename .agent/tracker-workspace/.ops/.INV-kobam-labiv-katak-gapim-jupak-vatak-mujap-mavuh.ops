  data:  # 381e
    kind: invariant  # 381e
    title: "verify-claims: a community overlay passed by --io-primitives or a claims file is listed as an APPLIED completeness grant although the load withholds it"  # 381e
    status: violated  # 381e
    priority: 2  # 381e
    parent:  # 381e
    tags:  # 381e
    - verify_claims  # 381e
    - io_boundary  # 381e
    - catalogue_tiers  # 381e

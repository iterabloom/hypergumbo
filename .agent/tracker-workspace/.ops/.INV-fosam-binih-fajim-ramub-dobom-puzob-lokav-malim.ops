    kind: invariant  # 9015
    title: "Detected route framework whose LANGUAGE_FRAMEWORKS key != YAML basename loads NO route YAML (next/adonis/aspnetcore/vert.x/zio-http) -> routes silently dropped even WITH a manifest"  # 9015
    status: violated  # 9015
    priority: 2  # 9015

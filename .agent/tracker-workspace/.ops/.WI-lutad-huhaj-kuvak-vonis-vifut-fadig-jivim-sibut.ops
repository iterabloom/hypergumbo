  data:  # be0c
    kind: work_item  # be0c
    title: "18388 linker edges exceed 0.95 ceiling; 81/104 entrypoints below 0.70 floor"  # be0c
    status: todo_hard  # be0c
    priority: 1  # be0c
    parent: INV-suvil-jojoh-gifib-zirig-famom-sorim-tarar-hojok  # be0c

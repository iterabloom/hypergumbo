    kind: invariant  # 77dc
    title: "The axis-drift NAME filter cannot reach a consumer named for what it maps TO, so two live io-boundary dicts are ungated by construction"  # 77dc
    status: violated  # 77dc
    priority: 3  # 77dc
    parent:  # 77dc

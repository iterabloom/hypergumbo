    kind: invariant  # 6d7c
    title: "A constructor declared under a data-transfer boundary: urllib.request.Request (net_send) and its family"  # 6d7c
    status: violated  # 6d7c
    priority: 2  # 6d7c
    parent:  # 6d7c
    tags:  # 6d7c

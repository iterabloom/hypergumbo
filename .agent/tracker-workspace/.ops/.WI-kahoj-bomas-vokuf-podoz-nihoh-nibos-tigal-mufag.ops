    kind: work_item  # 58c8
    title: "GitHub test harness prepends to PATH, so unfaked tools fall through to real binaries (one reaches the live API)"  # 58c8
    status: todo_hard  # 58c8
    priority: 1  # 58c8
    parent:  # 58c8
    tags:  # 58c8

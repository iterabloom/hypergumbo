  data:  # 5c8b
    kind: work_item  # 5c8b
    title: "release.yml: asset upload has no retry or completeness check; v9.1.0 GitHub Release lacks sbom.json after a transient 404"  # 5c8b
    status: todo_hard  # 5c8b
    priority: 3  # 5c8b
    parent:  # 5c8b

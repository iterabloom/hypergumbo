    kind: work_item  # ba51
    title: "Coordinated log_training_example metadata cutover (snapshot+pause+restart)"  # ba51
    status: needs_human_review  # ba51
    priority: 2  # ba51
    parent:  # ba51
    tags:  # ba51
    - bf4oxh91w_investigation  # ba51

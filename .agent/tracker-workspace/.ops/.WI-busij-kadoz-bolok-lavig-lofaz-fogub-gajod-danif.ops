    kind: work_item  # 64a2
    title: "Pre-commit detection of new multi-value field additions to core dataclasses"  # 64a2
    status: todo_soft  # 64a2
    priority: 4  # 64a2
    parent:  # 64a2
    tags:  # 64a2

  data:  # a93b
    kind: invariant  # a93b
    title: "INV: HTTP-linker URL extraction folds constant-composed URLs across all source languages"  # a93b
    status: needs_human_review  # a93b
    priority: 4  # a93b
    parent:  # a93b
    tags:  # a93b
    - cross_language_linkers  # a93b

    title: "AR.files_analyzed non-deterministic across runs on 18/84 ARs (file-router race or dict-iteration-order assignment)"  # 3584
    status: todo_hard  # 3584
    priority: 2  # 3584
    parent: INV-luhur-sital-lonar-tagiv-kuzab-mokol-jikot-fosug  # 3584

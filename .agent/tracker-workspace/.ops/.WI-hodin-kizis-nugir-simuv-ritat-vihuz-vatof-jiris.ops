    kind: work_item  # 1beb
    title: "ADR-0036 and ADR-0034 points the id work could not decide: empty name slot, slots with no ruled language"  # 1beb
    status: needs_human_review  # 1beb
    priority: 3  # 1beb
    parent:  # 1beb
    tags:  # 1beb
    - id_format  # 1beb

  data:  # de16
    kind: invariant  # de16
    title: "G1 validator ratchet BREACHED on dev — 2 runtime_coherence offenders vs baseline 1, plus a stale go route test, both masked by test selection"  # de16
    status: violated  # de16
    priority: 1  # de16
    parent:  # de16
    tags:  # de16

    kind: work_item  # 5b33
    title: "metrics.by_supply_chain_tier.edges=0 for tier 2/3 despite 2881/27272 incident edges"  # 5b33
    status: todo_hard  # 5b33
    priority: 1  # 5b33
    parent:  # 5b33
    tags:  # 5b33
    - dogfood_tranch_03  # 5b33

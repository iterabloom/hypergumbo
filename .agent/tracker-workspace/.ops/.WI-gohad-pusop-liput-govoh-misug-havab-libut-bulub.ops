    kind: work_item  # 4325
    title: "Go linker: spf13/cobra CLI command dispatch (RunE, PreRunE, etc.)"  # 4325
    status: todo_soft  # 4325
    priority: 3  # 4325
    parent: WI-juhov-pisup-gumit-filan-puhon-kavof-govad-dikuf  # 4325
    tags:  # 4325

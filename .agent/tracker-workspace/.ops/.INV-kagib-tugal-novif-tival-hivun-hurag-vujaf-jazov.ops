    kind: invariant  # c2dc
    title: "ocaml/agda/lean/wolfram analyzers drop the second same-name callable in a file (nested modules, namespaces, records, overloads)"  # c2dc
    status: violated  # c2dc
    priority: 2  # c2dc
    parent:  # c2dc
    tags:  # c2dc
    - analysis_quality  # c2dc

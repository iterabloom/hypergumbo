    title: "ADR-0015: Slice --dataflow flag (write-to-read chain traversal)"  # ce6e
    status: todo_soft  # ce6e
    priority: 1  # ce6e
    parent:  # ce6e
    tags:  # ce6e
    - adr-0015  # ce6e

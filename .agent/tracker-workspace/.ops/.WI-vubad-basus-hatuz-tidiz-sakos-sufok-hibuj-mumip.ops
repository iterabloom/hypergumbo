    kind: work_item  # bb64
    title: "is_generated_file detection misses TypeScript OpenAPI-generated files (openapi-gen/**)"  # bb64
    status: todo_soft  # bb64
    priority: 3  # bb64
    parent:  # bb64
    tags:  # bb64

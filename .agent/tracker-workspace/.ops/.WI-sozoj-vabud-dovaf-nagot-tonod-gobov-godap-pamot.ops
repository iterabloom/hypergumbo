    kind: work_item  # 6a8d
    title: "Django-ORM / SQLAlchemy I/O invisible: db_* needs receiver-type inference, not catalog entries (io_tag_rate ~0.5% on Django repos)"  # 6a8d
    status: todo_hard  # 6a8d
    priority: 2  # 6a8d

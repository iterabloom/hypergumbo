  data:  # a163
    kind: invariant  # a163
    title: "agda: renaming-import aliases are extracted but never consulted, so references through a renamed name drop"  # a163
    status: violated  # a163
    priority: 3  # a163
    parent:  # a163
    tags:  # a163
    - docstring_audit  # a163

  data:  # 0b00
    kind: work_item  # 0b00
    title: "WI-depends-on-substrate: Pass.depends_on field + validator + bridge-linker population"  # 0b00
    status: todo_soft  # 0b00
    priority: 3  # 0b00
    parent:  # 0b00
    tags:  # 0b00

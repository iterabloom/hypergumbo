    kind: work_item  # 89b5
    title: "npm and Cargo workspace imports of a sibling package call a tier-3 phantom (@ws/b:helper, crate_b::helper external_symbol) instead of the sibling's real source"  # 89b5
    status: todo_hard  # 89b5
    priority: 2  # 89b5

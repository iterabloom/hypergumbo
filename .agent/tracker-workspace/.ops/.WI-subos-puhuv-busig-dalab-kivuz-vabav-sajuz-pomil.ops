    kind: work_item  # 2b45
    title: "A sketch without source content leaves most of a large budget unused when its listings run out, and no test checks a section's size against its ADR-0005 share"  # 2b45
    status: todo_hard  # 2b45
    priority: 3  # 2b45
    parent:  # 2b45
    tags:  # 2b45

  data:  # 93a4
    kind: invariant  # 93a4
    title: "Every tree-sitter analyzer anchors module_attr_ref to the FILE, so all 21 attribute-kind js/ts taint sources (process.env included) can never start a flow"  # 93a4
    status: violated  # 93a4
    priority: 1  # 93a4
    parent:  # 93a4
    tags:  # 93a4

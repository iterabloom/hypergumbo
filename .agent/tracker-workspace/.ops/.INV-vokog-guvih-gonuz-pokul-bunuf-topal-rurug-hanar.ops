    kind: invariant  # bf76
    title: "an opaque launch is also counted as an uncatalogued module, so qualifying_only can never hold and the fourth verdict is unreachable by construction"  # bf76
    status: violated  # bf76
    priority: 1  # bf76
    parent:  # bf76

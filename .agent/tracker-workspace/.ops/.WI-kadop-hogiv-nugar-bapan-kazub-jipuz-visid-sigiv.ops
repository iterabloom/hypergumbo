  data:  # ed73
    kind: work_item  # ed73
    title: "Symbol.synthesis_mechanism sibling field (new ADR + IR change + producer/consumer migration)"  # ed73
    status: todo_hard  # ed73
    priority: 2  # ed73
    parent:  # ed73
    tags:  # ed73
    - classification_axes  # ed73

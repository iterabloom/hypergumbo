    kind: work_item  # 9f8c
    title: "README coverage badge: restore it (Woodpecker writes badges/coverage.json) or add a static one; owner deferred 2026-10-20"  # 9f8c
    status: needs_human_review  # 9f8c
    priority: 4  # 9f8c

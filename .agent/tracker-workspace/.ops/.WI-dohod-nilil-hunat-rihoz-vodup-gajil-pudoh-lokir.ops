    kind: work_item  # d2a3
    title: "Row the unrowed I/O in C's stdio, unistd, stdlib, sys/socket, sys/stat, fcntl and dirent, then audit them for module_completeness"  # d2a3
    status: todo_hard  # d2a3
    priority: 3  # d2a3
    parent:  # d2a3

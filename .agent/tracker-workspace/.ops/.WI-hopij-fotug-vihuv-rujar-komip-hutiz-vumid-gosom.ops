    kind: work_item  # 4c9d
    title: "Add shared has_concept(symbol, name) helper to prevent concept-tag shape drift"  # 4c9d
    status: todo_soft  # 4c9d
    priority: 3  # 4c9d
    parent:  # 4c9d
    tags:  # 4c9d
    - framework_dispatch_linkers  # 4c9d

  data:  # ac68
    kind: invariant  # ac68
    title: "cross_language meta field misses 55% of actually-cross-language edges; cross_language=False is redundant"  # ac68
    status: violated  # ac68
    priority: 2  # ac68
    parent:  # ac68
    tags:  # ac68
    - pass19  # ac68
    - dogfooding  # ac68
    - classification_axes_audit  # ac68
    isbefore: []  # ac68
    duplicate_of: []  # ac68
    not_duplicate_of: []  # ac68
    pr_ref:  # ac68
    description: ""  # ac68
    fields:  # ac68
      severity: "medium"  # ac68
      statement: "Among 64 edges where src.language != dst.language, only 29 carry meta.cross_language=True (45% coverage). The other 35 (depends_on_manifest 26, uses 7, script_src 1, imports 1) are silently untagged. Conversely, meta.cross_language=False appears on 103 edges where src.language == dst.language — fully redundant since derivable from node.language fields. The field has no informational value: True undercounts, False over-tags within-language."  # ac68
      root_cause: "Only some linkers (websocket-linker, message-queue-linker, http-linker) explicitly populate cross_language. Others (dependency-linker, enclosure-linker, html, solidity) emit cross-language edges without the field. The field design also doesn't distinguish 'unmarked' from 'within-language'."  # ac68

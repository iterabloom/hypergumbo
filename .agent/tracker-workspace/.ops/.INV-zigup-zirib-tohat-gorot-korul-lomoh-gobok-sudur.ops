    kind: invariant  # ac68
    title: "cross_language meta field misses 55% of actually-cross-language edges; cross_language=False is redundant"  # ac68
    status: violated  # ac68
    priority: 2  # ac68
    parent:  # ac68
    tags:  # ac68
    - pass19  # ac68

    title: "profile.languages.<lang>.loc 1.66× double-counts vs Σ(node.lines_of_code) from nested-symbol aggregation; file-kind LOC=0; methodology undocumented"  # 8bd9
    status: todo_hard  # 8bd9
    priority: 3  # 8bd9

  data:  # 0265
    kind: work_item  # 0265
    title: "Emit references edge from 'from X import BAR' site to BAR variable Symbol (WI-gafog follow-up)"  # 0265
    status: todo_hard  # 0265
    priority: 3  # 0265
    parent:  # 0265
    tags:  # 0265

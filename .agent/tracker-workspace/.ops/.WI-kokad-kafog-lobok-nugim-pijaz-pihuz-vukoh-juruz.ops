    kind: work_item  # 2406
    title: "elixir: defdelegate registers no symbol under the delegating module, so Phoenix.CodeReloader.sync() resolves to nothing (it used to resolve to the WRONG module via bare-name lookup)"  # 2406
    status: todo_hard  # 2406
    priority: 3  # 2406

    title: "auto-pr: fall back to branch-push + API PR-create when AGit proc-receive fails (desync resilience)"  # 69ba
    status: needs_human_review  # 69ba
    priority: 2  # 69ba
    parent:  # 69ba
    tags:  # 69ba

    kind: invariant  # 29c2
    title: "Route transport protocol (WS/LIVE/RPC) smuggled into http_method; fold to route_protocol axis reconciled with protocol_origin"  # 29c2
    status: violated  # 29c2
    priority: 3  # 29c2

    kind: work_item  # 2933
    title: "Validation ratchet: warning checks are advisory (total-count-only) + the strategy-promised self-tree gate does not exist"  # 2933
    status: todo_hard  # 2933
    priority: 2  # 2933
    parent:  # 2933
    tags:  # 2933

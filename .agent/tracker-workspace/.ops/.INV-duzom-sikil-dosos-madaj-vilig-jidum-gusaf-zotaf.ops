  data:  # c841
    kind: invariant  # c841
    title: "A fully-qualified Rust call path is never split into module + name, so std::io::stdin() and std::fs::File::open() reach no catalogue row"  # c841
    status: violated  # c841
    priority: 2  # c841
    parent:  # c841
    tags:  # c841

    kind: work_item  # 5a3f
    title: "calls-edge src endpoint resolves to wrong same-base-name sibling method (506 edges out-of-span; 504 attributed to same-named peer in same file)"  # 5a3f
    status: todo_hard  # 5a3f
    priority: 0  # 5a3f
    parent:  # 5a3f

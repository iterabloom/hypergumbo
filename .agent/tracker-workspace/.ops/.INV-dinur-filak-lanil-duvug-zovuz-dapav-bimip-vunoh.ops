    duplicate_of: []  # 40f7
    not_duplicate_of: []  # 40f7
    pr_ref:  # 40f7
    justification:  # 40f7
    description: "Universal gap across all 8 major analyzers. No analyzer detects function references in struct/object literal field values, variable assignments, or collection elements. Go is the only analyzer with dedicated _extract_function_reference_edges but it only fires for call arguments, not struct literal fields. C has partial coverage (static array initializers only). Discovered via external bakeoff evaluation: cobra.Command{RunE: myFunc} in Go produces zero edges."  # 40f7
    fields:  # 40f7
      statement: "Function references that appear outside direct call expressions (struct fields, object literal values, variable assignments, array elements) must produce edges to the referenced function"  # 40f7
      root_cause: "All analyzers only walk call_expression AST nodes for edge extraction. Struct literal fields, object/dict values, array elements, and variable assignments containing function references are not traversed."  # 40f7

  data:  # 063b
    kind: work_item  # 063b
    title: "auto-pr exits without a declared terminal state (final_state=unknown) in 14 of 481 recorded runs"  # 063b
    status: todo_hard  # 063b
    priority: 2  # 063b
    parent:  # 063b
    tags:  # 063b

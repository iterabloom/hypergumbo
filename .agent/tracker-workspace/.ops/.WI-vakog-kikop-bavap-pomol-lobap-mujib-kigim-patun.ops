    kind: work_item  # ebd4
    title: "cfg.unaccounted_names keys statements by node_type, so names in a `with` header are never checked (the completeness gate fails open there)"  # ebd4
    status: todo_hard  # ebd4
    priority: 3  # ebd4
    parent:  # ebd4
    tags:  # ebd4
    - docstring_audit  # ebd4

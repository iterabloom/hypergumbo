    kind: invariant  # bf82
    title: "analysis_method conflates \"walk proved no dependence\" with \"walk escaped\": ddg_mixed keys on fn_has_ddg, not on the walk result"  # bf82
    status: violated  # bf82
    priority: 1  # bf82

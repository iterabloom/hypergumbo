    kind: work_item  # 2df1
    title: "ruby: a call on an external constant receiver binds an in-repo method by short name (Rails.root.join -> HealthServer#root, Postal::Config.dns -> DNSResolver#dns)"  # 2df1
    status: todo_hard  # 2df1
    priority: 2  # 2df1
    parent:  # 2df1

    kind: work_item  # 80bd
    title: "BUG-04 regression: rust.py:1097 single-value global_symbols dict misresolves trait/struct name collisions in Rust"  # 80bd
    status: todo_soft  # 80bd
    priority: 1  # 80bd
    parent: WI-zozuz-hobuv-budif-pozog-dazis-huvov-nudit-gazig  # 80bd
    tags:  # 80bd

  data:  # f3a6
    kind: invariant  # f3a6
    title: "call_construct still mixes resolution status and dispatch mechanism into a construct axis; INV-vakaf drained only the cross_file instance"  # f3a6
    status: violated  # f3a6
    priority: 2  # f3a6
    parent:  # f3a6
    tags:  # f3a6
    - analyzer  # f3a6
    - classification_axes_audit  # f3a6

  data:  # 8c2b
    kind: work_item  # 8c2b
    title: "PyO3 FFI calls to Rust IO primitives not traced by io-boundaries"  # 8c2b
    status: todo_soft  # 8c2b
    priority: 3  # 8c2b
    parent:  # 8c2b
    tags:  # 8c2b
    - io-boundary  # 8c2b

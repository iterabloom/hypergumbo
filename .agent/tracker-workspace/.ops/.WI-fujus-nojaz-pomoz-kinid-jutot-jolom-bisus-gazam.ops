    kind: work_item  # a77b
    title: "htrac-frontend: BlockNote discussion view bound to an item's Y.Text (React island); reads via Yjs sync, writes via the op bridge"  # a77b
    status: todo_soft  # a77b
    priority: 4  # a77b
    parent:  # a77b
    tags:  # a77b
    - frontend  # a77b
    - yjs  # a77b

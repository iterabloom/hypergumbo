  data:  # 704b
    kind: invariant  # 704b
    title: "verify-claims never returns on a repository holding a self-referencing directory symlink: supply_chain's manifest walkers follow directory symlinks with no visited set"  # 704b
    status: violated  # 704b
    priority: 2  # 704b
    parent:  # 704b

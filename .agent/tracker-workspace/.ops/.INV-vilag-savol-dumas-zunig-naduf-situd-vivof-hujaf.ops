    kind: invariant  # a1e8
    title: "smart-test exits 0 with a green verdict when test modules fail to COLLECT (false green; the coverage verdict is computed without them)"  # a1e8
    status: violated  # a1e8
    priority: 1  # a1e8
    parent:  # a1e8

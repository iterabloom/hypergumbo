    kind: work_item  # 8b01
    title: "_classify_symbols runs classify_file once PER SYMBOL, re-reading each whole file N times (40x bytes on nestjs; 319 s CPU-bound on flink)"  # 8b01
    status: todo_hard  # 8b01
    priority: 3  # 8b01
    parent:  # 8b01
    tags:  # 8b01

    title: "node.id format escapes documented 'lang:path:span:name:kind' on 12 nodes (rust :: namespacing, npm packages, route IDs)"  # 7744
    status: violated  # 7744
    priority: 2  # 7744
    parent:  # 7744
    tags:  # 7744
    - pass20  # 7744

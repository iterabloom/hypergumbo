    kind: invariant  # 8790
    title: "Path.mkdir callsites in build_grammars + gitleaks bypass safety_zones wrapper discipline"  # 8790
    status: violated  # 8790
    priority: 2  # 8790
    parent:  # 8790
    tags:  # 8790
    - taint_flow  # 8790
    - io_boundary  # 8790

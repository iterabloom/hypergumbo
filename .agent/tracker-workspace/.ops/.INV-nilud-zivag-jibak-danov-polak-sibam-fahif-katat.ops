    kind: invariant  # 864b
    title: "META: Inheritance-aware call resolution lives in linkers/inherited_calls.py, not in language analyzers"  # 864b
    status: violated  # 864b
    priority: 3  # 864b
    parent:  # 864b
    tags:  # 864b

    title: "js-module-linker resolves require('.') / require('..') to an npm package named '.' / '..' (35 of 7,290 resolutions on 4 repos): _is_relative_import misses the bare dot specifiers"  # 64ab
    status: todo_hard  # 64ab
    priority: 3  # 64ab

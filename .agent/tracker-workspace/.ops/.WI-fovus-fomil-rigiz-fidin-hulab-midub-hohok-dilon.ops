    kind: work_item  # 8498
    title: "JavaScript DDG spec globs only *.js, so .mjs/.cjs/.jsx reach no machinery (observed: apollo-server smoke-test.mjs)"  # 8498
    status: todo_soft  # 8498
    priority: 3  # 8498
    parent:  # 8498

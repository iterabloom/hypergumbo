    kind: work_item  # 829a
    title: "io-boundaries: attribute-style IO primitives not counted in primitive_counts (env_read misses os.environ, sys.argv, etc.)"  # 829a
    status: todo_hard  # 829a
    priority: 2  # 829a
    parent:  # 829a

    title: "sketch -t budget >=17000 produces exit 141 SIGPIPE with 0 bytes output (broken pipe to early-exiting child)"  # 04f9
    status: violated  # 04f9
    priority: 3  # 04f9
    parent:  # 04f9
    tags:  # 04f9
    - dogfooding  # 04f9

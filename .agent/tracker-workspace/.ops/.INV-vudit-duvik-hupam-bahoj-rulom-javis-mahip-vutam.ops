  data:  # 1bfb
    kind: invariant  # 1bfb
    title: "Deleting an item must clear dangling isbefore references (its own and inbound)"  # 1bfb
    status: violated  # 1bfb
    priority: 4  # 1bfb
    parent:  # 1bfb
    tags:  # 1bfb

    kind: work_item  # fbf5
    title: "js probe_file resolves a dotted relative specifier to the WRONG sibling: './X.test-wrapper' lands on X.tsx (with_suffix replaces the last suffix; Node appends): 30 nuclear edges"  # fbf5
    status: todo_hard  # fbf5
    priority: 3  # fbf5

  data:  # bfba
    kind: invariant  # bfba
    title: "Every catalog with status=complete MUST declare stdlib_provenance whose source_url hostname suffix-matches ALLOWED_PROVENANCE_HOSTNAME_SUFFIXES"  # bfba
    status: pending_validation  # bfba
    priority: 1  # bfba

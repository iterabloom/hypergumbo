#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Contributor workflow script for fork-based development.
#
# This script helps external contributors create PRs from their fork
# to the upstream repository. Unlike auto-pr, this does NOT auto-merge
# (contributors don't have write access to upstream).
#
# Usage:
#   ./scripts/contribute [--title "PR title"] [--body "PR description"]
#
# Prerequisites:
#   1. Fork the repo to your account
#   2. Clone YOUR fork (not upstream)
#   3. Add upstream remote: git remote add upstream <upstream-url>
#   4. Set FORGEJO_USER (fork owner) plus the credential the UPSTREAM forge
#      needs: HG_GITHUB_TOKEN for a github upstream, FORGEJO_TOKEN otherwise
#
# The script will:
#   1. Push your branch to your fork (origin)
#   2. Create a PR from your fork to upstream/dev
#   3. Print the PR URL for tracking
#
# You'll need to wait for maintainer review and merge.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/forgejo-api.sh
source "$SCRIPT_DIR/lib/forgejo-api.sh"

load_env

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ------------------------------------------------------------------
# Parse arguments
# ------------------------------------------------------------------
TITLE=""
BODY=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --title)
            TITLE="$2"
            shift 2
            ;;
        --body)
            BODY="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# ------------------------------------------------------------------
# Validate environment
# ------------------------------------------------------------------
# USER is the FORK owner and is needed by the fork-push credential helper on
# either backend, so it is guarded here. The TOKEN guard is NOT: contribute's
# credential belongs to the UPSTREAM forge, which is not known until
# detect_forge_backend "$UPSTREAM_URL" runs further down — guarding here would
# resolve against the wrong backend (C9).
USER="${FORGEJO_USER:-}"

if [[ -z "$USER" ]]; then
    echo -e "${RED}Error: FORGEJO_USER not set${NC}"
    echo "Set it in .env or export FORGEJO_USER=your-username"
    exit 1
fi

BRANCH="$(git branch --show-current)"
if [[ "$BRANCH" == "main" || "$BRANCH" == "dev" ]]; then
    echo -e "${RED}Error: You're on '$BRANCH'. Create a feature branch first:${NC}"
    echo "  git checkout -b yourname/feat/description"
    exit 1
fi

# ------------------------------------------------------------------
# Detect fork setup
# ------------------------------------------------------------------
ORIGIN_URL="$(git remote get-url origin)"
UPSTREAM_URL="$(git remote get-url upstream 2>/dev/null || echo "")"

if [[ -z "$UPSTREAM_URL" ]]; then
    echo -e "${RED}Error: No 'upstream' remote found${NC}"
    echo ""
    echo "Fork-based workflow requires:"
    echo "  1. Fork the repo on the upstream forge"
    echo "  2. Clone YOUR fork"
    echo "  3. Add the upstream remote, e.g.:"
    echo "       git remote add upstream https://github.com/iterabloom/hypergumbo.git"
    echo "       git remote add upstream https://codeberg.org/iterabloom/hypergumbo.git"
    echo "     (see CONTRIBUTING.md)"
    echo ""
    echo "Your current origin: $ORIGIN_URL"
    exit 1
fi

# Extract repo slugs
extract_slug() {
    echo "$1" | sed 's/\.git$//' | awk -F'[:/]' '{print $(NF-1)"/"$NF}'
}

FORK_SLUG=$(extract_slug "$ORIGIN_URL")
UPSTREAM_SLUG=$(extract_slug "$UPSTREAM_URL")
LOCAL_SHA="$(git rev-parse HEAD)"

# Detect the upstream forge (keyed on the UPSTREAM remote — the lib's default
# reads origin, which is the fork here). GitHub → gh pr create (auto-fork);
# Forgejo → curl/api_post. Dormant while codeberg is upstream (byte-identical
# api base + /pulls/ web path for a codeberg upstream).
detect_forge_backend "$UPSTREAM_URL"

# Backend-aware credential (C9), resolved now that the upstream forge is known.
resolve_forge_token
TOKEN="${FORGE_TOKEN:-}"
if [[ -z "$TOKEN" ]]; then
    echo -e "${RED}Error: no forge credential${NC}"
    echo "Set HG_GITHUB_TOKEN (github upstream) or FORGEJO_TOKEN in .env"
    exit 1
fi

FORK_OWNER="${FORK_SLUG%%/*}"
if [[ "${FORGE_BACKEND:-forgejo}" == "github" ]]; then
    UPSTREAM_API_BASE="https://api.github.com/repos/$UPSTREAM_SLUG"
    UPSTREAM_WEB="https://github.com/$UPSTREAM_SLUG"
    PR_PATH="pull"
else
    # Robust host extraction (the lib's detect_api_base sed only handles SSH
    # URLs): strip scheme, then userinfo, then the path/port tail.
    UPSTREAM_HOST=$(echo "$UPSTREAM_URL" | sed -E -e 's|^[a-z]+://||' -e 's|^[^@]+@||' -e 's|[:/].*$||')
    UPSTREAM_API_BASE="https://$UPSTREAM_HOST/api/v1/repos/$UPSTREAM_SLUG"
    UPSTREAM_WEB="https://$UPSTREAM_HOST/$UPSTREAM_SLUG"
    PR_PATH="pulls"
fi

echo "╔════════════════════════════════════════╗"
echo "║       Contributor PR Workflow          ║"
echo "╚════════════════════════════════════════╝"
echo ""
echo -e "📂 Fork:     ${BLUE}$FORK_SLUG${NC}"
echo -e "📂 Upstream: ${BLUE}$UPSTREAM_SLUG${NC}"
echo -e "🌿 Branch:   ${BLUE}$BRANCH${NC}"
echo -e "🔑 Commit:   ${BLUE}${LOCAL_SHA:0:7}${NC}"
echo ""

# ------------------------------------------------------------------
# Pre-flight checks
# ------------------------------------------------------------------
echo "━━━ Pre-flight Checks ━━━"

# Check for uncommitted changes
if [[ -n "$(git status --porcelain)" ]]; then
    echo -e "${RED}✗ Uncommitted changes detected${NC}"
    git status --short
    exit 1
fi
echo -e "${GREEN}✓${NC} Working directory clean"

# Check if branch is ahead of dev
AHEAD=$(git rev-list --count dev..HEAD 2>/dev/null || echo "0")
if [[ "$AHEAD" -eq 0 ]]; then
    echo -e "${RED}✗ No commits ahead of dev${NC}"
    echo "  Make some commits first!"
    exit 1
fi
echo -e "${GREEN}✓${NC} $AHEAD commit(s) ahead of dev"

# Check for DCO sign-off on all commits
UNSIGNED=$(git log dev..HEAD --pretty=format:'%H %s' | while read sha msg; do
    if ! git log -1 --format='%B' "$sha" | grep -q "^Signed-off-by:"; then
        echo "$sha"
    fi
done)
if [[ -n "$UNSIGNED" ]]; then
    echo -e "${YELLOW}!${NC} Some commits lack DCO sign-off"
    echo "  Consider: git rebase -i dev and amend commits with -s"
fi

echo ""

# ------------------------------------------------------------------
# Exclude workspace tracker data from upstream PR
# ------------------------------------------------------------------
WORKSPACE_FILES=$(git diff dev..HEAD --name-only -- '.agent/tracker-workspace/' 2>/dev/null || true)
PUSH_BRANCH="$BRANCH"
if [[ -n "$WORKSPACE_FILES" ]]; then
    echo "━━━ Workspace Exclusion ━━━"
    WORKSPACE_COUNT=$(echo "$WORKSPACE_FILES" | wc -l | tr -d ' ')
    echo -e "${YELLOW}!${NC} Stripping $WORKSPACE_COUNT workspace file(s) from PR push"
    echo "  (your local branch is unchanged — workspace stays in your fork)"

    # Create a temp branch, reset workspace files to upstream state, push that
    CLEAN_BRANCH="${BRANCH}__upstream-clean"
    git checkout -b "$CLEAN_BRANCH" 2>/dev/null
    # Restore workspace to upstream/dev state (or remove if new)
    git checkout upstream/dev -- .agent/tracker-workspace/ 2>/dev/null \
        || git rm -r --cached .agent/tracker-workspace/ 2>/dev/null || true
    git commit -m "chore: exclude workspace from upstream PR" --allow-empty --no-verify 2>/dev/null || true
    PUSH_BRANCH="$CLEAN_BRANCH"
    echo -e "${GREEN}✓${NC} Workspace files excluded"
    echo ""
fi

# ------------------------------------------------------------------
# Push to fork
# ------------------------------------------------------------------
echo "━━━ Pushing to Fork ━━━"

git -c credential.helper="!f() { echo username=$USER; echo password=$TOKEN; }; f" \
    push -u origin "$PUSH_BRANCH:$BRANCH" --force-with-lease

echo -e "${GREEN}✓${NC} Pushed to $FORK_SLUG:$BRANCH"

# Clean up temp branch if workspace exclusion was used
if [[ "$PUSH_BRANCH" != "$BRANCH" ]]; then
    git checkout "$BRANCH" 2>/dev/null
    git branch -D "$PUSH_BRANCH" 2>/dev/null || true
fi
echo ""

# ------------------------------------------------------------------
# Create PR to upstream
# ------------------------------------------------------------------
echo "━━━ Creating Pull Request ━━━"

# Default title from branch name or last commit
if [[ -z "$TITLE" ]]; then
    TITLE=$(git log -1 --pretty=%s)
fi

# Default body from commit messages
if [[ -z "$BODY" ]]; then
    BODY=$(git log dev..HEAD --pretty=format:'- %s' | head -10)
fi

# GitHub via gh: auto-forks + collapses the token/fork ceremony (the one place
# gh earns its keep — contributor-facing, human-run). Falls through to the
# curl/api_post path below when gh is unavailable.
if [[ "${FORGE_BACKEND:-forgejo}" == "github" ]] && command -v gh >/dev/null 2>&1; then
    # gh maps --head to the bare headRefName (no owner), so pass the bare
    # branch and disambiguate cross-fork PRs by the head repo owner in the JSON.
    EXISTING_PR=$(GH_TOKEN="$TOKEN" gh pr list --repo "$UPSTREAM_SLUG" \
        --state open --head "$BRANCH" \
        --json number,headRepositoryOwner \
        --jq "map(select(.headRepositoryOwner.login == \"$FORK_OWNER\")) | .[0].number // empty" 2>/dev/null || echo "")
    if [[ -n "$EXISTING_PR" ]]; then
        echo -e "${YELLOW}PR #$EXISTING_PR already exists for this branch${NC}"
        echo "🔗 $UPSTREAM_WEB/$PR_PATH/$EXISTING_PR"
        echo ""
        echo "To update the PR, just push more commits."
        exit 0
    fi
    if PR_URL=$(GH_TOKEN="$TOKEN" gh pr create --repo "$UPSTREAM_SLUG" \
        --base dev --head "$FORK_OWNER:$BRANCH" \
        --title "$TITLE" --body "$BODY" 2>&1); then
        PR_NUM="${PR_URL##*/}"
        echo -e "${GREEN}✓${NC} Created PR #$PR_NUM"
        echo ""
        echo "╔════════════════════════════════════════╗"
        echo -e "║  ${GREEN}PR Created Successfully!${NC}              ║"
        echo "╚════════════════════════════════════════╝"
        echo ""
        echo "🔗 $PR_URL"
        echo ""
        echo "Next steps:"
        echo "  1. Wait for CI to run"
        echo "  2. Address any review feedback"
        echo "  3. Maintainer will merge when ready"
        echo ""
        echo -e "${YELLOW}Note: You don't have write access, so the PR will NOT auto-merge.${NC}"
        exit 0
    else
        echo -e "${RED}✗ Failed to create PR${NC}"
        echo "$PR_URL"
        echo ""
        echo "You can create manually at:"
        echo "  $UPSTREAM_WEB/compare/dev...$FORK_OWNER:$BRANCH"
        exit 1
    fi
fi

# Forgejo (or github with gh unavailable): curl/api_post against the REST API.
# ${API_BASE:-} avoids a set -u crash — contribute never runs detect_api_base
# (it targets upstream, not origin), so the origin-derived API_BASE is unset;
# we point it at the upstream base for the probe, then restore.
_saved_api_base="${API_BASE:-}"
API_BASE="$UPSTREAM_API_BASE"

# Search for existing PR from this fork/branch
if api_get "$API_BASE/pulls?state=open"; then
    EXISTING_PR=$(echo "$API_RESPONSE" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    fork_slug = '$FORK_SLUG'
    branch = '$BRANCH'
    for pr in data:
        head_repo = pr.get('head', {}).get('repo', {}).get('full_name', '')
        head_branch = pr.get('head', {}).get('ref', '')
        if head_repo == fork_slug and head_branch == branch:
            print(pr['number'])
            break
except Exception:
    pass
" 2>/dev/null || echo "")
else
    EXISTING_PR=""
fi

API_BASE="$_saved_api_base"

if [[ -n "$EXISTING_PR" ]]; then
    echo -e "${YELLOW}PR #$EXISTING_PR already exists for this branch${NC}"
    echo "🔗 $UPSTREAM_WEB/$PR_PATH/$EXISTING_PR"
    echo ""
    echo "To update the PR, just push more commits."
    exit 0
fi

# Create new PR
PR_PAYLOAD=$(python3 -c "
import json, sys
payload = {
    'title': sys.stdin.readline().rstrip('\n'),
    'body': sys.stdin.read(),
    'head': '$FORK_OWNER:$BRANCH',
    'base': 'dev'
}
print(json.dumps(payload))
" <<EOF
$TITLE
$BODY
EOF
)

if api_post "$UPSTREAM_API_BASE/pulls" "$PR_PAYLOAD"; then
    PR_NUM=$(echo "$API_RESPONSE" | json_field "number")

    if [[ -n "$PR_NUM" && "$PR_NUM" != "None" && "$PR_NUM" != "" ]]; then
        echo -e "${GREEN}✓${NC} Created PR #$PR_NUM"
        echo ""
        echo "╔════════════════════════════════════════╗"
        echo -e "║  ${GREEN}PR Created Successfully!${NC}              ║"
        echo "╚════════════════════════════════════════╝"
        echo ""
        echo "🔗 $UPSTREAM_WEB/$PR_PATH/$PR_NUM"
        echo ""
        echo "Next steps:"
        echo "  1. Wait for CI to run"
        echo "  2. Address any review feedback"
        echo "  3. Maintainer will merge when ready"
        echo ""
        echo -e "${YELLOW}Note: You don't have write access, so the PR will NOT auto-merge.${NC}"
    else
        echo -e "${RED}✗ Failed to create PR${NC}"
        echo "Response: $API_RESPONSE"
        echo ""
        echo "You can create manually at:"
        echo "  $UPSTREAM_WEB/compare/dev...$FORK_OWNER:$BRANCH"
        exit 1
    fi
else
    echo -e "${RED}✗ Failed to create PR (HTTP $API_HTTP_CODE)${NC}"
    echo "Response: $API_RESPONSE"
    echo ""
    echo "You can create manually at:"
    echo "  $UPSTREAM_WEB/compare/dev...$FORK_OWNER:$BRANCH"
    exit 1
fi

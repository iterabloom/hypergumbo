#!/usr/bin/env python3
"""Generate ARCHITECTURE.md using hypergumbo to analyze itself.

This script uses hypergumbo's own analysis capabilities to generate architecture
documentation that stays in sync with the code.

Usage:
    ./scripts/generate-architecture              # Generate docs/ARCHITECTURE.md
    ./scripts/generate-architecture --check      # Verify docs are up-to-date (for CI)

The generated documentation includes:
- Counts read from the source tree: modules, registered analyzers, linkers
  by subcategory, pattern files. ``--check`` recomputes these and requires
  them verbatim, since they are cheap and deterministic.
- Counts from a self-analysis (``hypergumbo survey packages/
  --first-party-only``): nodes, edges, most-connected symbols. These vary
  with the Python version and grammar builds, so ``--check`` covers them
  only by the commit-distance window.
- Curated prose, written in this script. It is not checked against the
  code: a change to the pipeline, the tiers or the registration API must
  edit it here.
- Module reference with docstrings
"""

from __future__ import annotations

import argparse
import ast
import itertools
import json
import math
import platform
import re
import subprocess
import sys
import textwrap
import tokenize
from collections import defaultdict
from pathlib import Path

# Try to import a TOML parser for reading pyproject.toml
try:
    import tomllib  # Python 3.11+
except ImportError:
    try:
        import tomli as tomllib  # Fallback for Python 3.9-3.10
    except ImportError:
        tomllib = None  # type: ignore[assignment]

REPO_ROOT = Path(__file__).parent.parent


def get_git_commit_sha() -> str | None:
    """Get the current git commit SHA."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            cwd=REPO_ROOT,
        )
        if result.returncode == 0:
            return result.stdout.strip()[:12]  # Short SHA
    except Exception:
        pass
    return None


# How many recent commits reachable from HEAD are accepted by ``--check``.
# The doc's recorded SHA gets "stale" the moment the doc-regeneration
# commit lands (HEAD moves past the SHA the doc was generated against),
# so strict equality with HEAD is unworkable. The window absorbs the
# doc-update commit plus follow-on changes that don't materially affect
# the self-analysis (typos, comment fixes, README edits, small refactors)
# without letting the doc rot indefinitely.
#
# Raised 15 → 30 (2026-08-03) after the window closed mid-PR on a change that
# touched no architecture at all: a taint-analysis branch was in flight while
# two feature merges and three tracker auto-syncs landed, and the doc hit 17
# commits of distance. Pre-flighting cannot prevent that — the counter moves
# after your last commit, not before your first (L35) — so the failure lands
# on whoever happens to be holding an open PR.
#
# The counter is also consumed by commits that CANNOT invalidate the doc.
# Tracker auto-sync commits touch only ``.agent/tracker*/.ops`` and never any
# analyzed source, yet each one advances the distance. Excluding them would
# fix the cause rather than the symptom; filed separately rather than widened
# into this change.
#
# At ``dev``'s commit cadence, 30 commits ≈ ~6 days of headroom.
RECENT_COMMIT_WINDOW = 30


def get_recent_commit_shas(n: int = RECENT_COMMIT_WINDOW) -> list[str]:
    """Return up to ``n`` most recent commit SHAs reachable from HEAD, short-form."""
    try:
        result = subprocess.run(
            ["git", "log", f"-n{n}", "--format=%H"],
            capture_output=True,
            text=True,
            cwd=REPO_ROOT,
        )
        if result.returncode == 0:
            return [line[:12] for line in result.stdout.splitlines() if line]
    except Exception:
        pass
    return []


def get_commit_count() -> int | None:
    """Return the number of commits reachable from HEAD (rebase-stable).

    Unlike a commit SHA, this survives GitHub's rebase-merge — which REWRITES the
    merged commits' SHAs, orphaning any recorded branch SHA — because the count of
    ancestors is preserved. ``--check`` uses it to measure doc staleness as
    ``current_count - recorded_count`` instead of SHA membership.
    """
    try:
        result = subprocess.run(
            ["git", "rev-list", "--count", "HEAD"],
            capture_output=True,
            text=True,
            cwd=REPO_ROOT,
        )
        if result.returncode == 0:
            return int(result.stdout.strip())
    except Exception:
        pass
    return None


#: The auto-sync's ``tracker: N files (M ops) -- ...`` and the ``tracker:``
#: conventional prefix AGENTS.md mandates for tracker-only changes, with an
#: optional scope (``tracker(workspace): ...``). ``fix(tracker): ...`` is code.
_TRACKER_SUBJECT = re.compile(r"^tracker(\([^)]*\))?:")


def count_tracker_only_commits(n: int) -> int:
    """How many of the ``n`` most recent commits are tracker-only commits.

    Those commits move no code, so they must not age docs/ARCHITECTURE.md:
    on 2026-10-16 an afternoon of tracker filing produced 34 auto-sync commits
    on ``dev`` with zero code commits between them, and a doc regenerated that
    morning failed the 30-commit window on the very next PR. Git failures count
    as zero so the check degrades to the plain distance rather than erroring.
    """
    if n <= 0:
        return 0
    try:
        result = subprocess.run(
            ["git", "log", f"-n{n}", "--format=%s"],
            capture_output=True,
            text=True,
            cwd=REPO_ROOT,
        )
    except Exception:
        return 0
    if result.returncode != 0:
        return 0
    return sum(1 for line in result.stdout.splitlines() if _TRACKER_SUBJECT.match(line))


def staleness_distance(recorded_count: int) -> tuple[int, int, int]:
    """``(raw, tracker_only, effective)`` commits since the doc was generated.

    ``raw`` is ``current_count - recorded_count`` (rebase-stable, see
    ``get_commit_count``); ``effective`` subtracts the tracker-only commits
    among those ``raw`` most recent ones and is what the window applies to.
    """
    current_count = get_commit_count()
    if current_count is None:
        raise RuntimeError("could not count commits (git rev-list failed)")
    raw = current_count - recorded_count
    tracker_only = count_tracker_only_commits(raw)
    return raw, tracker_only, raw - tracker_only


def get_hypergumbo_version() -> str:
    """Get the hypergumbo package version from pyproject.toml.

    Reads directly from pyproject.toml rather than importing the package,
    ensuring we get the repo version rather than a potentially different
    installed version.
    """
    # Read from meta-package pyproject.toml (source of truth for version)
    pyproject_path = REPO_ROOT / "packages" / "hypergumbo" / "pyproject.toml"
    if not pyproject_path.exists():
        return "unknown"

    try:
        content = pyproject_path.read_text(encoding="utf-8")

        # Try TOML parser first (more reliable)
        if tomllib is not None:
            data = tomllib.loads(content)
            return data.get("project", {}).get("version", "unknown")

        # Fallback: simple regex for version = "x.y.z" line
        # This is reliable enough for the simple pyproject.toml format
        match = re.search(r'^version\s*=\s*["\']([^"\']+)["\']', content, re.MULTILINE)
        if match:
            return match.group(1)
    except Exception:
        pass
    return "unknown"


def run_command(args: list[str], description: str) -> subprocess.CompletedProcess:
    """Run a command with proper error handling.

    Args:
        args: Command and arguments to run
        description: Human-readable description for error messages

    Returns:
        CompletedProcess on success

    Raises:
        SystemExit: If command fails
    """
    result = subprocess.run(
        args,
        capture_output=True,
        text=True,
        cwd=REPO_ROOT,
    )

    if result.returncode != 0:
        print(f"ERROR: {description} failed with exit code {result.returncode}",
              file=sys.stderr)
        print(f"Command: {' '.join(args)}", file=sys.stderr)
        if result.stderr:
            print(f"stderr: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    return result


def run_hypergumbo_analysis() -> dict:
    """Run hypergumbo full analysis on itself."""
    output_file = REPO_ROOT / ".hypergumbo" / "self-analysis.json"
    output_file.parent.mkdir(parents=True, exist_ok=True)

    # Delete stale analysis file to avoid reusing old data on failure
    if output_file.exists():
        output_file.unlink()

    # Analyze all package src directories
    packages_dir = REPO_ROOT / "packages"
    run_command(
        [sys.executable, "-m", "hypergumbo_core", "run", str(packages_dir),
         "--out", str(output_file), "--first-party-only"],
        "hypergumbo run",
    )

    if not output_file.exists():
        print(f"ERROR: hypergumbo run succeeded but output file not created: {output_file}",
              file=sys.stderr)
        sys.exit(1)

    return json.loads(output_file.read_text(encoding="utf-8"))


def extract_module_docstring(file_path: Path) -> str | None:
    """Extract the module docstring from a Python file.

    Uses tokenize.open() to respect PEP 263 encoding declarations,
    ensuring correct handling of files with non-UTF8 encodings.
    """
    try:
        with tokenize.open(file_path) as f:
            content = f.read()
        tree = ast.parse(content)
        return ast.get_docstring(tree)
    except Exception:
        return None


def _registers_a_linker(py_file: Path) -> bool:
    """True when a ``linkers/`` module carries a ``@register_linker``.

    The module inventory skips underscore-prefixed files because private
    helpers (``_concept_utils``, ``_text_filters``, ``_view_template_core``)
    are not linkers and counting them would inflate the catalogue. But the
    underscore is a naming convention, not a registration fact, and one
    module is both: ``linkers/_third_party_bases.py`` registers
    ``django-third-party-dispatch-linker``.

    Deciding on the decorator instead of the filename closes the class.
    Before this, an underscore-named linker was skipped outright, so the
    ADR-3bbb Uncategorized counter could flag it neither way — the
    enforcement promise had a hole exactly the shape of this file, and the
    generated count read 60 against a registry of 61.
    """
    if py_file.parent.name != "linkers":
        return False
    return "@register_linker" in py_file.read_text(encoding="utf-8")


# Core modules listed under "CLI & I/O" rather than "Core".
CLI_MODULE_NAMES = frozenset({"cli", "schema", "sketch", "__main__"})


def _package_roots() -> list[tuple[str, Path]]:
    """Every package ``src`` root the inventory scans, as (import name, path).

    A missing root raises instead of being skipped: a renamed or removed
    package would otherwise drop out of every count in the doc silently.
    """
    roots = [
        (name, REPO_ROOT / "packages" / name.replace("_", "-") / "src" / name)
        for name in (
            "hypergumbo_core",
            "hypergumbo_lang_mainstream",
            "hypergumbo_lang_common",
            "hypergumbo_lang_extended1",
            "hypergumbo_lang_rust_analyzer",
            "hypergumbo_lang_scip_python",
            "hypergumbo_tracker",
        )
    ]
    for _name, root in roots:
        if not root.is_dir():
            raise FileNotFoundError(f"package source root missing: {root}")
    return roots


def categorize_modules() -> dict[str, list[tuple[str, str | None]]]:
    """Categorize modules into logical groups with docstrings."""
    categories: dict[str, list[tuple[str, str | None]]] = {
        "Core": [],
        "Analyzers": [],
        "Linkers": [],
        "CLI & I/O": [],
        "Tracker": [],
    }

    for package_name, src_root in _package_roots():
        for py_file in sorted(src_root.rglob("*.py")):
            # A private directory (``scip/_generated/``) holds no public
            # module, whatever its files are named.
            if any(
                part.startswith("_")
                for part in py_file.relative_to(src_root).parts[:-1]
            ):
                continue
            # Skip private modules except __init__.py, __main__.py, and any
            # module that actually registers a linker (see
            # _registers_a_linker for why the underscore alone cannot decide
            # this).
            if (
                py_file.name.startswith("_")
                and py_file.name not in {"__init__.py", "__main__.py"}
                and not _registers_a_linker(py_file)
            ):
                continue

            rel_path = py_file.relative_to(src_root)
            parts = list(rel_path.parts)
            if parts[-1] == "__init__.py":
                continue  # Skip __init__ files in listing

            # Use with_suffix to properly remove only the .py extension
            # (avoids bug where analyze/py.py became "analyze" via .replace(".py", ""))
            module_path = rel_path.with_suffix("")
            module_name = f"{package_name}.{'.'.join(module_path.parts)}"
            docstring = extract_module_docstring(py_file)

            # Classify by directory structure and package origin.
            # Language analyzer modules live as top-level files in hypergumbo_lang_*
            # packages, while core analyzer infrastructure lives under analyze/.
            if package_name == "hypergumbo_tracker":
                categories["Tracker"].append((module_name, docstring))
            elif package_name.startswith("hypergumbo_lang_"):
                categories["Analyzers"].append((module_name, docstring))
            elif parts and parts[0] == "analyze":
                categories["Analyzers"].append((module_name, docstring))
            elif parts and parts[0] == "linkers":
                # Exclude registry.py (the linker registry scaffolding, not a
                # linker module itself). Matching its subcategory convention
                # would be meaningless since it doesn't belong to any of the
                # ADR-3bbb subcategories; counting it as a linker would
                # inflate the total and flag it Uncategorized forever.
                if module_path.name == "registry":
                    categories["Core"].append((module_name, docstring))
                else:
                    categories["Linkers"].append((module_name, docstring))
            elif module_path.name in CLI_MODULE_NAMES:
                categories["CLI & I/O"].append((module_name, docstring))
            else:
                categories["Core"].append((module_name, docstring))

    return categories


def _is_test_node(node: dict) -> bool:
    return bool((node.get("supply_chain") or {}).get("is_test_file"))


def get_top_symbols(analysis: dict, limit: int = 15) -> list[dict]:
    """Rank the project's own non-test symbols by edge centrality.

    ``score = in_degree * (1 + ln(1 + out_degree))``, counted only over
    edges whose source is not test code. Placeholder nodes for library
    targets (``external_symbol``: ``len``, ``Path``) and test symbols are
    not ranked. This is the doc's own measure, not the ranking
    ``hypergumbo symbols`` uses (``ranking.py`` adds tier, leaf and
    saturation weights).
    """
    nodes = {n["id"]: n for n in analysis.get("nodes", [])}
    test_ids = {i for i, n in nodes.items() if _is_test_node(n)}
    in_degree: dict[str, int] = defaultdict(int)
    out_degree: dict[str, int] = defaultdict(int)
    for edge in analysis.get("edges", []):
        src, dst = edge.get("src", ""), edge.get("dst", "")
        if not src or src in test_ids:
            continue
        out_degree[src] += 1
        if dst:
            in_degree[dst] += 1

    scored: list[tuple[float, str]] = []
    for sym_id, ind in in_degree.items():
        node = nodes.get(sym_id)
        if node is None or node.get("kind") == "external_symbol" or sym_id in test_ids:
            continue
        scored.append((ind * (1 + math.log(1 + out_degree.get(sym_id, 0))), sym_id))
    scored.sort(key=lambda x: (-x[0], x[1]))

    return [
        {
            "name": nodes[sym_id].get("name", ""),
            "kind": nodes[sym_id].get("kind", ""),
            "path": nodes[sym_id].get("path", ""),
            "score": score,
            "in_degree": in_degree[sym_id],
        }
        for score, sym_id in scored[:limit]
    ]


def get_edge_type_distribution(analysis: dict) -> dict[str, int]:
    """Get the distribution of edge types.

    Returns a dict mapping edge type to count, sorted by count descending.
    """
    type_counts: dict[str, int] = defaultdict(int)
    for edge in analysis.get("edges", []):
        edge_type = edge.get("type", "unknown")
        type_counts[edge_type] += 1

    # Sort by count descending, then by name for determinism
    return dict(sorted(type_counts.items(), key=lambda x: (-x[1], x[0])))


def _convention_pattern_ids() -> tuple[str, ...]:
    """The always-loaded pattern ids, read from ``framework_patterns.py``.

    ``framework_patterns._CONVENTION_PATTERN_IDS`` is the list the loader
    applies to every repo. It is read with ``ast`` so the script needs no
    import of the package it documents.
    """
    path = (REPO_ROOT / "packages" / "hypergumbo-core" / "src"
            / "hypergumbo_core" / "framework_patterns.py")
    tree = ast.parse(path.read_text(encoding="utf-8"))
    for node in ast.walk(tree):
        if (isinstance(node, ast.AnnAssign)
                and isinstance(node.target, ast.Name)
                and node.target.id == "_CONVENTION_PATTERN_IDS"):
            return tuple(ast.literal_eval(node.value))
    raise LookupError(f"_CONVENTION_PATTERN_IDS not found in {path}")


def count_framework_patterns() -> tuple[int, int, int]:
    """Count always-loaded vs framework-gated YAML pattern files.

    A file is always loaded when its ``id:`` is in the loader's
    ``_CONVENTION_PATTERN_IDS``; every other file loads only when its
    framework is detected. (``language: multi`` is not that test: three
    always-loaded files name one language.)

    Returns (total, convention_count, framework_count).
    """
    frameworks_dir = (
        REPO_ROOT / "packages" / "hypergumbo-core" / "src"
        / "hypergumbo_core" / "frameworks"
    )
    yaml_files = sorted(frameworks_dir.glob("*.yaml"))
    if not yaml_files:
        raise FileNotFoundError(f"no pattern files in {frameworks_dir}")
    convention_ids = set(_convention_pattern_ids())
    convention = 0
    for yaml_file in yaml_files:
        match = re.search(r"^id:\s*(\S+)", yaml_file.read_text(encoding="utf-8"),
                          re.MULTILINE)
        if match and match.group(1) in convention_ids:
            convention += 1
    return (len(yaml_files), convention, len(yaml_files) - convention)


def _docstring_attributes(docstring: str) -> dict[str, str]:
    """Map attribute name -> description from a numpydoc ``Attributes:`` block.

    An attribute line is the block's shallowest indent with ``name: text``
    where ``name`` is an identifier; anything deeper, or not shaped that
    way, continues the previous description. Splitting every ``word:``
    instead turned wrapped prose ("producer: fingerprint.py") into fields.
    When a name is described twice, the longer description is kept.
    """
    attrs: dict[str, str] = {}
    lines = docstring.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.strip().startswith("Attributes"))
    except StopIteration:
        return attrs
    body: list[str] = []
    for line in lines[start + 1:]:
        if line.strip().startswith("---"):
            continue
        if line.strip() and not line.startswith(" "):
            break  # next section header
        body.append(line)
    indents = [len(ln) - len(ln.lstrip()) for ln in body if ln.strip()]
    if not indents:
        return attrs
    base = min(indents)
    current: str | None = None
    for line in body:
        stripped = line.strip()
        if not stripped:
            continue
        indent = len(line) - len(line.lstrip())
        match = re.match(r"([A-Za-z_][A-Za-z0-9_]*)\s*:\s*(.*)", stripped)
        if indent == base and match:
            current = match.group(1)
            desc = match.group(2)
            if len(desc) >= len(attrs.get(current, "")):
                attrs[current] = desc
        elif current is not None:
            attrs[current] = (attrs[current] + " " + stripped).strip()
    return attrs


def extract_ir_abstractions() -> str:
    """Extract Key Abstractions markdown from the IR dataclasses in ir.py.

    Lists every public field each of Span, Symbol, Edge and AnalysisRun
    declares, in declaration order, with its description from the class
    docstring's Attributes block where one exists. Driving the list from
    the declarations means a field the docstring forgets still appears and
    a docstring fragment never becomes a field.
    """
    ir_path = (
        REPO_ROOT / "packages" / "hypergumbo-core" / "src"
        / "hypergumbo_core" / "ir.py"
    )
    tree = ast.parse(ir_path.read_text(encoding="utf-8"))

    sections: list[str] = []
    for node in tree.body:
        if not isinstance(node, ast.ClassDef) or node.name not in {
            "Span", "Symbol", "Edge", "AnalysisRun",
        }:
            continue
        docstring = ast.get_docstring(node) or ""
        first_para = " ".join(
            ln.strip() for ln in itertools.takewhile(
                lambda ln: ln.strip() and not ln.strip().startswith("Attributes"),
                docstring.splitlines(),
            )
        )
        described = _docstring_attributes(docstring)
        fields = [
            stmt.target.id for stmt in node.body
            if isinstance(stmt, ast.AnnAssign)
            and isinstance(stmt.target, ast.Name)
            and not stmt.target.id.startswith("_")
        ]
        rows = [
            f"- `{name}`: {described[name]}" if described.get(name) else f"- `{name}`"
            for name in fields
        ]
        sections.append(f"### {node.name} (`ir.py`)\n{first_para}\n" + "\n".join(rows) + "\n")

    if not sections:
        raise LookupError(f"no IR dataclasses found in {ir_path}")
    return "\n".join(sections)


def extract_linker_howto() -> str:
    """Build the linker how-to around the example in registry.py's docstring.

    The code is the indented block under "In a linker module:" in the
    module docstring's Usage section, dedented with its relative
    indentation kept (stripping every line made the function body
    unreadable). No block raises: the section would otherwise ship a
    how-to without its example.
    """
    registry_path = (
        REPO_ROOT / "packages" / "hypergumbo-core" / "src"
        / "hypergumbo_core" / "linkers" / "registry.py"
    )
    docstring = ast.get_docstring(ast.parse(registry_path.read_text(encoding="utf-8"))) or ""
    lines = docstring.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.strip() == "In a linker module:")
    except StopIteration:
        raise LookupError(f'no "In a linker module:" example in {registry_path}') from None
    block: list[str] = []
    for line in lines[start + 1:]:
        if line.strip() and not line.startswith(" "):
            break
        block.append(line)
    code_block = textwrap.dedent("\n".join(block)).strip("\n")

    return (
        "1. Create `packages/hypergumbo-core/src/hypergumbo_core/linkers/<name>.py`\n"
        "2. Register it with the decorator:\n\n"
        "```python\n"
        f"{code_block}\n"
        "```\n\n"
        "3. Import the module in `cli.py`'s block of side-effect imports "
        "(`import hypergumbo_core.linkers.<name> as _<name>_linker  # noqa: F401`); "
        "the decorator runs only when something imports the module\n"
        "4. Add tests in `packages/hypergumbo-core/tests/test_<name>_linker.py`"
    )


def _render_yaml_catalogs_section() -> list[str]:
    """Render the YAML Catalogs section, sourced from yaml_catalogs registry.

    The registry lives at ``hypergumbo_core.yaml_catalogs`` (canonical source
    of truth). The companion ``scripts/yaml-catalog-index`` script offers the
    same view from the command line plus a ``--check`` drift mode.
    """
    sys.path.insert(
        0, str(REPO_ROOT / "packages" / "hypergumbo-core" / "src")
    )
    from hypergumbo_core.yaml_catalogs import enumerate_catalogs

    rows = enumerate_catalogs()
    total = sum(count for _, count in rows)
    lines = [
        "## YAML Catalogs (auto)",
        "",
        f"The `hypergumbo-core` package ships {total} YAML catalog files "
        f"across {len(rows)} directories. Each directory holds a category "
        "of analysis data consumed by a specific loader; the registry at "
        "`hypergumbo_core.yaml_catalogs` is the canonical index. Run "
        "`scripts/yaml-catalog-index` for the same view at the CLI, or "
        "`scripts/yaml-catalog-index --check` to verify the registry "
        "matches the filesystem.",
        "",
        "| Directory | Files | User channel | ADR | Loader | Purpose |",
        "|---|---:|---|---|---|---|",
    ]
    for spec, count in rows:
        if spec.user_channel is None:
            channel = "internal"
        else:
            channel = f"`{spec.user_channel}`"
            if spec.channel_scope:
                channel += f" (`{spec.channel_scope}` only)"
            if spec.channel_gated:
                channel += " (gated)"
        lines.append(
            f"| `{spec.directory}/` | {count} | {channel} | "
            f"{spec.adr or '—'} | `{spec.loader}` | {spec.purpose} |"
        )
    lines.append("")
    lines.append(
        "**User channel** (ADR-0047 ruling 7) names where a user's own rows "
        "for that family live, under `$XDG_CONFIG_HOME/hypergumbo/` — or "
        "`internal` when the family describes the *language's* world rather "
        "than the *user's* and takes no user input. The fields are required "
        "on `CatalogSpec`, so a new family cannot land without answering."
    )
    lines.append("")
    lines.append(
        "Adding a new catalog category: create the directory, write the "
        "loader (or extend an existing one), and register a `CatalogSpec` "
        "in `hypergumbo_core.yaml_catalogs.YAML_CATALOGS`. The drift check "
        "fails until the registry entry lands."
    )
    lines.append("")
    return lines


def count_registered_analyzers() -> dict[str, int]:
    """Count modules that register an analyzer, per language package.

    A language package also holds helpers that are not analyzers
    (``*_def_use``, ``*_deps``, ``header_owner``, ``rust_scip``), so the
    package's module count overstates its analyzers. The decorator is the
    registration fact; count it.

    Returns a dict keyed by package short name, e.g. ``{"mainstream": 38}``.
    """
    counts: dict[str, int] = {}
    for package_name, src_root in _package_roots():
        if not package_name.startswith("hypergumbo_lang_"):
            continue
        short = package_name.removeprefix("hypergumbo_lang_")
        counts[short] = sum(
            1 for py_file in src_root.rglob("*.py")
            if re.search(r"^@register_analyzer\b",
                         py_file.read_text(encoding="utf-8"), re.MULTILINE)
        )
    return counts


# Subcategory vocabulary from ADR-3aaa §2.4 as restored by ADR-3bbb
# (Linker Subcategory Restoration). Each linker module's docstring must
# open with one of these four labels. An "Uncategorized" bucket catches
# files that don't follow the convention so the generator surfaces the
# omission rather than silently miscounting.
# RCT-pinned surface — see tests/test_rct_public_api_pinned.py before changing this tuple.
_LINKER_SUBCATEGORIES = ("Protocol", "Bridge", "Framework", "Infrastructure")


def count_linker_subcategories(
    categories: dict[str, list[tuple[str, str | None]]],
) -> dict[str, int]:
    """Count linker modules by ADR-3bbb subcategory.

    Reads the first line of each linker module's docstring and matches it
    against the four ADR-3bbb subcategory labels. The convention (from
    ADR-3bbb §2 decision point #2) is that every linker module's
    docstring opens with ``"<Subcategory> linker: <purpose>."``.

    Returns a dict keyed by subcategory name ("Protocol", "Bridge",
    "Framework", "Infrastructure") plus an "Uncategorized" bucket for
    modules that don't declare a subcategory in the expected form. The
    Uncategorized count SHOULD be zero after ADR-3bbb is fully rolled
    out; a non-zero count is a documentation-drift signal that surfaces
    automatically in the generated architecture doc.
    """
    counts: dict[str, int] = {name: 0 for name in _LINKER_SUBCATEGORIES}
    counts["Uncategorized"] = 0
    for _module_name, docstring in categories.get("Linkers", []):
        first_line = (docstring or "").strip().split("\n", 1)[0].strip()
        matched = False
        for subcat in _LINKER_SUBCATEGORIES:
            # Match ``"<Subcat> linker:"`` (case-sensitive, with the colon)
            if first_line.startswith(f"{subcat} linker:"):
                counts[subcat] += 1
                matched = True
                break
        if not matched:
            counts["Uncategorized"] += 1
    return counts


SCRIPT_CATEGORIES: dict[str, list[str]] = {
    "CI & Release": [
        "auto-pr", "merge-pr", "prepare-release", "release-check",
        "ci-debug", "tag-release", "release",
    ],
    "Testing & Quality": [
        "smart-test", "check-package-coverage", "integration-test",
        "license-headers", "validate-agents.sh",
    ],
    "Development": [
        "dev-install", "build-source-grammars", "bump-version",
        "install-hooks", "tracker", "tracker-textconv", "loop-toggle",
        "install-embeddings", "uninstall-embeddings", "stop-hook-preview",
    ],
    "Analysis & Bakeoff": [
        "bakeoff-broad", "bakeoff-deep", "bakeoff-broad-reflect",
        "bakeoff-deep-reflect", "generate-architecture",
        "generate-schema", "analyze-artifacts", "test-leaderboard",
        "changelog-date-bucket", "compute_probe_embeddings.py",
        "hypergumbo_diag.py",
    ],
    "Contribution": ["contribute", "list-my-prs"],
}


def _extract_script_description(path: Path) -> str:
    """Extract a one-line description from a script file.

    For Python scripts: uses ast.parse to get the module docstring's first line.
    For Bash scripts: takes the first comment line after shebang and SPDX header.
    Returns "(no description)" if extraction fails.
    """
    try:
        content = path.read_text(encoding="utf-8")
    except Exception:
        return "(no description)"

    lines = content.splitlines()
    if not lines:
        return "(no description)"

    # Python script (by shebang or by extension): module docstring via ast
    if path.suffix == ".py" or (lines[0].startswith("#!") and "python" in lines[0]):
        try:
            tree = ast.parse(content)
            docstring = ast.get_docstring(tree)
            if docstring:
                first_line = next(
                    (ln.strip() for ln in docstring.splitlines() if ln.strip()),
                    "",
                )
                return first_line or "(no description)"
        except Exception:
            pass

    # Bash script (or Python fallback): scan comment lines
    # Skip shebang, SPDX, set -euo pipefail, blank lines, dash-only lines
    skip_prefixes = ("#!/", "# SPDX", "set -")
    for line in lines:
        stripped = line.strip()
        if not stripped:
            continue
        if any(stripped.startswith(p) for p in skip_prefixes):
            continue
        if stripped.startswith("#"):
            desc = stripped.lstrip("# ").strip()
            # Skip dash-only separator lines (e.g. "# --------")
            if not desc or set(desc) <= {"-", "="}:
                continue
            # Remove "scriptname: " prefix if present
            name = path.name
            if desc.lower().startswith(name.lower() + ":"):
                desc = desc[len(name) + 1:].strip()
            elif ":" in desc:
                prefix = desc.split(":")[0]
                # Heuristic: short alphanumeric-with-dashes prefix = script name
                if (prefix.replace("-", "").replace("_", "").isalnum()
                        and len(prefix) < 30):
                    desc = desc[len(prefix) + 1:].strip()
            return desc
        # Non-comment, non-blank line — stop looking
        break

    return "(no description)"


def categorize_scripts() -> dict[str, list[tuple[str, str]]]:
    """Scan scripts/ directory and return categorized (name, description) pairs.

    Groups scripts into categories defined by SCRIPT_CATEGORIES.
    Scripts not in any category go into "Other".
    Skips __pycache__ and lib/ subdirectories.
    """
    scripts_dir = REPO_ROOT / "scripts"
    if not scripts_dir.exists():
        return {}

    # Build reverse mapping: script name -> category
    name_to_category: dict[str, str] = {}
    for category, names in SCRIPT_CATEGORIES.items():
        for name in names:
            name_to_category[name] = category

    result: dict[str, list[tuple[str, str]]] = {}
    for category in SCRIPT_CATEGORIES:
        result[category] = []

    for entry in sorted(scripts_dir.iterdir()):
        if not entry.is_file():
            continue
        if entry.name.startswith("__") or entry.name == "lib":
            continue
        category = name_to_category.get(entry.name, "Other")
        desc = _extract_script_description(entry)
        if category not in result:
            result[category] = []
        result[category].append((entry.name, desc))

    # Remove empty categories
    return {k: v for k, v in result.items() if v}


def cheap_count_lines() -> list[str]:
    """The doc lines whose numbers come from the source tree alone.

    Module, analyzer, linker and pattern counts need no self-analysis run,
    so ``--check`` recomputes them and requires each line verbatim; the
    analysis totals (symbols, edges, top symbols) vary by environment and
    are covered by the commit-distance window instead.
    """
    categories = categorize_modules()
    subcats = count_linker_subcategories(categories)
    analyzers = count_registered_analyzers()
    pattern_total, conv_count, fw_count = count_framework_patterns()
    lang_modules = sum(
        1 for name, _ in categories["Analyzers"] if name.startswith("hypergumbo_lang_")
    )
    uncategorized = (
        f", Uncategorized {subcats['Uncategorized']} "
        "(missing subcategory declaration in module docstring)"
        if subcats["Uncategorized"] else ""
    )
    return [
        (
            f"- **{sum(len(v) for v in categories.values())}** Python modules: "
            f"{lang_modules} in the language packages, of which "
            f"{sum(analyzers.values())} register an analyzer; "
            f"{len(categories['Linkers'])} linkers "
            f"(Protocol {subcats['Protocol']}, Bridge {subcats['Bridge']}, "
            f"Framework {subcats['Framework']}, "
            f"Infrastructure {subcats['Infrastructure']}{uncategorized}); "
            f"{len(categories['Core'])} other core modules "
            f"({len(categories['Analyzers']) - lang_modules} of them analyzer "
            f"infrastructure under `analyze/`), "
            f"{len(categories['CLI & I/O'])} CLI, {len(categories['Tracker'])} tracker"
        ),
        (
            f" ├── hypergumbo-lang-mainstream    {analyzers['mainstream']} analyzers   "
            "-> core"
        ),
        f" ├── hypergumbo-lang-common        {analyzers['common']} analyzers   -> core",
        f" └── hypergumbo-lang-extended1     {analyzers['extended1']} analyzers   -> core",
        (
            f"- **`frameworks/*.yaml`**: {pattern_total} pattern files "
            f"({conv_count} always loaded, {fw_count} loaded when their framework is detected)"
        ),
    ]


def stale_count_lines(doc: str) -> list[str]:
    """The cheap-count lines the doc does not carry verbatim."""
    present = set(doc.splitlines())
    return [line for line in cheap_count_lines() if line not in present]


def generate_architecture_md() -> str:
    """Generate the ARCHITECTURE.md content.

    Produces a document organized around architectural understanding:
    1. Package structure and dependency hierarchy
    2. Analysis pipeline (data flow)
    3. Key concepts (output modes, supply chain, symbol resolution)
    4. Extension guides (new analyzers, linkers, patterns)
    5. Scripts & tooling (auto-generated from script headers)
    6. Module reference (auto-generated from docstrings)
    """
    print("Running hypergumbo analysis on itself...", file=sys.stderr)
    analysis = run_hypergumbo_analysis()

    categories = categorize_modules()
    top_symbols = get_top_symbols(analysis)

    if not top_symbols:
        raise ValueError("self-analysis ranked no symbols")

    # Count stats
    linker_count = len(categories.get("Linkers", []))
    lang_counts = count_registered_analyzers()
    linker_subcats = count_linker_subcategories(categories)
    pattern_total, conv_count, fw_count = count_framework_patterns()
    count_lines = cheap_count_lines()
    nodes = analysis.get("nodes", [])
    node_count = len(nodes)
    own_nodes = [
        n for n in nodes
        if not _is_test_node(n) and n.get("kind") != "external_symbol"
    ]
    own_callables = sum(
        1 for n in own_nodes if n.get("kind") in {"function", "method", "class"}
    )
    edge_count = len(analysis.get("edges", []))
    edge_types = get_edge_type_distribution(analysis)

    # Get metadata for drift detection
    commit_sha = get_git_commit_sha()
    hypergumbo_version = get_hypergumbo_version()
    python_version = platform.python_version()

    lines = [
        "<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->",
        "# Architecture",
        "",
        "> **Auto-generated** by running hypergumbo on itself.",
        "> Sections marked with (auto) are computed at generation time; unmarked sections are curated.",
        "> Run `./scripts/generate-architecture` to update.",
        "",
        "hypergumbo is a local-first CLI that analyzes source code and emits",
        "behavior maps — JSON graphs of symbols, call edges, framework patterns,",
        "and cross-language links. It supports three output modes: a Markdown sketch",
        "for human reading, a full JSON behavior map for tooling, and graph slices",
        "for focused LLM context.",
        "",
        "## Self-Analysis Summary (auto)",
        "",
        "Counts from the source tree, and from `hypergumbo survey packages/ "
        "--first-party-only` (tests included; `scripts/` not analysed):",
        "",
        count_lines[0],
        (
            f"- **{node_count}** graph nodes, every kind, test code included. "
            f"Outside test files, and leaving out placeholders for library "
            f"targets (`external_symbol`): {len(own_nodes)}, of which "
            f"{own_callables} are functions, methods or classes"
        ),
        f"- **{edge_count}** edges, test code included, by type:",
    ]

    # Add edge type breakdown
    for edge_type, count in list(edge_types.items())[:6]:  # Top 6 types
        lines.append(f"  - {edge_type}: {count}")
    if len(edge_types) > 6:
        other_count = sum(c for t, c in list(edge_types.items())[6:])
        lines.append(f"  - other: {other_count}")

    # ── Package Architecture ──────────────────────────────────────
    lines.extend([
        "",
        "## Package Architecture",
        "",
        "The codebase is a Python monorepo with eight packages. Every language",
        "package depends on `hypergumbo-core`; the two SCIP backends also depend",
        "on `hypergumbo-lang-mainstream` (rust-analyzer imports its `rust_scip`",
        "module). `hypergumbo-tracker` depends on no other hypergumbo package.",
        "",
        "```",
        "hypergumbo (meta-package: `pip install hypergumbo`)",
        " ├── hypergumbo-core",
        count_lines[1],
        count_lines[2],
        count_lines[3],
        "",
        "extras: `pip install 'hypergumbo[rust-analyzer]'` / `'hypergumbo[scip-python]'`",
        f" hypergumbo-lang-rust-analyzer     {lang_counts['rust_analyzer']} SCIP backend  "
        "-> core, lang-mainstream",
        f" hypergumbo-lang-scip-python       {lang_counts['scip_python']} SCIP backend  "
        "-> core, lang-mainstream",
        "",
        "separate install:",
        " hypergumbo-tracker                governance tool, no hypergumbo dependency",
        "```",
        "",
        "| Package | Role |",
        "|---------|------|",
        "| **hypergumbo-core** | IR types (`Symbol`, `Edge`, `Span`), CLI, analysis base classes, "
        f"{linker_count} linkers (Protocol / Bridge / Framework / Infrastructure — ADR-3bbb), "
        f"{pattern_total} YAML pattern files, sketch/slice output, "
        "supply chain classification, symbol resolution, ranking |",
        f"| **hypergumbo-lang-mainstream** | {lang_counts['mainstream']} analyzers for widely-used languages "
        "(Python, JS/TS, Java, Go, Rust, C/C++, Ruby, PHP, C#, Kotlin, Swift, Scala, etc.) |",
        f"| **hypergumbo-lang-common** | {lang_counts['common']} analyzers for domain-specific and functional languages "
        "(Haskell, Elixir, OCaml, Dart, Julia, CUDA, GraphQL, HCL, etc.) |",
        f"| **hypergumbo-lang-extended1** | {lang_counts['extended1']} analyzers for specialized languages "
        "(Zig, Odin, Solidity, Verilog, VHDL, Agda, Lean, Wolfram, etc.) |",
        "| **hypergumbo-lang-rust-analyzer** | SCIP-backed Rust analyzer "
        "(alternative to the tree-sitter Rust analyzer in `lang-mainstream`; activates with `--backend rust-analyzer`) |",
        "| **hypergumbo-lang-scip-python** | SCIP-backed Python analyzer "
        "(pyright via scip-python, beside the ast Python analyzer in `lang-mainstream`; executes nothing; activates with `--backend scip-python` or `[backends] scip_python = true`) |",
        "| **hypergumbo** | Meta-package: installs core and the mainstream, common and extended1 "
        "language packages; the two SCIP backends are extras |",
        "| **hypergumbo-tracker** | Standalone governance tool with TUI, YAML-backed op-log store, "
        "Lamport-clock ordering, and optional embedding-based dedup |",
        "",
    ])

    # ── Analysis Pipeline ─────────────────────────────────────────
    lines.extend([
        "## Analysis Pipeline",
        "",
        "`cli.run_survey()` runs the pipeline; `sketch` and `slice` build on its result.",
        "The stages below are its `run_status` phases, in order:",
        "",
        "```",
        "Source files",
        "  │",
        "  1. INDEX     find files; apply .gitignore, default excludes and --exclude;",
        "  │            prune generated output and installed dependency source",
        "  2. PROFILE   languages and LOC; frameworks from manifest markers",
        "  │",
        "  3. ANALYZE   every registered analyzer (tree-sitter, Python ast, regex,",
        "  │            or a SCIP backend) emits symbols, edges and usage contexts;",
        "  │            deferred symbol references resolved; records two producers",
        "  │            emitted for one declaration merged (ADR-0057)",
        "  4. ENRICH    YAML patterns add meta.concepts (ADR-3aaa):",
        f"  │            {conv_count} files always loaded, {fw_count} more when their framework",
        "  │            is detected; route symbols materialized",
        (
            f"  5. LINK      {linker_count} linkers (P{linker_subcats['Protocol']} / "
            f"B{linker_subcats['Bridge']} / F{linker_subcats['Framework']} / "
            f"I{linker_subcats['Infrastructure']}) recover cross-file and"
        ),
        "  │            cross-language edges; synthetic identities reconciled;",
        "  │            edges deduplicated",
        "  6. CLASSIFY  fingerprints stamped; supply chain tier assigned per file;",
        "  │            tier filter (--max-tier / --first-party-only); finalize",
        "  7. RANK      centrality ranking, metrics, entrypoints",
        "  │",
        "  ├── sketch   Markdown, token-budgeted",
        "  ├── survey   JSON behavior map (`run` is a deprecated alias)",
        "  └── slice    JSON subgraph from an entry point",
        "```",
        "",
        "Taint-flow analysis is not a pipeline stage: it runs only under "
        "`hypergumbo verify-claims`.",
        "",
    ])

    # ── Output Modes ──────────────────────────────────────────────
    lines.extend([
        "## Output Modes",
        "",
        "| Mode | Format | Purpose |",
        "|------|--------|---------|",
        "| **`sketch`** | Markdown | Token-budgeted overview of repo structure and key symbols. "
        "Designed for human reading and LLM context windows. Default output mode. |",
        "| **`survey`** | JSON | Full behavior map with all symbols, edges, and metadata, for "
        "downstream tools and CI checks. `run` is a deprecated alias. |",
        "| **`slice`** | JSON | Subgraph extraction from an entry point (forward or reverse). "
        "Produces focused dependency/dependents view for a specific symbol. |",
        "",
    ])

    # ── Supply Chain Tiers ────────────────────────────────────────
    lines.extend([
        "## Supply Chain Tiers",
        "",
        "Every symbol gets a tier after analysis: `_classify_symbols` classifies",
        "each file path and stamps the tier on the symbols in that file.",
        "",
        "| Tier | Name | What lands there |",
        "|------|------|----------|",
        "| **1** | First-party | The project's code, including its tests, examples, docs and workspace packages (their role is a flag: `is_test_file`, `is_example_file`) |",
        "| **2** | Internal dep | Org-internal code from `SupplyChainConfig.internal_package_roots`, plus dependency manifests (`is_config_file`); no CLI flag sets internal roots |",
        "| **3** | External dep | `node_modules/`, `vendor/`, vendored SDKs |",
        "| **4** | Derived | Build output that discovery's build-output rules recognise; minified files (`*.min.js`) |",
        "",
        "The first matching rule wins, in the order given in `supply_chain.py`'s",
        "module docstring (derived and external first). `--max-tier N` drops nodes",
        "above tier N after analysis; `--first-party-only` is `--max-tier 1`. Neither",
        "drops tests: they are tier 1.",
        "",
    ])

    # ── Analyzer Implementations ──────────────────────────────────
    lines.extend([
        "## Analyzer Implementations",
        "",
        "Most analyzers subclass `TreeSitterAnalyzer` (`analyze/base.py`), which",
        "provides a two-pass architecture:",
        "",
        "1. **Pass 1 (symbol extraction):** Parse each file with tree-sitter, walk the AST,",
        "   extract symbols (functions, classes, methods, etc.) with metadata",
        "2. **Pass 2 (edge resolution):** Re-walk ASTs, resolve calls and imports against",
        "   the global symbol registry built in pass 1",
        "",
        "Some do not: the Python analyzer uses the standard-library `ast`; a few",
        "(handlebars, just, qml, blade, gnuplot, mermaid, …) use regular expressions;",
        "and the two SCIP backends translate an index that an external indexer wrote.",
        "",
        "Tree-sitter grammars come from three sources:",
        "- **Per-language PyPI packages**: `tree-sitter-<lang>` dependencies",
        "- **`tree-sitter-language-pack`**: one PyPI package bundling many grammars",
        "- **Build-from-source** (Lean, Wolfram, etc.): compiled by `scripts/build-source-grammars`",
        "  when no usable PyPI grammar exists",
        "",
    ])

    # ── Symbol Resolution ─────────────────────────────────────────
    lines.extend([
        "## Symbol Resolution",
        "",
        "Analyzers (and `framework_patterns.py`) resolve a referenced name to a",
        "symbol with `NameResolver` (`symbol_resolution.py`), which provides tiered",
        "matching with confidence levels:",
        "",
        "| Strategy | Confidence | When used |",
        "|----------|-----------|-----------|",
        "| Exact | 1.0 | Direct key match in symbol registry |",
        "| Path hint | 0.90 | Disambiguate using import path (Go-style) |",
        "| Suffix | 0.85 | Match `MyClass.doWork` for lookup `doWork` |",
        "| Ambiguous | 0.70 | Multiple candidates, picked heuristically |",
        "",
        "The suffix index is built lazily on first fuzzy lookup, not upfront.",
        "Confidence scores propagate to edges, enabling downstream consumers to",
        "filter by reliability.",
        "",
    ])

    # ── Key Abstractions ──────────────────────────────────────────
    ir_abstractions = extract_ir_abstractions()
    lines.extend([
        "## Key Abstractions",
        "",
    ])
    lines.append(ir_abstractions)
    lines.append("")

    # ── Canonical Vocabularies ────────────────────────────────────
    lines.extend([
        "## Canonical Vocabularies",
        "",
        "Three IR fields are typed by the heavyweight canonical registries below.",
        "Every other string field on the core dataclasses declares its axis in a",
        "`# axis:` comment (io-boundary, module-key, language, pass-id, …), checked",
        "by `check-multi-value-field-axis-declaration`.",
        "",
        "| Field | Registry | Axis | ADR |",
        "|---|---|---|---|",
        "| `Edge.edge_type` | `edge_types.py` | relationship | "
        "[ADR-0023](adr/0023-edge-type-relationship-not-endpoints.md) |",
        "| `Symbol.kind` | `symbol_kinds.py` | language construct | "
        "[ADR-0027](adr/0027-symbol-kind-language-construct-only.md) |",
        "| `Edge.evidence_type` | `evidence_types.py` | inference pathway | "
        "[ADR-0028](adr/0028-evidence-type-inference-pathway-only.md) |",
        "",
        "Each axis is declared per "
        "[ADR-0024](adr/0024-axis-declaration-template.md)'s four-part template "
        "(axis name, axiom, consumer pattern, enforcement). Properties not "
        "intrinsic to the axis live elsewhere: endpoint kind on `dst.kind`, "
        "framework participation in `Symbol.meta` / `Edge.meta` (key vocabulary "
        "in `axis_meta_keys.py`), resolution status in the sibling "
        "`Edge.is_resolved` bool.",
        "",
        "Drift linters enforce the discipline statically:",
        "",
        "- **L1 axis-drift** (`check-edge-type-drift`, `check-symbol-kind-drift`, "
        "`check-evidence-type-drift`, `check-io-boundary-drift`) — every literal "
        "value set for the axis in `packages/` must be a subset of the canonical "
        "registry. Runs in pre-commit.",
        "- **L3 producer-coherence** (`check-producer-axis-coherence`) — "
        "literal-string keyword arguments at `Edge.create` / `Symbol(...)` "
        "construction sites must match the registry; handles inline ternaries, "
        "f-strings, and locally-bound names.",
        "- **L4 fallback-coherence** (`check-fallback-coherence`) — any "
        "`Edge.create` site declaring `meta[\"disambiguation_fallback\"]=True` "
        "must also bind `confidence ≤ 0.5` on the same call.",
        "- **Runtime coherence** (`check-edge-type-runtime-coherence`) — "
        "partitions emitted edges by `(src.kind, src.language, dst.kind, "
        "dst.language)` to surface producer-side endpoint-shape leakage.",
        "",
        "Live by-axis view: [`docs/concept-axes.md`](concept-axes.md). "
        "Downstream consumers of the behavior-map JSON: "
        "[`docs/migrating-edge-types.md`](migrating-edge-types.md).",
        "",
    ])

    # ── Most-Connected Symbols ────────────────────────────────────
    lines.extend([
        "## Most-Connected Symbols (auto)",
        "",
        "The project's own symbols with the highest "
        "`score = in_degree * (1 + ln(1 + out_degree))`, counting only edges "
        "from non-test code. Test symbols and library placeholders are not "
        "ranked. This is not the ranking `hypergumbo symbols` uses.",
        "",
        "| Symbol | Kind | Score | Location |",
        "|--------|------|-------|----------|",
    ])
    for sym in top_symbols:
        path = re.sub(r"^[^/]+/src/", "", sym["path"])
        lines.append(f"| `{sym['name']}` | {sym['kind']} | {sym['score']:.1f} | {path} |")
    lines.append("")

    # ── Pattern System ────────────────────────────────────────────
    lines.extend([
        "## Pattern System",
        "",
        "### Key Components",
        "",
        "- **`framework_patterns.py`**: Loads and applies YAML pattern files",
        count_lines[4],
        "- **`meta.concepts`**: List of matched concepts (single source of truth)",
        "- **`meta.decorators`/`meta.annotations`**: Raw metadata for pattern matching",
        "",
        "### meta.concepts Structure",
        "",
        "Enriched symbols have a `meta.concepts` list:",
        "",
        "```json",
        '{',
        '  "meta": {',
        '    "concepts": [',
        '      {"concept": "route", "path": "/users", "method": "GET", "framework": "fastapi"},',
        '      {"concept": "test_function", "framework": "test-frameworks"}',
        '    ]',
        '  }',
        '}',
        "```",
        "",
        "Pattern-driven linkers and entrypoint detection read `meta.concepts`; some",
        "linkers also read raw `decorators` / `annotations` / `base_classes` metadata.",
        "",
        "### Adding a New Pattern",
        "",
        "**Framework pattern** (loaded when framework detected):",
        "1. Create `packages/hypergumbo-core/src/hypergumbo_core/frameworks/<framework>.yaml`",
        "2. Patterns only: a linker's activation is its `LinkerActivation` in code, and a key the loader does not read is refused (WI-hapon)",
        "3. Add tests in `packages/hypergumbo-core/tests/test_framework_patterns.py`",
        "",
        "**Convention pattern** (always loaded):",
        "1. Edit an existing convention file or create a new one",
        "2. Use `language: multi` for cross-language patterns",
        "3. Add its `id` to `_CONVENTION_PATTERN_IDS` in `framework_patterns.py`",
        "",
        "Example patterns:",
        "",
        "**Definition-based (decorators/annotations):**",
        "```yaml",
        "id: myframework",
        "language: python",
        "",
        "patterns:",
        "  - concept: route",
        '    decorator: "^myapp\\\\.(get|post|put|delete)$"',
        '    extract_path: "args[0]"',
        '    extract_method: "decorator_suffix"',
        "```",
        "",
        "**Convention-based (symbol_name + symbol_kind + language):**",
        "```yaml",
        "id: test-frameworks",
        "language: multi",
        "",
        "patterns:",
        "  - concept: test_function",
        '    symbol_name: "^test_"',
        '    symbol_kind: "^function$"',
        '    language: "^python$"',
        "```",
        "",
    ])

    # ── YAML Catalogs ─────────────────────────────────────────────
    lines.extend(_render_yaml_catalogs_section())

    # ── Tracker Subsystem ─────────────────────────────────────────
    lines.extend([
        "## Tracker Subsystem",
        "",
        "The `hypergumbo-tracker` package is an independent governance tool for",
        "managing work items, invariants, and project state. Key design choices:",
        "",
        "- **Op-log store:** Items are append-only YAML op logs, not mutable records.",
        "  `compile()` folds the log into current state (LWW for scalars, accumulation for sets).",
        "- **Lamport clock:** Cross-branch causal ordering: a new op's clock is one",
        "  more than the highest stored clock read from other branches' op logs.",
        "- **Multi-tier views:** `TrackerSet` provides a unified view over canonical,",
        "  workspace, and stealth stores.",
        "- **SQLite cache:** Read-hot path uses a SQLite cache (`Cache`) that rebuilds",
        "  from the op-log on invalidation.",
        "- **Proquint IDs:** Content-hash IDs (SHA-256 + proquint encoding) for",
        "  natural deduplication — same logical item always gets the same ID.",
        "- **TUI:** Textual-based terminal UI (`TrackerApp`) for interactive browsing,",
        "  filtering, and discussion.",
        "",
    ])

    # ── Scripts & Tooling ─────────────────────────────────────────
    script_categories = categorize_scripts()
    if script_categories:
        lines.extend([
            "## Scripts & Tooling (auto)",
            "",
            "The `scripts/` directory contains operational tooling. "
            "Descriptions are extracted from each script's header comment or docstring.",
            "",
        ])
        for category, scripts in script_categories.items():
            lines.append(f"### {category}")
            lines.append("")
            lines.append("| Script | Description |")
            lines.append("|--------|-------------|")
            for name, desc in scripts:
                lines.append(f"| `{name}` | {desc} |")
            lines.append("")

    # ── Extension Guides ──────────────────────────────────────────
    lines.extend([
        "## Adding a New Analyzer",
        "",
        "1. Create analyzer in the appropriate lang package:",
        "   - Mainstream: `packages/hypergumbo-lang-mainstream/src/hypergumbo_lang_mainstream/<language>.py`",
        "   - Common: `packages/hypergumbo-lang-common/src/hypergumbo_lang_common/<language>.py`",
        "   - Extended1: `packages/hypergumbo-lang-extended1/src/hypergumbo_lang_extended1/<language>.py`",
        "2. Write `analyze_<language>(repo_root: Path) -> AnalysisResult` and decorate it",
        "   with `@register_analyzer(\"<language>\")` (`analyze/registry.py`); the decorator",
        "   raises `LanguageDeclarationError` if the language is not in the taxonomy",
        "3. Add the module to `ANALYZER_MODULES` in the package's `__init__.py`",
        "   (the package exposes it through the `hypergumbo.analyzers` entry point)",
        "4. Add tests in the package's `tests/` directory",
        "",
    ])

    # Adding a New Linker (auto-generated from registry.py docstring)
    linker_howto = extract_linker_howto()
    lines.extend([
        "## Adding a New Linker",
        "",
        "Per [ADR-3bbb](adr/3bbb-linker-subcategory-restoration.md), the first "
        "line of every linker module's docstring must declare its subcategory in the "
        "form `\"\"\"<Protocol|Bridge|Framework|Infrastructure> linker: <one-line purpose>.`",
        "",
    ])
    lines.append(linker_howto)
    lines.append("")

    # ── Module Reference ──────────────────────────────────────────
    lines.extend([
        "## Module Reference (auto)",
        "",
    ])

    for category, mods in categories.items():
        if not mods:
            continue
        lines.append(f"### {category}")
        lines.append("")

        for name, docstring in mods:
            # Extract first non-empty line of docstring
            if docstring:
                first_line = next(
                    (ln.strip() for ln in docstring.splitlines() if ln.strip()),
                    "(no docstring)"
                )
                if len(first_line) > 70:
                    first_line = first_line[:67] + "..."
            else:
                first_line = "(no docstring)"

            lines.append(f"- **`{name}`**: {first_line}")

        lines.append("")

    # ── Generation Metadata ──────────────────────────────────────
    commit_count = get_commit_count()
    lines.extend([
        "---",
        "",
        "<!--",
        "GENERATION METADATA (for drift detection):",
        f"  commit: {commit_sha or 'unknown'}",
        f"  commit_count: {commit_count if commit_count is not None else 'unknown'}",
        f"  hypergumbo: {hypergumbo_version}",
        f"  python: {python_version}",
        "-->",
    ])

    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate ARCHITECTURE.md")
    parser.add_argument("--check", action="store_true", help="Check if docs are up-to-date")
    args = parser.parse_args()

    output_path = REPO_ROOT / "docs" / "ARCHITECTURE.md"

    if args.check:
        if not output_path.exists():
            print("ERROR: docs/ARCHITECTURE.md does not exist")
            print("Run: ./scripts/generate-architecture")
            return 1

        # Freshness check. We don't byte-compare regenerated content (as
        # generate-schema does) because architecture generation runs hypergumbo
        # on itself — output varies by Python version and tree-sitter build,
        # not reproducible in CI. Instead the doc records how far HEAD had
        # advanced when it was generated, and we require the doc to be within
        # RECENT_COMMIT_WINDOW commits of the current HEAD.
        #
        # PRIMARY signal: ``commit_count`` (rebase-stable). GitHub's rebase-merge
        # REWRITES the merged commits' SHAs, so any recorded branch ``commit:``
        # SHA is orphaned on ``dev`` the moment the PR merges — a SHA-membership
        # check then false-fails on the very next code PR (it did, twice). The
        # count of ancestors survives rebase, so staleness = current - recorded.
        content = output_path.read_text(encoding="utf-8")
        if "Auto-generated" not in content:
            print("ERROR: docs/ARCHITECTURE.md doesn't appear to be auto-generated")
            return 1

        # Counts read from the source tree are cheap and deterministic, so
        # they are recomputed rather than trusted to the commit window: a new
        # linker or analyzer must show up in the doc in the PR that adds it.
        stale = stale_count_lines(content)
        if stale:
            print("ERROR: docs/ARCHITECTURE.md has stale counts; expected these lines:")
            for line in stale:
                print(f"  {line}")
            print("Run: ./scripts/generate-architecture")
            return 1

        count_match = re.search(r"commit_count:\s+(\d+)", content)
        if count_match:
            recorded_count = int(count_match.group(1))
            try:
                raw, tracker_only, distance = staleness_distance(recorded_count)
            except RuntimeError as exc:
                print(f"ERROR: {exc}")
                return 1
            note = (f" ({raw} including {tracker_only} tracker-only commit(s), not counted)"
                    if tracker_only else "")
            if distance <= RECENT_COMMIT_WINDOW:
                print(f"OK: docs/ARCHITECTURE.md was generated {distance} commit(s) "
                      f"ago (window {RECENT_COMMIT_WINDOW}){note}")
                return 0
            print(f"ERROR: docs/ARCHITECTURE.md is out of date: generated {distance} "
                  f"commits ago{note}, exceeds the {RECENT_COMMIT_WINDOW}-commit window")
            print("Run: ./scripts/generate-architecture")
            return 1

        # Legacy fallback: a doc predating commit_count records only a SHA. The
        # SHA-membership window is rebase-fragile (see above), but keeps an old
        # doc checkable until it is regenerated with a commit_count.
        sha_match = re.search(r"commit:\s+([0-9a-f]{6,})", content)
        if not sha_match:  # pragma: no cover - a generated doc always has commit metadata
            print("ERROR: docs/ARCHITECTURE.md is missing commit metadata")
            return 1
        recent = get_recent_commit_shas()
        if recent and sha_match.group(1) in recent:
            print(f"OK: docs/ARCHITECTURE.md recorded commit {sha_match.group(1)} "
                  f"is within the last {len(recent)} commits (legacy SHA path)")
            return 0
        print("ERROR: docs/ARCHITECTURE.md is out of date (legacy SHA path)")
        print(f"  recorded commit: {sha_match.group(1)}")
        print("Run: ./scripts/generate-architecture")
        return 1

    generated = generate_architecture_md()
    output_path.write_text(generated, encoding="utf-8")
    print(f"Generated {output_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Generate ARCHITECTURE.md using hypergumbo to analyze itself.

This script uses hypergumbo's own analysis capabilities to generate architecture
documentation that stays in sync with the code.

Usage:
    ./scripts/generate-architecture              # Generate docs/ARCHITECTURE.md
    ./scripts/generate-architecture --check      # Verify docs are up-to-date (for CI)

The generated documentation includes:
- Sketch overview (from hypergumbo sketch)
- Most-connected symbols (from hypergumbo run)
- Module reference with docstrings
"""

from __future__ import annotations

import argparse
import ast
import json
import math
import os
import platform
import re
import subprocess
import sys
import tokenize
from collections import defaultdict
from pathlib import Path

# Try to import a TOML parser for reading pyproject.toml
try:
    import tomllib  # Python 3.11+
except ImportError:
    try:
        import tomli as tomllib  # Fallback for Python 3.9-3.10
    except ImportError:
        tomllib = None  # type: ignore[assignment]

REPO_ROOT = Path(__file__).parent.parent


def get_git_commit_sha() -> str | None:
    """Get the current git commit SHA."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            cwd=REPO_ROOT,
        )
        if result.returncode == 0:
            return result.stdout.strip()[:12]  # Short SHA
    except Exception:
        pass
    return None


def get_hypergumbo_version() -> str:
    """Get the hypergumbo package version from pyproject.toml.

    Reads directly from pyproject.toml rather than importing the package,
    ensuring we get the repo version rather than a potentially different
    installed version.
    """
    # Read from meta-package pyproject.toml (source of truth for version)
    pyproject_path = REPO_ROOT / "packages" / "hypergumbo" / "pyproject.toml"
    if not pyproject_path.exists():
        return "unknown"

    try:
        content = pyproject_path.read_text(encoding="utf-8")

        # Try TOML parser first (more reliable)
        if tomllib is not None:
            data = tomllib.loads(content)
            return data.get("project", {}).get("version", "unknown")

        # Fallback: simple regex for version = "x.y.z" line
        # This is reliable enough for the simple pyproject.toml format
        match = re.search(r'^version\s*=\s*["\']([^"\']+)["\']', content, re.MULTILINE)
        if match:
            return match.group(1)
    except Exception:
        pass
    return "unknown"


def run_command(args: list[str], description: str) -> subprocess.CompletedProcess:
    """Run a command with proper error handling.

    Args:
        args: Command and arguments to run
        description: Human-readable description for error messages

    Returns:
        CompletedProcess on success

    Raises:
        SystemExit: If command fails
    """
    result = subprocess.run(
        args,
        capture_output=True,
        text=True,
        cwd=REPO_ROOT,
    )

    if result.returncode != 0:
        print(f"ERROR: {description} failed with exit code {result.returncode}",
              file=sys.stderr)
        print(f"Command: {' '.join(args)}", file=sys.stderr)
        if result.stderr:
            print(f"stderr: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    return result


def run_hypergumbo_sketch() -> str:
    """Run hypergumbo sketch on the entire repo.

    Strips the trailing ``[hypergumbo sketch]`` status summary that the CLI
    appends to stdout (artifact paths, cache locations, etc.).
    """
    result = run_command(
        [sys.executable, "-m", "hypergumbo_core", "sketch", str(REPO_ROOT),
         "-t", "8000"],
        "hypergumbo sketch",
    )
    output = result.stdout
    # Strip CLI status summary (e.g. "[hypergumbo sketch] Generated 5 ...")
    marker = "\n[hypergumbo sketch]"
    idx = output.find(marker)
    if idx != -1:
        output = output[:idx]
    return output


# AI tool folders to filter from structure output
AI_TOOL_FOLDERS = {".gemini", ".codex", ".claude", ".continue", ".aider", ".clinerules", ".cursor"}


def filter_ai_folders_from_structure(sketch: str) -> str:
    """Remove AI tool folders from the Structure section of the sketch.

    Filters out repo-root-level folders like .claude, .cursor, etc.
    """
    lines = sketch.split("\n")
    result = []
    in_structure = False
    skip_until_unindent = False
    skip_indent_level = 0

    for line in lines:
        # Detect Structure section
        if line.startswith("## Structure"):
            in_structure = True
            result.append(line)
            continue

        # Detect end of Structure section (next ## header)
        if in_structure and line.startswith("## ") and not line.startswith("## Structure"):
            in_structure = False
            skip_until_unindent = False

        if in_structure:
            # Check if this line references an AI tool folder at repo root level
            # These appear as "├── .claude" or "└── .claude" at low indent
            stripped = line.lstrip("│├└─ ")
            folder_name = stripped.split()[0] if stripped.split() else ""

            # Check for AI tool folder at root level (shallow indent)
            # Root level items have minimal leading characters
            leading_chars = len(line) - len(line.lstrip("│├└─ "))
            is_root_level = leading_chars <= 4

            if is_root_level and folder_name in AI_TOOL_FOLDERS:
                # Skip this line and any children (more indented lines)
                skip_until_unindent = True
                skip_indent_level = leading_chars
                continue

            if skip_until_unindent:
                current_indent = len(line) - len(line.lstrip("│├└─ "))
                if current_indent <= skip_indent_level and line.strip():
                    # Back to same or lower indent, stop skipping
                    skip_until_unindent = False
                else:
                    # Still in AI folder subtree, skip
                    continue

        result.append(line)

    return "\n".join(result)


def _remove_sketch_sections(sketch: str, sections: list[str]) -> str:
    """Remove entire sections (header through next same-level header) from sketch.

    Used to strip sections (e.g. Entry Points, Source Files Content) that are
    useful in a standalone sketch but noise in architecture documentation.

    Code-fence-aware: ``## Heading`` lines inside fenced code blocks (e.g.
    README content rendered by the sketch) are ignored rather than treated as
    section boundaries.  Handles nested fences per the CommonMark spec: a
    closing fence must have at least as many backticks as the opening fence.
    """
    lines = sketch.split("\n")
    result: list[str] = []
    skipping = False
    fence_delim_len = 0  # 0 = not inside a fence

    for line in lines:
        # Track code fence boundaries per CommonMark: opening fence is 3+
        # backticks; closing fence must match or exceed that count.
        stripped = line.lstrip()
        if stripped.startswith("```"):
            backtick_count = len(stripped) - len(stripped.lstrip("`"))
            if fence_delim_len == 0:
                # Opening a fence
                fence_delim_len = backtick_count
            elif backtick_count >= fence_delim_len:
                # Closing a fence (matching or longer delimiter)
                fence_delim_len = 0

        # Inside a code fence, headings are literal content, not structure.
        if fence_delim_len == 0:
            # Detect start of a target section
            if any(line.startswith(f"## {s}") for s in sections):
                skipping = True
                continue

            # Detect next ## header — stop skipping
            if skipping and line.startswith("## "):
                skipping = False

        if not skipping:
            result.append(line)

    return "\n".join(result)


def remove_section_code_fences(sketch: str, sections: list[str]) -> str:
    """Remove code fences (triple backticks) around specified sections.

    Some sections use special characters (tree chars, config snippets) that
    render better without being wrapped in a code fence in web markdown viewers.

    Args:
        sketch: The sketch content
        sections: List of section names to process (e.g., ["Structure", "Configuration"])
    """
    lines = sketch.split("\n")
    result = []
    in_target_section = False
    found_opening_fence = False
    current_section = ""

    i = 0
    while i < len(lines):
        line = lines[i]

        # Detect target sections
        for section in sections:
            if line.startswith(f"## {section}"):
                in_target_section = True
                current_section = section
                result.append(line)
                i += 1
                # Skip empty lines after header
                while i < len(lines) and not lines[i].strip():
                    result.append(lines[i])
                    i += 1
                # Check for opening code fence
                if i < len(lines) and lines[i].strip() == "```":
                    found_opening_fence = True
                    i += 1  # Skip the opening fence
                break
        else:
            # No section matched, continue normal processing

            # In target section, look for closing fence
            if in_target_section and found_opening_fence:
                if line.strip() == "```":
                    # Found closing fence - skip it and end section
                    in_target_section = False
                    found_opening_fence = False
                    current_section = ""
                    i += 1
                    continue

            # Detect end of target section (next ## header)
            if in_target_section and line.startswith("## ") and not line.startswith(f"## {current_section}"):
                in_target_section = False
                found_opening_fence = False
                current_section = ""

            result.append(line)
            i += 1
            continue

        # If we matched a section and are continuing, don't append twice
        if not found_opening_fence:
            continue

    return "\n".join(result)


def run_hypergumbo_analysis() -> dict:
    """Run hypergumbo full analysis on itself."""
    output_file = REPO_ROOT / ".hypergumbo" / "self-analysis.json"
    output_file.parent.mkdir(parents=True, exist_ok=True)

    # Delete stale analysis file to avoid reusing old data on failure
    if output_file.exists():
        output_file.unlink()

    # Analyze all package src directories
    packages_dir = REPO_ROOT / "packages"
    run_command(
        [sys.executable, "-m", "hypergumbo_core", "run", str(packages_dir),
         "--out", str(output_file), "--first-party-only"],
        "hypergumbo run",
    )

    if not output_file.exists():
        print(f"ERROR: hypergumbo run succeeded but output file not created: {output_file}",
              file=sys.stderr)
        sys.exit(1)

    return json.loads(output_file.read_text(encoding="utf-8"))


def extract_module_docstring(file_path: Path) -> str | None:
    """Extract the module docstring from a Python file.

    Uses tokenize.open() to respect PEP 263 encoding declarations,
    ensuring correct handling of files with non-UTF8 encodings.
    """
    try:
        with tokenize.open(file_path) as f:
            content = f.read()
        tree = ast.parse(content)
        return ast.get_docstring(tree)
    except Exception:
        return None


def categorize_modules() -> dict[str, list[tuple[str, str | None]]]:
    """Categorize modules into logical groups with docstrings."""
    categories: dict[str, list[tuple[str, str | None]]] = {
        "Core": [],
        "Analyzers": [],
        "Linkers": [],
        "CLI & I/O": [],
        "Tracker": [],
    }

    # Scan all package src directories
    package_roots = [
        ("hypergumbo_core", REPO_ROOT / "packages" / "hypergumbo-core" / "src" / "hypergumbo_core"),
        ("hypergumbo_lang_mainstream", REPO_ROOT / "packages" / "hypergumbo-lang-mainstream" / "src" / "hypergumbo_lang_mainstream"),
        ("hypergumbo_lang_common", REPO_ROOT / "packages" / "hypergumbo-lang-common" / "src" / "hypergumbo_lang_common"),
        ("hypergumbo_lang_extended1", REPO_ROOT / "packages" / "hypergumbo-lang-extended1" / "src" / "hypergumbo_lang_extended1"),
        ("hypergumbo_tracker", REPO_ROOT / "packages" / "hypergumbo-tracker" / "src" / "hypergumbo_tracker"),
    ]

    for package_name, src_root in package_roots:
        if not src_root.exists():
            continue

        for py_file in sorted(src_root.rglob("*.py")):
            # Skip private modules except __init__.py and __main__.py
            if py_file.name.startswith("_") and py_file.name not in {"__init__.py", "__main__.py"}:
                continue

            rel_path = py_file.relative_to(src_root)
            parts = list(rel_path.parts)
            if parts[-1] == "__init__.py":
                continue  # Skip __init__ files in listing

            # Use with_suffix to properly remove only the .py extension
            # (avoids bug where analyze/py.py became "analyze" via .replace(".py", ""))
            module_path = rel_path.with_suffix("")
            module_name = f"{package_name}.{'.'.join(module_path.parts)}"
            docstring = extract_module_docstring(py_file)

            # Classify by directory structure and package origin.
            # Language analyzer modules live as top-level files in hypergumbo_lang_*
            # packages, while core analyzer infrastructure lives under analyze/.
            if package_name == "hypergumbo_tracker":
                categories["Tracker"].append((module_name, docstring))
            elif package_name.startswith("hypergumbo_lang_"):
                categories["Analyzers"].append((module_name, docstring))
            elif parts and parts[0] == "analyze":
                categories["Analyzers"].append((module_name, docstring))
            elif parts and parts[0] == "linkers":
                # Exclude registry.py (the linker registry scaffolding, not a
                # linker module itself). Matching its subcategory convention
                # would be meaningless since it doesn't belong to any of the
                # ADR-0003-ext subcategories; counting it as a linker would
                # inflate the total and flag it Uncategorized forever.
                if module_path.name == "registry":
                    categories["Core"].append((module_name, docstring))
                else:
                    categories["Linkers"].append((module_name, docstring))
            elif module_path.name in {"cli", "export", "schema", "plan", "sketch", "__main__"}:
                categories["CLI & I/O"].append((module_name, docstring))
            else:
                categories["Core"].append((module_name, docstring))

    return categories


def get_top_symbols(analysis: dict, limit: int = 20) -> list[dict]:
    """Get the top symbols by bidirectional centrality.

    Uses the same formula as ``hypergumbo symbols``:
        score = in_degree * (1 + ln(1 + out_degree))
    """
    in_degree: dict[str, int] = defaultdict(int)
    out_degree: dict[str, int] = defaultdict(int)
    for edge in analysis.get("edges", []):
        dst = edge.get("dst", "")
        src = edge.get("src", "")
        if dst:
            in_degree[dst] += 1
        if src:
            out_degree[src] += 1

    symbols_by_id = {s["id"]: s for s in analysis.get("nodes", [])}
    all_ids = set(in_degree) | set(out_degree)

    scored: list[tuple[str, float, int]] = []
    for sym_id in all_ids:
        ind = in_degree.get(sym_id, 0)
        outd = out_degree.get(sym_id, 0)
        score = ind * (1 + math.log(1 + outd))
        scored.append((sym_id, score, ind))

    scored.sort(key=lambda x: (-x[1], x[0]))

    result = []
    for sym_id, score, ind in scored[:limit]:
        if sym_id in symbols_by_id:
            sym = symbols_by_id[sym_id]
            result.append({
                "name": sym.get("name", ""),
                "kind": sym.get("kind", ""),
                "path": sym.get("path", ""),
                "score": score,
                "in_degree": ind,
            })

    return result


def get_edge_type_distribution(analysis: dict) -> dict[str, int]:
    """Get the distribution of edge types.

    Returns a dict mapping edge type to count, sorted by count descending.
    """
    type_counts: dict[str, int] = defaultdict(int)
    for edge in analysis.get("edges", []):
        edge_type = edge.get("type", "unknown")
        type_counts[edge_type] += 1

    # Sort by count descending, then by name for determinism
    return dict(sorted(type_counts.items(), key=lambda x: (-x[1], x[0])))


def count_framework_patterns() -> tuple[int, int, int]:
    """Count convention vs framework YAML pattern files.

    Convention patterns have ``language: multi``; all others are framework patterns.

    Returns (total, convention_count, framework_count).
    """
    frameworks_dir = (
        REPO_ROOT / "packages" / "hypergumbo-core" / "src"
        / "hypergumbo_core" / "frameworks"
    )
    convention = framework = 0
    for yaml_file in sorted(frameworks_dir.glob("*.yaml")):
        content = yaml_file.read_text(encoding="utf-8")
        if re.search(r"^language:\s*multi", content, re.MULTILINE):
            convention += 1
        else:
            framework += 1
    return (convention + framework, convention, framework)


def extract_ir_abstractions() -> str:
    """Extract Key Abstractions markdown from ir.py class docstrings.

    Parses Span, Symbol, Edge, and AnalysisRun classes using the ast module
    and formats their numpydoc Attributes sections as markdown lists.
    """
    ir_path = (
        REPO_ROOT / "packages" / "hypergumbo-core" / "src"
        / "hypergumbo_core" / "ir.py"
    )
    try:
        source = ir_path.read_text(encoding="utf-8")
        tree = ast.parse(source)
    except Exception:
        return ""

    target_classes = ["Span", "Symbol", "Edge", "AnalysisRun"]
    sections: list[str] = []

    for node in ast.walk(tree):
        if not isinstance(node, ast.ClassDef) or node.name not in target_classes:
            continue
        docstring = ast.get_docstring(node)
        if not docstring:
            continue

        # Extract first paragraph (up to first blank line or Attributes)
        first_para_lines: list[str] = []
        for line in docstring.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("Attributes"):
                break
            first_para_lines.append(stripped)
        first_para = " ".join(first_para_lines)

        # Extract Attributes section
        attrs: list[str] = []
        in_attrs = False
        for line in docstring.splitlines():
            stripped = line.strip()
            if stripped.startswith("Attributes"):
                in_attrs = True
                continue
            if in_attrs:
                if stripped.startswith("---"):
                    continue
                # A new numpydoc section header (word followed by line of dashes)
                if stripped and not stripped.startswith(" ") and ":" not in stripped:
                    break
                if ": " in stripped:
                    name, desc = stripped.split(": ", 1)
                    attrs.append(f"- `{name.strip()}`: {desc}")
                elif stripped and attrs:
                    # Continuation line
                    attrs[-1] += " " + stripped

        section = f"### {node.name} (`ir.py`)\n{first_para}\n"
        if attrs:
            section += "\n".join(attrs) + "\n"
        sections.append(section)

    return "\n".join(sections)


def extract_linker_howto() -> str:
    """Extract the linker registration example from registry.py's Usage docstring.

    Falls back to a generic pointer if extraction fails.
    """
    registry_path = (
        REPO_ROOT / "packages" / "hypergumbo-core" / "src"
        / "hypergumbo_core" / "linkers" / "registry.py"
    )
    try:
        source = registry_path.read_text(encoding="utf-8")
        tree = ast.parse(source)
        docstring = ast.get_docstring(tree)
    except Exception:
        docstring = None

    if not docstring:
        return (
            "1. Create `packages/hypergumbo-core/src/hypergumbo_core/linkers/<name>.py`\n"
            "2. See `linkers/registry.py` for the registration API\n"
            "3. Add tests in `packages/hypergumbo-core/tests/test_<name>_linker.py`"
        )

    # Extract the first code block from the Usage section.
    # We look for lines starting with typical Python code tokens
    # (from, @, def, class, return, #) and stop when we see a non-code line
    # after a blank separator.
    _CODE_STARTS = ("from ", "@", "def ", "class ", "return ", "#", "repo_root")
    doc_lines = docstring.splitlines()
    in_usage = False
    in_code = False
    pending_blanks = 0
    code_lines: list[str] = []
    for i, line in enumerate(doc_lines):
        stripped = line.strip()
        if stripped.startswith("Usage"):
            in_usage = True
            continue
        if in_usage and not in_code:
            if stripped.startswith("from ") or stripped.startswith("@register_linker"):
                in_code = True
                code_lines.append(stripped)
        elif in_code:
            if not stripped:
                pending_blanks += 1
                continue
            if pending_blanks and not any(stripped.startswith(t) for t in _CODE_STARTS):
                # Non-code line after a blank — end of code block
                break
            # Flush pending blanks into code
            for _ in range(pending_blanks):
                code_lines.append("")
            pending_blanks = 0
            code_lines.append(stripped)

    # Trim trailing blank lines
    while code_lines and not code_lines[-1].strip():
        code_lines.pop()

    if not code_lines:
        return (
            "1. Create `packages/hypergumbo-core/src/hypergumbo_core/linkers/<name>.py`\n"
            "2. See `linkers/registry.py` for the registration API\n"
            "3. Add tests in `packages/hypergumbo-core/tests/test_<name>_linker.py`"
        )

    code_block = "\n".join(code_lines)
    return (
        "1. Create `packages/hypergumbo-core/src/hypergumbo_core/linkers/<name>.py`\n"
        "2. Register using the decorator pattern:\n\n"
        "```python\n"
        f"{code_block}\n"
        "```\n\n"
        "3. Add tests in `packages/hypergumbo-core/tests/test_<name>_linker.py`"
    )


def count_language_analyzers(categories: dict[str, list[tuple[str, str | None]]]) -> dict[str, int]:
    """Count analyzers per language package.

    Returns a dict mapping package short name to count, e.g.
    {"mainstream": 35, "common": 25, "extended1": 37}.
    """
    counts: dict[str, int] = {}
    for name, _ in categories.get("Analyzers", []):
        if "hypergumbo_lang_mainstream" in name:
            counts["mainstream"] = counts.get("mainstream", 0) + 1
        elif "hypergumbo_lang_common" in name:
            counts["common"] = counts.get("common", 0) + 1
        elif "hypergumbo_lang_extended1" in name:
            counts["extended1"] = counts.get("extended1", 0) + 1
        else:
            counts["core"] = counts.get("core", 0) + 1
    return counts


# Subcategory vocabulary from ADR-0003 §2.4 as restored by ADR-0003-ext
# (Linker Subcategory Restoration). Each linker module's docstring must
# open with one of these four labels. An "Uncategorized" bucket catches
# files that don't follow the convention so the generator surfaces the
# omission rather than silently miscounting.
_LINKER_SUBCATEGORIES = ("Protocol", "Bridge", "Framework", "Infrastructure")


def count_linker_subcategories(
    categories: dict[str, list[tuple[str, str | None]]],
) -> dict[str, int]:
    """Count linker modules by ADR-0003-ext subcategory.

    Reads the first line of each linker module's docstring and matches it
    against the four ADR-0003-ext subcategory labels. The convention (from
    ADR-0003-ext §2 decision point #2) is that every linker module's
    docstring opens with ``"<Subcategory> linker: <purpose>."``.

    Returns a dict keyed by subcategory name ("Protocol", "Bridge",
    "Framework", "Infrastructure") plus an "Uncategorized" bucket for
    modules that don't declare a subcategory in the expected form. The
    Uncategorized count SHOULD be zero after ADR-0003-ext is fully rolled
    out; a non-zero count is a documentation-drift signal that surfaces
    automatically in the generated architecture doc.
    """
    counts: dict[str, int] = {name: 0 for name in _LINKER_SUBCATEGORIES}
    counts["Uncategorized"] = 0
    for _module_name, docstring in categories.get("Linkers", []):
        first_line = (docstring or "").strip().split("\n", 1)[0].strip()
        matched = False
        for subcat in _LINKER_SUBCATEGORIES:
            # Match ``"<Subcat> linker:"`` (case-sensitive, with the colon)
            if first_line.startswith(f"{subcat} linker:"):
                counts[subcat] += 1
                matched = True
                break
        if not matched:
            counts["Uncategorized"] += 1
    return counts


def extract_supply_chain_tiers() -> str:
    """Extract supply chain tier documentation from supply_chain.py's docstring.

    Parses the module docstring to produce a markdown description
    of the tier classification system.
    """
    sc_path = (
        REPO_ROOT / "packages" / "hypergumbo-core" / "src"
        / "hypergumbo_core" / "supply_chain.py"
    )
    docstring = extract_module_docstring(sc_path)
    if not docstring:
        return ""

    # Extract the Tiers section
    lines: list[str] = []
    in_tiers = False
    in_algorithm = False
    for line in docstring.splitlines():
        stripped = line.strip()
        if stripped.startswith("Tiers"):
            in_tiers = True
            continue
        if stripped.startswith("Classification Algorithm"):
            in_tiers = False
            in_algorithm = True
            continue
        if in_algorithm and stripped.startswith("---"):
            continue
        if in_algorithm and stripped and not stripped.startswith("See "):
            lines.append(stripped)
            continue
        if in_algorithm and stripped.startswith("See "):
            break
        if in_tiers and stripped.startswith("---"):
            continue
        if in_tiers and stripped.startswith("- "):
            # Convert "- FIRST_PARTY (1): desc" to table-friendly format
            lines.append(stripped)
    return "\n".join(lines)


def extract_tracker_architecture() -> str:
    """Extract tracker architecture description from store.py's docstring."""
    store_path = (
        REPO_ROOT / "packages" / "hypergumbo-tracker" / "src"
        / "hypergumbo_tracker" / "store.py"
    )
    docstring = extract_module_docstring(store_path)
    if not docstring:
        return ""
    # Return first paragraph (up to first blank line after content)
    para_lines: list[str] = []
    started = False
    for line in docstring.splitlines():
        stripped = line.strip()
        if not stripped and started:
            break
        if stripped:
            started = True
            para_lines.append(stripped)
    return " ".join(para_lines)


SCRIPT_CATEGORIES: dict[str, list[str]] = {
    "CI & Release": [
        "auto-pr", "merge-pr", "prepare-release", "release-check",
        "ci-debug", "ci-failover", "tag-release", "release",
    ],
    "Testing & Quality": [
        "smart-test", "check-package-coverage", "integration-test",
        "license-headers", "validate-agents.sh",
    ],
    "Development": [
        "dev-install", "build-source-grammars", "bump-version",
        "install-hooks", "tracker", "tracker-textconv", "loop-toggle",
        "install-embeddings", "uninstall-embeddings", "stop-hook-preview",
    ],
    "Analysis & Bakeoff": [
        "bakeoff-broad", "bakeoff-deep", "bakeoff-broad-reflect",
        "bakeoff-deep-reflect", "generate-architecture",
        "generate-schema", "analyze-artifacts", "test-leaderboard",
        "changelog-date-bucket", "compute_probe_embeddings.py",
        "hypergumbo_diag.py",
    ],
    "Contribution": ["contribute", "list-my-prs"],
}


def _extract_script_description(path: Path) -> str:
    """Extract a one-line description from a script file.

    For Python scripts: uses ast.parse to get the module docstring's first line.
    For Bash scripts: takes the first comment line after shebang and SPDX header.
    Returns "(no description)" if extraction fails.
    """
    try:
        content = path.read_text(encoding="utf-8")
    except Exception:
        return "(no description)"

    lines = content.splitlines()
    if not lines:
        return "(no description)"

    # Python script: extract module docstring via ast
    if lines[0].startswith("#!") and "python" in lines[0]:
        try:
            tree = ast.parse(content)
            docstring = ast.get_docstring(tree)
            if docstring:
                first_line = next(
                    (ln.strip() for ln in docstring.splitlines() if ln.strip()),
                    "",
                )
                return first_line or "(no description)"
        except Exception:
            pass

    # Bash script (or Python fallback): scan comment lines
    # Skip shebang, SPDX, set -euo pipefail, blank lines, dash-only lines
    skip_prefixes = ("#!/", "# SPDX", "set -")
    for line in lines:
        stripped = line.strip()
        if not stripped:
            continue
        if any(stripped.startswith(p) for p in skip_prefixes):
            continue
        if stripped.startswith("#"):
            desc = stripped.lstrip("# ").strip()
            # Skip dash-only separator lines (e.g. "# --------")
            if not desc or set(desc) <= {"-", "="}:
                continue
            # Remove "scriptname: " prefix if present
            name = path.name
            if desc.lower().startswith(name.lower() + ":"):
                desc = desc[len(name) + 1:].strip()
            elif ":" in desc:
                prefix = desc.split(":")[0]
                # Heuristic: short alphanumeric-with-dashes prefix = script name
                if (prefix.replace("-", "").replace("_", "").isalnum()
                        and len(prefix) < 30):
                    desc = desc[len(prefix) + 1:].strip()
            return desc
        # Non-comment, non-blank line — stop looking
        break

    return "(no description)"


def categorize_scripts() -> dict[str, list[tuple[str, str]]]:
    """Scan scripts/ directory and return categorized (name, description) pairs.

    Groups scripts into categories defined by SCRIPT_CATEGORIES.
    Scripts not in any category go into "Other".
    Skips __pycache__ and lib/ subdirectories.
    """
    scripts_dir = REPO_ROOT / "scripts"
    if not scripts_dir.exists():
        return {}

    # Build reverse mapping: script name -> category
    name_to_category: dict[str, str] = {}
    for category, names in SCRIPT_CATEGORIES.items():
        for name in names:
            name_to_category[name] = category

    result: dict[str, list[tuple[str, str]]] = {}
    for category in SCRIPT_CATEGORIES:
        result[category] = []

    for entry in sorted(scripts_dir.iterdir()):
        if not entry.is_file():
            continue
        if entry.name.startswith("__") or entry.name == "lib":
            continue
        category = name_to_category.get(entry.name, "Other")
        desc = _extract_script_description(entry)
        if category not in result:
            result[category] = []
        result[category].append((entry.name, desc))

    # Remove empty categories
    return {k: v for k, v in result.items() if v}


def generate_architecture_md() -> str:
    """Generate the ARCHITECTURE.md content.

    Produces a document organized around architectural understanding:
    1. Package structure and dependency hierarchy
    2. Analysis pipeline (data flow)
    3. Key concepts (output modes, supply chain, symbol resolution)
    4. Extension guides (new analyzers, linkers, patterns)
    5. Scripts & tooling (auto-generated from script headers)
    6. Module reference (auto-generated from docstrings)
    """
    print("Running hypergumbo analysis on itself...", file=sys.stderr)
    analysis = run_hypergumbo_analysis()

    categories = categorize_modules()
    top_symbols = get_top_symbols(analysis)

    # Count stats
    analyzer_count = len(categories.get("Analyzers", []))
    linker_count = len(categories.get("Linkers", []))
    core_count = len(categories.get("Core", []))
    cli_count = len(categories.get("CLI & I/O", []))
    total_modules = sum(len(v) for v in categories.values())
    lang_counts = count_language_analyzers(categories)
    linker_subcats = count_linker_subcategories(categories)
    pattern_total, conv_count, fw_count = count_framework_patterns()
    node_count = len(analysis.get("nodes", []))
    edge_count = len(analysis.get("edges", []))
    edge_types = get_edge_type_distribution(analysis)

    # Get metadata for drift detection
    commit_sha = get_git_commit_sha()
    hypergumbo_version = get_hypergumbo_version()
    python_version = platform.python_version()

    lines = [
        "# Architecture",
        "",
        "> **Auto-generated** by running hypergumbo on itself.",
        "> Sections marked with (auto) are computed at generation time; unmarked sections are curated.",
        "> Run `./scripts/generate-architecture` to update.",
        "",
        "hypergumbo is a local-first CLI that analyzes source code and emits",
        "behavior maps — JSON graphs of symbols, call edges, framework patterns,",
        "and cross-language links. It supports three output modes: a Markdown sketch",
        "for human reading, a full JSON behavior map for tooling, and graph slices",
        "for focused LLM context.",
        "",
        "## Self-Analysis Summary (auto)",
        "",
        f"hypergumbo analyzed its own source code and found:",
        (
            f"- **{total_modules}** Python modules ({analyzer_count} analyzers, "
            f"{linker_count} linkers across four subcategories per "
            f"[ADR-0003-ext](adr/0003-linker-subcategory-restoration.md) — "
            f"Protocol {linker_subcats['Protocol']}, "
            f"Bridge {linker_subcats['Bridge']}, "
            f"Framework {linker_subcats['Framework']}, "
            f"Infrastructure {linker_subcats['Infrastructure']}"
            + (
                f", Uncategorized {linker_subcats['Uncategorized']} "
                f"(missing subcategory declaration in module docstring)"
                if linker_subcats["Uncategorized"] > 0
                else ""
            )
            + f"; {core_count} core, {cli_count} CLI, "
            f"{len(categories.get('Tracker', []))} tracker)"
        ),
        f"- **{node_count}** symbols (functions, classes, methods)",
        f"- **{edge_count}** edges by type:",
    ]

    # Add edge type breakdown
    for edge_type, count in list(edge_types.items())[:6]:  # Top 6 types
        lines.append(f"  - {edge_type}: {count}")
    if len(edge_types) > 6:
        other_count = sum(c for t, c in list(edge_types.items())[6:])
        lines.append(f"  - other: {other_count}")

    # ── Package Architecture ──────────────────────────────────────
    mainstream_n = lang_counts.get("mainstream", 0)
    common_n = lang_counts.get("common", 0)
    extended1_n = lang_counts.get("extended1", 0)
    lines.extend([
        "",
        "## Package Architecture",
        "",
        "The codebase is a Python monorepo with six packages arranged in a strict",
        "dependency hierarchy. The separation enforces layering: language analyzers",
        "depend on core but not on each other, and the tracker is fully independent.",
        "",
        "```",
        "                      hypergumbo (meta-package)",
        "                    /       |       \\",
        "                   v        v        v",
        f"  lang-mainstream   lang-common   lang-extended1",
        f"  ({mainstream_n} analyzers)   ({common_n} analyzers)   ({extended1_n} analyzers)",
        "                   \\       |       /",
        "                    v      v      v",
        "                   hypergumbo-core",
        "           (IR, CLI, linkers, patterns,",
        "            ranking, discovery, sketch)",
        "",
        "  hypergumbo-tracker  (independent)",
        "  (governance TUI, op-log store,",
        "   CRDT-like merge, SQLite cache)",
        "```",
        "",
        "| Package | Role |",
        "|---------|------|",
        "| **hypergumbo-core** | IR types (`Symbol`, `Edge`, `Span`), CLI, analysis base classes, "
        f"{linker_count} linkers (Protocol / Bridge / Framework / Infrastructure — ADR-0003-ext), "
        f"{pattern_total} YAML pattern files, sketch/slice output, "
        "supply chain classification, symbol resolution, ranking |",
        f"| **hypergumbo-lang-mainstream** | {mainstream_n} tree-sitter analyzers for widely-used languages "
        "(Python, JS/TS, Java, Go, Rust, C/C++, Ruby, PHP, C#, Kotlin, Swift, Scala, etc.) |",
        f"| **hypergumbo-lang-common** | {common_n} analyzers for domain-specific and functional languages "
        "(Haskell, Elixir, OCaml, Dart, Julia, CUDA, GraphQL, HCL, etc.) |",
        f"| **hypergumbo-lang-extended1** | {extended1_n} analyzers for specialized languages "
        "(Zig, Odin, Solidity, Verilog, VHDL, Agda, Lean, Wolfram, etc.) |",
        "| **hypergumbo** | Meta-package that installs core + all language packages |",
        "| **hypergumbo-tracker** | Standalone governance tool with TUI, YAML-backed op-log store, "
        "Lamport-clock ordering, and optional embedding-based dedup |",
        "",
    ])

    # ── Analysis Pipeline ─────────────────────────────────────────
    lines.extend([
        "## Analysis Pipeline",
        "",
        "The CLI's `run_behavior_map()` function orchestrates the full pipeline:",
        "",
        "```",
        "Source Files",
        "     │",
        "     ▼",
        "┌─────────────────────────────────────────────────────────────────┐",
        "│                        1. DISCOVERY                             │",
        "│  Find files, classify into supply chain tiers (1-4),            │",
        "│  apply .gitignore + exclude patterns                            │",
        "└─────────────────────────────────────────────────────────────────┘",
        "     │",
        "     ▼",
        "┌─────────────────────────────────────────────────────────────────┐",
        "│                         2. PROFILE                              │",
        "│  Detect languages (by file extension)                           │",
        "│  Detect frameworks (by manifest markers, scoped to languages)   │",
        "└─────────────────────────────────────────────────────────────────┘",
        "     │",
        "     ▼",
        "┌─────────────────────────────────────────────────────────────────┐",
        "│                        3. ANALYZERS                             │",
        "│  Per-language tree-sitter parsing (two-pass architecture):      │",
        "│    Pass 1: Extract symbols from AST nodes                       │",
        "│    Pass 2: Resolve calls/imports against global symbol registry │",
        f"│  Output: {node_count} Symbols + {edge_count} Edges + UsageContexts".ljust(66) + "│",
        "└─────────────────────────────────────────────────────────────────┘",
        "     │",
        "     ▼",
        "┌─────────────────────────────────────────────────────────────────┐",
        "│                     4. PATTERN ENRICHMENT                       │",
        "│  YAML-driven pattern matching (ADR-0003):                       │",
        f"│  - {conv_count} convention patterns (always loaded)".ljust(66) + "│",
        f"│  - {fw_count} framework patterns (loaded when framework detected)".ljust(66) + "│",
        "│  Output: Symbols enriched with meta.concepts                    │",
        "└─────────────────────────────────────────────────────────────────┘",
        "     │",
        "     ▼",
        "┌─────────────────────────────────────────────────────────────────┐",
        "│                        5. LINKERS                               │",
        "│  Tier 2 edge recovery (ADR-0003-ext — Protocol / Bridge /       │",
        "│  Framework / Infrastructure). Match via meta.concepts and       │",
        "│  symbol metadata across files and language boundaries.          │",
        (
            f"│  {linker_count} linkers: "
            f"P{linker_subcats['Protocol']} / "
            f"B{linker_subcats['Bridge']} / "
            f"F{linker_subcats['Framework']} / "
            f"I{linker_subcats['Infrastructure']} "
            "(HTTP, JNI, gRPC, React, ...)"
        ).ljust(66) + "│",
        "└─────────────────────────────────────────────────────────────────┘",
        "     │",
        "     ▼",
        "┌─────────────────────────────────────────────────────────────────┐",
        "│                     6. RANKING & OUTPUT                         │",
        "│  Centrality scoring, supply chain tier filtering,               │",
        "│  token-budget-aware truncation (compact mode)                   │",
        "└─────────────────────────────────────────────────────────────────┘",
        "                          │",
        "                          ▼",
        "          ┌───────────────┼───────────────┐",
        "          ▼               ▼               ▼",
        "    ┌──────────┐   ┌──────────┐   ┌──────────┐",
        "    │  sketch  │   │   run    │   │  slice   │",
        "    │ Markdown │   │   JSON   │   │ subgraph │",
        "    └──────────┘   └──────────┘   └──────────┘",
        "```",
        "",
    ])

    # ── Output Modes ──────────────────────────────────────────────
    lines.extend([
        "## Output Modes",
        "",
        "| Mode | Format | Purpose |",
        "|------|--------|---------|",
        "| **`sketch`** | Markdown | Token-budgeted overview of repo structure and key symbols. "
        "Designed for human reading and LLM context windows. Default output mode. |",
        "| **`run`** | JSON | Full behavior map with all symbols, edges, and metadata. "
        "Used by downstream tools, CI checks, and the tracker. |",
        "| **`slice`** | JSON | Subgraph extraction from an entry point (forward or reverse). "
        "Produces focused dependency/dependents view for a specific symbol. |",
        "",
    ])

    # ── Supply Chain Tiers ────────────────────────────────────────
    lines.extend([
        "## Supply Chain Tiers",
        "",
        "Files are classified into tiers at discovery time (before analysis)",
        "to prioritize first-party code and filter noise:",
        "",
        "| Tier | Name | Examples |",
        "|------|------|----------|",
        "| **1** | First-party | Project source code (`src/`, `lib/`, `app/`) |",
        "| **2** | Internal dep | Monorepo packages, examples, tests |",
        "| **3** | External dep | `node_modules/`, `vendor/`, vendored SDKs |",
        "| **4** | Derived | Build artifacts, transpiled output (`dist/`, `build/`, `*.min.js`) |",
        "",
        "Classification uses first-match-wins: derived artifacts (tier 4) are checked first,",
        "then external deps (tier 3), then internal (tier 2), and remaining files default to",
        "first-party (tier 1). The `--first-party-only` flag restricts analysis to tier 1.",
        "",
    ])

    # ── Tree-sitter Infrastructure ────────────────────────────────
    lines.extend([
        "## Tree-sitter Infrastructure",
        "",
        "All language analyzers inherit from `TreeSitterAnalyzer` (`analyze/base.py`),",
        "which provides a universal two-pass architecture:",
        "",
        "1. **Pass 1 (symbol extraction):** Parse each file with tree-sitter, walk the AST,",
        "   extract symbols (functions, classes, methods, etc.) with metadata",
        "2. **Pass 2 (edge resolution):** Re-walk ASTs, resolve calls and imports against",
        "   the global symbol registry built in pass 1",
        "",
        "Grammars come from two sources:",
        f"- **PyPI packages** (most languages): installed via `pip` as `tree-sitter-<lang>` dependencies",
        "- **Build-from-source** (Lean, Wolfram, etc.): compiled by `scripts/build-source-grammars`",
        "  when the PyPI grammar is unavailable or incompatible",
        "",
    ])

    # ── Symbol Resolution ─────────────────────────────────────────
    lines.extend([
        "## Symbol Resolution",
        "",
        "Linkers match symbols across files and languages using `NameResolver`",
        "(`symbol_resolution.py`), which provides tiered matching with confidence levels:",
        "",
        "| Strategy | Confidence | When used |",
        "|----------|-----------|-----------|",
        "| Exact | 1.0 | Direct key match in symbol registry |",
        "| Path hint | 0.90 | Disambiguate using import path (Go-style) |",
        "| Suffix | 0.85 | Match `MyClass.doWork` for lookup `doWork` |",
        "| Ambiguous | 0.70 | Multiple candidates, picked heuristically |",
        "",
        "The suffix index is built lazily on first fuzzy lookup, not upfront.",
        "Confidence scores propagate to edges, enabling downstream consumers to",
        "filter by reliability.",
        "",
    ])

    # ── Key Abstractions ──────────────────────────────────────────
    ir_abstractions = extract_ir_abstractions()
    lines.extend([
        "## Key Abstractions",
        "",
    ])
    if ir_abstractions:
        lines.append(ir_abstractions)
    lines.append("")

    # ── Most-Connected Symbols ────────────────────────────────────
    if top_symbols:
        lines.extend([
            "## Most-Connected Symbols (auto)",
            "",
            "These symbols have the highest bidirectional centrality",
            "(`score = in_degree * (1 + ln(1 + out_degree))`):",
            "",
            "| Symbol | Kind | Score | Location |",
            "|--------|------|-------|----------|",
        ])
        for sym in top_symbols[:15]:
            path = Path(sym["path"]).name if sym["path"] else ""
            lines.append(f"| `{sym['name']}` | {sym['kind']} | {sym['score']:.1f} | {path} |")
        lines.append("")

    # ── Pattern System ────────────────────────────────────────────
    lines.extend([
        "## Pattern System",
        "",
        "### Key Components",
        "",
        "- **`framework_patterns.py`**: Loads and applies YAML pattern files",
        f"- **`frameworks/*.yaml`**: {pattern_total} pattern files ({conv_count} convention + {fw_count} framework)",
        "- **`meta.concepts`**: List of matched concepts (single source of truth)",
        "- **`meta.decorators`/`meta.annotations`**: Raw metadata for pattern matching",
        "",
        "### meta.concepts Structure",
        "",
        "Enriched symbols have a `meta.concepts` list:",
        "",
        "```json",
        '{',
        '  "meta": {',
        '    "concepts": [',
        '      {"concept": "route", "path": "/users", "method": "GET", "framework": "fastapi"},',
        '      {"concept": "test_function", "framework": "test-frameworks"}',
        '    ]',
        '  }',
        '}',
        "```",
        "",
        "Linkers and entrypoint detection use `meta.concepts` exclusively.",
        "",
        "### Adding a New Pattern",
        "",
        "**Framework pattern** (loaded when framework detected):",
        "1. Create `packages/hypergumbo-core/src/hypergumbo_core/frameworks/<framework>.yaml`",
        "2. Add `linkers:` section to enable relevant linkers",
        "3. Add tests in `packages/hypergumbo-core/tests/test_framework_patterns.py`",
        "",
        "**Convention pattern** (always loaded):",
        "1. Edit existing convention file or create new one",
        "2. Use `language: multi` for cross-language patterns",
        "3. Add to `enrich_symbols()` load list in `framework_patterns.py`",
        "",
        "Example patterns:",
        "",
        "**Definition-based (decorators/annotations):**",
        "```yaml",
        "id: myframework",
        "language: python",
        "",
        "patterns:",
        "  - concept: route",
        '    decorator: "^myapp\\\\.(get|post|put|delete)$"',
        '    extract_path: "args[0]"',
        '    extract_method: "decorator_suffix"',
        "```",
        "",
        "**Convention-based (symbol_name + symbol_kind + language):**",
        "```yaml",
        "id: test-frameworks",
        "language: multi",
        "",
        "patterns:",
        "  - concept: test_function",
        '    symbol_name: "^test_"',
        '    symbol_kind: "^function$"',
        '    language: "^python$"',
        "```",
        "",
    ])

    # ── Tracker Subsystem ─────────────────────────────────────────
    tracker_desc = extract_tracker_architecture()
    lines.extend([
        "## Tracker Subsystem",
        "",
        "The `hypergumbo-tracker` package is an independent governance tool for",
        "managing work items, invariants, and project state. Key design choices:",
        "",
        "- **Op-log store:** Items are append-only YAML op logs, not mutable records.",
        "  `compile()` folds the log into current state (LWW for scalars, accumulation for sets).",
        "- **Lamport clock:** Cross-branch causal ordering via git object timestamps.",
        "- **Multi-tier views:** `TrackerSet` provides a unified view over canonical,",
        "  workspace, and stealth stores.",
        "- **SQLite cache:** Read-hot path uses a SQLite cache (`Cache`) that rebuilds",
        "  from the op-log on invalidation.",
        "- **Proquint IDs:** Content-hash IDs (SHA-256 + proquint encoding) for",
        "  natural deduplication — same logical item always gets the same ID.",
        "- **TUI:** Textual-based terminal UI (`TrackerApp`) for interactive browsing,",
        "  filtering, and discussion.",
        "",
    ])

    # ── Scripts & Tooling ─────────────────────────────────────────
    script_categories = categorize_scripts()
    if script_categories:
        lines.extend([
            "## Scripts & Tooling (auto)",
            "",
            "The `scripts/` directory contains operational tooling. "
            "Descriptions are extracted from each script's header comment or docstring.",
            "",
        ])
        for category, scripts in script_categories.items():
            lines.append(f"### {category}")
            lines.append("")
            lines.append("| Script | Description |")
            lines.append("|--------|-------------|")
            for name, desc in scripts:
                lines.append(f"| `{name}` | {desc} |")
            lines.append("")

    # ── Extension Guides ──────────────────────────────────────────
    lines.extend([
        "## Adding a New Analyzer",
        "",
        "1. Create analyzer in the appropriate lang package:",
        "   - Mainstream: `packages/hypergumbo-lang-mainstream/src/hypergumbo_lang_mainstream/<language>.py`",
        "   - Common: `packages/hypergumbo-lang-common/src/hypergumbo_lang_common/<language>.py`",
        "   - Extended1: `packages/hypergumbo-lang-extended1/src/hypergumbo_lang_extended1/<language>.py`",
        "2. Implement `analyze(root: Path) -> AnalysisResult`",
        "3. Return symbols and edges following IR conventions",
        "4. Add tests in the package's `tests/` directory",
        "5. Register in the package's `__init__.py` ANALYZER_SPECS",
        "",
    ])

    # Adding a New Linker (auto-generated from registry.py docstring)
    linker_howto = extract_linker_howto()
    lines.extend([
        "## Adding a New Linker",
        "",
        "Per [ADR-0003-ext](adr/0003-linker-subcategory-restoration.md), the first "
        "line of every linker module's docstring must declare its subcategory in the "
        "form `\"\"\"<Protocol|Bridge|Framework|Infrastructure> linker: <one-line purpose>.`",
        "",
    ])
    lines.append(linker_howto)
    lines.append("")

    # ── Module Reference ──────────────────────────────────────────
    lines.extend([
        "## Module Reference (auto)",
        "",
    ])

    for category, mods in categories.items():
        if not mods:
            continue
        lines.append(f"### {category}")
        lines.append("")

        for name, docstring in mods:
            # Extract first non-empty line of docstring
            if docstring:
                first_line = next(
                    (ln.strip() for ln in docstring.splitlines() if ln.strip()),
                    "(no docstring)"
                )
                if len(first_line) > 70:
                    first_line = first_line[:67] + "..."
            else:
                first_line = "(no docstring)"

            lines.append(f"- **`{name}`**: {first_line}")

        lines.append("")

    # ── Generation Metadata ──────────────────────────────────────
    lines.extend([
        "---",
        "",
        "<!--",
        "GENERATION METADATA (for drift detection):",
        f"  commit: {commit_sha or 'unknown'}",
        f"  hypergumbo: {hypergumbo_version}",
        f"  python: {python_version}",
        "-->",
    ])

    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate ARCHITECTURE.md")
    parser.add_argument("--check", action="store_true", help="Check if docs are up-to-date")
    args = parser.parse_args()

    output_path = REPO_ROOT / "docs" / "ARCHITECTURE.md"

    if args.check:
        if not output_path.exists():
            print("ERROR: docs/ARCHITECTURE.md does not exist")
            print("Run: ./scripts/generate-architecture")
            return 1

        # Light check: verify file exists and has auto-generated markers
        # Full content comparison is not reliable across environments because
        # hypergumbo output can vary by Python version, tree-sitter builds, etc.
        content = output_path.read_text(encoding="utf-8")
        if "Auto-generated" not in content:
            print("ERROR: docs/ARCHITECTURE.md doesn't appear to be auto-generated")
            return 1
        if not re.search(r"commit:\s+[0-9a-f]{6,}", content):
            print("ERROR: docs/ARCHITECTURE.md is missing commit hash")
            return 1

        # Check for commit SHA drift (warn-only, not a hard failure)
        # This helps detect when docs may be stale relative to code changes
        current_sha = get_git_commit_sha()
        if current_sha:
            sha_match = re.search(r"commit:\s*(\w+)", content)
            if sha_match:
                doc_sha = sha_match.group(1)
                if doc_sha != current_sha:
                    print(f"WARNING: docs generated at commit {doc_sha}, current HEAD is {current_sha}")
                    print("Consider regenerating: ./scripts/generate-architecture")
            else:
                print("WARNING: could not extract commit SHA from ARCHITECTURE.md")

        print("OK: docs/ARCHITECTURE.md exists and appears valid")
        return 0

    generated = generate_architecture_md()
    output_path.write_text(generated, encoding="utf-8")
    print(f"Generated {output_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

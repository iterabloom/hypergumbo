#!/usr/bin/env python3
"""
Reflective analysis of bakeoff artifacts.

This script asks open-ended qualitative questions about hypergumbo's performance.
Run it REPEATEDLY - the value is in the variation of insights across cycles.

Philosophy:
- Diverse ways of asking related questions each time improves the robustness
  and flexibility of hypergumbo
- Qualitative assessments, not just metrics
- "Needs work" vs "doing something special" framing
- Designed to surface non-obvious patterns through varied questioning angles
- Journal stratum forces review of lab notebook entries and longitudinal analysis

What "doing something special" means:
- Genuinely valuable insights other tools miss (cross-file resolution, framework patterns)
- Helping developers/agents understand "what happens when X" across boundaries
- NOT: novelty for its own sake, impressive-looking but useless metrics

What "needs work" means:
- Missing patterns that users would actually care about
- Failing to connect things that are obviously related
- NOT: missing obscure edge cases nobody encounters

Usage:
    ./scripts/bakeoff-reflect /path/to/bakeoff/out/cohort-N/iter-N
    ./scripts/bakeoff-reflect --cycle 3  # Record which reflection cycle this is
"""

import json
import sys
from pathlib import Path
from collections import defaultdict
import random


def load_hg(repo_dir: Path) -> dict | None:
    """Load hg.json for a repo."""
    hg_path = repo_dir / "hg.json"
    if not hg_path.exists():
        return None
    with open(hg_path) as f:
        return json.load(f)


def analyze_repo(repo_name: str, hg: dict) -> dict:
    """Produce qualitative analysis of a single repo."""
    nodes = hg.get("nodes", [])
    edges = hg.get("edges", [])

    # Basic counts
    node_count = len(nodes)
    edge_by_type = defaultdict(list)
    for e in edges:
        # Note: field is "type", not "edge_type" in serialized form
        edge_by_type[e.get("type", "unknown")].append(e)

    calls = edge_by_type.get("calls", [])
    imports = edge_by_type.get("imports", [])

    # Compute metrics
    # Unresolved calls have :unresolved or :external or ? in dst
    resolved_calls = [c for c in calls
                      if ":unresolved" not in c.get("dst", "")
                      and ":external" not in c.get("dst", "")
                      and "?" not in c.get("dst", "?")]
    cross_file_calls = [c for c in resolved_calls
                        if c.get("src", "").split(":")[1] != c.get("dst", "").split(":")[1]]

    analysis = {
        "repo": repo_name,
        "nodes": node_count,
        "calls": len(calls),
        "resolved_calls": len(resolved_calls),
        "cross_file_calls": len(cross_file_calls),
        "imports": len(imports),
        "other_edges": {k: len(v) for k, v in edge_by_type.items() if k not in ("calls", "imports")},
        "concerns": [],
        "strengths": [],
    }

    # Qualitative assessments

    # Concern: Nodes but no calls
    if node_count > 5 and len(calls) == 0:
        analysis["concerns"].append({
            "type": "NO_CALL_EDGES",
            "description": f"Has {node_count} nodes but 0 call edges",
            "hypothesis": "Callback/anonymous function pattern not captured, or declarative-only code",
            "severity": "HIGH",
        })

    # Concern: Very low resolution rate
    if len(calls) > 10:
        resolution_rate = len(resolved_calls) / len(calls) if calls else 0
        if resolution_rate < 0.3:
            analysis["concerns"].append({
                "type": "LOW_RESOLUTION",
                "description": f"Only {resolution_rate:.1%} of calls resolved",
                "hypothesis": "Heavy external dependencies OR missing analyzer patterns",
                "severity": "MEDIUM",
            })

    # Concern: Low cross-file ratio (isolated analysis)
    if len(resolved_calls) > 20:
        cross_file_ratio = len(cross_file_calls) / len(resolved_calls)
        if cross_file_ratio < 0.2:
            analysis["concerns"].append({
                "type": "LOW_CROSS_FILE",
                "description": f"Only {cross_file_ratio:.1%} of resolved calls are cross-file",
                "hypothesis": "Import resolution may be incomplete",
                "severity": "LOW",
            })

    # Strength: High cross-file resolution
    if len(resolved_calls) > 20:
        cross_file_ratio = len(cross_file_calls) / len(resolved_calls)
        if cross_file_ratio > 0.5:
            analysis["strengths"].append({
                "type": "STRONG_CROSS_FILE",
                "description": f"{cross_file_ratio:.1%} cross-file resolution",
                "insight": "Module/import system well understood",
            })

    # Strength: Rich edge types
    interesting_edges = [k for k in edge_by_type.keys()
                         if k not in ("calls", "imports") and len(edge_by_type[k]) > 0]
    if interesting_edges:
        analysis["strengths"].append({
            "type": "RICH_EDGE_TYPES",
            "description": f"Beyond basic calls/imports: {', '.join(interesting_edges)}",
            "insight": "Framework-specific or cross-language patterns detected",
        })

    # Strength: High resolution with substantial calls
    if len(calls) > 50 and len(resolved_calls) / len(calls) > 0.8:
        analysis["strengths"].append({
            "type": "HIGH_RESOLUTION",
            "description": f"{len(resolved_calls)}/{len(calls)} calls resolved ({len(resolved_calls)/len(calls):.1%})",
            "insight": "Strong internal call graph",
        })

    return analysis


# 70+ open-ended questions organized by theme but phrased diversely.
# Each run picks 3 at random. The diversity of phrasing ensures different
# angles of inquiry surface across cycles, improving hypergumbo's robustness.
REFLECTION_QUESTIONS = [
    # --- Missing patterns ---
    "What patterns in the source code are we systematically missing?",
    "If a junior developer looked at this output, what obvious connections would they expect to see?",
    "Which function call patterns are invisible to the current analyzers?",
    "Are there idioms in this language that produce calls the AST walk doesn't capture?",
    "What would a grep for 'TODO' or 'FIXME' in the source reveal that the call graph misses?",
    "If you traced execution manually from main(), where does the call graph diverge from reality?",
    "What string-based dispatch patterns (registry lookups, event names, URL routing) are we blind to?",
    "Which decorator or annotation patterns create implicit relationships we don't model?",
    "Are there factory or builder patterns that produce objects whose method calls we can't resolve?",
    "What configuration-driven behavior (YAML/JSON/env vars) creates edges we'll never see in code?",

    # --- Edge types ---
    "Are there edge types we should be detecting but aren't?",
    "What relationship between two symbols would most surprise a developer to learn about?",
    "If we added a 'depends_on_config' edge type, which repos would light up?",
    "What edges exist in the developer's mental model that are absent from ours?",
    "Could we detect 'tested_by' edges from test files to production code? How valuable would that be?",
    "Are 'implements' edges between interfaces and concrete classes consistently captured?",
    "What pub/sub or event-driven edges exist that we model as disconnected components?",
    "Would 'co-changes' edges (files that change together in git history) add value?",
    "Are there data-flow edges (variable assignment chains) worth modeling beyond call edges?",
    "What cross-boundary edges (API calls, IPC, message queues) are we missing entirely?",

    # --- Language performance ---
    "Which languages have unexpectedly low or high performance?",
    "For each language in this cohort, what's the ratio of symbols extracted to lines of code?",
    "Which language's analyzer produces the richest metadata per symbol?",
    "Are there languages where the call graph is suspiciously sparse relative to code complexity?",
    "Which language handles nested/anonymous functions best? Which handles them worst?",
    "If we compared Python and Ruby analysis quality side by side, who wins and why?",
    "Is there a language where resolution rate drops dramatically for larger files?",
    "Which language's import resolution is weakest? What specific import patterns break it?",
    "How does Go's package-based resolution compare to Java's class-based resolution in practice?",
    "Are there languages where our framework detection is strong but basic call resolution is weak?",

    # --- User needs ---
    "What would a user WANT to see in the behavior map that's missing?",
    "If a developer asked 'what happens when I call this endpoint?', could we answer from the graph?",
    "What question would a new team member ask that our output can't answer?",
    "If you were onboarding onto this codebase, what would the behavior map need to show you?",
    "What's the most common developer task (debug, refactor, add feature) and does our output help?",
    "Would a user care more about call depth or call breadth? Do we optimize for the right one?",
    "If we ranked functions by 'how risky is it to change this?', would our centrality match intuition?",
    "What's the gap between what symbols.txt shows and what a developer needs for a code review?",
    "Could our output help with 'what's the blast radius of changing this function?'",
    "If a security auditor used our output, what attack surfaces would they miss?",

    # --- Over-engineering ---
    "Are we over-engineering some detections while missing simpler ones?",
    "Which of our edge types has the worst signal-to-noise ratio?",
    "Is there a detection that's technically impressive but practically useless?",
    "Are we spending analyzer time on patterns that appear in <1% of real repos?",
    "What's the simplest possible improvement that would help the most repos?",
    "If we could only keep 3 edge types, which 3 would maximize usefulness?",
    "Are we detecting framework patterns for frameworks nobody actually uses?",
    "Is our metadata schema too rich? Would a simpler schema serve users better?",
    "Are there places where 'good enough' resolution would be more useful than perfect resolution?",
    "What would we delete from the output if we had to cut it in half?",

    # --- Cross-language ---
    "What cross-language patterns exist that we're not linking?",
    "In a polyglot repo, what's the most important boundary to get right?",
    "How would a Python service calling a Go microservice appear in our output?",
    "If TypeScript frontend calls a Ruby backend API, do we model that connection?",
    "What FFI (Foreign Function Interface) patterns create cross-language edges?",
    "Are there shared data models (protobuf, GraphQL, OpenAPI) that should unify symbols across languages?",
    "In a monorepo with JS frontend and Python backend, what's the glue we're missing?",
    "How well do our linkers handle the case where language A generates code that language B consumes?",
    "What cross-language test patterns (e.g., Python integration tests for a Rust library) should we detect?",
    "If two languages share a database, how should that shared dependency appear?",

    # --- Cohort variation ---
    "How would the analysis change if we ran on a different cohort?",
    "Which repo in this cohort is most 'typical' of real-world code? Which is least?",
    "Are our metrics biased by the repo sizes in this cohort?",
    "If we analyzed only repos with >100 files, would our concerns change?",
    "What kind of repo would maximally stress our analyzers? Have we tested one like that?",
    "Is there a repo archetype (CLI tool, web app, library, microservice) we haven't tested?",
    "Would our analysis look different on a Fortune 500 enterprise monorepo vs an OSS library?",
    "Are there repos where our analysis is actively misleading rather than just incomplete?",
    "What's the smallest repo where our analysis adds genuine value over just reading the code?",
    "If we ran on the top 10 GitHub repos by stars, what would embarrass us?",

    # --- Provocative / speculative ---
    "What would a competing tool do better with the same AST information?",
    "If we had access to runtime traces, what would change most dramatically?",
    "What's the biggest lie our call graph tells about this codebase?",
    "If we showed this output to the repo maintainer, what would they correct first?",
    "What assumption baked into our IR is most likely to be wrong for unusual codebases?",
    "Is there a repo where ZERO edges would be more honest than what we currently produce?",
    "What would break if we doubled the number of symbols we extract?",
    "Are we building a microscope when users need a telescope (or vice versa)?",
]

# Questions that induce review of lab notebook entries and longitudinal analysis.
# Each run picks 1 from this stratum IN ADDITION to the 3 from the main pool.
# The goal: force the reflect cycle to connect current findings to prior observations,
# surface recurring themes, and detect regressions or improvements over time.
JOURNAL_QUESTIONS = [
    # --- Reviewing recent entries ---
    "Review the most recent lab notebook entry. What finding from that session is most relevant to this cohort's results?",
    "Look at the last 3 notebook entries. Is there a concern that keeps showing up? If so, has it gotten better or worse?",
    "What hypothesis from a previous notebook entry could this cohort's data confirm or refute?",
    "Find the most recent 'Hypotheses' section in the lab notebook. Which hypothesis has the most evidence for or against it now?",
    "Read the last notebook's 'Key Findings' section. Do any of those findings contradict what you see in this cohort?",

    # --- Longitudinal patterns ---
    "Compare this cohort's edge density distribution to any prior cohort documented in the notebook. Is the trend improving?",
    "Has the set of 'inactive linkers' (linkers producing 0 edges) changed across notebook entries? Which ones came alive?",
    "Look at resolution rates across notebook sessions. Is there a language whose resolution rate is consistently low?",
    "Across all documented bakeoff sessions, which concern type (NO_CALL_EDGES, LOW_RESOLUTION, etc.) appears most often?",
    "Review concept coverage trends in the notebook. Are we enriching more symbols over time, or has coverage plateaued?",

    # --- Connecting experiments to outcomes ---
    "What code change documented in the CHANGELOG most recently should have affected this cohort's results? Did it?",
    "Is there an analysis script (08-14) whose output on this cohort would directly test a notebook hypothesis?",
    "What experiment or fix from a prior session was supposed to improve results for repos like these? Verify it did.",
    "Look at the 'Process Retrospective' from the last notebook entry. Are you following or ignoring its advice?",
    "What question from a prior reflect cycle went unanswered? Can this cohort's data answer it now?",
]


def generate_reflection(analyses: list[dict], cycle: int) -> str:
    """Generate a qualitative reflection on the cohort."""
    lines = []
    lines.append(f"# Bakeoff Reflection - Cycle {cycle}")
    lines.append("")
    lines.append("*What is hypergumbo doing well? Where does it need work?*")
    lines.append("")

    # Aggregate concerns and strengths
    all_concerns = []
    all_strengths = []
    for a in analyses:
        for c in a["concerns"]:
            c["repo"] = a["repo"]
            all_concerns.append(c)
        for s in a["strengths"]:
            s["repo"] = a["repo"]
            all_strengths.append(s)

    # Group by type
    concerns_by_type = defaultdict(list)
    for c in all_concerns:
        concerns_by_type[c["type"]].append(c)

    strengths_by_type = defaultdict(list)
    for s in all_strengths:
        strengths_by_type[s["type"]].append(s)

    lines.append("## Where Hypergumbo Needs Work")
    lines.append("")
    if not concerns_by_type:
        lines.append("*No significant concerns detected in this cohort.*")
    else:
        for concern_type, concerns in sorted(concerns_by_type.items(), key=lambda x: -len(x[1])):
            lines.append(f"### {concern_type} ({len(concerns)} repos)")
            for c in concerns:
                lines.append(f"- **{c['repo']}**: {c['description']}")
                lines.append(f"  - Hypothesis: {c['hypothesis']}")
            lines.append("")

    lines.append("## Where Hypergumbo Is Doing Something Special")
    lines.append("")
    if not strengths_by_type:
        lines.append("*No particular strengths stood out in this cohort.*")
    else:
        for strength_type, strengths in sorted(strengths_by_type.items(), key=lambda x: -len(x[1])):
            lines.append(f"### {strength_type} ({len(strengths)} repos)")
            for s in strengths:
                lines.append(f"- **{s['repo']}**: {s['description']}")
                lines.append(f"  - Insight: {s['insight']}")
            lines.append("")

    # Add open-ended questions for next cycle
    lines.append("## Questions for This Cycle")
    lines.append("")
    # Pick 3 random questions from the main pool
    for q in random.sample(REFLECTION_QUESTIONS, min(3, len(REFLECTION_QUESTIONS))):
        lines.append(f"- {q}")
    lines.append("")

    # Pick 1 random question from the journal stratum
    lines.append("## Journal Review Question")
    lines.append("")
    lines.append(f"- {random.choice(JOURNAL_QUESTIONS)}")
    lines.append("")

    lines.append("---")
    lines.append("*Run this script again. Different questions surface different insights.*")

    return "\n".join(lines)


def main():
    import argparse
    parser = argparse.ArgumentParser(description="Reflective bakeoff analysis")
    parser.add_argument("out_dir", type=Path, help="Path to bakeoff output directory")
    parser.add_argument("--cycle", type=int, default=1, help="Reflection cycle number")
    args = parser.parse_args()

    if not args.out_dir.exists():
        print(f"Error: {args.out_dir} does not exist", file=sys.stderr)
        sys.exit(1)

    # Find all repos
    analyses = []
    for repo_dir in sorted(args.out_dir.iterdir()):
        if not repo_dir.is_dir():
            continue
        hg = load_hg(repo_dir)
        if hg is None:
            continue
        analysis = analyze_repo(repo_dir.name, hg)
        analyses.append(analysis)

    if not analyses:
        print(f"No hg.json files found in {args.out_dir}", file=sys.stderr)
        sys.exit(1)

    reflection = generate_reflection(analyses, args.cycle)
    print(reflection)


if __name__ == "__main__":
    main()

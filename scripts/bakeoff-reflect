#!/usr/bin/env python3
"""
bakeoff-reflect - LLM-driven parse correctness assessment for BROAD bakeoff

This script generates structured assessment prompts for LLM agents to evaluate
whether hypergumbo correctly parses and represents codebases. It mirrors the
architecture of bakeoff-features-reflect (DEEP) but focuses on parse correctness
rather than feature usefulness.

Two-phase pipeline:
  1. reflect (default) — generates per-repo prompt files with a fixed assessment
     protocol plus stratified random questions from the 74-question pool
  2. aggregate — reads assessment YAML files, deduplicates and frequency-ranks
     findings, produces summary.yaml

The 74 main questions are organized into 8 strata (roughly 10 each). Each run
samples 1 question per stratum, guaranteeing every theme is represented while
preserving variety across runs. 15 journal questions are organized into 3 strata
(5 each); 1 is sampled per run from a randomly chosen stratum.

Usage:
    ./scripts/bakeoff-reflect                    # Generate prompts for latest session
    ./scripts/bakeoff-reflect reflect            # Same as above
    ./scripts/bakeoff-reflect aggregate          # Aggregate assessment results
    ./scripts/bakeoff-reflect --workdir PATH     # Override workdir
    ./scripts/bakeoff-reflect --iteration N      # Specific iteration

Environment:
    BAKEOFF_WORKDIR: Override workdir location
"""

import argparse
import datetime
import json
import os
import random
import sys
from pathlib import Path

DEFAULT_BAKEOFF_DIR = os.path.expanduser(
    "~/hypergumbo_lab_notebook/bakeoff_artifacts"
)
LAB_NOTEBOOK_DIR = os.path.expanduser("~/hypergumbo_lab_notebook")

# ---------------------------------------------------------------------------
# Stratified question pools
# ---------------------------------------------------------------------------

# 8 strata of main questions (~10 each). Each run samples 1 per stratum.
STRATA = {
    "missing_patterns": [
        "What patterns in the source code are we systematically missing?",
        "If a junior developer looked at this output, what obvious connections would they expect to see?",
        "Which function call patterns are invisible to the current analyzers?",
        "Are there idioms in this language that produce calls the AST walk doesn't capture?",
        "What would a grep for 'TODO' or 'FIXME' in the source reveal that the call graph misses?",
        "If you traced execution manually from main(), where does the call graph diverge from reality?",
        "What string-based dispatch patterns (registry lookups, event names, URL routing) are we blind to?",
        "Which decorator or annotation patterns create implicit relationships we don't model?",
        "Are there factory or builder patterns that produce objects whose method calls we can't resolve?",
        "What configuration-driven behavior (YAML/JSON/env vars) creates edges we'll never see in code?",
    ],
    "edge_types": [
        "Are there edge types we should be detecting but aren't?",
        "What relationship between two symbols would most surprise a developer to learn about?",
        "If we added a 'depends_on_config' edge type, which repos would light up?",
        "What edges exist in the developer's mental model that are absent from ours?",
        "Could we detect 'tested_by' edges from test files to production code? How valuable would that be?",
        "Are 'implements' edges between interfaces and concrete classes consistently captured?",
        "What pub/sub or event-driven edges exist that we model as disconnected components?",
        "Would 'co-changes' edges (files that change together in git history) add value?",
        "Are there data-flow edges (variable assignment chains) worth modeling beyond call edges?",
        "What cross-boundary edges (API calls, IPC, message queues) are we missing entirely?",
    ],
    "language_performance": [
        "Which languages have unexpectedly low or high performance?",
        "For each language in this cohort, what's the ratio of symbols extracted to lines of code?",
        "Which language's analyzer produces the richest metadata per symbol?",
        "Are there languages where the call graph is suspiciously sparse relative to code complexity?",
        "Which language handles nested/anonymous functions best? Which handles them worst?",
        "If we compared Python and Ruby analysis quality side by side, who wins and why?",
        "Is there a language where resolution rate drops dramatically for larger files?",
        "Which language's import resolution is weakest? What specific import patterns break it?",
        "How does Go's package-based resolution compare to Java's class-based resolution in practice?",
        "Are there languages where our framework detection is strong but basic call resolution is weak?",
    ],
    "user_needs": [
        "What would a user WANT to see in the behavior map that's missing?",
        "If a developer asked 'what happens when I call this endpoint?', could we answer from the graph?",
        "What question would a new team member ask that our output can't answer?",
        "If you were onboarding onto this codebase, what would the behavior map need to show you?",
        "What's the most common developer task (debug, refactor, add feature) and does our output help?",
        "Would a user care more about call depth or call breadth? Do we optimize for the right one?",
        "If we ranked functions by 'how risky is it to change this?', would our centrality match intuition?",
        "What's the gap between what symbols.txt shows and what a developer needs for a code review?",
        "Could our output help with 'what's the blast radius of changing this function?'",
        "If a security auditor used our output, what attack surfaces would they miss?",
    ],
    "over_engineering": [
        "Are we over-engineering some detections while missing simpler ones?",
        "Which of our edge types has the worst signal-to-noise ratio?",
        "Is there a detection that's technically impressive but practically useless?",
        "Are we spending analyzer time on patterns that appear in <1% of real repos?",
        "What's the simplest possible improvement that would help the most repos?",
        "If we could only keep 3 edge types, which 3 would maximize usefulness?",
        "Are we detecting framework patterns for frameworks nobody actually uses?",
        "Is our metadata schema too rich? Would a simpler schema serve users better?",
        "Are there places where 'good enough' resolution would be more useful than perfect resolution?",
        "What would we delete from the output if we had to cut it in half?",
    ],
    "cross_language": [
        "What cross-language patterns exist that we're not linking?",
        "In a polyglot repo, what's the most important boundary to get right?",
        "How would a Python service calling a Go microservice appear in our output?",
        "If TypeScript frontend calls a Ruby backend API, do we model that connection?",
        "What FFI (Foreign Function Interface) patterns create cross-language edges?",
        "Are there shared data models (protobuf, GraphQL, OpenAPI) that should unify symbols across languages?",
        "In a monorepo with JS frontend and Python backend, what's the glue we're missing?",
        "How well do our linkers handle the case where language A generates code that language B consumes?",
        "What cross-language test patterns (e.g., Python integration tests for a Rust library) should we detect?",
        "If two languages share a database, how should that shared dependency appear?",
    ],
    "cohort_variation": [
        "How would the analysis change if we ran on a different cohort?",
        "Which repo in this cohort is most 'typical' of real-world code? Which is least?",
        "Are our metrics biased by the repo sizes in this cohort?",
        "If we analyzed only repos with >100 files, would our concerns change?",
        "What kind of repo would maximally stress our analyzers? Have we tested one like that?",
        "Is there a repo archetype (CLI tool, web app, library, microservice) we haven't tested?",
        "Would our analysis look different on a Fortune 500 enterprise monorepo vs an OSS library?",
        "Are there repos where our analysis is actively misleading rather than just incomplete?",
        "What's the smallest repo where our analysis adds genuine value over just reading the code?",
        "If we ran on the top 10 GitHub repos by stars, what would embarrass us?",
    ],
    "provocative": [
        "What would a competing tool do better with the same AST information?",
        "If we had access to runtime traces, what would change most dramatically?",
        "What's the biggest lie our call graph tells about this codebase?",
        "If we showed this output to the repo maintainer, what would they correct first?",
        "What assumption baked into our IR is most likely to be wrong for unusual codebases?",
        "Is there a repo where ZERO edges would be more honest than what we currently produce?",
        "What would break if we doubled the number of symbols we extract?",
        "Are we building a microscope when users need a telescope (or vice versa)?",
    ],
    "io_and_dataflow": [
        "Which stdlib I/O functions in this repo are missing from the IO primitive catalogs?",
        "Are io_boundary tags on edges that aren't actually performing I/O?",
        "Does the access_mode annotation match what the AST context actually shows?",
        "If you traced a file write backward, would io-boundaries show the full chain?",
        "Which boundary types (fs/net/ipc/env/subprocess) are present in the source but undetected?",
        "Are there I/O operations hiding behind abstractions (ORMs, HTTP clients) that catalogs miss?",
        "Does the io_boundary tagging distinguish read from write for bidirectional operations?",
        "Would a developer find the io-boundaries output useful for understanding this repo's I/O surface?",
        "Are access_mode annotations present on the edges that matter most for understanding dataflow?",
        "What I/O patterns in this repo would require new catalog entries to detect?",
    ],
}

STRATUM_NAMES = list(STRATA.keys())

# Journal question strata (3 strata, 5 each)
JOURNAL_STRATA = {
    "reviewing_recent": [
        "Review the most recent lab notebook entry. What finding from that session is most relevant to this cohort's results?",
        "Look at the last 3 notebook entries. Is there a concern that keeps showing up? If so, has it gotten better or worse?",
        "What hypothesis from a previous notebook entry could this cohort's data confirm or refute?",
        "Find the most recent 'Hypotheses' section in the lab notebook. Which hypothesis has the most evidence for or against it now?",
        "Read the last notebook's 'Key Findings' section. Do any of those findings contradict what you see in this cohort?",
    ],
    "longitudinal_patterns": [
        "Compare this cohort's edge density distribution to any prior cohort documented in the notebook. Is the trend improving?",
        "Has the set of 'inactive linkers' (linkers producing 0 edges) changed across notebook entries? Which ones came alive?",
        "Look at resolution rates across notebook sessions. Is there a language whose resolution rate is consistently low?",
        "Across all documented bakeoff sessions, which concern type (NO_CALL_EDGES, LOW_RESOLUTION, etc.) appears most often?",
        "Review concept coverage trends in the notebook. Are we enriching more symbols over time, or has coverage plateaued?",
    ],
    "connecting_experiments": [
        "What code change documented in the CHANGELOG most recently should have affected this cohort's results? Did it?",
        "Is there an analysis script (08-14) whose output on this cohort would directly test a notebook hypothesis?",
        "What experiment or fix from a prior session was supposed to improve results for repos like these? Verify it did.",
        "Look at the 'Process Retrospective' from the last notebook entry. Are you following or ignoring its advice?",
        "What question from a prior reflect cycle went unanswered? Can this cohort's data answer it now?",
    ],
}

JOURNAL_STRATUM_NAMES = list(JOURNAL_STRATA.keys())

# ---------------------------------------------------------------------------
# Prompt template
# ---------------------------------------------------------------------------

ASSESSMENT_PROMPT_TEMPLATE = """\
You are evaluating whether hypergumbo correctly parses and represents the
**{repo_name}** repository. Your focus is parse correctness: does the call graph,
route detection, and symbol extraction faithfully reflect the actual source code?

## Repository Information
- Name: {repo_name}
- Path: {repo_path}
- Dominant language: {dominant_language}

## Available Artifacts
{artifact_list}

## Pre-computed Diagnosis Context
The automated diagnostic pass flagged the following issues (from issues.json).
Use these as starting points — validate whether they are real, and look for
issues the automated pass missed.

{diagnosis_context}

---

## Assessment Tasks

Complete all three tasks. For each, read the actual source code alongside the
hypergumbo artifacts to verify correctness.

### Task A: Call Graph Fidelity
1. Pick a non-trivial function from hg.json (one with multiple callers or callees)
2. Read the actual function in the source code
3. Trace its real call relationships manually
4. Compare against the call edges in hg.json
5. Report: true positives, false positives, false negatives
6. Assess cross-file resolution quality (do edges correctly resolve across files?)

### Task B: Route & Entrypoint Accuracy
1. Check routes.txt against actual route definitions in the source code
2. Identify: correct routes, missing routes, spurious routes
3. Check entrypoints.txt — is the best entrypoint sensible for this repo?
4. Assess whether auto-slice from the best entrypoint would be useful

### Task C: Symbol & Structure Completeness
1. Check symbols.txt — do the top-ranked symbols match what's actually important?
2. Identify any important symbols that are missing entirely
3. Verify edge type correctness (are "calls" edges actually calls, not imports?)
4. Check language detection accuracy

---

## Stratified Reflection Questions

Reflect on these while performing your assessment. Address each briefly in the
`stratified_reflections` section of your output.

{stratified_questions}

## Journal Review

{journal_question}

Lab notebook location: {lab_notebook_dir}

---

## Output Format

Provide your assessment as YAML (copy this schema exactly):

```yaml
parse_assessment:
  repo: {repo_name}
  timestamp: "{timestamp}"
  dominant_language: "{dominant_language}"

  call_graph_fidelity:
    sample_function: "path/to/file:func_name"
    true_positives: <n>
    false_positives: <n>
    false_negatives: <n>
    cross_file_correct: true/false
    resolution_quality: HIGH | MEDIUM | LOW
    false_positive_examples:
      - "description of false positive edge"
    false_negative_examples:
      - "description of missing edge"
    notes: ""

  route_entrypoint_accuracy:
    routes_checked: <n>
    routes_correct: <n>
    routes_missing: <n>
    routes_spurious: <n>
    best_entrypoint_sensible: true/false
    auto_slice_useful: true/false
    missing_routes:
      - "description of missing route"
    spurious_routes:
      - "description of spurious route"
    notes: ""

  symbol_completeness:
    top_symbols_accurate: true/false
    important_symbols_missing:
      - "symbol that should appear but doesn't"
    edge_types_correct: true/false
    edge_misclassifications:
      - "description of misclassified edge"
    language_detection_correct: true/false
    notes: ""

  stratified_reflections:
    missing_patterns: "brief response"
    edge_types: "brief response"
    language_performance: "brief response"
    user_needs: "brief response"
    over_engineering: "brief response"
    cross_language: "brief response"
    cohort_variation: "brief response"
    provocative: "brief response"
    io_and_dataflow: "brief response"
    journal: "brief response"

  overall_verdict: CORRECT | MOSTLY_CORRECT | INCORRECT
  confidence: HIGH | MEDIUM | LOW
  improvement_ideas:
    - "specific, actionable suggestion"
  questions:
    - "open question about hypergumbo behavior"
```

Be specific and concrete. Reference actual files, functions, and line numbers.
Focus on whether parsing is correct, not on whether the output is useful.
"""

# ---------------------------------------------------------------------------
# Artifact descriptions for BROAD bakeoff outputs
# ---------------------------------------------------------------------------

ARTIFACT_DESCRIPTIONS = {
    "hg.json": "Full behavior map (nodes, edges, call graph)",
    "hg.4k.json": "Budget-limited behavior map (4k tokens)",
    "hg.16k.json": "Budget-limited behavior map (16k tokens)",
    "hg.64k.json": "Budget-limited behavior map (64k tokens)",
    "symbols.txt": "Symbols ranked by connectivity",
    "entrypoints.txt": "Detected entrypoints",
    "routes.txt": "Detected API routes and endpoints",
    "io-boundaries.txt": "IO boundary map (boundary types, chains, entry points)",
    "run.txt": "Hypergumbo stdout output",
    "run.err": "Hypergumbo stderr output",
    "time.txt": "Analysis timing",
}


# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------


def resolve_workdir(args_workdir=None, env_var="BAKEOFF_WORKDIR"):
    """Resolve workdir from CLI arg, env var, or canonical default.

    Resolution order: CLI --workdir > env var > canonical default.

    If the resolved directory has no state.json but contains session
    subdirectories (broad-*), returns the most recent one.
    """
    workdir = args_workdir or os.environ.get(env_var) or DEFAULT_BAKEOFF_DIR
    workdir = os.path.abspath(os.path.expanduser(workdir))

    # If the workdir itself has state.json, use it directly
    if os.path.exists(os.path.join(workdir, "state.json")):
        return workdir

    # Otherwise, look for the most recent broad session subdirectory
    if os.path.isdir(workdir):
        sessions = []
        for entry in os.scandir(workdir):
            if entry.is_dir() and entry.name.startswith("broad-"):
                state_path = os.path.join(entry.path, "state.json")
                if os.path.exists(state_path):
                    sessions.append(entry.path)
        if sessions:
            sessions.sort()
            return sessions[-1]

    return workdir


def load_state(workdir):
    """Load bakeoff state.json from workdir. Returns dict or None."""
    state_path = os.path.join(workdir, "state.json")
    if not os.path.exists(state_path):
        return None
    with open(state_path) as f:
        return json.load(f)


def get_artifact_list(repo_out_dir):
    """Generate a formatted list of available artifacts with sizes."""
    lines = []
    for fname, desc in ARTIFACT_DESCRIPTIONS.items():
        fpath = os.path.join(repo_out_dir, fname)
        if os.path.exists(fpath):
            size = os.path.getsize(fpath)
            if size >= 1024:
                lines.append(f"- {fname} ({size // 1024}KB): {desc}")
            else:
                lines.append(f"- {fname} ({size}B): {desc}")
    return "\n".join(lines) if lines else "No artifacts found"


def get_diagnosis_context(diag_dir, repo_name):
    """Load pre-computed diagnosis from issues.json for a specific repo."""
    issues_path = os.path.join(diag_dir, "issues.json")
    if not os.path.exists(issues_path):
        return "No automated diagnosis available for this iteration."

    with open(issues_path) as f:
        all_issues = json.load(f)

    repo_issues = [i for i in all_issues if i.get("repo") == repo_name]
    if not repo_issues:
        return "No issues flagged by automated diagnosis for this repo."

    lines = []
    for issue in repo_issues:
        sev = issue.get("severity", "UNKNOWN")
        flag = issue.get("flag", "")
        hint = issue.get("code_hint", "")
        lines.append(f"- [{sev}] {flag}: {hint}")
    return "\n".join(lines)


def get_dominant_language(repo_out_dir, diag_dir, repo_name):
    """Determine dominant language from issues.json metrics or hg.json."""
    # Try issues.json first
    issues_path = os.path.join(diag_dir, "issues.json")
    if os.path.exists(issues_path):
        with open(issues_path) as f:
            all_issues = json.load(f)
        for issue in all_issues:
            if issue.get("repo") == repo_name:
                metrics = issue.get("metrics", {})
                lang = metrics.get("dominant_language")
                if lang:
                    return lang

    # Fall back to hg.json
    hg_path = os.path.join(repo_out_dir, "hg.json")
    if os.path.exists(hg_path):
        with open(hg_path) as f:
            hg = json.load(f)
        # Count nodes by language (file extension heuristic)
        lang_counts = {}
        for node in hg.get("nodes", []):
            nid = node.get("id", "")
            parts = nid.split(":")
            if len(parts) >= 2:
                filepath = parts[1] if len(parts) > 1 else ""
                ext = os.path.splitext(filepath)[1].lower()
                lang_counts[ext] = lang_counts.get(ext, 0) + 1
        if lang_counts:
            return max(lang_counts, key=lang_counts.get)

    return "unknown"


def sample_stratified_questions():
    """Sample 1 question per stratum from the main pool.

    Returns list of (stratum_name, question) tuples.
    """
    result = []
    for name in STRATUM_NAMES:
        questions = STRATA[name]
        result.append((name, random.choice(questions)))
    return result


def sample_journal_question():
    """Sample 1 journal question from a randomly chosen journal stratum.

    Returns (stratum_name, question) tuple.
    """
    stratum_name = random.choice(JOURNAL_STRATUM_NAMES)
    question = random.choice(JOURNAL_STRATA[stratum_name])
    return (stratum_name, question)


def format_stratified_questions(sampled):
    """Format sampled stratified questions for inclusion in the prompt."""
    lines = []
    for stratum_name, question in sampled:
        label = stratum_name.replace("_", " ").title()
        lines.append(f"**[{label}]** {question}")
    return "\n".join(lines)


def generate_prompt(
    repo_name, repo_path, repo_out_dir, diag_dir, dominant_language
):
    """Generate the full assessment prompt for a repo."""
    artifact_list = get_artifact_list(repo_out_dir)
    diagnosis_context = get_diagnosis_context(diag_dir, repo_name)
    timestamp = datetime.datetime.now().isoformat()

    # Sample questions
    stratified = sample_stratified_questions()
    journal_stratum, journal_q = sample_journal_question()

    stratified_text = format_stratified_questions(stratified)
    journal_label = journal_stratum.replace("_", " ").title()
    journal_text = f"**[Journal: {journal_label}]** {journal_q}"

    return ASSESSMENT_PROMPT_TEMPLATE.format(
        repo_name=repo_name,
        repo_path=repo_path,
        dominant_language=dominant_language,
        artifact_list=artifact_list,
        diagnosis_context=diagnosis_context,
        timestamp=timestamp,
        stratified_questions=stratified_text,
        journal_question=journal_text,
        lab_notebook_dir=LAB_NOTEBOOK_DIR,
    )


# ---------------------------------------------------------------------------
# Aggregation
# ---------------------------------------------------------------------------


def aggregate_assessments(assessments):
    """Aggregate individual parse assessments into a summary.

    Deduplicates and frequency-ranks common findings across repos. Also
    aggregates stratified_reflections by stratum.
    """
    summary = {
        "total_repos": len(assessments),
        "verdicts": {"CORRECT": 0, "MOSTLY_CORRECT": 0, "INCORRECT": 0},
        "confidence": {"HIGH": 0, "MEDIUM": 0, "LOW": 0},
    }

    all_false_positives = []
    all_false_negatives = []
    all_missing_routes = []
    all_spurious_routes = []
    all_missing_symbols = []
    all_edge_misclassifications = []
    all_improvement_ideas = []
    all_questions = []

    # Collect per-stratum reflections
    reflections_by_stratum = {name: [] for name in STRATUM_NAMES}
    reflections_by_stratum["journal"] = []

    for a in assessments:
        if not a:
            continue

        # Verdicts
        verdict = a.get("overall_verdict", "INCORRECT")
        if verdict in summary["verdicts"]:
            summary["verdicts"][verdict] += 1

        confidence = a.get("confidence", "LOW")
        if confidence in summary["confidence"]:
            summary["confidence"][confidence] += 1

        # Call graph fidelity
        cgf = a.get("call_graph_fidelity", {})
        all_false_positives.extend(cgf.get("false_positive_examples", []))
        all_false_negatives.extend(cgf.get("false_negative_examples", []))

        # Route accuracy
        rea = a.get("route_entrypoint_accuracy", {})
        all_missing_routes.extend(rea.get("missing_routes", []))
        all_spurious_routes.extend(rea.get("spurious_routes", []))

        # Symbol completeness
        sc = a.get("symbol_completeness", {})
        all_missing_symbols.extend(sc.get("important_symbols_missing", []))
        all_edge_misclassifications.extend(
            sc.get("edge_misclassifications", [])
        )

        # Ideas and questions
        all_improvement_ideas.extend(a.get("improvement_ideas", []))
        all_questions.extend(a.get("questions", []))

        # Stratified reflections
        sr = a.get("stratified_reflections", {})
        for stratum_name in STRATUM_NAMES:
            text = sr.get(stratum_name, "")
            if text:
                repo = a.get("repo", "unknown")
                reflections_by_stratum[stratum_name].append(
                    {"repo": repo, "response": text}
                )
        journal_text = sr.get("journal", "")
        if journal_text:
            repo = a.get("repo", "unknown")
            reflections_by_stratum["journal"].append(
                {"repo": repo, "response": journal_text}
            )

    def count_items(items):
        """Deduplicate and frequency-rank a list of strings."""
        counts = {}
        for item in items:
            if isinstance(item, str) and item.strip():
                counts[item] = counts.get(item, 0) + 1
        return sorted(counts.items(), key=lambda x: -x[1])

    summary["common_false_positives"] = [
        {"issue": m, "count": c} for m, c in count_items(all_false_positives)[:10]
    ]
    summary["common_false_negatives"] = [
        {"issue": m, "count": c} for m, c in count_items(all_false_negatives)[:10]
    ]
    summary["common_missing_routes"] = [
        {"issue": m, "count": c} for m, c in count_items(all_missing_routes)[:10]
    ]
    summary["common_spurious_routes"] = [
        {"issue": m, "count": c} for m, c in count_items(all_spurious_routes)[:10]
    ]
    summary["common_missing_symbols"] = [
        {"issue": m, "count": c} for m, c in count_items(all_missing_symbols)[:10]
    ]
    summary["common_edge_misclassifications"] = [
        {"issue": m, "count": c}
        for m, c in count_items(all_edge_misclassifications)[:10]
    ]
    summary["improvement_ideas"] = [
        {"idea": i, "count": c} for i, c in count_items(all_improvement_ideas)[:10]
    ]
    summary["questions"] = [
        {"question": q, "count": c} for q, c in count_items(all_questions)[:10]
    ]

    # Filter out empty strata
    summary["stratified_reflections"] = {
        k: v for k, v in reflections_by_stratum.items() if v
    }

    return summary


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------


def cmd_reflect(args):
    """Generate LLM assessment prompts for each repo in the latest bakeoff."""
    workdir = resolve_workdir(args.workdir)
    print(f"Workdir: {workdir}")
    state = load_state(workdir)

    if not state:
        print("Error: No bakeoff session found.", file=sys.stderr)
        return 1

    cohort_number = state.get("cohort_number", 0)
    iteration = args.iteration or state.get("iteration", 0)
    pool_path = state.get("pool_path", "")
    current_cohort = state.get("current_cohort", [])

    out_dir = os.path.join(
        workdir, "out", f"cohort-{cohort_number:03d}", f"iter-{iteration:03d}"
    )
    diag_dir = os.path.join(
        workdir, "diag", f"cohort-{cohort_number:03d}", f"iter-{iteration:03d}"
    )

    if not os.path.isdir(out_dir):
        print(f"Error: No output found at {out_dir}.", file=sys.stderr)
        return 1

    print("Bakeoff Parse Assessment (BROAD)")
    print(f"  Cohort: #{cohort_number}")
    print(f"  Iteration: {iteration}")
    print(f"  Repos: {', '.join(current_cohort)}")
    print()

    # Generate prompts
    prompts_dir = os.path.join(
        workdir, "reflect", f"cohort-{cohort_number:03d}", f"iter-{iteration:03d}"
    )
    os.makedirs(prompts_dir, exist_ok=True)

    generated = 0
    for repo_name in current_cohort:
        repo_path = os.path.join(pool_path, repo_name)
        repo_out = os.path.join(out_dir, repo_name)

        if not os.path.isdir(repo_out):
            print(f"[{repo_name}] Skipped (no output)")
            continue

        dominant_language = get_dominant_language(repo_out, diag_dir, repo_name)
        prompt = generate_prompt(
            repo_name, repo_path, repo_out, diag_dir, dominant_language
        )

        prompt_path = os.path.join(prompts_dir, f"{repo_name}.prompt.md")
        with open(prompt_path, "w") as f:
            f.write(prompt)

        print(f"[{repo_name}] Prompt generated: {prompt_path}")
        generated += 1

    if generated == 0:
        print("No repos had output to generate prompts for.", file=sys.stderr)
        return 1

    print()
    print("=" * 60)
    print("NEXT STEPS")
    print("=" * 60)
    print()
    print("The reflection prompts have been generated. To complete the assessment:")
    print()
    print("1. For each repo, invoke an LLM agent with the prompt:")
    print(f"   Prompts are in: {prompts_dir}/")
    print()
    print("2. The agent should have access to:")
    print(f"   - The repo source code at: {pool_path}/<repo_name>/")
    print(f"   - The hypergumbo artifacts at: {out_dir}/<repo_name>/")
    print()
    print("3. Save the YAML assessment output to:")
    print(f"   {prompts_dir}/<repo_name>.assessment.yaml")
    print()
    print("4. Run aggregate to synthesize findings:")
    print(f"   ./scripts/bakeoff-reflect aggregate --workdir {workdir}")
    print()

    return 0


def cmd_aggregate(args):
    """Aggregate individual assessment YAML files into a summary."""
    workdir = resolve_workdir(args.workdir)
    print(f"Workdir: {workdir}")
    state = load_state(workdir)

    if not state:
        print("Error: No bakeoff session found.", file=sys.stderr)
        return 1

    cohort_number = state.get("cohort_number", 0)
    iteration = args.iteration or state.get("iteration", 0)

    prompts_dir = os.path.join(
        workdir, "reflect", f"cohort-{cohort_number:03d}", f"iter-{iteration:03d}"
    )

    if not os.path.isdir(prompts_dir):
        print(
            f"Error: No reflection directory found at {prompts_dir}.",
            file=sys.stderr,
        )
        return 1

    # Try to import yaml; fall back to json if unavailable
    try:
        import yaml

        use_yaml = True
    except ImportError:
        use_yaml = False

    assessments = []
    current_cohort = state.get("current_cohort", [])

    for repo_name in current_cohort:
        assessment_path = os.path.join(
            prompts_dir, f"{repo_name}.assessment.yaml"
        )

        if not os.path.exists(assessment_path):
            print(f"[{repo_name}] No assessment found (skipped)")
            continue

        try:
            with open(assessment_path) as f:
                if use_yaml:
                    data = yaml.safe_load(f)
                else:
                    data = json.load(f)

                if data and "parse_assessment" in data:
                    assessments.append(data["parse_assessment"])
                elif data:
                    assessments.append(data)
                print(f"[{repo_name}] Loaded assessment")
        except Exception as e:
            print(f"[{repo_name}] Error loading assessment: {e}")

    if not assessments:
        print()
        print("No assessments found to aggregate.")
        print("Run the reflection prompts first, then save results as:")
        print(f"  {prompts_dir}/<repo_name>.assessment.yaml")
        return 1

    # Aggregate
    summary = aggregate_assessments(assessments)
    summary["cohort"] = cohort_number
    summary["iteration"] = iteration
    summary["timestamp"] = datetime.datetime.now().isoformat()

    # Write summary
    summary_path = os.path.join(prompts_dir, "summary.yaml")
    with open(summary_path, "w") as f:
        if use_yaml:
            yaml.dump(summary, f, default_flow_style=False, sort_keys=False)
        else:
            json.dump(summary, f, indent=2)

    # Print human-readable summary
    print()
    print("=" * 60)
    print("PARSE ASSESSMENT SUMMARY")
    print("=" * 60)
    print()
    print(f"Assessed repos: {summary['total_repos']}")
    print("Verdicts:")
    for verdict, count in summary["verdicts"].items():
        print(f"  {verdict}: {count}")
    print()

    if summary.get("common_false_positives"):
        print("Common false positives (call graph):")
        for item in summary["common_false_positives"][:5]:
            print(f"  - {item['issue']} (x{item['count']})")
        print()

    if summary.get("common_false_negatives"):
        print("Common false negatives (call graph):")
        for item in summary["common_false_negatives"][:5]:
            print(f"  - {item['issue']} (x{item['count']})")
        print()

    if summary.get("common_missing_routes"):
        print("Common missing routes:")
        for item in summary["common_missing_routes"][:5]:
            print(f"  - {item['issue']} (x{item['count']})")
        print()

    if summary.get("improvement_ideas"):
        print("Top improvement ideas:")
        for item in summary["improvement_ideas"][:5]:
            print(f"  - {item['idea']} (x{item['count']})")
        print()

    # Show stratified reflection summary
    sr = summary.get("stratified_reflections", {})
    if sr:
        print("Stratified reflections:")
        for stratum_name, responses in sr.items():
            label = stratum_name.replace("_", " ").title()
            print(f"  [{label}] {len(responses)} response(s)")
        print()

    print(f"Full summary: {summary_path}")

    return 0


# ---------------------------------------------------------------------------
# CLI entrypoint
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(
        description="LLM-driven parse correctness assessment for BROAD bakeoff",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    subparsers = parser.add_subparsers(dest="command", help="Command")

    # reflect (default)
    p_reflect = subparsers.add_parser(
        "reflect", help="Generate assessment prompts"
    )
    p_reflect.add_argument("--workdir", help="Bakeoff workdir")
    p_reflect.add_argument(
        "--iteration", type=int, help="Specific iteration to reflect on"
    )

    # aggregate
    p_aggregate = subparsers.add_parser(
        "aggregate", help="Aggregate assessment results"
    )
    p_aggregate.add_argument("--workdir", help="Bakeoff workdir")
    p_aggregate.add_argument(
        "--iteration", type=int, help="Specific iteration"
    )

    args = parser.parse_args()

    # Default to reflect if no command given
    if not args.command:
        args.command = "reflect"
        args.workdir = None
        args.iteration = None

    commands = {
        "reflect": cmd_reflect,
        "aggregate": cmd_aggregate,
    }

    return commands[args.command](args)


if __name__ == "__main__":
    sys.exit(main())

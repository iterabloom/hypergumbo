#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
set -euo pipefail

# ------------------------------------------------------------------
# ci-failover: Switch CI targeting between Codeberg and self-hosted Forgejo
#
# When Codeberg is down, `engage` redirects auto-pr, merge-pr, and
# ci-debug to use a self-hosted Forgejo mirror with its own runner. When
# Codeberg recovers, `disengage` pushes all locally-merged work back
# to Codeberg, re-enables mirror sync, and resumes normal operations.
#
# Usage:
#   ci-failover engage [--local-url URL] [--force]
#   ci-failover disengage [--skip-ci] [--force]
#   ci-failover status
#
# Environment:
#   SELFHOSTED_FORGEJO_URL    Base URL of self-hosted Forgejo (e.g., http://forgejo-ci.internal:3000)
#   SELFHOSTED_FORGEJO_TOKEN  API token for self-hosted Forgejo
#   SELFHOSTED_FORGEJO_REPO   Repo slug on self-hosted Forgejo (e.g., user/hypergumbo)
#   SELFHOSTED_FORGEJO_USER   Username for self-hosted Forgejo (defaults to FORGEJO_USER)
#
# State file: .git/CI_FAILOVER_ACTIVE (JSON, not tracked)
# ------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/forgejo-api.sh
source "$SCRIPT_DIR/lib/forgejo-api.sh"

load_env

FAILOVER_FILE="$REPO_ROOT/.git/CI_FAILOVER_ACTIVE"

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------

die() {
	echo "❌ $*" >&2
	exit 1
}

warn() {
	echo "⚠️  $*" >&2
}

codeberg_reachable() {
	curl -sf --max-time 10 "https://codeberg.org/api/v1/version" >/dev/null 2>&1
}

selfhosted_forgejo_reachable() {
	local url="${1:-${SELFHOSTED_FORGEJO_URL:-}}"
	[[ -n "$url" ]] && curl -sf --max-time 10 "$url/api/v1/version" >/dev/null 2>&1
}

failover_json_field() {
	local field="$1"
	python3 -c "import json; print(json.load(open('$FAILOVER_FILE')).get('$field', ''))" 2>/dev/null
}

# ------------------------------------------------------------------
# engage: Switch to self-hosted Forgejo
# ------------------------------------------------------------------
cmd_engage() {
	local force=false
	local local_url="${SELFHOSTED_FORGEJO_URL:-}"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--local-url)
			local_url="$2"
			shift 2
			;;
		--force)
			force=true
			shift
			;;
		*)
			die "Unknown option: $1"
			;;
		esac
	done

	# Precondition checks
	if [[ -f "$FAILOVER_FILE" ]] && [[ "$force" != "true" ]]; then
		die "Failover already engaged. Use 'status' to check, or 'engage --force' to re-engage."
	fi

	if [[ -f "$REPO_ROOT/.git/PR_PENDING" ]] && [[ "$force" != "true" ]]; then
		die "PR is currently in flight (.git/PR_PENDING exists). Wait for it to complete first."
	fi

	# last_stop_check.json now lives in ~/hypergumbo_lab_notebook/ (outside git tree)

	# Flush pending tracker ops via its own sync mechanism
	if ls .agent/tracker-workspace/.ops/.WI-*.ops >/dev/null 2>&1; then
		echo "   📋 Syncing tracker ops..."
		"$SCRIPT_DIR/tracker" sync || warn "Tracker sync failed (non-fatal)"
	fi

	if [[ "$force" != "true" ]]; then
		if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
			die "Working tree is not clean. Commit or stash changes first."
		fi
	fi

	local repo="${SELFHOSTED_FORGEJO_REPO:-}"
	local token="${SELFHOSTED_FORGEJO_TOKEN:-}"
	local user="${SELFHOSTED_FORGEJO_USER:-${FORGEJO_USER:-}}"

	if [[ -z "$local_url" ]]; then
		die "SELFHOSTED_FORGEJO_URL not set. Set it in .env or pass --local-url URL."
	fi
	if [[ -z "$repo" ]]; then
		die "SELFHOSTED_FORGEJO_REPO not set. Set it in .env (e.g., SELFHOSTED_FORGEJO_REPO=user/hypergumbo)."
	fi

	echo "🔄 Engaging CI failover..."
	echo "   Self-hosted Forgejo: $local_url"
	echo "   Repository:    $repo"

	# Check self-hosted Forgejo reachability
	if ! selfhosted_forgejo_reachable "$local_url"; then
		die "Self-hosted Forgejo at $local_url is not reachable."
	fi
	echo "   ✅ Self-hosted Forgejo is reachable"

	# Ensure 'local' git remote exists with embedded credentials
	local local_user="${SELFHOSTED_FORGEJO_USER:-$FORGEJO_USER}"
	local local_token="${SELFHOSTED_FORGEJO_TOKEN:-}"
	local authed_url
	# Embed credentials in URL (same pattern as origin)
	authed_url=$(echo "$local_url" | sed "s|://|://${local_user}:${local_token}@|")
	if ! git remote get-url selfh >/dev/null 2>&1; then
		echo "   Adding 'local' git remote..."
		git remote add selfh "$authed_url/$repo.git"
	else
		# Update URL in case credentials changed
		git remote set-url selfh "$authed_url/$repo.git"
	fi

	# Record origin/dev SHA
	git fetch origin dev --quiet 2>/dev/null || warn "Could not fetch origin/dev (Codeberg may be down)"
	local codeberg_dev_sha
	codeberg_dev_sha=$(git rev-parse origin/dev 2>/dev/null || echo "unknown")

	# Check if the local repo is a mirror and convert it
	local api_url="$local_url/api/v1/repos/$repo"
	local saved_token="${FORGEJO_TOKEN:-}"
	export FORGEJO_TOKEN="${token:-$saved_token}"
	local is_mirror=false
	local mirror_converted=false
	local original_mirror_url=""

	if api_get "$api_url"; then
		is_mirror=$(echo "$API_RESPONSE" | json_field "mirror")
		if [[ "$is_mirror" == "True" || "$is_mirror" == "true" ]]; then
			# Save the original mirror source URL for re-creation on disengage
			original_mirror_url=$(echo "$API_RESPONSE" | python3 -c "
import json, sys
data = json.load(sys.stdin)
# mirror_url is not always exposed; fall back to clone_url of origin
print(data.get('original_url', data.get('clone_url', '')))
" 2>/dev/null || echo "")

			echo ""
			echo "   📋 Local repo is a mirror (read-only). Converting to regular repo..."
			echo "   ⚠️  This is required so auto-pr can push feature branches."
			echo "   ⚠️  Disengage will re-create the mirror automatically."

			# Try Forgejo v13+ API: POST /repos/{owner}/{repo}/convert
			if api_post "$api_url/convert" ""; then
				echo "   ✅ Mirror converted to regular repo via API"
				mirror_converted=true
			else
				# API not available (pre-v13). Try PATCH with mirror=false.
				if api_patch "$api_url" '{"mirror": false}'; then
					# Verify it actually worked
					if api_get "$api_url"; then
						local still_mirror
						still_mirror=$(echo "$API_RESPONSE" | json_field "mirror")
						if [[ "$still_mirror" == "False" || "$still_mirror" == "false" ]]; then
							echo "   ✅ Mirror converted to regular repo"
							mirror_converted=true
						fi
					fi
				fi

				if [[ "$mirror_converted" != "true" ]]; then
					echo ""
					echo "   ❌ Could not convert mirror via API (Forgejo v13+ required)."
					echo "   👉 Manual step needed: go to the self-hosted Forgejo web UI:"
					echo "      $local_url/$repo/settings"
					echo "      → Danger Zone → 'Convert to Regular Repository'"
					echo "   Then re-run: ./scripts/ci-failover engage"
					export FORGEJO_TOKEN="$saved_token"
					exit 1
				fi
			fi
		else
			echo "   ℹ️  Local repo is already a regular repo (not a mirror)"
		fi
	else
		warn "Could not query local repo status (HTTP $API_HTTP_CODE) — proceeding anyway"
	fi
	export FORGEJO_TOKEN="$saved_token"

	# Push dev to self-hosted Forgejo
	echo "   Pushing dev to self-hosted Forgejo..."
	if git push selfh dev 2>/dev/null; then
		echo "   ✅ Local dev is up to date"
	else
		# Try with credentials
		local push_user="${SELFHOSTED_FORGEJO_USER:-${FORGEJO_USER:-}}"
		if git -c credential.helper="!f() { echo username=$push_user; echo password=$token; }; f" push local dev 2>/dev/null; then
			echo "   ✅ Local dev is up to date"
		else
			warn "Push to local failed — self-hosted Forgejo may already be up to date"
		fi
	fi

	# Warn about existing vPR queue
	if [[ -f "$REPO_ROOT/.git/PR_QUEUE" ]] && [[ -s "$REPO_ROOT/.git/PR_QUEUE" ]]; then
		local count
		count=$(wc -l <"$REPO_ROOT/.git/PR_QUEUE" | tr -d ' ')
		warn "vPR queue has $count item(s). These will flush to self-hosted Forgejo on next 'auto-pr flush'."
	fi

	# Write flag file
	local ts
	ts=$(date -Iseconds)
	_FAILOVER_MIRROR_URL="$original_mirror_url" python3 -c "
import json, os
state = {
    'engaged_at': '$ts',
    'codeberg_dev_sha': '$codeberg_dev_sha',
    'selfhosted_forgejo_url': '$local_url',
    'selfhosted_forgejo_repo': '$repo',
    'mirror_was_enabled': $( [[ "$is_mirror" == "True" || "$is_mirror" == "true" ]] && echo "True" || echo "False" ),
    'mirror_converted': $( [[ "$mirror_converted" == "true" ]] && echo "True" || echo "False" ),
    'original_mirror_url': os.environ.get('_FAILOVER_MIRROR_URL', ''),
    'prs_merged_locally': []
}
with open('$FAILOVER_FILE', 'w') as f:
    json.dump(state, f, indent=2)
    f.write('\n')
"

	echo ""
	echo "✅ CI failover engaged"
	echo "   auto-pr, merge-pr, and ci-debug now target self-hosted Forgejo"
	if [[ "$mirror_converted" == "true" ]]; then
		echo ""
		echo "   📋 REMINDER: The local repo was converted from a mirror to a regular repo."
		echo "   When you disengage, the mirror will be re-created automatically by"
		echo "   deleting and re-importing the repo as a mirror from Codeberg."
	fi
	echo ""
	echo "   When Codeberg recovers: ./scripts/ci-failover disengage"
}

# ------------------------------------------------------------------
# disengage: Create a repatriation PR on Codeberg
#
# Because dev is branch-protected on Codeberg, we cannot push to it
# directly. Instead, disengage creates a temporary feature branch
# containing all the commits made during failover, pushes it to
# Codeberg via AGit flow, and polls CI. Since failover work typically
# touches governance files, the script stops after CI passes and
# instructs the human to review and merge the PR on Codeberg.
#
# After the human merges the PR, they run:
#   ./scripts/ci-failover disengage-cleanup
# which verifies the merge, restores the self-hosted mirror, and
# removes the failover flag file.
# ------------------------------------------------------------------
cmd_disengage() {
	local force=false
	local skip_ci=false

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--skip-ci)
			skip_ci=true
			shift
			;;
		--force)
			force=true
			shift
			;;
		*)
			die "Unknown option: $1"
			;;
		esac
	done

	if [[ ! -f "$FAILOVER_FILE" ]] && [[ "$force" != "true" ]]; then
		die "Failover is not engaged. Nothing to disengage."
	fi

	# Check if disengage already created a PR (re-entrant guard)
	local existing_pr
	existing_pr=$(failover_json_field "disengage_pr_num")
	if [[ -n "$existing_pr" ]] && [[ "$existing_pr" != "0" ]] && [[ "$force" != "true" ]]; then
		echo ""
		echo "====================================================================="
		echo "  Disengage PR #$existing_pr was already created on Codeberg."
		echo ""
		echo "  If it has been merged, finish with:"
		echo "    ./scripts/ci-failover disengage-cleanup"
		echo ""
		echo "  If it needs to be re-created, use:"
		echo "    ./scripts/ci-failover disengage --force"
		echo "====================================================================="
		exit 0
	fi

	if [[ -f "$REPO_ROOT/.git/PR_PENDING" ]] && [[ "$force" != "true" ]]; then
		die "PR is currently in flight (.git/PR_PENDING exists). Wait for it to complete first."
	fi

	local current_branch
	current_branch=$(git branch --show-current)
	if [[ "$current_branch" != "dev" ]] && [[ "$force" != "true" ]]; then
		die "Not on dev branch (on '$current_branch'). Switch to dev first."
	fi

	# Auto-commit operational state that's always dirty mid-session
	# last_stop_check.json now lives in ~/hypergumbo_lab_notebook/ (outside git tree)

	# Flush pending tracker ops via its own sync mechanism
	if ls .agent/tracker-workspace/.ops/.WI-*.ops >/dev/null 2>&1; then
		echo "   📋 Syncing tracker ops..."
		"$SCRIPT_DIR/tracker" sync || warn "Tracker sync failed (non-fatal)"
	fi

	if [[ "$force" != "true" ]]; then
		if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
			die "Working tree is not clean. Commit or stash changes first."
		fi
	fi

	echo ""
	echo "====================================================================="
	echo "  DISENGAGE: Repatriating failover work to Codeberg"
	echo "====================================================================="
	echo ""
	echo "  Because 'dev' is branch-protected on Codeberg, failover commits"
	echo "  cannot be pushed directly. Instead, this script will:"
	echo ""
	echo "    1. Create a temporary repatriation branch"
	echo "    2. Push it to Codeberg as a PR (via AGit flow)"
	echo "    3. Poll Codeberg CI until it passes"
	echo "    4. Stop and ask YOU to review + merge the PR"
	echo ""
	echo "  After you merge on Codeberg, run:"
	echo "    ./scripts/ci-failover disengage-cleanup"
	echo ""
	echo "====================================================================="
	echo ""

	# Check Codeberg reachability
	if ! codeberg_reachable; then
		if [[ "$force" != "true" ]]; then
			die "Codeberg is not reachable. Wait for it to recover, or use --force."
		fi
		warn "Codeberg is not reachable — proceeding anyway (--force)"
	else
		echo "   ✅ Codeberg is reachable"
	fi

	# Fetch latest from Codeberg
	echo "   Fetching origin/dev..."
	git fetch origin dev --quiet 2>/dev/null || warn "Could not fetch origin/dev"

	local origin_dev_sha codeberg_dev_sha local_dev_sha
	origin_dev_sha=$(git rev-parse origin/dev 2>/dev/null || echo "unknown")
	codeberg_dev_sha=$(failover_json_field "codeberg_dev_sha")
	local_dev_sha=$(git rev-parse dev 2>/dev/null)

	# Check fast-forward feasibility
	if [[ "$origin_dev_sha" != "unknown" ]] && [[ "$codeberg_dev_sha" != "unknown" ]]; then
		if [[ "$origin_dev_sha" != "$codeberg_dev_sha" ]]; then
			# origin/dev has advanced — check if local dev is still a descendant
			if ! git merge-base --is-ancestor "$origin_dev_sha" "$local_dev_sha" 2>/dev/null; then
				die "origin/dev has diverged from local dev (someone pushed to Codeberg during the outage).
   Rebase local dev onto origin/dev first:
     git rebase origin/dev
   Then re-run: ./scripts/ci-failover disengage"
			fi
			warn "origin/dev advanced during outage, but local dev is a fast-forward descendant — proceeding"
		fi
	fi

	# Count commits ahead for the PR description
	local commits_ahead=0
	if [[ "$origin_dev_sha" != "unknown" ]]; then
		commits_ahead=$(git rev-list --count "$origin_dev_sha..dev" 2>/dev/null || echo "?")
	fi

	# Build PR description from failover state
	local pr_body
	pr_body=$(python3 -c "
import json, sys
try:
    data = json.load(open('$FAILOVER_FILE'))
except Exception:
    data = {}
prs = data.get('prs_merged_locally', [])
engaged_at = data.get('engaged_at', 'unknown')
lines = []
lines.append('## CI Failover Repatriation')
lines.append('')
lines.append('This PR contains all commits made during a CI failover session')
lines.append('(Codeberg outage). Each commit was individually reviewed and merged')
lines.append('via PRs on the self-hosted Forgejo instance.')
lines.append('')
lines.append(f'- **Failover engaged:** {engaged_at}')
lines.append(f'- **Commits:** $commits_ahead')
lines.append(f'- **PRs merged on self-hosted Forgejo:** {len(prs)}')
if prs:
    lines.append('')
    for pr in prs:
        num = pr.get('pr_num', '?')
        title = pr.get('title', '(untitled)')
        lines.append(f'  - Self-hosted PR #{num}: {title}')
lines.append('')
lines.append('## Governance note')
lines.append('')
lines.append('This PR touches governance files (scripts/ci-failover, auto-pr,')
lines.append('merge-pr, ci-debug, forgejo-api.sh). Human review is required.')
print('\n'.join(lines))
" 2>/dev/null || echo "CI failover repatriation — all commits were PR-reviewed on self-hosted Forgejo.")

	# Create a temporary repatriation branch from current dev
	local repatriation_branch="jgstern-agent/fix/failover-repatriation"
	echo "   Creating repatriation branch: $repatriation_branch"
	git checkout -b "$repatriation_branch" 2>/dev/null || {
		# Branch may already exist from a previous attempt
		git checkout "$repatriation_branch" 2>/dev/null || die "Could not create/checkout repatriation branch"
		# Make sure it points to current dev
		git reset --hard dev
	}

	# Regenerate test manifest for the repatriation branch
	echo "   📋 Regenerating test manifest..."
	if "$SCRIPT_DIR/smart-test" --manifest >/dev/null 2>&1; then
		if grep -q "^# Mode: full-suite" .ci/affected-tests.txt 2>/dev/null; then
			echo "   ⚠️  Manifest regenerated as full-suite — keeping existing"
			git checkout -- .ci/affected-tests.txt 2>/dev/null || true
		elif ! git diff --quiet -- .ci/affected-tests.txt 2>/dev/null; then
			echo "   Manifest updated — amending commit"
			git add .ci/affected-tests.txt
			git commit --amend --no-edit -s
		else
			echo "   ✅ Manifest up to date"
		fi
	else
		echo "   ⚠️  Manifest generation skipped"
	fi

	local LOCAL_SHA
	LOCAL_SHA=$(git rev-parse HEAD)

	# Push to Codeberg via AGit flow (creates a PR targeting dev)
	echo ""
	echo "   📤 Pushing repatriation branch to Codeberg..."
	local push_title="fix: CI failover repatriation ($commits_ahead commits)"
	# git push -o description can't have newlines
	local push_desc_flat="${pr_body//$'\n'/\\n}"

	local USER="${FORGEJO_USER:-}"
	local TOKEN="${FORGEJO_TOKEN:-}"

	local push_success=false
	local PUSH_OUTPUT=""
	PUSH_OUTPUT=$(git -c credential.helper="!f() { echo username=$USER; echo password=$TOKEN; }; f" \
		push origin "HEAD:refs/for/dev/$repatriation_branch" \
		-o title="$push_title" \
		-o description="$push_desc_flat" \
		-o force-push=true 2>&1) && push_success=true
	echo "$PUSH_OUTPUT"

	if [[ "$push_success" != "true" ]]; then
		git checkout dev
		die "Failed to push repatriation branch to Codeberg."
	fi

	# Find the PR number
	detect_api_base
	local PR_NUM=""

	# First try to find by branch name
	if api_get "$API_BASE/pulls?state=open&limit=20"; then
		PR_NUM=$(echo "$API_RESPONSE" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for pr in data:
    if pr.get('head', {}).get('ref', '') == '$repatriation_branch':
        print(pr['number'])
        break
" 2>/dev/null || echo "")
	fi

	if [[ -z "$PR_NUM" ]]; then
		# Fallback: search by SHA
		if api_get "$API_BASE/pulls?state=open&limit=20"; then
			PR_NUM=$(echo "$API_RESPONSE" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for pr in data:
    if pr.get('head', {}).get('sha', '').startswith('${LOCAL_SHA:0:7}'):
        print(pr['number'])
        break
" 2>/dev/null || echo "")
		fi
	fi

	if [[ -z "$PR_NUM" ]]; then
		echo ""
		warn "Could not find the PR number automatically."
		echo "   Check Codeberg manually: https://codeberg.org/$REPO_SLUG/pulls"
		echo "   Then run: ./scripts/ci-failover disengage-cleanup"
		git checkout dev
		exit 1
	fi

	echo ""
	echo "   ✅ Codeberg PR #$PR_NUM created"
	echo "   🔗 https://codeberg.org/$REPO_SLUG/pulls/$PR_NUM"

	# Update PR body with actual newlines
	local json_body
	json_body=$(python3 -c "import json,sys; print(json.dumps({'body': sys.stdin.read()}))" <<<"$pr_body")
	api_patch "$API_BASE/pulls/$PR_NUM" "$json_body" || true

	# Record disengage PR in flag file
	python3 -c "
import json
fpath = '$FAILOVER_FILE'
with open(fpath) as f:
    data = json.load(f)
data['disengage_pr_num'] = int('$PR_NUM')
data['disengage_branch'] = '$repatriation_branch'
data['disengage_sha'] = '$LOCAL_SHA'
with open(fpath, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
" 2>/dev/null || true

	# Poll CI on Codeberg
	if [[ "$skip_ci" != "true" ]]; then
		echo ""
		echo "   ⏳ Polling Codeberg CI..."
		local poll_result=0
		poll_ci "$LOCAL_SHA" || poll_result=$?

		if [[ $poll_result -eq 1 ]]; then
			echo ""
			echo "   ❌ Codeberg CI failed."
			echo "   Fix the issue, push to the repatriation branch, then try again."
			git checkout dev
			exit 1
		elif [[ $poll_result -eq 2 ]]; then
			echo ""
			warn "CI polling timed out. CI may still be running."
			echo "   Check: ./scripts/ci-debug status $LOCAL_SHA"
		fi
	fi

	# Return to dev
	git checkout dev --quiet

	# Print prominent instructions
	echo ""
	echo ""
	echo "====================================================================="
	echo "====================================================================="
	echo ""
	echo "  DISENGAGE PHASE 1 COMPLETE"
	echo ""
	echo "  Codeberg PR #$PR_NUM is ready for your review."
	echo ""
	echo "  🔗 https://codeberg.org/$REPO_SLUG/pulls/$PR_NUM"
	echo ""
	echo "  This PR contains $commits_ahead commit(s) from the failover"
	echo "  session. Each was individually PR-reviewed on self-hosted Forgejo."
	echo ""
	echo "  WHAT TO DO NOW:"
	echo ""
	echo "    1. Review the PR on Codeberg (link above)"
	echo "    2. Merge it (fast-forward or merge commit, your choice)"
	echo "    3. Then run:"
	echo ""
	echo "         ./scripts/ci-failover disengage-cleanup"
	echo ""
	echo "       This will:"
	echo "         - Verify the PR was merged"
	echo "         - Pull the merged dev branch"
	echo "         - Restore the self-hosted Forgejo mirror"
	echo "         - Remove the failover flag and return to normal"
	echo ""
	echo "  Until you complete step 3, failover remains engaged and"
	echo "  auto-pr/merge-pr/ci-debug still target self-hosted Forgejo."
	echo ""
	echo "====================================================================="
	echo "====================================================================="
}

# ------------------------------------------------------------------
# disengage-cleanup: Finalize disengage after human merges Codeberg PR
# ------------------------------------------------------------------
cmd_disengage_cleanup() {
	if [[ ! -f "$FAILOVER_FILE" ]]; then
		die "Failover is not engaged. Nothing to clean up."
	fi

	local pr_num
	pr_num=$(failover_json_field "disengage_pr_num")
	local repatriation_branch
	repatriation_branch=$(failover_json_field "disengage_branch")

	if [[ -z "$pr_num" ]] || [[ "$pr_num" == "0" ]]; then
		die "No disengage PR found in failover state.
   Run './scripts/ci-failover disengage' first to create the repatriation PR."
	fi

	echo ""
	echo "====================================================================="
	echo "  DISENGAGE CLEANUP: Verifying Codeberg PR #$pr_num"
	echo "====================================================================="
	echo ""

	# Check if the PR is merged on Codeberg
	detect_api_base
	if ! api_get "$API_BASE/pulls/$pr_num"; then
		die "Could not fetch PR #$pr_num from Codeberg (HTTP $API_HTTP_CODE)"
	fi

	local pr_state pr_merged
	pr_state=$(echo "$API_RESPONSE" | json_field "state")
	pr_merged=$(echo "$API_RESPONSE" | json_field "merged")

	if [[ "$pr_merged" != "True" && "$pr_merged" != "true" ]]; then
		echo "   ❌ PR #$pr_num is not yet merged on Codeberg."
		echo ""
		echo "   Current state: $pr_state"
		echo ""
		echo "   Please merge the PR first:"
		echo "     🔗 https://codeberg.org/$REPO_SLUG/pulls/$pr_num"
		echo ""
		echo "   Then re-run: ./scripts/ci-failover disengage-cleanup"
		exit 1
	fi

	echo "   ✅ PR #$pr_num confirmed merged on Codeberg"

	# Pull merged dev from Codeberg.
	# The repatriation branch may have amended a commit (e.g., manifest
	# regeneration), so local dev and origin/dev can diverge even though
	# the content is identical. Use fetch+reset instead of pull to handle
	# this cleanly — origin/dev is the canonical merged truth.
	echo "   Syncing local dev with Codeberg..."
	git checkout dev --quiet 2>/dev/null || true
	git fetch origin dev --quiet 2>/dev/null || warn "Could not fetch origin/dev"
	git reset --hard origin/dev --quiet 2>/dev/null || warn "Could not reset to origin/dev"

	# Delete repatriation branch locally
	if [[ -n "$repatriation_branch" ]]; then
		git branch -D "$repatriation_branch" 2>/dev/null || true
	fi

	# Restore self-hosted Forgejo mirror
	local local_url local_repo local_token
	local_url=$(failover_json_field "selfhosted_forgejo_url")
	local_repo=$(failover_json_field "selfhosted_forgejo_repo")
	local_token="${SELFHOSTED_FORGEJO_TOKEN:-${FORGEJO_TOKEN:-}}"
	local mirror_converted
	mirror_converted=$(failover_json_field "mirror_converted")
	local original_mirror_url
	original_mirror_url=$(failover_json_field "original_mirror_url")
	local codeberg_dev_sha
	codeberg_dev_sha=$(failover_json_field "codeberg_dev_sha")
	local local_dev_sha
	local_dev_sha=$(git rev-parse dev 2>/dev/null)

	if [[ -n "$local_url" ]] && [[ -n "$local_repo" ]]; then
		local saved_token="${FORGEJO_TOKEN:-}"
		export FORGEJO_TOKEN="$local_token"
		local api_url="$local_url/api/v1/repos/$local_repo"

		if [[ "$mirror_converted" == "True" || "$mirror_converted" == "true" ]]; then
			# Mirror was converted to regular repo during engage.
			# Safe restore: create mirror under temp name first, then swap.
			echo ""
			echo "   📋 Restoring mirror on self-hosted Forgejo..."

			local mirror_source="${original_mirror_url:-}"
			if [[ -z "$mirror_source" ]]; then
				mirror_source=$(git remote get-url origin 2>/dev/null || echo "")
			fi

			if [[ -z "$mirror_source" ]]; then
				warn "Could not determine mirror source URL."
				warn "Re-create the mirror manually on self-hosted Forgejo."
			else
				local repo_owner repo_name
				repo_owner="${local_repo%%/*}"
				repo_name="${local_repo##*/}"
				local temp_name="${repo_name}-mirror-restore"

				# Step 1: Create mirror under temp name
				echo "   Creating mirror as '$temp_name'..."
				local migrate_payload
				migrate_payload=$(python3 -c "
import json
payload = {
    'clone_addr': '$mirror_source',
    'mirror': True,
    'mirror_interval': '10m',
    'repo_name': '$temp_name',
    'repo_owner': '$repo_owner',
    'service': 'gitea'
}
print(json.dumps(payload))
")
				if api_post "$local_url/api/v1/repos/migrate" "$migrate_payload"; then
					echo "   ✅ Mirror created as $repo_owner/$temp_name"

					# Step 2: Delete the old regular repo
					echo "   Deleting old regular repo ($repo_name)..."
					if api_call DELETE "$api_url"; then
						echo "   ✅ Old repo deleted"

						# Step 3: Rename temp mirror to original name
						echo "   Renaming $temp_name → $repo_name..."
						if api_patch "$local_url/api/v1/repos/$repo_owner/$temp_name" \
							"{\"name\": \"$repo_name\"}"; then
							echo "   ✅ Mirror restored as $local_repo"
						else
							warn "Rename failed (HTTP $API_HTTP_CODE)"
							echo "   Mirror exists as: $local_url/$repo_owner/$temp_name"
							echo "   Rename it manually to '$repo_name' in the Forgejo web UI."
						fi
					else
						warn "Could not delete old repo (HTTP $API_HTTP_CODE)"
						echo "   Mirror exists as: $local_url/$repo_owner/$temp_name"
						echo "   Delete '$repo_name' and rename '$temp_name' manually."
					fi
				else
					warn "Mirror creation failed (HTTP $API_HTTP_CODE)"
					echo "   The regular repo is untouched — nothing was lost."
					echo "   Re-create the mirror manually when ready."
				fi
			fi
		else
			# Repo was already a regular repo (or mirror wasn't converted).
			# Just re-enable mirror sync if it was paused.
			echo "   Re-enabling mirror sync on self-hosted Forgejo..."
			if api_patch "$api_url" '{"mirror_interval":"10m"}'; then
				echo "   ✅ Mirror sync re-enabled (10m interval)"
			else
				warn "Could not re-enable mirror sync (HTTP $API_HTTP_CODE)"
			fi

			# Trigger immediate sync
			if api_post "$api_url/mirror-sync" ""; then
				echo "   ✅ Mirror sync triggered"
			else
				warn "Could not trigger immediate mirror sync"
			fi
		fi
		export FORGEJO_TOKEN="$saved_token"

		# Clean up remote feature branches on self-hosted Forgejo (skip if repo was just re-created)
		if [[ "$mirror_converted" != "True" && "$mirror_converted" != "true" ]]; then
			local prs_count
			prs_count=$(python3 -c "
import json
data = json.load(open('$FAILOVER_FILE'))
prs = data.get('prs_merged_locally', [])
print(len(prs))
for pr in prs:
    print(pr.get('branch', ''))
" 2>/dev/null || echo "0")

			local pr_total branch_list
			pr_total=$(echo "$prs_count" | head -1)
			branch_list=$(echo "$prs_count" | tail -n +2)

			if [[ "$pr_total" -gt 0 ]] && [[ -n "$branch_list" ]]; then
				echo "   Cleaning up $pr_total feature branch(es) on self-hosted Forgejo..."
				while IFS= read -r branch; do
					[[ -z "$branch" ]] && continue
					git push selfh --delete "$branch" 2>/dev/null || true
				done <<<"$branch_list"
			fi
		fi

		# Remove selfh remote (no longer needed)
		git remote remove selfh 2>/dev/null || true
	fi

	# Print summary
	echo ""
	echo "---------------------------------------------------"
	local pr_total_display
	pr_total_display=$(python3 -c "
import json
data = json.load(open('$FAILOVER_FILE'))
prs = data.get('prs_merged_locally', [])
print(len(prs))
for pr in prs:
    print(f\"  - Self-hosted PR #{pr.get('pr_num', '?')}: {pr.get('title', '(untitled)')}\")
" 2>/dev/null || echo "0")

	local count
	count=$(echo "$pr_total_display" | head -1)
	echo "📊 Summary:"
	echo "   PRs merged on self-hosted Forgejo: $count"
	if [[ "$count" -gt 0 ]]; then
		echo "$pr_total_display" | tail -n +2
	fi
	echo "   Codeberg PR: #$pr_num (repatriation)"
	echo "   dev: ${codeberg_dev_sha:0:7} → ${local_dev_sha:0:7}"

	# Remove flag file and PR_PENDING
	rm -f "$FAILOVER_FILE"
	rm -f "$REPO_ROOT/.git/PR_PENDING"

	echo ""
	echo "====================================================================="
	echo ""
	echo "  ✅ CI FAILOVER FULLY DISENGAGED"
	echo ""
	echo "  All failover-period work is now on Codeberg."
	echo "  auto-pr, merge-pr, and ci-debug target Codeberg."
	echo "  Self-hosted Forgejo mirror is restored as warm standby."
	echo ""
	echo "  Normal operations resumed."
	echo ""
	echo "====================================================================="
}

# ------------------------------------------------------------------
# status: Show current failover state
# ------------------------------------------------------------------
cmd_status() {
	if [[ -f "$FAILOVER_FILE" ]]; then
		local engaged_at local_url codeberg_sha local_sha prs_info
		engaged_at=$(failover_json_field "engaged_at")
		local_url=$(failover_json_field "selfhosted_forgejo_url")
		codeberg_sha=$(failover_json_field "codeberg_dev_sha")
		local_sha=$(git rev-parse dev 2>/dev/null || echo "unknown")

		echo "🔴 CI Failover: ENGAGED"
		echo "   Since:          $engaged_at"
		echo "   Self-hosted Forgejo:  $local_url"
		echo "   Codeberg dev:   ${codeberg_sha:0:7} (at engage time)"
		echo "   Local dev:      ${local_sha:0:7}"

		# Show commit delta
		local commits_ahead=0
		if git rev-parse "$codeberg_sha" >/dev/null 2>&1; then
			commits_ahead=$(git rev-list --count "$codeberg_sha..dev" 2>/dev/null || echo "?")
		fi
		echo "   Commits ahead:  $commits_ahead"

		# Count PRs merged locally
		local pr_count
		pr_count=$(python3 -c "
import json
data = json.load(open('$FAILOVER_FILE'))
prs = data.get('prs_merged_locally', [])
print(len(prs))
for pr in prs:
    print(f\"  - PR #{pr.get('pr_num', '?')}: {pr.get('title', '(untitled)')}\")
" 2>/dev/null || echo "0")
		local count
		count=$(echo "$pr_count" | head -1)
		echo "   PRs merged:     $count"
		if [[ "$count" -gt 0 ]]; then
			echo "$pr_count" | tail -n +2
		fi

		echo ""
		# Probe Codeberg
		if codeberg_reachable; then
			echo "   💡 Codeberg appears to be back — consider running: ./scripts/ci-failover disengage"
		else
			echo "   ℹ️  Codeberg is still unreachable"
		fi
	else
		echo "🟢 CI Failover: Normal mode"
		echo "   auto-pr targets Codeberg"
		echo ""
		# Health check
		if codeberg_reachable; then
			echo "   ✅ Codeberg is reachable"
		else
			echo "   ⚠️  Codeberg appears unreachable"
			echo "   💡 Consider engaging failover: ./scripts/ci-failover engage"
		fi
	fi
}

# ------------------------------------------------------------------
# Main dispatch
# ------------------------------------------------------------------
case "${1:-}" in
engage)
	shift
	cmd_engage "$@"
	;;
disengage)
	shift
	cmd_disengage "$@"
	;;
disengage-cleanup)
	shift
	cmd_disengage_cleanup "$@"
	;;
status)
	cmd_status
	;;
help | --help | -h)
	echo "ci-failover: Switch CI targeting between Codeberg and self-hosted Forgejo"
	echo ""
	echo "Usage: ci-failover <command> [options]"
	echo ""
	echo "Commands:"
	echo "  engage             Switch to self-hosted Forgejo for CI"
	echo "  disengage          Create repatriation PR on Codeberg (Phase 1)"
	echo "  disengage-cleanup  Finalize disengage after PR is merged (Phase 2)"
	echo "  status             Show current failover state"
	echo ""
	echo "Disengage is a two-phase process because 'dev' is branch-protected:"
	echo "  1. 'disengage' creates a PR on Codeberg with all failover commits"
	echo "  2. Human reviews and merges the PR on Codeberg"
	echo "  3. 'disengage-cleanup' verifies merge, restores mirror, clears flag"
	echo ""
	echo "Engage options:"
	echo "  --local-url URL  Override SELFHOSTED_FORGEJO_URL"
	echo "  --force          Skip precondition checks"
	echo ""
	echo "Disengage options:"
	echo "  --skip-ci        Don't poll Codeberg CI after pushing"
	echo "  --force          Skip precondition checks / re-create PR"
	echo ""
	echo "Environment (set in .env):"
	echo "  SELFHOSTED_FORGEJO_URL    Base URL of self-hosted Forgejo"
	echo "  SELFHOSTED_FORGEJO_TOKEN  API token for self-hosted Forgejo"
	echo "  SELFHOSTED_FORGEJO_REPO   Repo slug (e.g., user/hypergumbo)"
	echo "  SELFHOSTED_FORGEJO_USER   Username (defaults to FORGEJO_USER)"
	;;
*)
	echo "Usage: ci-failover {engage|disengage|disengage-cleanup|status|--help}"
	exit 1
	;;
esac

#!/usr/bin/env python3
"""
bakeoff-deep - Feature-focused hypergumbo bakeoff runner

This script orchestrates a deep bakeoff cycle focused on testing hypergumbo's
advanced features (slice, reverse-slice, supply chain, graph operations) on
diverse, larger repositories.

## Philosophy: Different From Regular Bakeoff

This is a **separate bakeoff loop**, not integrated into `scripts/bakeoff-broad`:
- **Different repo profiles:** Feature testing needs heavier repos (20-200MB)
  where slice limits actually matter
- **Different cadence:** Regular bakeoff for quick regression; feature bakeoff
  less often (includes expensive LLM reasoning)
- **Different artifacts:** Produces slice/reverse-slice/tier outputs not needed
  by regular bakeoff
- **Separation of concerns:** Regular bakeoff: "does hypergumbo parse correctly?"
  Feature bakeoff: "are outputs useful to developers?"

## Usage

    # Initialize a new feature bakeoff session (creates timestamped dir in canonical default)
    ./scripts/bakeoff-deep init --pool ~/repos

    # Select cohort — auto-selection (larger repos than regular bakeoff)
    ./scripts/bakeoff-deep cohort --count 4 --min-size 20 --max-size 200

    # Or select cohort — explicit repos (for curriculum-based workflows)
    ./scripts/bakeoff-deep cohort --repos repo-a,repo-b,repo-c

    # Run feature battery on cohort
    ./scripts/bakeoff-deep run

    # Generate diagnostic report with quality metrics
    ./scripts/bakeoff-deep diagnose

    # Check session status
    ./scripts/bakeoff-deep status

    # Full cycle: run + diagnose
    ./scripts/bakeoff-deep cycle

## Quality Metrics

Slice Quality:
| Metric              | Good Range  | Warning       |
|---------------------|-------------|---------------|
| avg_slice_nodes     | 20-2000*    | <5 or >5000   |
| slice_coverage_pct  | 0.1-20%     | <0.01% or >50%|
| limit_hit_frequency | <50%        | >80%          |
| cross_file_ratio    | >20%        | <5%           |

*avg_slice_nodes good_min scales to max(5, total_nodes*0.1) for repos <200 nodes.

Supply Chain:
| Metric     | Good Range | Warning        |
|------------|------------|----------------|
| tier1_pct  | 15-100%    | <5%            |
| tier4_pct  | 0-5%       | >10%           |

Graph:
| Metric          | Good Range | Warning        |
|-----------------|------------|----------------|
| centrality_gini | 30%-85%    | <10% or >95%   |
| orphan_rate     | <15%       | >35%           | (non-test code nodes)

Environment:
    BAKEOFF_FEATURES_WORKDIR: Override workdir location
    BAKEOFF_FEATURES_POOL: Override repo pool location
"""

import argparse
import datetime
import glob
import gzip
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Optional


# =============================================================================
# Configuration
# =============================================================================

DEFAULT_COHORT_SIZE = 4
DEFAULT_MIN_SIZE_MB = 20
DEFAULT_MAX_SIZE_MB = 200
MIN_FILE_COUNT = 500  # Minimum files for complexity
DEFAULT_BAKEOFF_DIR = os.path.expanduser("~/hypergumbo_lab_notebook/bakeoff_artifacts")

# Issue severity levels
SEVERITY_CRITICAL = "CRITICAL"
SEVERITY_HIGH = "HIGH"
SEVERITY_MEDIUM = "MEDIUM"
SEVERITY_LOW = "LOW"

# Node kinds that represent callable/structural code symbols (for orphan rate).
# Excludes documentation (section, link, code_block), CSS (class_selector, rule_set),
# build config (dependency, devDependency, tsconfig, requirement, etc.),
# and data declarations (variable) — variables/fields/parameters are naturally
# not connected by call edges and would inflate the orphan rate.
# Also excludes: directive (Vue template annotations like v-if, @click, :src —
# not callable code), scalar (GraphQL scalar types — no call edges),
# type (TypeScript type aliases — type-level declarations, not callable),
# interface (TypeScript/Java interface declarations — structural types, may have
# implements/extends edges but are not callable code themselves; on GrowthBook
# 2,133 type+interface nodes were 100% orphaned, inflating rate from ~23% to 39%).
_CODE_NODE_KINDS = frozenset({
    "function", "method", "class", "module", "struct",
    "enum", "trait", "constructor", "getter", "setter",
    "route", "export", "service",
    "event_subscriber", "event_publisher", "websocket_endpoint",
    "http_client", "mq_subscriber", "mq_publisher", "rpc",
    "subprocess_call", "graphql_resolver", "db_query",
})

# Path segments that indicate test files. Used to filter entrypoints before
# slicing with --exclude-tests (test-file entries yield empty slices).
# Covers: Python (tests/, test_), JS (__tests__/, spec/, _test.),
# JVM (Test*.java, *IT.java, *Tests.java, src/test/, src/integration/),
# Go (unittest/), C/Perl (t/, test-*.c).
#
# IMPORTANT: Each directory-name pattern MUST require a trailing `/` to
# avoid false positives on partial matches.  Without this, `/spec` inside
# `/special_repos/` (the bakeoff pool path) matched, filtering out ALL
# entrypoints and producing zero forward slices for every repo in the pool.
_TEST_PATH_RE = re.compile(
    r'(?:^|/)(tests?|spec|__tests__|test-[^/]+|unittest)/' # dirs (incl. test-artifacts/)
    r'|(?:^|/)(t)/'                                   # t/ (C/Perl convention)
    r'|(?:^|/)test_[^/]'                               # test_ prefix files
    r'|(?:^|/)integration/'                            # integration test dirs
    r'|_test\.'                                        # Go: *_test.go
    r'|\.(?:test|spec)\.'                              # JS/TS: *.test.js, *.spec.ts
    r'|/Test[A-Z][^/]*\.java'                          # JVM: TestFoo.java
    r'|/[A-Z]\w*(?:IT|Tests?)\.(?:java|scala|kt)'     # JVM: FooIT.java, FooTest.java
    r'|(?:^|/)tests\.rs$'                                # Rust: co-located test module
    r'|(?:^|/)testonly[/.]'                             # Rust: testonly/ dirs and testonly.rs
)

# Annotation names that indicate a test function/method.
# Covers Rust (#[test], #[tokio::test], #[actix_rt::test], #[async_std::test]),
# Java/Kotlin (@Test, @org.junit.Test), and C# ([TestMethod], [Fact], [Theory]).
_TEST_ANNOTATION_NAMES = frozenset({
    "test", "Test",
    "tokio::test", "actix_rt::test", "async_std::test",
    "org.junit.Test", "org.junit.jupiter.api.Test",
    "TestMethod", "Fact", "Theory",
})


def _is_test_node(node: dict) -> bool:
    """Check if a node is test code by path or annotation.

    Extends file-path matching with annotation-based detection so that
    Rust ``#[test]``/``#[cfg(test)]`` functions in non-test files (e.g.
    ``src/lib.rs``) are correctly identified as test nodes.  This prevents
    test functions from appearing as rslice seed candidates and ensures
    edges from test functions don't inflate production in-degree.
    """
    if _TEST_PATH_RE.search(node.get("path", "")):
        return True
    meta = node.get("meta") or {}
    for key in ("decorators", "annotations"):
        for dec in (meta.get(key) or []):
            name = dec.get("name", "")
            if name in _TEST_ANNOTATION_NAMES:
                return True
            # Rust #[cfg(test)] — "cfg" with "test" in args
            if name == "cfg":
                for arg in (dec.get("args") or []):
                    if isinstance(arg, str) and "test" in arg:
                        return True
    return False


# Quality thresholds
QUALITY_THRESHOLDS = {
    "avg_slice_nodes": {"good_min": 20, "good_max": 2000, "warn_min": 5, "warn_max": 5000},
    "slice_coverage_pct": {"good_min": 0.1, "good_max": 20, "warn_min": 0.01, "warn_max": 50},
    "limit_hit_frequency": {"good_max": 50, "warn_max": 80},
    "cross_file_ratio": {"good_min": 20, "warn_min": 5},
    # Monorepos with many internal packages (e.g., hypergumbo with 100+ lang
    # packages depending on core) naturally have low tier-1 percentages because
    # sibling packages are classified as tier-2 (internal_dep). A 15% floor
    # accommodates these structures while still flagging repos where almost
    # everything is third-party. Single-language library repos (e.g., Swift
    # packages like Alamofire, SwiftyJSON) legitimately have 100% tier 1.
    "tier1_pct": {"good_min": 15, "good_max": 100, "warn_min": 5, "warn_max": 100},
    "tier4_pct": {"good_max": 5, "warn_max": 10},
    "centrality_gini": {"good_min": 30, "good_max": 85, "warn_min": 10, "warn_max": 95},
    # Polyglot repos have a structural orphan floor from languages without
    # cross-language edges (e.g., alertmanager: Elm 241, Jsonnet 94 orphans
    # that would need Go-Elm HTTP or Jsonnet-Go config linkers to connect).
    "orphan_rate": {"good_max": 20, "warn_max": 35},
    # IO boundary: 5-60% of call edges tagged is healthy. good_min scales down
    # for larger repos (see assess_metric). warn_min is a hard floor for FAIL:
    # <0.1% means essentially zero IO detection, suggesting a catalog gap or
    # analyzer bug. Previously 1%, but large Java/Go repos (50K+ nodes) with
    # 100K+ call edges legitimately have 0.5-1% IO rates.
    "io_tag_rate": {"good_min": 5, "good_max": 60, "warn_min": 0.1, "warn_max": 80},
    # Dataflow slice should be meaningfully tighter than regular slice (ratio <90%)
    # but not degenerate (ratio >10%). Ratio of 100% means --dataflow adds no value.
    # Stored as 0-1 ratio but assessed as percentage (multiplied by 100 in metric_assessments).
    "dataflow_slice_ratio": {"good_min": 10, "good_max": 90, "warn_min": 1, "warn_max": 99},
    # Access mode annotations on 10-80% of edges is healthy. <2% means dataflow
    # YAML is missing patterns; >95% suggests annotation is too aggressive.
    "access_mode_coverage": {"good_min": 10, "good_max": 80, "warn_min": 2, "warn_max": 95},
    # Cross-language IO: at least 5% of IO chains should traverse a linker edge
    # in polyglot repos. Only assessed when repo has 2+ languages.
    "cross_language_io_pct": {"good_min": 5, "warn_min": 1},
}


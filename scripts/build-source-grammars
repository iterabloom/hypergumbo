#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Build tree-sitter grammars that are not available on PyPI.
#
# This script builds tree-sitter-lean, tree-sitter-wolfram, and
# tree-sitter-circom from source. These grammars require building because
# they are not published to PyPI.
#
# Source is vendored under vendor/tree-sitter-{lean,wolfram,circom}/
# (WI-fipab-kivoj) — the build is offline-deterministic and does not
# clone from upstream. To re-sync from upstream, see
# docs/grammars/vendor-sync.md.
#
# Requirements:
# - gcc or clang (C/C++ compiler)
# - Python development headers
# - pip
#
# Usage:
#   ./scripts/build-source-grammars                    # Build and install
#   ./scripts/build-source-grammars --wheels-dir DIR   # Use DIR for wheel caching
#
# With --wheels-dir:
#   - If DIR contains pre-built wheels, installs from them (fast)
#   - Otherwise, builds wheels, saves to DIR, then installs
#
set -euo pipefail

BUILD_DIR="${BUILD_DIR:-/tmp/ts-grammar-build}"
WHEELS_DIR=""

# Repo root resolution (script lives in $REPO/scripts/).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VENDOR_ROOT="$REPO_ROOT/vendor"

# Pinning is preserved in vendor/tree-sitter-<name>/UPSTREAM. Updating a
# grammar version means re-syncing the vendor directory per
# docs/grammars/vendor-sync.md and bumping SHAPE_ID_SCHEME if shape_id
# values change (ADR-0014 §6).

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --wheels-dir)
            WHEELS_DIR="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

mkdir -p "$BUILD_DIR"
if [ -n "$WHEELS_DIR" ]; then
    mkdir -p "$WHEELS_DIR"
fi

# Check if we can install from cached wheels
install_from_wheels() {
    if [ -z "$WHEELS_DIR" ]; then
        return 1
    fi

    local lean_wheel="$WHEELS_DIR/tree_sitter_lean-"*.whl
    local wolfram_wheel="$WHEELS_DIR/tree_sitter_wolfram-"*.whl
    local circom_wheel="$WHEELS_DIR/tree_sitter_circom-"*.whl

    # Check if all wheels exist
    if ls $lean_wheel 1>/dev/null 2>&1 && ls $wolfram_wheel 1>/dev/null 2>&1 && ls $circom_wheel 1>/dev/null 2>&1; then
        echo "Installing from cached wheels..."
        python3 -m pip install "$WHEELS_DIR"/tree_sitter_lean-*.whl --quiet --no-cache-dir 2>&1 || return 1
        python3 -m pip install "$WHEELS_DIR"/tree_sitter_wolfram-*.whl --quiet --no-cache-dir 2>&1 || return 1
        python3 -m pip install "$WHEELS_DIR"/tree_sitter_circom-*.whl --quiet --no-cache-dir 2>&1 || return 1
        echo "Successfully installed grammars from wheels"
        return 0
    fi

    return 1
}

# Try installing from cached wheels first
if install_from_wheels; then
    echo ""
    echo "=== Grammars installed from cache ==="
    python3 -c "import tree_sitter_lean; print('tree-sitter-lean:', tree_sitter_lean.language())"
    python3 -c "import tree_sitter_wolfram; print('tree-sitter-wolfram:', tree_sitter_wolfram.language())"
    python3 -c "import tree_sitter_circom; print('tree-sitter-circom:', tree_sitter_circom.language())"
    exit 0
fi

echo "Building tree-sitter grammars from source..."
echo "Build directory: $BUILD_DIR"
if [ -n "$WHEELS_DIR" ]; then
    echo "Wheels directory: $WHEELS_DIR"
fi

# Function to build a grammar
# Args: name, function_name, scanner_type (none|c|cc)
# WI-fipab-kivoj: source comes from vendor/tree-sitter-<name>/ (vendored,
# not cloned). Upstream URL + pinned commit are recorded in
# vendor/tree-sitter-<name>/UPSTREAM and docs/grammars/vendor-sync.md.
build_grammar() {
    local name="$1"
    local function_name="$2"
    local scanner_type="${3:-none}"

    local repo_dir="$VENDOR_ROOT/tree-sitter-$name"
    local pkg_dir="$BUILD_DIR/tree-sitter-$name-py"
    local module_name="tree_sitter_$name"

    echo ""
    echo "=== Building tree-sitter-$name ==="

    if [ ! -d "$repo_dir/src" ]; then
        echo "Error: vendored source not found at $repo_dir/src"
        echo "See docs/grammars/vendor-sync.md to restore the vendor tree."
        return 1
    fi

    # Create Python package directory
    rm -rf "$pkg_dir"
    mkdir -p "$pkg_dir/$module_name"

    # Create __init__.py
    cat > "$pkg_dir/$module_name/__init__.py" << 'EOF'
"""Grammar for tree-sitter."""

from ._binding import language

__all__ = ["language"]
EOF

    # Create binding.c
    cat > "$pkg_dir/$module_name/binding.c" << BINDINGEOF
#include <Python.h>

typedef struct TSLanguage TSLanguage;

TSLanguage *$function_name(void);

static PyObject* _binding_language(PyObject *Py_UNUSED(self), PyObject *Py_UNUSED(args)) {
    return PyCapsule_New($function_name(), "tree_sitter.Language", NULL);
}

static PyMethodDef methods[] = {
    {"language", _binding_language, METH_NOARGS,
     "Get the tree-sitter language for this grammar."},
    {NULL, NULL, 0, NULL}
};

static struct PyModuleDef module = {
    .m_base = PyModuleDef_HEAD_INIT,
    .m_name = "_binding",
    .m_doc = NULL,
    .m_size = -1,
    .m_methods = methods
};

PyMODINIT_FUNC PyInit__binding(void) {
    return PyModule_Create(&module);
}
BINDINGEOF

    # Build sources list based on scanner type
    local sources="os.path.join(SRC_DIR, 'parser.c'), '$module_name/binding.c'"
    local extra_compile_args="['-std=c11', '-Wno-unused-parameter']"

    case "$scanner_type" in
        c)
            sources="os.path.join(SRC_DIR, 'parser.c'), os.path.join(SRC_DIR, 'scanner.c'), '$module_name/binding.c'"
            ;;
        cc)
            sources="os.path.join(SRC_DIR, 'parser.c'), os.path.join(SRC_DIR, 'scanner.cc'), '$module_name/binding.c'"
            extra_compile_args="['-std=c++14', '-Wno-unused-parameter']"
            ;;
    esac

    cat > "$pkg_dir/setup.py" << SETUPEOF
"""Setup for tree-sitter-$name Python bindings."""
from setuptools import setup, Extension
import os

TREE_SITTER_DIR = '$repo_dir'
SRC_DIR = os.path.join(TREE_SITTER_DIR, 'src')

ext_module = Extension(
    '$module_name._binding',
    sources=[$sources],
    include_dirs=[SRC_DIR],
    extra_compile_args=$extra_compile_args,
)

setup(
    name='tree-sitter-$name',
    version='0.1.0',
    description='$name grammar for tree-sitter',
    packages=['$module_name'],
    ext_modules=[ext_module],
    python_requires='>=3.9',
    install_requires=['tree-sitter>=0.21.0'],
)
SETUPEOF

    # Build wheel if wheels directory is specified
    if [ -n "$WHEELS_DIR" ]; then
        echo "Building wheel..."
        python3 -m pip wheel "$pkg_dir" -w "$WHEELS_DIR" --quiet --no-cache-dir 2>&1
        echo "Installing from wheel..."
        python3 -m pip install "$WHEELS_DIR"/tree_sitter_${name}-*.whl --quiet --no-cache-dir 2>&1
        echo "Successfully built and installed tree-sitter-$name"
        return 0
    fi

    # Build and install with retry logic (compilation can OOM on small runners)
    echo "Building and installing..."
    local max_retries=3
    local retry=0
    while [ $retry -lt $max_retries ]; do
        # Clear pip cache to free memory before each attempt
        python3 -m pip cache purge 2>/dev/null || true

        if python3 -m pip install "$pkg_dir" --quiet --no-cache-dir 2>&1; then
            echo "Successfully installed tree-sitter-$name"
            return 0
        fi

        retry=$((retry + 1))
        if [ $retry -lt $max_retries ]; then
            echo "Build failed (possibly OOM), retrying ($retry/$max_retries)..."
            # Clean up build artifacts to free memory
            rm -rf "$pkg_dir/build" "$pkg_dir/*.egg-info" 2>/dev/null || true
            # Flush filesystem buffers
            sync 2>/dev/null || true
            # Try to drop OS caches if we have permission (CI may run as root)
            echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
            sleep 3
        else
            echo "Failed to build tree-sitter-$name after $max_retries attempts"
            return 1
        fi
    done
}

# Build tree-sitter-lean (vendor: vendor/tree-sitter-lean/, scanner.c)
build_grammar "lean" "tree_sitter_lean" "c"

# Build tree-sitter-wolfram (vendor: vendor/tree-sitter-wolfram/, scanner.cc)
build_grammar "wolfram" "tree_sitter_wolfram" "cc"

# Build tree-sitter-circom (vendor: vendor/tree-sitter-circom/, no scanner)
build_grammar "circom" "tree_sitter_circom" "none"

echo ""
echo "=== All grammars built successfully ==="
echo ""

# Verify installation
python3 -c "import tree_sitter_lean; print('tree-sitter-lean:', tree_sitter_lean.language())"
python3 -c "import tree_sitter_wolfram; print('tree-sitter-wolfram:', tree_sitter_wolfram.language())"
python3 -c "import tree_sitter_circom; print('tree-sitter-circom:', tree_sitter_circom.language())"

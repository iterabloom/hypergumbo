#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Refresh the ``stdlib_modules`` section of an IO-primitive YAML catalog.

F3 PR-C operator script. Updates the authoritative interpreter list of
stdlib modules for a single language by reading the live interpreter
and writing the sorted result back into the corresponding YAML file
between sentinel markers.

Scope deliberately narrow:

- This script regenerates ONLY the ``stdlib_modules`` block and
  touches ``stdlib_provenance.retrieved``. It does NOT regenerate
  IO-primitive lists, ``stdlib_other``, or ``stdlib_module_completeness``
  flags. Those stay hand-maintained: closed-world claims demand
  per-module human audit, not a script that scrapes interpreter
  state.

- Currently implements Python only. ``--language`` accepts other
  values but prints a "not yet implemented" message and exits 1 for
  them; community contributions should follow the Python shape:
  authoritative interpreter source, version pin, sentinel markers.

Determinism: same script + same interpreter version → byte-identical
YAML output. Run twice to confirm.

Python: the list is the UNION over every supported interpreter (WI-gisan,
ADR-0041 §3). ``--version`` names the BASE interpreter whose
``sys.stdlib_module_names`` is read, and which must be the one running.
Every module in ``hypergumbo_core.python_stdlib_versions``'s version windows
is added on top, so a module that is standard library on only SOME supported
Pythons (``distutils`` on 3.10/3.11, ``tomllib`` on 3.11+) is recognised
whichever one runs this. ``stdlib_provenance.supported_versions`` must equal
that table's span, so the YAML cannot claim a range the list was not built
for.

Usage::

    scripts/refresh-stdlib-modules python --version 3.12
"""
from __future__ import annotations

import argparse
import datetime
import re
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
CATALOG_DIR = (
    REPO_ROOT
    / "packages"
    / "hypergumbo-core"
    / "src"
    / "hypergumbo_core"
    / "io_primitives"
)

BEGIN_MARKER_FMT = "  # BEGIN generated by scripts/refresh-stdlib-modules {language}"
END_MARKER_FMT = "  # END generated"


def _refresh_python(yaml_path: Path, requested_version: str) -> int:
    """Refresh python.yaml's stdlib_modules block.

    Validates that ``sys.version_info[:2]`` matches the requested version
    AND that the YAML's ``stdlib_provenance.version`` agrees. Then
    reads ``sys.stdlib_module_names``, writes the sorted list between
    sentinel markers, and updates ``stdlib_provenance.retrieved`` to
    today's UTC date.
    """
    interp_major, interp_minor = sys.version_info[:2]
    interp_version = f"{interp_major}.{interp_minor}"
    if interp_version != requested_version:
        print(
            f"ERROR: --version {requested_version} does not match the "
            f"running interpreter ({interp_version}). Re-run with the "
            f"intended Python.",
            file=sys.stderr,
        )
        return 1

    text = yaml_path.read_text(encoding="utf-8")

    # Confirm stdlib_provenance.version matches before rewriting.
    prov_version_match = re.search(
        r'^\s*version:\s*"(?P<v>[^"]+)"\s*$',
        text,
        re.MULTILINE,
    )
    if prov_version_match is None:
        print(
            f"ERROR: could not find stdlib_provenance.version in "
            f"{yaml_path}.",
            file=sys.stderr,
        )
        return 1
    yaml_version = prov_version_match.group("v")
    if yaml_version != requested_version:
        print(
            f"ERROR: --version {requested_version} does not match "
            f"stdlib_provenance.version {yaml_version!r} in {yaml_path}. "
            f"Edit the YAML first if you intend to bump the catalog's "
            f"declared interpreter version.",
            file=sys.stderr,
        )
        return 1

    from hypergumbo_core.python_stdlib_versions import (
        PYTHON_STDLIB_VERSION_WINDOWS,
        supported_versions_label,
    )

    expected_span = supported_versions_label()
    span_match = re.search(
        r'^\s*supported_versions:\s*"(?P<s>[^"]+)"\s*$', text, re.MULTILINE,
    )
    if span_match is None or span_match.group("s") != expected_span:
        found = span_match.group("s") if span_match else "(missing)"
        print(
            f"ERROR: stdlib_provenance.supported_versions is {found!r} in "
            f"{yaml_path}; the shared table "
            f"(hypergumbo_core/python_stdlib_versions.py) covers "
            f"{expected_span!r}. The list is written as the union over "
            f"exactly those interpreters, so the YAML must declare them.",
            file=sys.stderr,
        )
        return 1

    modules = sorted(
        set(sys.stdlib_module_names) | set(PYTHON_STDLIB_VERSION_WINDOWS)
    )

    begin = BEGIN_MARKER_FMT.format(language="python")
    end = END_MARKER_FMT

    block_lines = [begin]
    for mod in modules:
        block_lines.append(f"  - {mod}")
    block_lines.append(end)
    new_block = "\n".join(block_lines)

    if begin in text and end in text:
        # Replace existing block.
        block_re = re.compile(
            re.escape(begin) + r"\n(?:.*\n)*?" + re.escape(end),
            re.MULTILINE,
        )
        new_text = block_re.sub(new_block, text, count=1)
    else:
        # First-time insert: append a fresh ``stdlib_modules:`` section
        # at the end of the file, between markers.
        new_text = (
            text.rstrip()
            + "\n\nstdlib_modules:\n"
            + new_block
            + "\n"
        )

    # Update ``retrieved:`` to today's UTC date. Pattern is intentionally
    # narrow so we only touch the provenance field, not other ``retrieved:``
    # mentions elsewhere in the YAML.
    today = datetime.datetime.now(tz=datetime.timezone.utc).date().isoformat()
    new_text = re.sub(
        r'^(\s*retrieved:\s*)"[^"]+"(\s*)$',
        rf'\1"{today}"\2',
        new_text,
        count=1,
        flags=re.MULTILINE,
    )

    if new_text == text:
        print("(no changes)")
        return 0

    yaml_path.write_text(new_text, encoding="utf-8")
    try:
        display_path = yaml_path.relative_to(REPO_ROOT)
    except ValueError:
        # Test fixtures (under /tmp) live outside REPO_ROOT — fall back
        # to the absolute path for the success line.
        display_path = yaml_path
    print(
        f"Refreshed {len(modules)} stdlib modules for python "
        f"{requested_version} (union over {expected_span}) in {display_path}.",
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Refresh the stdlib_modules block of an IO-primitive YAML "
            "catalog from the running interpreter."
        ),
    )
    parser.add_argument(
        "language",
        help="Language catalog to refresh (e.g. 'python').",
    )
    parser.add_argument(
        "--version",
        required=False,
        help=(
            "Interpreter version (e.g. '3.12'). For 'python' this MUST "
            "match both sys.version_info[:2] and the YAML's "
            "stdlib_provenance.version."
        ),
    )
    args = parser.parse_args()

    if args.language == "python":
        if not args.version:
            print(
                "ERROR: --version is required for 'python'.",
                file=sys.stderr,
            )
            return 1
        yaml_path = CATALOG_DIR / "python.yaml"
        if not yaml_path.is_file():
            print(f"ERROR: {yaml_path} not found.", file=sys.stderr)
            return 1
        return _refresh_python(yaml_path, args.version)

    print(
        f"refresh-stdlib-modules: language {args.language!r} not yet "
        f"implemented; populate manually from authoritative docs and "
        f"add a per-language branch here.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())

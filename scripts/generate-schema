                "properties": {
                    "schema_version": {
                        "type": "string",
                        "description": "validation_report schema version"
                    },
                    "violations": {
                        "type": "array",
                        "items": {"$ref": "#/$defs/ValidationViolation"},
                        "description": "Structured violations, all classes"
                    },
                    "violations_by_class": {
                        "type": "object",
                        "additionalProperties": {"type": "integer"},
                        "description": "Per-validator-class counts"
                    },
                    "stable_id_stats": {
                        "oneOf": [
                            {
                                "type": "object",
                                "properties": {
                                    "total_symbols": {"type": "integer"},
                                    "non_null": {"type": "integer"},
                                    "none_cohort": {"type": "integer"},
                                    "none_cohort_pct": {"type": "number"},
                                    "collision_groups": {"type": "integer"},
                                    "collided_symbols": {"type": "integer"},
                                    "collision_rate_pct": {"type": "number"},
                                    "per_file_collision_groups": {
                                        "type": "integer"
                                    }
                                },
                                "additionalProperties": False
                            },
                            {"type": "null"}
                        ],
                        "description": (
                            "ADR-0035 §5 corpus stable_id "
                            "population/collision/None-cohort disclosure over "
                            "an all-Symbols denominator; always present so a "
                            "clean non-null rate can never hide a None-cohort. "
                            "Null on bare build_validation_report calls (unit "
                            "tests)."
                        )
                    }
                }
            },
            "sketch_precomputed": {
                "type": "object",
                "description": (
                    "Precomputed sketch payload (vocabulary, centrality, "
                    "readme description, config info). Optional; omitted "
                    "when --no-sketch-precomputed. Each sub-field is "
                    "nullable because small repos may not surface a "
                    "README, license, or any centrality signal."
                ),
                "properties": {
                    "centrality_scores": {
                        "oneOf": [
                            {
                                "type": "object",
                                "additionalProperties": {"type": "number"}

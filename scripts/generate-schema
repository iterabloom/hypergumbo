    # ==== Framework Pattern Types (for YAML input validation) ====
    # These definitions are used to validate src/hypergumbo/frameworks/*.yaml files

    # UsagePatternSpec - for matching usage contexts
    schema["$defs"]["UsagePatternSpec"] = {
        "type": "object",
        "description": "Specification for matching usage contexts (call-based frameworks)",
        "properties": {
            "kind": {
                "type": "string",
                "description": "Regex pattern to match context kind (call, data_value, export, macro)"
            },
            "name": {
                "type": "string",
                "description": "Regex pattern to match context_name (function called, var defined, etc.)"
            },
            "position": {
                "type": "string",
                "description": "Regex pattern to match position (args[1], :get, default, etc.)"
            }
        },
        "additionalProperties": False
    }

    # Pattern - a single pattern to match against symbols
    schema["$defs"]["Pattern"] = {
        "type": "object",
        "description": "A pattern to match against symbol metadata or usage contexts",
        "properties": {
            "concept": {
                "type": "string",
                "description": "The concept type this pattern identifies (route, model, task, etc.)"
            },
            "decorator": {
                "type": "string",
                "description": "Regex pattern to match against decorator names"
            },
            "base_class": {
                "type": "string",
                "description": "Regex pattern to match against base class names"
            },
            "parent_base_class": {
                "type": "string",
                "description": "Regex pattern to match parent class's base classes (for methods)"
            },
            "method_name": {
                "type": "string",
                "description": "Regex pattern to match method name (last part of qualified name)"
            },
            "symbol_name": {
                "type": "string",
                "description": "Regex pattern to match symbol name directly"
            },
            "language": {
                "type": "string",
                "description": "Regex pattern to filter by symbol's language"
            },
            "annotation": {
                "type": "string",
                "description": "Regex pattern to match against Java annotations"
            },
            "parameter_type": {
                "type": "string",
                "description": "Regex pattern to match against parameter types"
            },
            "symbol_kind": {
                "type": "string",
                "description": "Regex pattern to match against symbol kind field"
            },
            "extract_path": {
                "type": "string",
                "description": "JSONPath-like expression to extract route path from metadata"
            },
            "extract_method": {
                "type": "string",
                "description": "How to derive HTTP method (decorator_suffix, kwargs.methods, etc.)"
            },
            "prefix_from_parent": {
                "type": "string",
                "description": "Concept name to look up on parent class for path prefix (v1.3.x)"
            },
            "usage": {
                "$ref": "#/$defs/UsagePatternSpec",
                "description": "UsagePatternSpec for matching against UsageContext records"
            },
            "extract": {
                "type": "object",
                "additionalProperties": {"type": "string"},
                "description": "Dict of extraction expressions for usage-based patterns"
            }
        },
        "required": ["concept"],
        "additionalProperties": False
    }

    # FrameworkPatternDef - the top-level framework definition
    schema["$defs"]["FrameworkPatternDef"] = {
        "type": "object",
        "description": "Framework pattern definition (YAML file structure)",
        "properties": {
            "id": {
                "type": "string",
                "description": "Unique framework identifier (e.g., 'fastapi', 'spring')"
            },
            "language": {
                "type": "string",
                "description": "Primary language for this framework"
            },
            "patterns": {
                "type": "array",
                "items": {"$ref": "#/$defs/Pattern"},
                "description": "List of patterns to match"
            },
            "linkers": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Linkers that should be activated when this framework is detected"
            }
        },
        "required": ["id", "language", "patterns"],
        "additionalProperties": False
    }

    return schema


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate JSON Schema")
    parser.add_argument("--check", action="store_true", help="Check if schema is up-to-date")
    args = parser.parse_args()

    output_path = REPO_ROOT / "docs" / "schema.json"
    generated = generate_behavior_map_schema()
    generated_json = json.dumps(generated, indent=2) + "\n"

    if args.check:
        if not output_path.exists():
            print("ERROR: docs/schema.json does not exist")
            print("Run: ./scripts/generate-schema")
            return 1

        existing = output_path.read_text(encoding="utf-8")
        if existing != generated_json:
            print("ERROR: docs/schema.json is out of date")
            print("Run: ./scripts/generate-schema")
            return 1

        print("OK: docs/schema.json is up-to-date")
        return 0

    output_path.write_text(generated_json, encoding="utf-8")
    print(f"Generated {output_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

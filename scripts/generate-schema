            "metrics": {
                "type": "object",
                "description": "Aggregate analysis metrics",
                "properties": {
                    "total_nodes": {
                        "type": "integer",
                        "description": "Number of emitted Symbols"
                    },
                    "total_edges": {
                        "type": "integer",
                        "description": "Number of emitted Edges"
                    },
                    "total_files": {
                        "type": "integer",
                        "description": (
                            "Node-distinct path count — number of distinct "
                            "node.path values that survive analysis (INV-mozaf)"
                        )
                    },
                    "avg_confidence": {
                        "type": "number",
                        "description": "Mean edge confidence (3 decimal places)"
                    },
                    "languages": {
                        "type": "object",
                        "description": "Per-language node/edge/file counts",
                        "additionalProperties": {"type": "object"}
                    },
                    "by_supply_chain_tier": {
                        "type": "object",
                        "description": "Per-tier node/edge counts",
                        "additionalProperties": {"type": "object"}
                    },
                    "debug": {
                        "type": "object",
                        "description": "Introspection counters (not a stable API)",
                        "properties": {
                            "unique_paths_in_analysis": {"type": "integer"},
                            "analyzed_file_symbols": {"type": "integer"},
                            "profile_files_sum": {
                                "type": "integer",
                                "description": (
                                    "Legacy profile-language file-count sum, "
                                    "kept for introspection (over-counts vs "
                                    "node-distinct total_files)"
                                )
                            }
                        }
                    }
                }
            },
            "limits": {
                "$ref": "#/$defs/Limits",
                "description": "Known gaps and limitations"
            },
            "supply_chain_summary": {
                "type": "object",
                "description": "Summary of supply chain classification",
                "properties": {
                    "by_tier": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "properties": {
                                "files": {"type": "integer"},
                                "symbols": {"type": "integer"}
                            }
                        }
                    }
                }
            },
            # INV-piroh sub-issue (b): three top-level keys the CLI
            # produces but the schema didn't declare. All three are part
            # of hypergumbo's documented output contract:
            #   - entrypoints: per-language entrypoint detection results.
            #   - usage_contexts: per ADR-0003-ext usage_context_patterns.
            #   - sketch_precomputed: payload computed during run for
            #     reuse by the sketch step; included by default for
            #     downstream tooling.
            "entrypoints": {
                "type": "array",
                "items": {"$ref": "#/$defs/Entrypoint"},
                "description": "Detected program entrypoints"
            },
            "usage_contexts": {
                "type": "array",
                "items": {"$ref": "#/$defs/UsageContext"},
                "description": (
                    "Concept-tagged call/usage sites (per "
                    "ADR-0003-ext usage_context_patterns)"
                )
            },
            # WI-kutas PR2: reproducibility_context is built by
            # schema.build_reproducibility_context() (ad-hoc dict); its
            # properties are pinned to the builder's key set by

            "reproducibility_context": {
                "type": "object",
                "description": (
                    "L2 reproducibility metadata (INV-morag option B): "
                    "direct dependencies + runtime identity, with an "
                    "explicit not_captured disclosure of L3-L5 factors"
                ),
                "properties": {
                    "level": {
                        "type": "string",
                        "const": "L2",

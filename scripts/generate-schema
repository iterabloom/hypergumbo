        "$defs": {}
    }

    # Span / Symbol / Edge / AnalysisRun $defs are introspected from the
    # dataclasses (structure) + per-field decoration tables (descriptions,
    # x-annotations) in generate_schema_lib.py. The lib hard-fails on
    # overlay-vs-dataclass drift (WI-kutas / WI-kufib).
    schema["$defs"].update(build_all_defs())

    # Add Entrypoint definition (INV-piroh)
    schema["$defs"]["Entrypoint"] = {
        "type": "object",
        "description": (
            "A detected program entrypoint (main function, CLI verb, "
            "HTTP route, etc.). Produced by `detect_entrypoints()`."
        ),
        "properties": {
            "symbol_id": {
                "type": "string",
                "description": "ID of the Symbol that is the entrypoint"
            },
            "kind": {
                "type": "string",
                "description": (
                    "Entrypoint category — e.g. main_function, "
                    "cli_command, http_route, framework_handler"
                )
            },
            "label": {
                "type": "string",
                "description": "Human-readable label for the entrypoint"
            },
            "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Detection confidence"
            }
        },
        "required": ["symbol_id", "kind"]
    }

    # Add UsageContext definition (INV-piroh; see ADR-0003-ext)
    schema["$defs"]["UsageContext"] = {
        "type": "object",
        "description": (
            "Concept-tagged usage site (per ADR-0003-ext "
            "usage_context_patterns) — e.g. a Flask `@app.route` "
            "call or a Django ORM filter."
        ),
        "properties": {
            "id": {
                "type": "string",
                "description": "Stable hash ID for this usage site"
            },
            "context_name": {
                "type": "string",
                "description": (
                    "Name of the function/decorator/sentinel at this "
                    "site (e.g. 'Route', 'session.query')"
                )
            },
            "kind": {
                "type": "string",
                "description": (
                    "Usage kind — call, data_value, export, macro"
                )
            },
            "path": {
                "type": "string",
                "description": "Source file path (relative to repo root)"
            },
            "position": {
                "type": "string",
                "description": (
                    "Position descriptor — e.g. args[0], view_func, "
                    "default (per ADR-0003-ext positional vocabulary)"
                )
            },
            "span": {"$ref": "#/$defs/Span"},

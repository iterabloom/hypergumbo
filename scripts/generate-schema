                    },
                    "not_captured": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": (
                            "Factors that may affect reproducibility but "
                            "are not recorded (transitive deps, OS, hardware)"
                        )
                    },
                    "implications": {
                        "type": "string",
                        "description": (
                            "What diff-attribution level a consumer can "
                            "expect from the captured fields alone"
                        )
                    }

#!/usr/bin/env python3
"""
Rewrite STATUS.md into date-grouped sections showing when features were added.

Walks git history for STATUS.md, finds the first commit where each table row
appeared, and groups content by date (or date+hour).

Usage:
    ./scripts/status-date-bucket              # Preview to stdout
    ./scripts/status-date-bucket --in-place   # Rewrite file (creates .bak)
    ./scripts/status-date-bucket --granularity hour  # Group by hour
"""

from __future__ import annotations

import argparse
import re
import subprocess
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple


# ---------------------
# Git helpers
# ---------------------

def git(args: List[str], cwd: Path, check: bool = True) -> str:
    """Run git command and return stdout."""
    p = subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and p.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed:\n{p.stderr}")
    return p.stdout


def git_show_file(commit: str, relpath: str, repo: Path) -> Optional[str]:
    """Return file content at commit, or None if file doesn't exist there."""
    p = subprocess.run(
        ["git", "show", f"{commit}:{relpath}"],
        cwd=str(repo),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if p.returncode != 0:
        return None
    return p.stdout


def git_commit_date(commit: str, repo: Path) -> str:
    """Committer date (YYYY-MM-DD)."""
    return git(["show", "-s", "--format=%cs", commit], cwd=repo).strip()


def git_commit_datetime(commit: str, repo: Path) -> str:
    """Committer date with hour (YYYY-MM-DD HH:00)."""
    raw = git(["show", "-s", "--format=%ci", commit], cwd=repo).strip()
    parts = raw.split()
    if len(parts) >= 2:
        date = parts[0]
        time = parts[1]
        hour = time.split(":")[0]
        return f"{date} {hour}:00"
    return raw[:10]


# ---------------------
# Parsing
# ---------------------

TABLE_ROW_RE = re.compile(r"^\|(.+)\|$")
TABLE_SEPARATOR_RE = re.compile(r"^\|[-:| ]+\|$")
SECTION_RE = re.compile(r"^## (.+)$")


@dataclass
class TableRow:
    """A single table row with its original text and normalized key."""
    raw: str
    key: str  # Normalized content for deduplication


@dataclass
class Section:
    """A section of STATUS.md with header and table rows."""
    name: str
    header_line: str
    table_header: Optional[str]
    table_separator: Optional[str]
    rows: List[TableRow]
    other_lines: List[str]  # Non-table content


def normalize_row(raw: str) -> str:
    """Normalize a row for comparison (strip whitespace, collapse spaces)."""
    # Remove | boundaries and collapse whitespace
    return " ".join(raw.split())


def parse_status_md(md: str) -> Tuple[str, List[Section], str]:
    """
    Parse STATUS.md into (preamble, sections, epilogue).

    Preamble is everything before the first ## section.
    Each Section contains its table rows.
    """
    lines = md.splitlines()

    preamble_lines: List[str] = []
    sections: List[Section] = []
    current_section: Optional[Section] = None
    in_preamble = True

    i = 0
    while i < len(lines):
        line = lines[i]

        # Check for section header
        m = SECTION_RE.match(line)
        if m:
            if current_section:
                sections.append(current_section)
            in_preamble = False
            current_section = Section(
                name=m.group(1).strip(),
                header_line=line,
                table_header=None,
                table_separator=None,
                rows=[],
                other_lines=[],
            )
            i += 1
            continue

        if in_preamble:
            preamble_lines.append(line)
            i += 1
            continue

        if current_section is None:
            i += 1
            continue

        # Check for table content
        if TABLE_ROW_RE.match(line):
            if TABLE_SEPARATOR_RE.match(line):
                # This is a separator line
                current_section.table_separator = line
            elif current_section.table_header is None:
                # First non-separator table row is the header
                current_section.table_header = line
            else:
                # Data row
                current_section.rows.append(TableRow(
                    raw=line,
                    key=normalize_row(line),
                ))
        else:
            current_section.other_lines.append(line)

        i += 1

    if current_section:
        sections.append(current_section)

    return "\n".join(preamble_lines), sections, ""


def extract_row_keys(md: str) -> Set[str]:
    """Extract all table row keys from the file."""
    _, sections, _ = parse_status_md(md)
    keys = set()
    for section in sections:
        for row in section.rows:
            keys.add(row.key)
    return keys


# ---------------------
# Rewrite
# ---------------------

def build_date_bucketed_status(
    sections: List[Section],
    first_seen: Dict[str, Tuple[str, str]],
    date_desc: bool = True,
) -> str:
    """
    Create new STATUS.md content with date as primary grouping.
    first_seen maps row.key -> (timestamp, sha)

    Output structure:
        ## 2026-01-04 15:00

        ### Week 1: Foundation
        | Feature | Status | Notes |
        |---------|--------|-------|
        | row 1 | | |

        ### Sketch Generation
        | Feature | Status | Notes |
        |---------|--------|-------|
        | row 2 | | |
    """
    out: List[str] = []

    # Group all rows by timestamp, preserving section info
    # timestamp -> section_name -> [rows]
    date_groups: Dict[str, Dict[str, Tuple[Section, List[TableRow]]]] = defaultdict(dict)

    for section in sections:
        for row in section.rows:
            timestamp, _ = first_seen.get(row.key, ("UNKNOWN", "HEAD"))
            if section.name not in date_groups[timestamp]:
                date_groups[timestamp][section.name] = (section, [])
            date_groups[timestamp][section.name][1].append(row)

    # Sort timestamps
    timestamps = sorted(date_groups.keys(), reverse=date_desc)

    for ts in timestamps:
        out.append(f"## {ts}\n")

        section_data = date_groups[ts]
        # Process sections in their original order
        for section in sections:
            if section.name not in section_data:
                continue

            src_section, rows = section_data[section.name]
            if not rows:
                continue

            out.append(f"\n### {section.name}\n")

            # Output table if this section has table content
            if src_section.table_header:
                out.append(src_section.table_header + "\n")
                if src_section.table_separator:
                    out.append(src_section.table_separator + "\n")
                for row in rows:
                    out.append(row.raw + "\n")

        out.append("\n")

    return "".join(out).rstrip() + "\n"


# ---------------------
# Main
# ---------------------

def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--repo", default=".", help="Path to git repo (default: .)")
    ap.add_argument("--path", default="STATUS.md", help="Path to status file")
    ap.add_argument("--ref", default="HEAD", help="Ref to treat as current")
    ap.add_argument("--in-place", action="store_true", help="Rewrite file in place")
    ap.add_argument("--date-order", choices=["asc", "desc"], default="desc",
                    help="Date grouping order (default: desc)")
    ap.add_argument("--granularity", choices=["day", "hour", "auto"], default="auto",
                    help="Time granularity: day, hour, or auto (default: auto)")
    args = ap.parse_args()

    repo = Path(args.repo).resolve()
    relpath = args.path

    status_path = repo / relpath
    head_md = status_path.read_text(encoding="utf-8")
    preamble, sections, _ = parse_status_md(head_md)

    # Build set of row keys we want to attribute
    wanted = set()
    for section in sections:
        for row in section.rows:
            wanted.add(row.key)

    if not wanted:
        print("No table rows found.")
        return 0

    # Walk commits that touched STATUS.md (oldest -> newest)
    commits = git(["rev-list", "--reverse", args.ref, "--", relpath], cwd=repo).splitlines()

    first_seen: Dict[str, Tuple[str, str, str]] = {}  # key -> (date, datetime, sha)
    prev_keys: Set[str] = set()

    for sha in commits:
        md = git_show_file(sha, relpath, repo)
        if md is None:
            continue

        curr_keys = extract_row_keys(md)
        commit_date = git_commit_date(sha, repo)
        commit_datetime = git_commit_datetime(sha, repo)

        added = curr_keys - prev_keys
        for key in added:
            if key in wanted and key not in first_seen:
                first_seen[key] = (commit_date, commit_datetime, sha)

        prev_keys = curr_keys

        if len(first_seen) == len(wanted):
            break

    # Fallback for items we couldn't attribute
    for key in wanted:
        if key not in first_seen:
            first_seen[key] = ("UNKNOWN", "UNKNOWN", "HEAD")

    # Decide granularity
    granularity = args.granularity
    if granularity == "auto":
        unique_dates = set(v[0] for v in first_seen.values() if v[0] != "UNKNOWN")
        granularity = "hour" if len(unique_dates) <= 3 else "day"

    # Select timestamp based on granularity
    final_first_seen: Dict[str, Tuple[str, str]] = {}
    for key, (date, datetime, sha) in first_seen.items():
        timestamp = datetime if granularity == "hour" else date
        final_first_seen[key] = (timestamp, sha)

    new_content = build_date_bucketed_status(
        sections,
        final_first_seen,
        date_desc=(args.date_order == "desc"),
    )

    # Prepend preamble
    if preamble.strip():
        new_md = preamble + "\n\n" + new_content
    else:
        new_md = new_content

    if args.in_place:
        backup = status_path.with_suffix(status_path.suffix + ".bak")
        backup.write_text(head_md, encoding="utf-8")
        status_path.write_text(new_md, encoding="utf-8")
        print(f"Updated {status_path} (backup: {backup})")
    else:
        print(new_md, end="")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""
bakeoff-features-reflect - LLM-driven qualitative assessment of hypergumbo outputs

This script performs developer-perspective usefulness assessment by invoking
an LLM agent to examine raw artifacts and raw repo code side-by-side.

The agent adopts the persona of a developer working on that repo and asks:
"Would I actually find this useful?"

## Assessment Protocol

For each repo, the agent examines artifacts through the lens of 3 developer tasks:

### A. Refactoring Task Assessment
- Pick a function from the slice output
- Look at the actual function in the repo
- Ask: "If I wanted to refactor this, does the slice show me what I'd break?"
- Check: Does reverse-slice correctly identify callers that would need updates?
- Note: Missing dependencies, false connections, unhelpful noise

### B. New Feature Implementation Assessment
- Identify a realistic feature addition point
- Ask: "Does the entrypoint detection find similar existing endpoints?"
- Ask: "Does the slice from an existing endpoint show the implementation pattern?"
- Check: Does supply chain tier help focus on first-party code to copy?
- Note: Missing patterns, irrelevant includes, wrong abstraction level

### C. Integration/Understanding Assessment
- Pretend unfamiliarity with the codebase
- Ask: "Do the top-ranked symbols by centrality match actual important code?"
- Ask: "Does the behavior map help understand the architecture?"
- Check: Are cross-file edges actually meaningful relationships?
- Note: Misleading centrality, missing key components, noise ratio

## Output Format

```yaml
developer_assessment:
  repo: django
  refactoring:
    target: "django/views/generic/base.py:View.dispatch"
    slice_useful: true
    reverse_slice_useful: false
    missing: ["middleware chain not shown"]
    noise: ["unrelated admin code included"]
  new_feature:
    scenario: "add new generic view type"
    entrypoint_helpful: true
    pattern_discoverable: true
    notes: "..."
  understanding:
    centrality_accurate: true
    architecture_visible: false
    notes: "..."
  overall_verdict: USEFUL | PARTIALLY_USEFUL | NOT_USEFUL
  improvement_ideas: ["increase max_hops for deep inheritance", "..."]
```

## Usage

    # Run reflection on latest feature bakeoff results (uses canonical default workdir)
    ./scripts/bakeoff-features-reflect

    # Specify a specific iteration
    ./scripts/bakeoff-features-reflect --iteration 1

    # Override workdir
    ./scripts/bakeoff-features-reflect --workdir /path/to/custom/workdir

Environment:
    BAKEOFF_FEATURES_WORKDIR: Override workdir location
"""

import argparse
import datetime
import json
import os
import subprocess
import sys
from pathlib import Path

DEFAULT_BAKEOFF_DIR = os.path.expanduser("~/hypergumbo_lab_notebook/bakeoff_artifacts")

# Structured prompt template for the LLM agent
ASSESSMENT_PROMPT_TEMPLATE = """
You are a developer working on the {repo_name} repository. Your task is to evaluate
whether hypergumbo's analysis outputs would be useful to you for common development tasks.

## Repository Information
- Name: {repo_name}
- Path: {repo_path}

## Available Artifacts
The following hypergumbo outputs are available for your assessment:
{artifact_list}
{prior_context_section}
## Assessment Protocol

Examine the artifacts and source code, then evaluate usefulness for these 3 tasks:

### Task A: Refactoring Assessment
1. Pick a non-trivial function from the slice output (slice.0.json or similar)
2. Read the actual function in the source code
3. Imagine you want to refactor this function
4. Evaluate:
   - Does the forward slice show what code depends on this function?
   - Does the reverse slice (rslice.*.json) show what would need to change?
   - Does the production-only reverse slice (rslice.*.prod.json) separate
     production callers from test callers effectively?
   - What's missing that a real refactoring would need?
   - What's included that's not actually relevant?

### Task B: New Feature Implementation
1. Identify where you'd add a new feature (e.g., new API endpoint, new view)
2. Look at existing similar features in the entrypoint list
3. Evaluate:
   - Can you find similar existing implementations?
   - Does the slice from those implementations show the pattern to follow?
   - Does supply chain tier help you focus on code to modify vs libraries?

### Task C: Codebase Understanding
1. Pretend you're new to this codebase
2. Look at the symbols output (symbols.txt) for high-connectivity nodes
3. Evaluate:
   - Do the top-ranked symbols match what's actually important?
   - Does the call graph reveal the architecture?
   - Are the cross-file relationships meaningful?

## Scoring Rubric

For each task, assign a numeric score from 0-100:
- **0-20:** Not useful at all — output is misleading or empty
- **21-40:** Marginally useful — some signal but mostly noise or gaps
- **41-60:** Partially useful — real signal mixed with significant gaps/noise
- **61-80:** Useful — actionable output with minor gaps
- **81-100:** Highly useful — comprehensive, accurate, directly actionable

## Output Format

Provide your assessment as YAML:

```yaml
developer_assessment:
  repo: {repo_name}
  timestamp: "{timestamp}"

  refactoring:
    target: "path/to/file.py:function_name"
    slice_useful: true/false
    reverse_slice_useful: true/false
    missing:
      - "description of what's missing"
    noise:
      - "description of irrelevant content"
    notes: "additional observations"

  new_feature:
    scenario: "brief description of feature to add"
    entrypoint_helpful: true/false
    pattern_discoverable: true/false
    tier_filtering_helpful: true/false
    missing:
      - "what patterns weren't found"
    notes: "additional observations"

  understanding:
    centrality_accurate: true/false
    architecture_visible: true/false
    cross_file_edges_meaningful: true/false
    missing:
      - "key components not surfaced"
    noise:
      - "misleading or confusing elements"
    notes: "additional observations"

  task_scores:
    refactoring_score: <0-100>
    new_feature_score: <0-100>
    understanding_score: <0-100>

  overall_verdict: USEFUL | PARTIALLY_USEFUL | NOT_USEFUL
  confidence: HIGH | MEDIUM | LOW
  trajectory: IMPROVING | STABLE | REGRESSING | FIRST_ASSESSMENT

  improvement_ideas:
    - "specific, actionable suggestion 1"
    - "specific, actionable suggestion 2"

  questions:
    - "open question about hypergumbo behavior or output"
```

Be specific and concrete. Reference actual files and functions from the repo.
Focus on practical utility, not theoretical correctness.
"""

PRIOR_CONTEXT_TEMPLATE = """
## Prior Assessment Context

This repo was previously assessed in an earlier cohort. Here are the prior findings
so you can evaluate whether things have improved, stayed the same, or regressed:

- **Prior verdict:** {prior_verdict}
- **Prior confidence:** {prior_confidence}
{prior_scores_section}
**Prior improvement ideas:**
{prior_ideas}

**Prior missing items (refactoring):**
{prior_refactoring_missing}

**Prior missing items (new feature):**
{prior_new_feature_missing}

**Prior missing items (understanding):**
{prior_understanding_missing}

When assigning your trajectory field, compare against these prior findings:
- IMPROVING: Meaningful improvement in output quality vs. prior assessment
- STABLE: Roughly the same quality (within ~5 points)
- REGRESSING: Output quality has gotten worse
- FIRST_ASSESSMENT: Use this if no prior assessment context is provided
"""


def get_artifact_list(repo_out_dir: str) -> str:
    """Generate a list of available artifacts for the prompt."""
    artifacts = []

    artifact_descriptions = {
        "hg.json": "Full behavior map (nodes, edges, entrypoints)",
        "entries.txt": "Detected entrypoints for the repo",
        "symbols.txt": "Symbols ranked by connectivity (in/out degree)",
        "routes.txt": "Detected API routes and endpoints",
        "slice.0.json": "Forward slice from top entrypoint",
        "slice.1.json": "Forward slice from second entrypoint",
        "rslice_seeds.json": "Reverse slice seed selection (method and chosen symbols)",
        "rslice.0.json": "Reverse slice (what calls this?) from highest in-degree symbol",
        "rslice.0.prod.json": "Production-only reverse slice (test files excluded)",
        "rslice.1.json": "Reverse slice from second highest in-degree symbol",
        "rslice.1.prod.json": "Production-only reverse slice (test files excluded)",
        "rslice.2.prod.json": "Production-only reverse slice (test files excluded)",
        "slice.tier1.json": "Slice limited to tier-1 (first-party) code",
        "slice.tier2.json": "Slice limited to tier-1 and tier-2 code",
    }

    for fname, desc in artifact_descriptions.items():
        fpath = os.path.join(repo_out_dir, fname)
        if os.path.exists(fpath):
            size = os.path.getsize(fpath)
            artifacts.append(f"- {fname} ({size // 1024}KB): {desc}")

    return "\n".join(artifacts) if artifacts else "No artifacts found"


def load_state(workdir: str) -> dict:
    """Load bakeoff state from workdir."""
    state_path = os.path.join(workdir, "state.json")
    if not os.path.exists(state_path):
        return None

    with open(state_path, "r") as f:
        return json.load(f)


def find_prior_assessment(workdir: str, repo_name: str, cohort_number: int):
    """Find the most recent prior assessment for a repo.

    Searches backward through cohort directories (cohort_number-1 down to 1)
    for an assessment YAML file for the given repo. Returns the parsed
    assessment dict or None if no prior exists.
    """
    if cohort_number <= 1:
        return None

    reflect_base = os.path.join(workdir, "reflect")
    if not os.path.isdir(reflect_base):
        return None

    # Search backward from the previous cohort
    for prev_cohort in range(cohort_number - 1, 0, -1):
        # Check all iterations (prefer highest)
        cohort_dir = os.path.join(reflect_base, f"cohort-{prev_cohort:03d}")
        if not os.path.isdir(cohort_dir):
            continue

        iter_dirs = sorted(
            [
                d
                for d in os.listdir(cohort_dir)
                if os.path.isdir(os.path.join(cohort_dir, d))
                and d.startswith("iter-")
            ],
            reverse=True,
        )

        for iter_dir in iter_dirs:
            assessment_path = os.path.join(
                cohort_dir, iter_dir, f"{repo_name}.assessment.yaml"
            )
            if os.path.exists(assessment_path):
                try:
                    import yaml

                    with open(assessment_path) as f:
                        data = yaml.safe_load(f)
                    if data and "developer_assessment" in data:
                        return data["developer_assessment"]
                    return data
                except Exception:
                    continue

    return None


def find_prior_summary(workdir: str, cohort_number: int):
    """Find the most recent prior summary.yaml with score_statistics.

    Returns the parsed summary dict or None if no prior summary with
    scores exists.
    """
    if cohort_number <= 1:
        return None

    reflect_base = os.path.join(workdir, "reflect")
    if not os.path.isdir(reflect_base):
        return None

    for prev_cohort in range(cohort_number - 1, 0, -1):
        cohort_dir = os.path.join(reflect_base, f"cohort-{prev_cohort:03d}")
        if not os.path.isdir(cohort_dir):
            continue

        iter_dirs = sorted(
            [
                d
                for d in os.listdir(cohort_dir)
                if os.path.isdir(os.path.join(cohort_dir, d))
                and d.startswith("iter-")
            ],
            reverse=True,
        )

        for iter_dir in iter_dirs:
            summary_path = os.path.join(cohort_dir, iter_dir, "summary.yaml")
            if os.path.exists(summary_path):
                try:
                    import yaml

                    with open(summary_path) as f:
                        data = yaml.safe_load(f)
                    if data and "score_statistics" in data:
                        return data
                except Exception:
                    continue

    return None


def format_prior_context(prior_assessment: dict) -> str:
    """Format a prior assessment into a context section for the prompt."""
    if not prior_assessment:
        return ""

    prior_verdict = prior_assessment.get("overall_verdict", "unknown")
    prior_confidence = prior_assessment.get("confidence", "unknown")

    # Format scores if available
    scores = prior_assessment.get("task_scores", {})
    if scores:
        prior_scores_section = (
            f"- **Prior scores:** "
            f"refactoring={scores.get('refactoring_score', '?')}, "
            f"new_feature={scores.get('new_feature_score', '?')}, "
            f"understanding={scores.get('understanding_score', '?')}\n"
        )
    else:
        prior_scores_section = "- **Prior scores:** not available (pre-scoring assessment)\n"

    # Format improvement ideas
    ideas = prior_assessment.get("improvement_ideas", [])
    prior_ideas = "\n".join(f"- {idea}" for idea in ideas[:5]) if ideas else "- (none)"

    # Format missing items from each task
    def format_missing(section_name):
        section = prior_assessment.get(section_name, {})
        missing = section.get("missing", [])
        return "\n".join(f"- {m}" for m in missing[:3]) if missing else "- (none)"

    return PRIOR_CONTEXT_TEMPLATE.format(
        prior_verdict=prior_verdict,
        prior_confidence=prior_confidence,
        prior_scores_section=prior_scores_section,
        prior_ideas=prior_ideas,
        prior_refactoring_missing=format_missing("refactoring"),
        prior_new_feature_missing=format_missing("new_feature"),
        prior_understanding_missing=format_missing("understanding"),
    )


def generate_assessment_prompt(
    repo_name: str,
    repo_path: str,
    repo_out_dir: str,
    prior_assessment: dict = None,
) -> str:
    """Generate the assessment prompt for a specific repo.

    If prior_assessment is provided, includes prior findings context
    so the assessor can compute trajectory.
    """
    artifact_list = get_artifact_list(repo_out_dir)
    timestamp = datetime.datetime.now().isoformat()
    prior_context_section = format_prior_context(prior_assessment)

    return ASSESSMENT_PROMPT_TEMPLATE.format(
        repo_name=repo_name,
        repo_path=repo_path,
        artifact_list=artifact_list,
        timestamp=timestamp,
        prior_context_section=prior_context_section,
    )


def compute_trajectory(current_scores: dict, prior_scores: dict):
    """Compute trajectory by comparing current vs prior score statistics.

    Returns a dict with trend (IMPROVING/STABLE/REGRESSING), delta, and
    prior_mean_score. Returns None if prior_scores is None.

    Threshold: +/- 5 points is considered STABLE.
    """
    if prior_scores is None:
        return None

    current_mean = current_scores.get("mean_score", 0)
    prior_mean = prior_scores.get("mean_score", 0)
    delta = current_mean - prior_mean

    if delta > 5:
        trend = "IMPROVING"
    elif delta < -5:
        trend = "REGRESSING"
    else:
        trend = "STABLE"

    trajectory = {
        "trend": trend,
        "delta": round(delta, 1),
        "prior_mean_score": round(prior_mean, 1),
        "current_mean_score": round(current_mean, 1),
    }

    # Per-task trajectory if available
    current_per_task = current_scores.get("per_task", {})
    prior_per_task = prior_scores.get("per_task", {})
    if current_per_task and prior_per_task:
        task_deltas = {}
        for task_name in ["refactoring", "new_feature", "understanding"]:
            cur = current_per_task.get(task_name, {}).get("mean", 0)
            pri = prior_per_task.get(task_name, {}).get("mean", 0)
            task_deltas[task_name] = round(cur - pri, 1)
        trajectory["per_task_deltas"] = task_deltas

    return trajectory


def aggregate_assessments(assessments: list) -> dict:
    """Aggregate individual assessments into a summary report.

    Handles both legacy assessments (no scores) and new assessments with
    task_scores. When scores are present, computes statistics (mean, median,
    min, max) overall and per-task.
    """
    summary = {
        "total_repos": len(assessments),
        "verdicts": {"USEFUL": 0, "PARTIALLY_USEFUL": 0, "NOT_USEFUL": 0},
        "common_issues": [],
        "improvement_ideas": [],
        "questions": [],
    }

    all_missing = []
    all_noise = []
    all_ideas = []
    all_questions = []

    # Score collection
    overall_scores = []
    task_scores_by_name = {
        "refactoring": [],
        "new_feature": [],
        "understanding": [],
    }
    repo_scores = []

    for a in assessments:
        if not a:
            continue

        # Count verdicts
        verdict = a.get("overall_verdict", "NOT_USEFUL")
        if verdict in summary["verdicts"]:
            summary["verdicts"][verdict] += 1

        # Collect issues
        for section in ["refactoring", "new_feature", "understanding"]:
            section_data = a.get(section, {})
            all_missing.extend(section_data.get("missing", []))
            all_noise.extend(section_data.get("noise", []))

        all_ideas.extend(a.get("improvement_ideas", []))
        all_questions.extend(a.get("questions", []))

        # Collect scores if present
        scores = a.get("task_scores")
        if scores:
            r = scores.get("refactoring_score")
            n = scores.get("new_feature_score")
            u = scores.get("understanding_score")
            if r is not None and n is not None and u is not None:
                task_scores = [r, n, u]
                repo_overall = sum(task_scores) / len(task_scores)
                overall_scores.append(repo_overall)
                task_scores_by_name["refactoring"].append(r)
                task_scores_by_name["new_feature"].append(n)
                task_scores_by_name["understanding"].append(u)
                repo_scores.append({
                    "repo": a.get("repo", "unknown"),
                    "refactoring_score": r,
                    "new_feature_score": n,
                    "understanding_score": u,
                    "overall_score": round(repo_overall, 1),
                })

    # Deduplicate and count
    def count_items(items):
        counts = {}
        for item in items:
            counts[item] = counts.get(item, 0) + 1
        return sorted(counts.items(), key=lambda x: -x[1])

    missing_counts = count_items(all_missing)
    summary["common_missing"] = [{"issue": m, "count": c} for m, c in missing_counts[:10]]

    noise_counts = count_items(all_noise)
    summary["common_noise"] = [{"issue": n, "count": c} for n, c in noise_counts[:10]]

    idea_counts = count_items(all_ideas)
    summary["improvement_ideas"] = [{"idea": i, "count": c} for i, c in idea_counts[:10]]

    question_counts = count_items(all_questions)
    summary["questions"] = [{"question": q, "count": c} for q, c in question_counts[:10]]

    # Compute score statistics if any scores exist
    if overall_scores:
        import statistics as stats_mod

        per_task = {}
        for task_name, scores_list in task_scores_by_name.items():
            if scores_list:
                per_task[task_name] = {
                    "mean": round(stats_mod.mean(scores_list), 1),
                    "min": min(scores_list),
                    "max": max(scores_list),
                }

        summary["score_statistics"] = {
            "scored_repos": len(overall_scores),
            "mean_score": round(stats_mod.mean(overall_scores), 1),
            "min_score": round(min(overall_scores), 1),
            "max_score": round(max(overall_scores), 1),
            "per_task": per_task,
            "repos": repo_scores,
        }

        if len(overall_scores) > 1:
            summary["score_statistics"]["median_score"] = round(
                stats_mod.median(overall_scores), 1
            )

    return summary


def resolve_workdir(args_workdir: str = None, env_var: str = "BAKEOFF_FEATURES_WORKDIR") -> str:
    """Resolve workdir from CLI arg, env var, or canonical default.

    Resolution order: CLI --workdir > env var > canonical default.

    If the resolved directory has no state.json but contains session
    subdirectories (broad-*/deep-*), returns the most recent one.
    """
    workdir = args_workdir or os.environ.get(env_var) or DEFAULT_BAKEOFF_DIR
    workdir = os.path.abspath(os.path.expanduser(workdir))

    # If the workdir itself has state.json, use it directly
    if os.path.exists(os.path.join(workdir, "state.json")):
        return workdir

    # Otherwise, look for the most recent session subdirectory
    if os.path.isdir(workdir):
        sessions = []
        for entry in os.scandir(workdir):
            if entry.is_dir() and (entry.name.startswith("broad-") or entry.name.startswith("deep-")):
                state_path = os.path.join(entry.path, "state.json")
                if os.path.exists(state_path):
                    sessions.append(entry.path)
        if sessions:
            sessions.sort()
            return sessions[-1]

    return workdir


def cmd_reflect(args):
    """Run LLM-driven reflection on feature bakeoff results."""
    workdir = resolve_workdir(args.workdir)
    print(f"Workdir: {workdir}")
    state = load_state(workdir)

    if not state:
        print("Error: No feature bakeoff session found.", file=sys.stderr)
        return 1

    cohort_number = state.get("cohort_number", 0)
    iteration = args.iteration or state.get("iteration", 0)
    pool_path = state.get("pool_path", "")

    out_dir = os.path.join(workdir, "out", f"cohort-{cohort_number:03d}", f"iter-{iteration:03d}")

    if not os.path.isdir(out_dir):
        print(f"Error: No output found at {out_dir}.", file=sys.stderr)
        return 1

    current_cohort = state.get("current_cohort", [])

    print(f"Feature Bakeoff Reflection")
    print(f"  Cohort: #{cohort_number}")
    print(f"  Iteration: {iteration}")
    print(f"  Repos: {', '.join(current_cohort)}")
    print()

    # Generate prompts for each repo
    prompts_dir = os.path.join(workdir, "reflect", f"cohort-{cohort_number:03d}", f"iter-{iteration:03d}")
    os.makedirs(prompts_dir, exist_ok=True)

    for repo_name in current_cohort:
        repo_path = os.path.join(pool_path, repo_name)
        repo_out = os.path.join(out_dir, repo_name)

        if not os.path.isdir(repo_out):
            print(f"[{repo_name}] Skipped (no output)")
            continue

        # Look for prior assessment to inject context
        prior = find_prior_assessment(workdir, repo_name, cohort_number)
        if prior:
            print(f"[{repo_name}] Found prior assessment (injecting context)")

        prompt = generate_assessment_prompt(
            repo_name, repo_path, repo_out, prior_assessment=prior
        )

        # Write prompt to file
        prompt_path = os.path.join(prompts_dir, f"{repo_name}.prompt.md")
        with open(prompt_path, "w") as f:
            f.write(prompt)

        print(f"[{repo_name}] Prompt generated: {prompt_path}")

    print()
    print("=" * 60)
    print("NEXT STEPS")
    print("=" * 60)
    print()
    print("The reflection prompts have been generated. To complete the assessment:")
    print()
    print("1. For each repo, invoke an LLM agent with the prompt:")
    print(f"   Prompts are in: {prompts_dir}/")
    print()
    print("2. The agent should have access to:")
    print(f"   - The repo source code at: {pool_path}/<repo_name>/")
    print(f"   - The hypergumbo artifacts at: {out_dir}/<repo_name>/")
    print()
    print("3. Save the YAML assessment output to:")
    print(f"   {prompts_dir}/<repo_name>.assessment.yaml")
    print()
    print("4. Run aggregate to synthesize findings:")
    print(f"   ./scripts/bakeoff-features-reflect aggregate --workdir {workdir}")
    print()

    return 0


def cmd_aggregate(args):
    """Aggregate individual assessments into a summary report."""
    workdir = resolve_workdir(args.workdir)
    print(f"Workdir: {workdir}")
    state = load_state(workdir)

    if not state:
        print("Error: No feature bakeoff session found.", file=sys.stderr)
        return 1

    cohort_number = state.get("cohort_number", 0)
    iteration = args.iteration or state.get("iteration", 0)

    prompts_dir = os.path.join(workdir, "reflect", f"cohort-{cohort_number:03d}", f"iter-{iteration:03d}")

    if not os.path.isdir(prompts_dir):
        print(f"Error: No reflection directory found at {prompts_dir}.", file=sys.stderr)
        return 1

    # Load all assessments
    import yaml

    assessments = []
    current_cohort = state.get("current_cohort", [])

    for repo_name in current_cohort:
        assessment_path = os.path.join(prompts_dir, f"{repo_name}.assessment.yaml")

        if not os.path.exists(assessment_path):
            print(f"[{repo_name}] No assessment found (skipped)")
            continue

        try:
            with open(assessment_path) as f:
                data = yaml.safe_load(f)
                if data and "developer_assessment" in data:
                    assessments.append(data["developer_assessment"])
                elif data:
                    assessments.append(data)
                print(f"[{repo_name}] Loaded assessment")
        except Exception as e:
            print(f"[{repo_name}] Error loading assessment: {e}")

    if not assessments:
        print()
        print("No assessments found to aggregate.")
        print("Run the reflection prompts first, then save results as:")
        print(f"  {prompts_dir}/<repo_name>.assessment.yaml")
        return 1

    # Aggregate
    summary = aggregate_assessments(assessments)
    summary["cohort"] = cohort_number
    summary["iteration"] = iteration
    summary["timestamp"] = datetime.datetime.now().isoformat()

    # Compute trajectory if scores and prior summary exist
    if "score_statistics" in summary:
        prior_summary = find_prior_summary(workdir, cohort_number)
        if prior_summary:
            prior_stats = prior_summary.get("score_statistics")
            trajectory = compute_trajectory(summary["score_statistics"], prior_stats)
            if trajectory:
                summary["trajectory"] = trajectory

    # Write summary
    summary_path = os.path.join(prompts_dir, "summary.yaml")
    with open(summary_path, "w") as f:
        yaml.dump(summary, f, default_flow_style=False, sort_keys=False)

    print()
    print("=" * 60)
    print("REFLECTION SUMMARY")
    print("=" * 60)
    print()
    print(f"Assessed repos: {summary['total_repos']}")
    print(f"Verdicts:")
    for verdict, count in summary["verdicts"].items():
        print(f"  {verdict}: {count}")
    print()

    if summary.get("score_statistics"):
        stats = summary["score_statistics"]
        print(f"Scores (0-100):")
        print(f"  Mean: {stats['mean_score']}")
        print(f"  Range: {stats['min_score']} - {stats['max_score']}")
        if "per_task" in stats:
            for task, task_stats in stats["per_task"].items():
                print(f"  {task}: {task_stats['mean']}")
        print()

    if summary.get("trajectory"):
        t = summary["trajectory"]
        print(f"Trajectory: {t['trend']} ({t['delta']:+.1f} points vs prior)")
        print()

    if summary.get("common_missing"):
        print("Common missing items:")
        for item in summary["common_missing"][:5]:
            print(f"  - {item['issue']} (x{item['count']})")
        print()

    if summary.get("improvement_ideas"):
        print("Top improvement ideas:")
        for item in summary["improvement_ideas"][:5]:
            print(f"  - {item['idea']} (x{item['count']})")
        print()

    print(f"Full summary: {summary_path}")

    # Optional: ingest improvement ideas into tracker
    if getattr(args, "ingest", False):
        print()
        print("Ingesting improvement ideas into stealth tracker items...")
        created = ingest_improvement_ideas(summary, min_count=2)
        if created:
            print(f"Created {len(created)} stealth tracker item(s):")
            for item in created:
                print(f"  {item['id']}: {item['idea'][:60]}...")
        else:
            print("No new items (all already exist or below threshold).")

    return 0


def find_unaggregated(workdir: str) -> list:
    """Find cohort/iter dirs that have assessments but no summary.yaml.

    Returns a list of dicts: [{"cohort": N, "iteration": M, "path": str,
    "assessment_count": int}, ...] sorted by cohort then iteration.
    """
    reflect_base = os.path.join(workdir, "reflect")
    if not os.path.isdir(reflect_base):
        return []

    unaggregated = []

    for cohort_entry in sorted(os.listdir(reflect_base)):
        if not cohort_entry.startswith("cohort-"):
            continue
        cohort_dir = os.path.join(reflect_base, cohort_entry)
        if not os.path.isdir(cohort_dir):
            continue

        try:
            cohort_num = int(cohort_entry.split("-")[1])
        except (IndexError, ValueError):
            continue

        for iter_entry in sorted(os.listdir(cohort_dir)):
            if not iter_entry.startswith("iter-"):
                continue
            iter_dir = os.path.join(cohort_dir, iter_entry)
            if not os.path.isdir(iter_dir):
                continue

            try:
                iter_num = int(iter_entry.split("-")[1])
            except (IndexError, ValueError):
                continue

            # Check: has assessments but no summary
            summary_path = os.path.join(iter_dir, "summary.yaml")
            if os.path.exists(summary_path):
                continue

            assessment_count = sum(
                1
                for f in os.listdir(iter_dir)
                if f.endswith(".assessment.yaml")
            )

            if assessment_count > 0:
                unaggregated.append({
                    "cohort": cohort_num,
                    "iteration": iter_num,
                    "path": iter_dir,
                    "assessment_count": assessment_count,
                })

    return unaggregated


def cmd_check(args):
    """Check for unaggregated assessment sets and optionally aggregate them.

    This command addresses aggregation resilience: when a session dies after
    subagents complete their assessments but before aggregation runs, the
    orphaned assessments can be recovered by running this command.

    Returns 0 if all clean (or auto-aggregated), 1 if unaggregated found.
    """
    workdir = resolve_workdir(args.workdir)
    print(f"Workdir: {workdir}")

    unaggregated = find_unaggregated(workdir)

    if not unaggregated:
        print("All assessment sets are aggregated.")
        return 0

    print(f"Found {len(unaggregated)} unaggregated assessment set(s):")
    for item in unaggregated:
        print(
            f"  cohort-{item['cohort']:03d}/iter-{item['iteration']:03d}: "
            f"{item['assessment_count']} assessment(s)"
        )

    if not args.auto_aggregate:
        print()
        print("Run with --auto-aggregate to aggregate them, or run manually:")
        for item in unaggregated:
            print(
                f"  ./scripts/bakeoff-features-reflect aggregate "
                f"--workdir {workdir} --iteration {item['iteration']}"
            )
        return 1

    # Auto-aggregate each unaggregated set
    import yaml

    state = load_state(workdir)

    for item in unaggregated:
        iter_dir = item["path"]
        print(f"\nAggregating cohort-{item['cohort']:03d}/iter-{item['iteration']:03d}...")

        # Load assessments from the directory
        assessments = []
        for f in sorted(os.listdir(iter_dir)):
            if not f.endswith(".assessment.yaml"):
                continue
            try:
                fpath = os.path.join(iter_dir, f)
                with open(fpath) as fh:
                    data = yaml.safe_load(fh)
                if data and "developer_assessment" in data:
                    assessments.append(data["developer_assessment"])
                elif data:
                    assessments.append(data)
            except Exception as e:
                print(f"  Error loading {f}: {e}")

        if not assessments:
            print(f"  No valid assessments found, skipping.")
            continue

        summary = aggregate_assessments(assessments)
        summary["cohort"] = item["cohort"]
        summary["iteration"] = item["iteration"]
        summary["timestamp"] = datetime.datetime.now().isoformat()
        summary["retroactive"] = True

        # Compute trajectory if scores and prior summary exist
        if "score_statistics" in summary:
            prior_summary = find_prior_summary(workdir, item["cohort"])
            if prior_summary:
                prior_stats = prior_summary.get("score_statistics")
                trajectory = compute_trajectory(
                    summary["score_statistics"], prior_stats
                )
                if trajectory:
                    summary["trajectory"] = trajectory

        summary_path = os.path.join(iter_dir, "summary.yaml")
        with open(summary_path, "w") as fh:
            yaml.dump(summary, fh, default_flow_style=False, sort_keys=False)

        print(f"  Wrote {summary_path} ({summary['total_repos']} repos)")

    print(f"\nAggregated {len(unaggregated)} set(s).")
    return 0


# ---------------------------------------------------------------------------
# Improvement idea ingestion → tracker
# ---------------------------------------------------------------------------


def _tracker_script() -> str:
    """Return the path to the tracker CLI script."""
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "tracker")


def _list_stealth_titles(tracker_script: str) -> set[str]:
    """List existing stealth tracker item titles for dedup.

    Returns a set of lowercase titles for case-insensitive matching.
    """
    result = subprocess.run(
        [tracker_script, "--json", "list", "--tier", "stealth"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return set()
    try:
        items = json.loads(result.stdout)
        return {item["title"].lower() for item in items if "title" in item}
    except (json.JSONDecodeError, KeyError):
        return set()


def _normalize_idea(idea: str) -> str:
    """Normalize an improvement idea string for dedup comparison.

    Strips whitespace and lowercases for case-insensitive matching.
    Takes the first 80 chars to match the title truncation.
    """
    return idea.strip().lower()[:80]


def ingest_improvement_ideas(
    summary: dict,
    *,
    min_count: int = 2,
    tracker_script: str | None = None,
    dry_run: bool = False,
) -> list[dict]:
    """Create stealth-tier tracker items from aggregated improvement ideas.

    Only ideas appearing in >= min_count assessments are ingested. Ideas are
    deduplicated against existing stealth items by title prefix.

    Args:
        summary: Aggregated summary dict with ``improvement_ideas`` key.
        min_count: Minimum occurrence count to ingest (default 2).
        tracker_script: Path to tracker CLI script (auto-detected if None).
        dry_run: If True, report what would be created without calling tracker.

    Returns:
        List of dicts describing created items: [{"idea": str, "id": str}].
    """
    if tracker_script is None:
        tracker_script = _tracker_script()

    ideas = summary.get("improvement_ideas", [])
    if not ideas:
        return []

    # Filter by count threshold
    candidates = [i for i in ideas if i.get("count", 0) >= min_count]
    if not candidates:
        return []

    # Get existing stealth titles for dedup
    existing = _list_stealth_titles(tracker_script)

    created = []
    for item in candidates:
        idea_text = item["idea"]
        title = idea_text[:80]

        # Dedup: skip if a stealth item with the same title prefix exists
        if _normalize_idea(idea_text) in existing:
            continue

        count = item.get("count", 1)
        description = (
            f"{idea_text}\n\n"
            f"Source: bakeoff assessment aggregation "
            f"(found in {count} assessment(s))."
        )

        if dry_run:
            created.append({"idea": idea_text, "id": "(dry-run)"})
            continue

        result = subprocess.run(
            [
                tracker_script,
                "--no-auto-sync",
                "add",
                "--kind", "work_item",
                "--title", title,
                "--status", "todo_soft",
                "--priority", "3",
                "--tier", "stealth",
                "--tag", "bakeoff",
                "--tag", "assessment",
                "--description", description,
            ],
            capture_output=True,
            text=True,
        )

        if result.returncode == 0:
            item_id = result.stdout.strip()
            created.append({"idea": idea_text, "id": item_id})
        else:
            print(
                f"  Warning: failed to create tracker item for: "
                f"{title[:50]}...",
                file=sys.stderr,
            )
            if result.stderr:
                print(f"    {result.stderr.strip()}", file=sys.stderr)

    return created


def cmd_ingest(args):
    """Ingest improvement ideas from aggregated summary into tracker."""
    workdir = resolve_workdir(args.workdir)
    print(f"Workdir: {workdir}")
    state = load_state(workdir)

    if not state:
        print("Error: No feature bakeoff session found.", file=sys.stderr)
        return 1

    cohort_number = state.get("cohort_number", 0)
    iteration = args.iteration or state.get("iteration", 0)

    summary_path = os.path.join(
        workdir, "reflect",
        f"cohort-{cohort_number:03d}",
        f"iter-{iteration:03d}",
        "summary.yaml",
    )

    if not os.path.exists(summary_path):
        print(f"Error: No summary found at {summary_path}", file=sys.stderr)
        print("Run 'aggregate' first.", file=sys.stderr)
        return 1

    import yaml
    with open(summary_path) as f:
        summary = yaml.safe_load(f)

    min_count = getattr(args, "min_count", 2)
    dry_run = getattr(args, "dry_run", False)

    print(f"Ingesting improvement ideas (min_count={min_count})...")
    if dry_run:
        print("  (dry-run mode — no items will be created)")

    created = ingest_improvement_ideas(
        summary, min_count=min_count, dry_run=dry_run,
    )

    if created:
        print(f"\nCreated {len(created)} stealth tracker item(s):")
        for item in created:
            print(f"  {item['id']}: {item['idea'][:60]}...")
    else:
        print("\nNo new items to create (all already exist or below threshold).")

    return 0


def main():
    parser = argparse.ArgumentParser(
        description="LLM-driven qualitative assessment of hypergumbo outputs",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    subparsers = parser.add_subparsers(dest="command", help="Command")

    # reflect (default)
    p_reflect = subparsers.add_parser("reflect", help="Generate reflection prompts")
    p_reflect.add_argument("--workdir", help="Bakeoff workdir")
    p_reflect.add_argument("--iteration", type=int, help="Specific iteration to reflect on")

    # aggregate
    p_aggregate = subparsers.add_parser("aggregate", help="Aggregate assessment results")
    p_aggregate.add_argument("--workdir", help="Bakeoff workdir")
    p_aggregate.add_argument("--iteration", type=int, help="Specific iteration")
    p_aggregate.add_argument(
        "--ingest", action="store_true",
        help="Also ingest improvement ideas into stealth tracker items",
    )

    # check (aggregation resilience)
    p_check = subparsers.add_parser(
        "check", help="Find and optionally aggregate orphaned assessment sets"
    )
    p_check.add_argument("--workdir", help="Bakeoff workdir")
    p_check.add_argument(
        "--auto-aggregate",
        action="store_true",
        help="Automatically aggregate any unaggregated assessment sets",
    )

    # ingest (improvement ideas → tracker)
    p_ingest = subparsers.add_parser(
        "ingest", help="Ingest improvement ideas into stealth tracker items"
    )
    p_ingest.add_argument("--workdir", help="Bakeoff workdir")
    p_ingest.add_argument("--iteration", type=int, help="Specific iteration")
    p_ingest.add_argument(
        "--min-count", type=int, default=2, dest="min_count",
        help="Minimum occurrence count to ingest (default: 2)",
    )
    p_ingest.add_argument(
        "--dry-run", action="store_true", dest="dry_run",
        help="Report what would be created without calling tracker",
    )

    args = parser.parse_args()

    # Default to reflect if no command given
    if not args.command:
        args.command = "reflect"
        args.workdir = None
        args.iteration = None

    commands = {
        "reflect": cmd_reflect,
        "aggregate": cmd_aggregate,
        "check": cmd_check,
        "ingest": cmd_ingest,
    }

    return commands[args.command](args)


if __name__ == "__main__":
    sys.exit(main())

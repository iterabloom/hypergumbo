#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Pre-commit lint: literal-string keyword arguments to ``Edge.create``,
``Edge(...)``, ``Symbol.create``, and ``Symbol(...)`` constructors must
be in their corresponding canonical axis registry.

This is the L3 (producer-side) gate from ADR-0028 §"Phase 1". The L1
(consumer-side) gates live in ``check-edge-type-drift``,
``check-symbol-kind-drift``, and ``check-evidence-type-drift``. L1
catches hardcoded ``frozenset({...})`` sets at module level whose
values escape the registry; L3 catches literal-string emit sites that
introduce new values without registering them.

Behavior per axis:

- **Strict violations** (literal value not in registry) → exit 1.
- **Advisories** (f-string emits) → printed to stdout but do NOT block.
  These are Phase-3 fold candidates per the parent ADRs (ADR-0023 /
  ADR-0027 / ADR-0028); the registry-based discipline is established
  here, the per-cluster producer migration normalizes them later.

Exit codes:
    0 — no strict violations across all three sibling axes.
    1 — at least one axis has strict violations; fix before committing.
    2 — could not import a registry (likely a packaging /
        editable-install problem; do not block commits on this).
"""

from __future__ import annotations

import json
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parent.parent

# Add the core package's src to sys.path so we can import the registries
# without requiring an editable install.
sys.path.insert(0, str(REPO_ROOT / "packages" / "hypergumbo-core" / "src"))

try:
    from hypergumbo_core.producer_coherence import (
        ratchet_diff,
        unregistered_edge_types,
        unregistered_evidence_types,
        unregistered_symbol_kinds,
    )
except ImportError as exc:  # pragma: no cover — defensive
    print(
        f"check-producer-axis-coherence: cannot import linter: {exc}",
        file=sys.stderr,
    )
    sys.exit(2)


_BASELINE_PATH = REPO_ROOT / ".ci" / "producer-axis-coherence-baseline.json"

_AXES = (
    ("Edge.evidence_type", unregistered_evidence_types),
    ("Symbol.kind", unregistered_symbol_kinds),
    ("Edge.edge_type", unregistered_edge_types),
)


def main() -> int:
    """WI-zipis producer-side ratchet gate (INV-numat closure mechanism).

    Fails on a NEW unregistered axis value emitted by ANY producer — direct
    constructor, module-level helper, or nested-closure helper (positional
    or keyword) — or on a baselined value no longer emitted (shrink-only).
    This replaces the raw strict-0 gate AND per-cohort validation_report
    counting (which provably undercounts, missing positional-helper and
    nested-closure producers) as the producer-side closure check.
    """
    baseline = json.loads(_BASELINE_PATH.read_text(encoding="utf-8"))
    failed = False

    for axis_name, finder in _AXES:
        live = finder(REPO_ROOT)  # {value: (file:line, ...)}
        new_leaks, stale = ratchet_diff(
            set(live), set(baseline.get(axis_name, [])),
        )
        if new_leaks:
            failed = True
            print(f"[{axis_name}] NEW unregistered producer value(s):")
            for v in new_leaks:
                print(f"  {v!r}  emitted at: {', '.join(live[v])}")
        if stale:
            failed = True
            print(
                f"[{axis_name}] baselined value(s) no longer emitted "
                f"(remove from {_BASELINE_PATH.name}, shrink-only): "
                f"{', '.join(repr(s) for s in stale)}"
            )

    if failed:
        print(
            "\nProducer-side axis coherence ratchet failed.\n"
            "NEW value: register it (ADR-0023 / ADR-0027 / ADR-0028) or fold\n"
            "the producer to a registered value. STALE baseline entry: delete\n"
            f"it from {_BASELINE_PATH.name} (the ratchet only shrinks).",
            file=sys.stderr,
        )
        return 1
    pending = sum(len(v) for v in baseline.values() if isinstance(v, list))
    print(
        f"L3 producer-coherence ratchet OK "
        f"(0 new leaks; {pending} baselined value(s) pending drain)."
    )
    return 0


if __name__ == "__main__":  # pragma: no cover
    sys.exit(main())

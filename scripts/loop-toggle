#!/bin/bash
# Toggle autonomous mode on/off
#
# This script toggles:
#   1. AUTONOMOUS_MODE.txt: TRUE <-> FALSE
#   2. .agent/LOOP sentinel: .agent/LOOP <-> .agent/disabled.LOOP
#
# Usage:
#   ./scripts/loop-toggle        # Toggle current state
#   ./scripts/loop-toggle on     # Force enable
#   ./scripts/loop-toggle off    # Force disable
#   ./scripts/loop-toggle status # Show current state

set -euo pipefail

# Find repo root
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODE_FILE="$REPO_ROOT/AUTONOMOUS_MODE.txt"
LOOP_FILE="$REPO_ROOT/.agent/LOOP"
DISABLED_LOOP="$REPO_ROOT/.agent/disabled.LOOP"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

get_current_state() {
    local mode_state="OFF"
    local loop_state="disabled"

    if [[ -f "$MODE_FILE" ]] && [[ "$(cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]')" == "TRUE" ]]; then
        mode_state="ON"
    fi

    if [[ -f "$LOOP_FILE" ]]; then
        loop_state="enabled"
    fi

    echo "$mode_state:$loop_state"
}

show_status() {
    local state
    state=$(get_current_state)
    local mode_state="${state%%:*}"
    local loop_state="${state##*:}"

    echo "Autonomous Mode Status"
    echo "======================"

    if [[ "$mode_state" == "ON" ]]; then
        echo -e "AUTONOMOUS_MODE.txt: ${GREEN}TRUE${NC}"
    else
        echo -e "AUTONOMOUS_MODE.txt: ${RED}FALSE${NC}"
    fi

    if [[ "$loop_state" == "enabled" ]]; then
        echo -e ".agent/LOOP:         ${GREEN}exists${NC}"
    else
        echo -e ".agent/LOOP:         ${RED}disabled${NC}"
    fi

    echo ""
    if [[ "$mode_state" == "ON" && "$loop_state" == "enabled" ]]; then
        echo -e "Status: ${GREEN}AUTONOMOUS MODE ACTIVE${NC}"
        echo "Governance hooks will enforce reflection before stopping."
    else
        echo -e "Status: ${YELLOW}AUTONOMOUS MODE INACTIVE${NC}"
        echo "Agent can stop freely without reflection."
    fi
}

enable_loop() {
    # Set AUTONOMOUS_MODE.txt to TRUE
    echo "TRUE" > "$MODE_FILE"

    # Enable .agent/LOOP (rename back if disabled, or create)
    if [[ -f "$DISABLED_LOOP" ]]; then
        mv "$DISABLED_LOOP" "$LOOP_FILE"
    elif [[ ! -f "$LOOP_FILE" ]]; then
        touch "$LOOP_FILE"
    fi

    echo -e "${GREEN}✓${NC} Autonomous mode ${GREEN}ENABLED${NC}"
    echo "  - AUTONOMOUS_MODE.txt set to TRUE"
    echo "  - .agent/LOOP sentinel active"
}

disable_loop() {
    # Set AUTONOMOUS_MODE.txt to FALSE
    echo "FALSE" > "$MODE_FILE"

    # Disable .agent/LOOP (rename to preserve)
    if [[ -f "$LOOP_FILE" ]]; then
        mv "$LOOP_FILE" "$DISABLED_LOOP"
    fi

    echo -e "${GREEN}✓${NC} Autonomous mode ${RED}DISABLED${NC}"
    echo "  - AUTONOMOUS_MODE.txt set to FALSE"
    echo "  - .agent/LOOP sentinel disabled"
}

toggle_loop() {
    local state
    state=$(get_current_state)
    local mode_state="${state%%:*}"

    if [[ "$mode_state" == "ON" ]]; then
        disable_loop
    else
        enable_loop
    fi
}

# Main
case "${1:-toggle}" in
    on|enable)
        enable_loop
        ;;
    off|disable)
        disable_loop
        ;;
    status|s)
        show_status
        ;;
    toggle|t|"")
        toggle_loop
        ;;
    -h|--help|help)
        echo "Usage: $(basename "$0") [command]"
        echo ""
        echo "Commands:"
        echo "  on, enable    Enable autonomous mode"
        echo "  off, disable  Disable autonomous mode"
        echo "  status, s     Show current state"
        echo "  toggle, t     Toggle current state (default)"
        echo "  help, -h      Show this help"
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run '$(basename "$0") --help' for usage." >&2
        exit 1
        ;;
esac

#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Toggle autonomous mode on/off with support for multiple modes.
#
# This script manages TWO files with overlapping purpose:
#
#   1. AUTONOMOUS_MODE.txt — CURRENT SESSION'S mode, consumed by stop hook.
#      Rewritten by the circuit-breaker trip path (to OFF) and by
#      --set-session-mode.
#   2. autonomous_intent.txt — PROJECT INTENT, per-workstation signal for
#      the agent-supervisor daemon (WI-razub). The human's desired mode
#      for this project; never written by the circuit breaker. Values:
#      OFF | BROAD | DEEP.
#   3. .agent/LOOP sentinel: .agent/LOOP <-> .agent/disabled.LOOP
#
# The bareword form (loop-toggle DEEP) writes BOTH files — the existing UX
# where a human decision updates both the current session AND the project
# intent. Use the --set-intent / --set-session-mode flags to touch only one.
#
# Modes:
#   OFF   - Autonomous mode disabled, agent can stop freely
#   BROAD - Regular bakeoff: parse correctness, fast iteration (legacy TRUE)
#   DEEP  - Feature bakeoff: usefulness testing, larger repos, LLM assessment
#
# Usage:
#   ./scripts/loop-toggle                          # Toggle (off -> broad -> deep -> off)
#   ./scripts/loop-toggle off                      # Disable — writes both files
#   ./scripts/loop-toggle broad                    # Enable broad — writes both files
#   ./scripts/loop-toggle deep                     # Enable deep — writes both files
#   ./scripts/loop-toggle on                       # Alias for 'broad' (backward compat)
#   ./scripts/loop-toggle status                   # Show current state
#   ./scripts/loop-toggle --set-intent MODE        # Write autonomous_intent.txt only
#   ./scripts/loop-toggle --set-session-mode MODE  # Write AUTONOMOUS_MODE.txt only

set -euo pipefail

# Find repo root
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODE_FILE="$REPO_ROOT/AUTONOMOUS_MODE.txt"
INTENT_FILE="$REPO_ROOT/autonomous_intent.txt"
LOOP_FILE="$REPO_ROOT/.agent/LOOP"
DISABLED_LOOP="$REPO_ROOT/.agent/disabled.LOOP"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

get_current_mode() {
    # Returns: OFF, BROAD, or DEEP
    # Strips optional pid=<N> suffix from the mode line.
    if [[ ! -f "$MODE_FILE" ]]; then
        echo "OFF"
        return
    fi

    local content
    # Read first line, strip pid=... suffix, normalize
    content=$(head -1 "$MODE_FILE" 2>/dev/null | sed 's/ *pid=[0-9]*//' | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')

    case "$content" in
        OFF|FALSE)
            echo "OFF"
            ;;
        BROAD|TRUE)
            # TRUE is backward compatible alias for BROAD
            echo "BROAD"
            ;;
        DEEP)
            echo "DEEP"
            ;;
        *)
            # Unknown value, treat as OFF
            echo "OFF"
            ;;
    esac
}

get_current_pid() {
    # Returns the PID stored in AUTONOMOUS_MODE.txt, or empty string if none.
    if [[ ! -f "$MODE_FILE" ]]; then
        echo ""
        return
    fi
    local content
    content=$(head -1 "$MODE_FILE" 2>/dev/null)
    if [[ "$content" =~ pid=([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo ""
    fi
}

get_current_intent() {
    # Returns the value of autonomous_intent.txt, normalized to OFF/BROAD/DEEP.
    # Missing file or unrecognized content defaults to OFF (safe — supervisor
    # does nothing in OFF).
    if [[ ! -f "$INTENT_FILE" ]]; then
        echo "OFF"
        return
    fi
    local content
    content=$(head -1 "$INTENT_FILE" 2>/dev/null | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
    case "$content" in
        OFF|FALSE) echo "OFF" ;;
        BROAD|TRUE) echo "BROAD" ;;
        DEEP) echo "DEEP" ;;
        *) echo "OFF" ;;
    esac
}

# Uppercase a mode token; validate it's one of OFF/BROAD/DEEP. Exits 1 if not.
validate_mode() {
    local raw="${1:-}"
    if [[ -z "$raw" ]]; then
        echo "Missing mode argument. Expected one of: OFF, BROAD, DEEP." >&2
        exit 1
    fi
    local upper
    upper=$(echo "$raw" | tr '[:lower:]' '[:upper:]')
    case "$upper" in
        OFF|BROAD|DEEP)
            echo "$upper"
            ;;
        *)
            echo "Unknown mode: $raw. Must be one of: OFF, BROAD, DEEP." >&2
            exit 1
            ;;
    esac
}

# Write autonomous_intent.txt only. Does NOT touch AUTONOMOUS_MODE.txt, the
# LOOP sentinel, or the circuit breaker. Called by --set-intent and as part
# of the bareword dual-write path.
write_intent() {
    local mode="$1"  # already validated OFF/BROAD/DEEP
    echo "$mode" > "$INTENT_FILE"
}

# Known agent CLI process patterns for pgrep discovery.
# Users can extend this list via .agent/known_agents.txt (one pattern per line).
AGENT_PATTERNS='claude|gemini|codex|aider|cursor|copilot'
KNOWN_AGENTS_FILE="$REPO_ROOT/.agent/known_agents.txt"
if [[ -f "$KNOWN_AGENTS_FILE" ]]; then
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        AGENT_PATTERNS="${AGENT_PATTERNS}|${line}"
    done < "$KNOWN_AGENTS_FILE"
fi

find_agent_pid() {
    # Find a running agent process via pgrep.
    # Uses comm-based matching (process name only, not full command line)
    # to avoid false positives from arguments containing agent names.
    # Returns: PID if exactly one found, empty if zero or ambiguous.
    # When multiple are found, prints a warning to stderr and returns empty.
    local pids filtered=()
    local self_pid=$$ parent_pid=$PPID

    # First try: match by process comm name (basename of executable).
    # This avoids false positives from paths/args containing agent names.
    local IFS='|'
    local -a patterns
    read -ra patterns <<< "$AGENT_PATTERNS"
    IFS=$' \t\n'
    for pat in "${patterns[@]}"; do
        while IFS= read -r pid; do
            [[ -z "$pid" ]] && continue
            [[ "$pid" == "$self_pid" ]] && continue
            [[ "$pid" == "$parent_pid" ]] && continue
            filtered+=("$pid")
        done < <(pgrep -x "$pat" 2>/dev/null || true)
    done

    # Deduplicate
    local -A seen
    local unique=()
    for pid in "${filtered[@]}"; do
        if [[ -z "${seen[$pid]:-}" ]]; then
            seen[$pid]=1
            unique+=("$pid")
        fi
    done

    case "${#unique[@]}" in
        0)
            echo ""
            ;;
        1)
            echo "${unique[0]}"
            ;;
        *)
            echo -e "${YELLOW}⚠${NC}  Multiple agent processes found:" >&2
            for pid in "${unique[@]}"; do
                local cmdline
                cmdline=$(ps -p "$pid" -o args= 2>/dev/null | head -c 80) || cmdline="(unknown)"
                echo "    PID $pid: $cmdline" >&2
            done
            echo "  Autonomous mode will apply to the next agent that starts." >&2
            echo ""
            ;;
    esac
}

get_loop_state() {
    if [[ -f "$LOOP_FILE" ]]; then
        echo "enabled"
    else
        echo "disabled"
    fi
}

show_status() {
    local mode
    mode=$(get_current_mode)
    local intent
    intent=$(get_current_intent)
    local stored_pid
    stored_pid=$(get_current_pid)
    local loop_state
    loop_state=$(get_loop_state)

    echo "Autonomous Mode Status"
    echo "======================"
    echo ""

    case "$mode" in
        OFF)
            echo -e "Mode: ${RED}OFF${NC}"
            echo "  AUTONOMOUS_MODE.txt = OFF (or FALSE)"
            ;;
        BROAD)
            echo -e "Mode: ${GREEN}BROAD${NC}"
            echo "  AUTONOMOUS_MODE.txt = BROAD (or TRUE)"
            echo "  Focus: Parse correctness, fast iteration"
            echo "  Bakeoff: scripts/bakeoff-broad"
            ;;
        DEEP)
            echo -e "Mode: ${CYAN}DEEP${NC}"
            echo "  AUTONOMOUS_MODE.txt = DEEP"
            echo "  Focus: Feature usefulness, larger repos"
            echo "  Bakeoff: scripts/bakeoff-deep"
            ;;
    esac

    echo ""
    case "$intent" in
        OFF)   echo -e "Intent: ${RED}OFF${NC}   (autonomous_intent.txt)" ;;
        BROAD) echo -e "Intent: ${GREEN}BROAD${NC} (autonomous_intent.txt)" ;;
        DEEP)  echo -e "Intent: ${CYAN}DEEP${NC}  (autonomous_intent.txt)" ;;
    esac
    if [[ "$intent" != "$mode" ]]; then
        echo -e "  ${YELLOW}Intent and current session mode differ.${NC}"
        echo "  Intent is the project-level signal the agent-supervisor consults."
        echo "  Session mode is the current CLI's runtime mode."
    fi

    echo ""
    if [[ -n "$stored_pid" ]]; then
        if kill -0 "$stored_pid" 2>/dev/null; then
            local cmdline
            cmdline=$(ps -p "$stored_pid" -o args= 2>/dev/null | head -c 60) || cmdline="(unknown)"
            echo -e "Bound to: PID ${GREEN}$stored_pid${NC} ($cmdline)"
        else
            echo -e "Bound to: PID ${RED}$stored_pid${NC} (process not running)"
        fi
    elif [[ "$mode" != "OFF" ]]; then
        echo -e "Bound to: ${YELLOW}(none — will bind to next agent started)${NC}"
    fi

    echo ""
    if [[ "$loop_state" == "enabled" ]]; then
        echo -e ".agent/LOOP: ${GREEN}exists${NC}"
    else
        echo -e ".agent/LOOP: ${RED}disabled${NC}"
    fi

    echo ""
    if [[ "$mode" != "OFF" && "$loop_state" == "enabled" ]]; then
        echo -e "Status: ${GREEN}AUTONOMOUS MODE ACTIVE${NC} (${mode})"
        echo "Governance hooks will enforce reflection before stopping."
    else
        echo -e "Status: ${YELLOW}AUTONOMOUS MODE INACTIVE${NC}"
        echo "Agent can stop freely without reflection."
    fi

    echo ""
    echo "Commands:"
    echo "  ./scripts/loop-toggle off    # Disable"
    echo "  ./scripts/loop-toggle broad  # Parse correctness bakeoff"
    echo "  ./scripts/loop-toggle deep   # Feature usefulness bakeoff"
}

reset_circuit_breaker() {
    # Reset the stop-hook circuit breaker so a fresh autonomous session
    # doesn't immediately trip on stale hashes from the prior session.
    #
    # Strategy: read the last hash, remove ALL occurrences of it from the
    # file, then append it back once. This resets the consecutive-identical
    # count to 1 (below the threshold of 5) while preserving history of
    # other hashes.
    local repo_name="${REPO_ROOT##*/}"
    local hash_file="/tmp/${repo_name}_stop_hashes"
    if [[ ! -f "$hash_file" ]]; then
        return
    fi

    local last_hash
    last_hash=$(tail -n 1 "$hash_file" 2>/dev/null)
    if [[ -z "$last_hash" ]]; then
        return
    fi

    # Remove all lines matching the last hash, then append it once
    local tmp_file
    tmp_file=$(mktemp)
    grep -vxF "$last_hash" "$hash_file" > "$tmp_file" 2>/dev/null || true
    echo "$last_hash" >> "$tmp_file"
    mv "$tmp_file" "$hash_file"
}

enable_loop_sentinel() {
    # Enable .agent/LOOP (rename back if disabled, or create)
    if [[ -f "$DISABLED_LOOP" ]]; then
        mv "$DISABLED_LOOP" "$LOOP_FILE"
    elif [[ ! -f "$LOOP_FILE" ]]; then
        touch "$LOOP_FILE"
    fi
}

disable_loop_sentinel() {
    # Disable .agent/LOOP (rename to preserve)
    if [[ -f "$LOOP_FILE" ]]; then
        mv "$LOOP_FILE" "$DISABLED_LOOP"
    fi
}

# --- Session-mode-only writers ---
# These write AUTONOMOUS_MODE.txt + manage the LOOP sentinel + reset the
# circuit breaker (for BROAD/DEEP). They do NOT touch autonomous_intent.txt.
# Called directly by --set-session-mode, and indirectly by set_mode_* via
# the bareword dual-write path.

write_session_mode_off() {
    echo "OFF" > "$MODE_FILE"
    disable_loop_sentinel
}

write_session_mode_broad() {
    local agent_pid
    agent_pid=$(find_agent_pid)
    if [[ -n "$agent_pid" ]]; then
        echo "BROAD pid=$agent_pid" > "$MODE_FILE"
    else
        echo "BROAD" > "$MODE_FILE"
    fi
    enable_loop_sentinel
    reset_circuit_breaker
    # Emit the PID to stdout via a global so set_mode_broad can print it.
    _LAST_BOUND_PID="$agent_pid"
}

write_session_mode_deep() {
    local agent_pid
    agent_pid=$(find_agent_pid)
    if [[ -n "$agent_pid" ]]; then
        echo "DEEP pid=$agent_pid" > "$MODE_FILE"
    else
        echo "DEEP" > "$MODE_FILE"
    fi
    enable_loop_sentinel
    reset_circuit_breaker
    _LAST_BOUND_PID="$agent_pid"
}

# --- Dual-write (bareword) mode setters ---
# These call the session-mode writer AND update autonomous_intent.txt, then
# print user-facing status. Use these for interactive / human-driven mode
# changes, where "the human just expressed intent" and the current session
# should also reflect that intent.

set_mode_off() {
    write_session_mode_off
    write_intent "OFF"

    echo -e "${GREEN}✓${NC} Autonomous mode ${RED}DISABLED${NC}"
    echo "  - AUTONOMOUS_MODE.txt set to OFF"
    echo "  - autonomous_intent.txt set to OFF"
    echo "  - .agent/LOOP sentinel disabled"
}

set_mode_broad() {
    write_session_mode_broad
    write_intent "BROAD"

    echo -e "${GREEN}✓${NC} Autonomous mode set to ${GREEN}BROAD${NC}"
    echo "  - AUTONOMOUS_MODE.txt set to BROAD"
    echo "  - autonomous_intent.txt set to BROAD"
    if [[ -n "${_LAST_BOUND_PID:-}" ]]; then
        echo "  - Bound to agent PID $_LAST_BOUND_PID"
    else
        echo "  - No agent found; will bind to next agent started"
    fi
    echo "  - .agent/LOOP sentinel active"
    echo ""
    echo "Focus: Parse correctness, call graph quality, route detection"
    echo "Use: ./scripts/bakeoff-broad for automated testing"
}

set_mode_deep() {
    write_session_mode_deep
    write_intent "DEEP"

    echo -e "${GREEN}✓${NC} Autonomous mode set to ${CYAN}DEEP${NC}"
    echo "  - AUTONOMOUS_MODE.txt set to DEEP"
    echo "  - autonomous_intent.txt set to DEEP"
    if [[ -n "${_LAST_BOUND_PID:-}" ]]; then
        echo "  - Bound to agent PID $_LAST_BOUND_PID"
    else
        echo "  - No agent found; will bind to next agent started"
    fi
    echo "  - .agent/LOOP sentinel active"
    echo ""
    echo "Focus: Feature usefulness, slice quality, developer perspective"
    echo "Use: ./scripts/bakeoff-deep for feature testing"
    echo "     ./scripts/bakeoff-deep-reflect for LLM assessment"
}

# --- Flag-form: --set-intent ---
# Writes autonomous_intent.txt only. Does NOT touch AUTONOMOUS_MODE.txt, the
# LOOP sentinel, or the circuit breaker. The supervisor consults this file
# to decide whether to respawn; the circuit breaker must not touch it.
set_intent_only() {
    local mode="$1"  # already validated OFF/BROAD/DEEP
    write_intent "$mode"
    echo -e "${GREEN}✓${NC} autonomous_intent.txt set to ${CYAN}$mode${NC}"
    echo "  (AUTONOMOUS_MODE.txt and .agent/LOOP unchanged)"
}

# --- Flag-form: --set-session-mode ---
# Writes AUTONOMOUS_MODE.txt + manages LOOP sentinel + resets circuit breaker
# (for BROAD/DEEP). Does NOT touch autonomous_intent.txt. Called by the
# circuit-breaker trip path so a stuck session can reset itself without
# flipping the project-level intent OFF.
set_session_mode_only() {
    local mode="$1"  # already validated OFF/BROAD/DEEP
    case "$mode" in
        OFF)
            write_session_mode_off
            echo -e "${GREEN}✓${NC} AUTONOMOUS_MODE.txt set to ${RED}OFF${NC}"
            echo "  (autonomous_intent.txt unchanged)"
            ;;
        BROAD)
            write_session_mode_broad
            echo -e "${GREEN}✓${NC} AUTONOMOUS_MODE.txt set to ${GREEN}BROAD${NC}"
            echo "  (autonomous_intent.txt unchanged)"
            ;;
        DEEP)
            write_session_mode_deep
            echo -e "${GREEN}✓${NC} AUTONOMOUS_MODE.txt set to ${CYAN}DEEP${NC}"
            echo "  (autonomous_intent.txt unchanged)"
            ;;
    esac
}

toggle_mode() {
    local current_mode
    current_mode=$(get_current_mode)

    case "$current_mode" in
        OFF)
            set_mode_broad
            ;;
        BROAD)
            set_mode_deep
            ;;
        DEEP)
            set_mode_off
            ;;
    esac
}

# Main
#
# Lowercase the argument before dispatching so callers can pass any
# casing — e.g., the session-start hook prompts the agent with "BROAD",
# "DEEP", or "OFF" (uppercase), and the agent should not have to know
# the script is internally lowercase. The case arms below all use
# lowercase patterns; this normalization makes them effectively
# case-insensitive.
#
# The two flag forms --set-intent and --set-session-mode take a second
# positional argument (the mode). See the top-of-file docstring for the
# rationale behind the intent-vs-session-mode split.
raw_arg="${1:-toggle}"
arg="${raw_arg,,}"
case "$arg" in
    --set-intent)
        shift
        validated=$(validate_mode "${1:-}")
        set_intent_only "$validated"
        ;;
    --set-session-mode)
        shift
        validated=$(validate_mode "${1:-}")
        set_session_mode_only "$validated"
        ;;
    off|disable)
        set_mode_off
        ;;
    broad)
        set_mode_broad
        ;;
    deep)
        set_mode_deep
        ;;
    on|enable)
        # Backward compatible: 'on' means BROAD
        set_mode_broad
        ;;
    status|s)
        show_status
        ;;
    toggle|t|"")
        toggle_mode
        ;;
    -h|--help|help)
        echo "Usage: $(basename "$0") [command]"
        echo ""
        echo "Manage autonomous mode for hypergumbo development."
        echo ""
        echo "Modes:"
        echo "  OFF   - Autonomous mode disabled"
        echo "  BROAD - Parse correctness bakeoff (fast iteration)"
        echo "  DEEP  - Feature usefulness bakeoff (larger repos, LLM assessment)"
        echo ""
        echo "Commands (dual-write — touches BOTH files):"
        echo "  off, disable  Disable autonomous mode"
        echo "  broad         Enable BROAD mode (parse correctness)"
        echo "  deep          Enable DEEP mode (feature usefulness)"
        echo "  on, enable    Alias for 'broad' (backward compatible)"
        echo "  status, s     Show current state"
        echo "  toggle, t     Cycle: off -> broad -> deep -> off (default)"
        echo "  help, -h      Show this help"
        echo ""
        echo "Flag forms (narrow writes — touch ONE file):"
        echo "  --set-intent MODE         Write autonomous_intent.txt only."
        echo "                            Project-level signal consumed by"
        echo "                            scripts/agent-supervisor (WI-razub)."
        echo "  --set-session-mode MODE   Write AUTONOMOUS_MODE.txt only."
        echo "                            Called by the circuit-breaker trip"
        echo "                            path so a stuck session can reset"
        echo "                            itself without flipping project intent."
        echo "                            MODE must be OFF, BROAD, or DEEP."
        echo ""
        echo "When autonomous mode is active:"
        echo "  - AGENTS.md priority queue guides work"
        echo "  - Governance hooks enforce reflection before stopping"
        echo "  - BROAD uses scripts/bakeoff-broad"
        echo "  - DEEP uses scripts/bakeoff-deep"
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run '$(basename "$0") --help' for usage." >&2
        exit 1
        ;;
esac

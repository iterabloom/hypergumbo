#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Index hypergumbo's YAML catalogs (canonical-registry view).

Each top-level YAML directory under
``packages/hypergumbo-core/src/hypergumbo_core/`` holds a category of catalog
data (framework patterns, I/O primitives, dataflow rules, taint sources, etc.).
``hypergumbo_core.yaml_catalogs`` is the registry; this script is the operator
view of that registry plus a drift check.

Usage::

    scripts/yaml-catalog-index             # human-readable table
    scripts/yaml-catalog-index --json      # machine-readable JSON
    scripts/yaml-catalog-index --check     # exit 1 if registry and tree drift
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).parent.parent
sys.path.insert(
    0, str(REPO_ROOT / "packages" / "hypergumbo-core" / "src")
)

from hypergumbo_core.yaml_catalogs import (  # noqa: E402
    enumerate_catalogs,
    validate_registry,
)


def _channel_cell(spec: object) -> str:
    """One-cell summary of a family's ADR-0047 ruling-7 extensibility answer."""
    if spec.user_channel is None:
        return "internal"
    cell = spec.user_channel
    if spec.channel_scope:
        cell += f" [{spec.channel_scope} only]"
    if spec.channel_gated:
        cell += " (gated)"
    return cell


def _format_table(rows: list[tuple[object, int]]) -> str:
    """Render the (spec, count) rows as an aligned plain-text table."""
    headers = ("Directory", "Files", "User channel", "ADR", "Loader", "Purpose")
    body = [
        (
            spec.directory,
            str(count),
            _channel_cell(spec),
            spec.adr or "—",
            spec.loader,
            spec.purpose,
        )
        for spec, count in rows
    ]
    widths = [
        max(len(h), max(len(row[i]) for row in body))
        for i, h in enumerate(headers[:-1])
    ]
    out: list[str] = []
    header_line = "  ".join(
        h.ljust(widths[i]) for i, h in enumerate(headers[:-1])
    ) + "  " + headers[-1]
    out.append(header_line)
    out.append("  ".join("-" * w for w in widths) + "  " + "-" * len(headers[-1]))
    for row in body:
        line = "  ".join(
            row[i].ljust(widths[i]) for i in range(len(headers) - 1)
        ) + "  " + row[-1]
        out.append(line)
    return "\n".join(out)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Index and validate hypergumbo's YAML catalogs.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--json", action="store_true",
        help="Emit machine-readable JSON instead of a human-readable table.",
    )
    mode.add_argument(
        "--check", action="store_true",
        help="Exit non-zero if the registry and the filesystem disagree.",
    )
    args = parser.parse_args(argv)

    findings = validate_registry()

    if args.check:
        if findings:
            for f in findings:
                print(f"DRIFT: {f}", file=sys.stderr)
            return 1
        print("OK: YAML catalog registry matches filesystem.")
        return 0

    rows = enumerate_catalogs()
    if args.json:
        payload = [
            {
                "directory": spec.directory,
                "file_count": count,
                "adr": spec.adr,
                "loader": spec.loader,
                "purpose": spec.purpose,
                "user_channel": spec.user_channel,
                "no_channel_reason": spec.no_channel_reason,
                "channel_scope": spec.channel_scope,
                "channel_gated": spec.channel_gated,
            }
            for spec, count in rows
        ]
        print(json.dumps(payload, indent=2))
    else:
        print(_format_table(rows))
        total = sum(count for _, count in rows)
        print(f"\nTotal: {total} YAML files across {len(rows)} catalogs.")
        # Reported per FAMILY, not per file: dataflow_patterns' channel is
        # scoped to one section, so counting its files as extensible would
        # overstate what a user may actually contribute.
        open_families = [s for s, _ in rows if s.user_channel is not None]
        internal = [s for s, _ in rows if s.user_channel is None]
        print(
            f"User channel: {len(open_families)} of {len(rows)} families "
            f"(ADR-0047 ruling 10); internal: "
            f"{', '.join(s.directory for s in internal) or 'none'}."
        )
        for spec in open_families:
            if spec.channel_scope:
                print(
                    f"  {spec.directory}: limited to the "
                    f"'{spec.channel_scope}' section."
                )
            if spec.channel_gated:
                print(
                    f"  {spec.directory}: user entries ride "
                    f"{spec.channel_gated}."
                )

    if findings:
        print("\nDrift warnings:", file=sys.stderr)
        for f in findings:
            print(f"  {f}", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())

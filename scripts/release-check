#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Pre-release validation script for multi-package hypergumbo.
#
# Runs all checks required before a release can proceed.
# This is more thorough than dev CI - it's the "go/no-go" gate.
#
# Usage:
#   ./scripts/release-check [--fix]
#
# Options:
#   --fix    Attempt to fix issues (update CHANGELOG, bump version)
#
# Exit codes:
#   0 - All checks passed, ready to release
#   1 - Checks failed, see output for details
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FIX_MODE=false
if [[ "${1:-}" == "--fix" ]]; then
    FIX_MODE=true
fi

FAILED=0
WARNINGS=0

pass() {
    echo -e "${GREEN}✓${NC} $1"
}

fail() {
    echo -e "${RED}✗${NC} $1"
    FAILED=$((FAILED + 1))
}

warn() {
    echo -e "${YELLOW}!${NC} $1"
    WARNINGS=$((WARNINGS + 1))
}

section() {
    echo ""
    echo "━━━ $1 ━━━"
}

# Get project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

echo "╔════════════════════════════════════════╗"
echo "║       Release Readiness Check          ║"
echo "║       (Multi-Package v2.0+)            ║"
echo "╚════════════════════════════════════════╝"

# Package directories
PACKAGES=(
    "packages/hypergumbo-core"
    "packages/hypergumbo-lang-mainstream"
    "packages/hypergumbo-lang-common"
    "packages/hypergumbo-lang-extended1"
    "packages/hypergumbo-lang-rust-analyzer"
    "packages/hypergumbo-lang-scip-python"
    "packages/hypergumbo"
)

# ─────────────────────────────────────────────────────────────
section "1. Git State"
# ─────────────────────────────────────────────────────────────

# Check for uncommitted changes
if [[ -n "$(git status --porcelain)" ]]; then
    fail "Uncommitted changes detected"
    git status --short
else
    pass "Working directory clean"
fi

# Check we're on the right branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$CURRENT_BRANCH" == "dev" || "$CURRENT_BRANCH" == "main" ]]; then
    pass "On branch: $CURRENT_BRANCH"
else
    warn "On branch '$CURRENT_BRANCH' (expected 'dev' or 'main')"
fi

# Check if up to date with remote.
# NOTE on --verify: `git rev-parse <ref>` without --verify echoes the input
# ref to stdout AND returns non-zero when the ref can't be resolved, so the
# naive form `$(git rev-parse "origin/$CURRENT_BRANCH" 2>/dev/null || echo "none")`
# produces the multi-line string "origin/<branch>\nnone" on a brand-new
# branch (e.g., fresh `release/vX.Y.Z` during `prepare-release`). That
# string satisfies neither `== "none"` nor `git merge-base --is-ancestor`,
# so the check falls through to the generic `fail` branch and blocks the
# release gate on a false positive. `--verify "<ref>^{commit}"` makes
# rev-parse emit nothing and exit non-zero on an unknown ref, so the
# fallback branch is the only thing the command substitution captures.
git fetch origin --quiet
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse --verify "origin/$CURRENT_BRANCH^{commit}" 2>/dev/null || echo "none")
if [[ "$LOCAL" == "$REMOTE" ]]; then
    pass "Branch up to date with origin"
elif [[ "$REMOTE" == "none" ]]; then
    warn "No remote tracking branch (expected for a fresh feature or release branch)"
elif git merge-base --is-ancestor "$REMOTE" "$LOCAL" 2>/dev/null; then
    warn "Branch is ahead of origin (unpushed commits — expected during prepare-release)"
else
    fail "Branch not in sync with origin (pull or push needed)"
fi

# ─────────────────────────────────────────────────────────────
section "2. Version Sync Across Packages"
# ─────────────────────────────────────────────────────────────

# Extract version from core package (source of truth)
CORE_PYPROJECT="packages/hypergumbo-core/pyproject.toml"
if [[ ! -f "$CORE_PYPROJECT" ]]; then
    CORE_PYPROJECT="pyproject.toml"  # Fallback for pre-2.0
fi

VERSION=$(grep -E '^version\s*=' "$CORE_PYPROJECT" | head -1 | sed 's/^[^"]*"\([^"]*\)".*/\1/')
if [[ -n "$VERSION" ]]; then
    pass "Core version: $VERSION"
else
    fail "Could not extract version from $CORE_PYPROJECT"
fi

# Check all packages have the same version
for pkg in "${PACKAGES[@]}"; do
    pyproject="$pkg/pyproject.toml"
    if [[ -f "$pyproject" ]]; then
        PKG_VERSION=$(grep -E '^version\s*=' "$pyproject" | head -1 | sed 's/^[^"]*"\([^"]*\)".*/\1/')
        if [[ "$PKG_VERSION" == "$VERSION" ]]; then
            pass "$pkg: v$PKG_VERSION"
        else
            fail "$pkg: v$PKG_VERSION (expected v$VERSION)"
        fi
    fi
done

# Check CHANGELOG.md exists and has entry for this version
if [[ -f "CHANGELOG.md" ]]; then
    if grep -q "## \[$VERSION\]" CHANGELOG.md; then
        pass "CHANGELOG.md has entry for v$VERSION"
    elif grep -q "## \[Unreleased\]" CHANGELOG.md; then
        if $FIX_MODE; then
            warn "CHANGELOG.md has Unreleased section (would update in --fix mode)"
        else
            fail "CHANGELOG.md has Unreleased but no entry for v$VERSION"
            echo "    Run with --fix to update, or manually add ## [$VERSION] - $(date +%Y-%m-%d)"
        fi
    else
        fail "CHANGELOG.md missing entry for v$VERSION"
    fi
else
    fail "CHANGELOG.md not found"
fi

# Check version doesn't already have a git tag
if git rev-parse "v$VERSION" >/dev/null 2>&1; then
    fail "Tag v$VERSION already exists"
else
    pass "Tag v$VERSION is available"
fi

# ─────────────────────────────────────────────────────────────
section "2b. Tracker Version Consistency"
# ─────────────────────────────────────────────────────────────

# Tracker is independently versioned (NOT required to match main version)
TRACKER_PYPROJECT="packages/hypergumbo-tracker/pyproject.toml"
TRACKER_INIT="packages/hypergumbo-tracker/src/hypergumbo_tracker/__init__.py"
if [[ -f "$TRACKER_PYPROJECT" ]]; then
    TRACKER_PYPROJECT_VER=$(grep -E '^version\s*=' "$TRACKER_PYPROJECT" | head -1 | sed 's/^[^"]*"\([^"]*\)".*/\1/')
    if [[ -f "$TRACKER_INIT" ]] && grep -q "__version__" "$TRACKER_INIT"; then
        TRACKER_INIT_VER=$(grep "^__version__" "$TRACKER_INIT" | sed 's/^[^"]*"\([^"]*\)".*/\1/')
        if [[ "$TRACKER_PYPROJECT_VER" == "$TRACKER_INIT_VER" ]]; then
            pass "Tracker version consistent: $TRACKER_PYPROJECT_VER (pyproject.toml == __init__.py)"
        else
            fail "Tracker version mismatch: pyproject.toml=$TRACKER_PYPROJECT_VER, __init__.py=$TRACKER_INIT_VER"
        fi
    else
        pass "Tracker version: $TRACKER_PYPROJECT_VER (no __init__.py version to check)"
    fi
else
    warn "hypergumbo-tracker package not found"
fi

# ─────────────────────────────────────────────────────────────
section "3. Dependencies & Security"
# ─────────────────────────────────────────────────────────────

# Check for known vulnerabilities in a fresh environment built as
# .github/workflows/release.yml::security-audit builds its own, with the same
# invocation, so a clean local run is a faithful preview of the release gate:
#   --skip-editable        skip our own editable installs (audited at build)
#   --ignore-vuln CVE-2025-71176  pytest TOCTOU (dev-only, single-tenant runner)
#   --ignore-vuln CVE-2026-3219   pip ZIP confusion (AV:L+UI:A, ~0 exposure)
# Re-check cadence: tracker item WI-totak (drop each ignore when a fixed
# release ships).
# pip-audit's exit code is the gate: 0 = no vulnerabilities, 1 = found.
# Anything else (network, parse, unsupported package) is a real failure
# we want to surface, not paper over.
# WI-putib: the audit asks "does a fresh install of what we ship carry a known
# vulnerability". It used to audit THIS box's environment, after upgrading a
# hand-kept list of packages on it, so its answer depended on the box's history:
# the 10.0.0 prepare-release failed on 71 advisories in seven packages that
# satisfied old minimum versions (PR #2206 raised them), as 9.0.0 had
# (e67891020a), while a fresh environment, which resolves the newest releases,
# never saw them. It now builds a fresh environment the way release.yml's
# security-audit job does (the gate that blocks publishing) and audits that:
# the same editable packages, the same pins, the same ignore list.
# tests/test_release_check_gates.py pins the mirror. Python 3.11 when present
# (the runner's); otherwise python3, said below.
# >>> fresh audit environment
AUDIT_DIR=$(mktemp -d)
AUDIT_PY=$(command -v python3.11 || command -v python3)
AUDIT_ENV_OK=1
echo "  Building a fresh audit environment ($("$AUDIT_PY" --version 2>&1), as release.yml's security-audit)..."
{
    "$AUDIT_PY" -m venv "$AUDIT_DIR/venv" &&
    "$AUDIT_DIR/venv/bin/pip" install --upgrade pip "wheel>=0.46.2" setuptools &&
    "$AUDIT_DIR/venv/bin/pip" install -e "packages/hypergumbo-core[dev]" \
        -e packages/hypergumbo-lang-mainstream \
        -e packages/hypergumbo-lang-common \
        -e packages/hypergumbo-lang-extended1 \
        -e packages/hypergumbo-lang-rust-analyzer \
        -e packages/hypergumbo-tracker &&
    "$AUDIT_DIR/venv/bin/pip" install pip-audit bandit pip-licenses &&
    "$AUDIT_DIR/venv/bin/pip" install "requests~=2.33.0" "pygments~=2.20.0" "urllib3>=2.8.0" \
        "idna>=3.15" "msgpack>=1.2.3" "click>=8.3.3"
} >"$AUDIT_DIR/setup.log" 2>&1 || AUDIT_ENV_OK=0
# <<< fresh audit environment
AUDIT_SAVED_PATH=$PATH
if [ "$AUDIT_ENV_OK" -eq 1 ]; then
    PATH="$AUDIT_DIR/venv/bin:$PATH"
else
    tail -20 "$AUDIT_DIR/setup.log"
    # Never fall back to this box's pip-audit: that is the answer this replaced.
    pip-audit() { echo "pip-audit not run: the fresh audit environment did not build (above)"; return 2; }
fi

echo "  Running pip-audit..."
# --ignore-vuln list kept IN SYNC with .woodpecker/woodpecker.yml and
# release.yml (tests/test_audit_ignore_lists.py pins the sync). The local-only
# carve-out CVE-2025-69872 (diskcache, via llama_cpp_python, no fix) is gone with
# the box's environment: the fresh environment does not install it (WI-putib).
#
# The 24-id torch / transformers / joblib carve-out is RETIRED (WI-totak,
# 2026-09-27). On torch 2.14 / transformers 5.17 / joblib 1.5.3 none of its ids
# fires (an audit with only the two CI ignores reports diskcache and
# nothing else), and no CI audit env installs the ML stack at all. A dead ignore
# is not free: it would hide the NEXT torch or transformers advisory here.
#
# WI-totak, answered with evidence on 2026-08-18 rather than by re-reading the
# list: PYSEC-2026-597 (nltk) was carried here as "no fix available" and that had
# stopped being true — nltk 3.10 fixes it, along with PYSEC-2026-3582/3583/3584.
# Dropping the ignore and re-running leaves the audit clean for nltk, so the
# carve-out is gone and nltk is PINNED above instead. A dead ignore in a security
# gate is worse than the CVE it names: it is a false statement about what was
# checked, and it hides the next advisory for that package.
#
# The diskcache carve-out STAYS, and was re-tested the same way: dropping it
# surfaces PYSEC-2026-2447 (the same advisory under its PYSEC id, still no fix
# version). Fixable deps are pinned above, not ignored here.
#
# The nltk carve-out PYSEC-2026-3740 (CVE-2026-81726) is gone since 2026-11-16:
# with nltk 3.10.4 (pinned above) an audit with only the two CI ignores reports
# diskcache and nothing else.
#
# WI-zisoj: `|| AUDIT_EXIT=$?`, NOT a bare `AUDIT_EXIT=$?` on the next line.
# This script runs under `set -euo pipefail` (line 18), and a simple assignment
# whose command substitution exits non-zero terminates the script AT THE
# ASSIGNMENT — so the capture never ran, the if/else below was unreachable, and
# a non-clean audit killed the gate mid-sentence instead of reporting. Every
# check after this one was skipped with it. The comment above ("a real failure
# we want to surface, not paper over") described the intent; the mechanism did
# the opposite.
AUDIT_EXIT=0
AUDIT_OUTPUT=$(pip-audit --skip-editable \
    --ignore-vuln CVE-2025-71176 --ignore-vuln CVE-2026-3219 2>&1) || AUDIT_EXIT=$?
if [ $AUDIT_EXIT -eq 0 ]; then
    pass "No known vulnerabilities in dependencies"
else
    echo "$AUDIT_OUTPUT"
    fail "Vulnerabilities detected (pip-audit exit $AUDIT_EXIT)"
fi
PATH=$AUDIT_SAVED_PATH
unset -f pip-audit 2>/dev/null || true
rm -rf "$AUDIT_DIR"

# Check for secrets
echo "  Scanning for secrets..."
if command -v gitleaks &>/dev/null; then
    if gitleaks detect --source . --no-git --no-banner 2>/dev/null; then
        pass "No secrets detected (gitleaks)"
    else
        fail "Potential secrets detected (run 'gitleaks detect' for details)"
    fi
elif command -v trufflehog &>/dev/null; then
    if trufflehog filesystem . --no-update --quiet 2>/dev/null; then
        pass "No secrets detected (trufflehog)"
    else
        fail "Potential secrets detected"
    fi
else
    warn "No secret scanner installed (install gitleaks or trufflehog)"
fi

# Security linting
echo "  Running Bandit..."
if bandit -r src/ packages/*/src/ -c pyproject.toml --quiet 2>/dev/null; then
    pass "Security linting passed (Bandit)"
else
    fail "Security issues detected (run 'bandit -r src/' for details)"
fi

# ─────────────────────────────────────────────────────────────
section "4. Code Quality"
# ─────────────────────────────────────────────────────────────

# Linting
echo "  Running Ruff..."
if ruff check packages/*/src packages/*/tests tests/ --quiet 2>/dev/null; then
    pass "Linting passed (Ruff)"
else
    fail "Linting issues detected (run 'ruff check packages/*/src packages/*/tests tests/')"
fi

# Type checking (if configured)
if command -v mypy &>/dev/null && [[ -f "mypy.ini" || -f "pyproject.toml" ]]; then
    echo "  Running mypy..."
    if mypy src/ --quiet 2>/dev/null; then
        pass "Type checking passed (mypy)"
    else
        warn "Type checking issues (run 'mypy src/')"
    fi
fi

# ─────────────────────────────────────────────────────────────
section "5. Test Suite"
# ─────────────────────────────────────────────────────────────

# Run tests with coverage — call pytest directly, matching the way the
# three sibling authoritative full-suite runners (`full-suite.yml`,
# `nightly.yml`, `release.yml`) already invoke pytest. release-check is
# architecturally parallel to those workflows: it is a gate, not part of
# the dev feedback loop, and therefore does not route through the
# smart-test pytest wrapper. That wrapper (a) is designed to select only
# affected tests and (b) writes a targeted manifest as a side effect — both
# appropriate for the dev loop, neither appropriate for a release gate.
#
# Coverage paths are sourced from scripts/lib/cov-paths.sh so that adding
# a new released package updates this gate in a single edit.
#
# Previously this block read:
#   pytest --full --cov-fail-under=100 --quiet 2>/dev/null
# That routed through smart-test; silenced stderr (violating the norm
# codified by commit 72b7f1fd5 for smart-test's own slice stderr capture);
# and surfaced "Tests failed or coverage < 100%" with a stale
# `.ci/pytest-output.log` as the only artifact when things went wrong.
# The new form captures full output to a dedicated log that the failure
# message names, so the next agent or human does not have to re-run a
# 15-minute suite to learn which line is uncovered.
# shellcheck source=lib/cov-paths.sh
source "$(dirname "$0")/lib/cov-paths.sh"
RELEASE_CHECK_PYTEST_LOG=".ci/release-check-pytest.log"
echo "  Running pytest with coverage (full suite)..."
echo "    log: $RELEASE_CHECK_PYTEST_LOG"
if python -m pytest packages/*/tests/ \
        "${COV_PATHS_ALL[@]}" \
        -n auto \
        --cov-fail-under=100 \
        >"$RELEASE_CHECK_PYTEST_LOG" 2>&1; then
    pass "All tests passed with 100% coverage"
else
    fail "Tests failed or coverage < 100% (see $RELEASE_CHECK_PYTEST_LOG)"
fi

# ─────────────────────────────────────────────────────────────
section "6. Build Verification (All Packages)"
# ─────────────────────────────────────────────────────────────

# Test that all packages build
echo "  Building all packages..."
rm -rf dist/ build/ *.egg-info

BUILD_FAILED=0
for pkg in "${PACKAGES[@]}"; do
    if [[ -f "$pkg/pyproject.toml" ]]; then
        echo "    Building $pkg..."
        if pip wheel "$pkg" --no-deps --wheel-dir dist/ --quiet 2>/dev/null; then
            PKG_NAME=$(basename "$pkg")
            PKG_NAME_UNDER="${PKG_NAME//-/_}"
            WHEEL=$(ls dist/*"$PKG_NAME_UNDER"*.whl 2>/dev/null | head -1 || echo "")
            if [[ -n "$WHEEL" ]]; then
                pass "  Built: $(basename "$WHEEL")"
            else
                fail "  Wheel not created for $pkg"
                BUILD_FAILED=1
            fi
        else
            fail "  Build failed for $pkg"
            BUILD_FAILED=1
        fi
    fi
done

if [[ $BUILD_FAILED -eq 0 ]]; then
    pass "All main packages build successfully"
fi

# Build tracker separately (independent version)
if [[ -f "packages/hypergumbo-tracker/pyproject.toml" ]]; then
    echo "    Building packages/hypergumbo-tracker..."
    if pip wheel "packages/hypergumbo-tracker" --no-deps --wheel-dir dist/ --quiet 2>/dev/null; then
        TRACKER_WHEEL=$(ls dist/*hypergumbo_tracker*.whl 2>/dev/null | head -1 || echo "")
        if [[ -n "$TRACKER_WHEEL" ]]; then
            pass "  Built: $(basename "$TRACKER_WHEEL")"
        else
            fail "  Wheel not created for hypergumbo-tracker"
        fi
    else
        fail "  Build failed for hypergumbo-tracker"
    fi
fi

# >>> wheel install
# WI-putib: the wheels are INSTALLED, not dry-run against an index. `pip install
# <wheel> --dry-run` could not resolve hypergumbo-core==<new version> before it is
# published, so it warned "(may be pip version issue)" for six packages on every
# run, and a check that always warns cannot report a real failure. Like
# release.yml's "Verify wheels" step, pip finds the sibling wheels in dist/
# (--find-links). The default package set (release.yml's io-manifest job: as a
# user installs it) goes into a fresh environment that the I/O check below runs;
# the other packages are resolved against it.
echo "  Installing the built wheels into a fresh environment, as a user would..."
WHEEL_PY=${WHEEL_PY:-$(command -v python3.11 || command -v python3)}
WHEEL_DIR=$(mktemp -d)
WHEEL_VENV=""
DEFAULT_SET=(hypergumbo-core hypergumbo-lang-mainstream hypergumbo-lang-common
             hypergumbo-lang-extended1 hypergumbo)
DEFAULT_WHEELS=()
for name in "${DEFAULT_SET[@]}"; do
    w=$(ls dist/"${name//-/_}"-*.whl 2>/dev/null | head -1 || true)
    if [[ -n "$w" ]]; then DEFAULT_WHEELS+=("$w"); else fail "  No wheel in dist/ for $name"; fi
done
if "$WHEEL_PY" -m venv "$WHEEL_DIR/venv" >"$WHEEL_DIR/install.log" 2>&1 &&
    "$WHEEL_DIR/venv/bin/pip" install --find-links dist/ "${DEFAULT_WHEELS[@]}" \
        >>"$WHEEL_DIR/install.log" 2>&1; then
    WHEEL_VENV="$WHEEL_DIR/venv"
    pass "  The default package set installs from the built wheels"
else
    tail -20 "$WHEEL_DIR/install.log"
    fail "  The default package set does not install from the built wheels (pip says above)"
fi
for name in hypergumbo-lang-rust-analyzer hypergumbo-lang-scip-python hypergumbo-tracker; do
    w=$(ls dist/"${name//-/_}"-*.whl 2>/dev/null | head -1 || true)
    [[ -n "$w" ]] || continue  # its build above already failed, loudly
    if [[ -n "$WHEEL_VENV" ]] && "$WHEEL_VENV/bin/pip" install --dry-run --find-links dist/ \
            "$w" >>"$WHEEL_DIR/install.log" 2>&1; then
        pass "  $name can be installed"
    else
        tail -20 "$WHEEL_DIR/install.log"
        fail "  $name cannot be installed from the built wheels (pip says above)"
    fi
done
# <<< wheel install

# ─────────────────────────────────────────────────────────────
section "6b. Observed I/O (release.yml's io-manifest job)"
# ─────────────────────────────────────────────────────────────
# >>> io-manifest gate
# WI-putib: the I/O manifest comparison ran only in the release workflow, after
# the tag: v10.0.0 was signed and pushed, the run failed on four lines the release
# itself had added (merged days earlier), nothing was published, and the tag was
# recreated. It runs here, before any tag, whenever strace is installed: the
# default package set from the wheels above, PATH hidden as the README's hermetic
# recipe does (no local gitleaks or rust-analyzer). IO_MANIFEST_CORPUS_ROOT names
# existing clones (reused at their pins); without it the six repositories are
# fetched. Without strace it says so: dispatch the Release workflow with
# dry_run=true on main before tag-release (prepare-release's handoff says it too).
IO_MANIFEST=${IO_MANIFEST:-./scripts/io-manifest}
if ! command -v strace >/dev/null 2>&1; then
    warn "strace is not installed, so the I/O manifest was not compared: before tag-release, dispatch the Release workflow with dry_run=true on main"
elif [[ -z "$WHEEL_VENV" ]]; then
    fail "The I/O manifest was not compared: the default package set did not install"
else
    echo "  Tracing the corpus (docs/io-manifest/corpus.txt)..."
    IOM_ARGS=(run --corpus docs/io-manifest/corpus.txt --expected docs/io-manifest/expected.txt
              --out "$WHEEL_DIR/io-manifest" --hypergumbo "$WHEEL_VENV/bin/hypergumbo"
              --path /usr/local/bin:/usr/bin:/bin)
    if [[ -n "${IO_MANIFEST_CORPUS_ROOT:-}" ]]; then
        IOM_ARGS+=(--corpus-root "$IO_MANIFEST_CORPUS_ROOT")
    fi
    IOM_EXIT=0
    "$IO_MANIFEST" "${IOM_ARGS[@]}" >"$WHEEL_DIR/io-manifest.log" 2>&1 || IOM_EXIT=$?
    if [ $IOM_EXIT -eq 0 ]; then
        pass "The observed I/O matches docs/io-manifest/expected.txt"
    else
        tail -30 "$WHEEL_DIR/io-manifest.log"
        fail "The observed I/O differs from docs/io-manifest/expected.txt, or the trace failed (io-manifest exit $IOM_EXIT; above)"
    fi
fi
# <<< io-manifest gate
rm -rf "$WHEEL_DIR"

# ─────────────────────────────────────────────────────────────
section "7. Documentation"
# ─────────────────────────────────────────────────────────────

# Check generated files are up to date
if [[ -x "./scripts/generate-schema" ]]; then
    if ./scripts/generate-schema --check 2>/dev/null; then
        pass "Schema is up to date"
    else
        fail "Schema needs regeneration (run './scripts/generate-schema')"
    fi
fi

if [[ -x "./scripts/generate-architecture" ]]; then
    if ./scripts/generate-architecture --check 2>/dev/null; then
        pass "Architecture docs up to date"
    else
        fail "Architecture docs need regeneration"
    fi
fi

# ─────────────────────────────────────────────────────────────
section "8. License Compliance"
# ─────────────────────────────────────────────────────────────

# Check dependency licenses (if pip-licenses available)
if command -v pip-licenses &>/dev/null; then
    echo "  Checking dependency licenses..."
    PROBLEMATIC="GPL;AGPL;SSPL;BUSL"
    if pip-licenses --format=csv 2>/dev/null | grep -qiE "$PROBLEMATIC"; then
        warn "Some dependencies have copyleft licenses (review manually)"
        pip-licenses --format=markdown | grep -iE "$PROBLEMATIC" || true
    else
        pass "No problematic licenses detected"
    fi
else
    warn "pip-licenses not installed (run 'pip install pip-licenses' for license audit)"
fi

# ─────────────────────────────────────────────────────────────
section "Summary"
# ─────────────────────────────────────────────────────────────

echo ""
if [[ $FAILED -eq 0 ]]; then
    echo -e "${GREEN}╔════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   All checks passed! Ready to release  ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════╝${NC}"
    if [[ $WARNINGS -gt 0 ]]; then
        echo -e "${YELLOW}($WARNINGS warnings - review recommended)${NC}"
    fi
    echo ""
    echo "Packages to release:"
    for pkg in "${PACKAGES[@]}"; do
        echo "  - $(basename "$pkg") v$VERSION"
    done
    if [[ -f "$TRACKER_PYPROJECT" ]]; then
        echo "  - hypergumbo-tracker v$TRACKER_PYPROJECT_VER (independent version)"
    fi
    echo ""
    echo "Next steps:"
    echo "  1. Review CHANGELOG.md"
    echo "  2. Run: ./scripts/prepare-release $VERSION"
    exit 0
else
    echo -e "${RED}╔════════════════════════════════════════╗${NC}"
    echo -e "${RED}║   $FAILED check(s) failed - not ready     ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════╝${NC}"
    echo ""
    echo "Fix the issues above before releasing."
    exit 1
fi

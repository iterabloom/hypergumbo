#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Pre-release validation script for multi-package hypergumbo.
#
# Runs all checks required before a release can proceed.
# This is more thorough than dev CI - it's the "go/no-go" gate.
#
# Usage:
#   ./scripts/release-check [--fix]
#
# Options:
#   --fix    Attempt to fix issues (update CHANGELOG, bump version)
#
# Exit codes:
#   0 - All checks passed, ready to release
#   1 - Checks failed, see output for details
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FIX_MODE=false
if [[ "${1:-}" == "--fix" ]]; then
    FIX_MODE=true
fi

FAILED=0
WARNINGS=0

pass() {
    echo -e "${GREEN}✓${NC} $1"
}

fail() {
    echo -e "${RED}✗${NC} $1"
    FAILED=$((FAILED + 1))
}

warn() {
    echo -e "${YELLOW}!${NC} $1"
    WARNINGS=$((WARNINGS + 1))
}

section() {
    echo ""
    echo "━━━ $1 ━━━"
}

# Get project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

echo "╔════════════════════════════════════════╗"
echo "║       Release Readiness Check          ║"
echo "║       (Multi-Package v2.0+)            ║"
echo "╚════════════════════════════════════════╝"

# Package directories
PACKAGES=(
    "packages/hypergumbo-core"
    "packages/hypergumbo-lang-mainstream"
    "packages/hypergumbo-lang-common"
    "packages/hypergumbo-lang-extended1"
    "packages/hypergumbo-lang-rust-analyzer"
    "packages/hypergumbo"
)

# ─────────────────────────────────────────────────────────────
section "1. Git State"
# ─────────────────────────────────────────────────────────────

# Check for uncommitted changes
if [[ -n "$(git status --porcelain)" ]]; then
    fail "Uncommitted changes detected"
    git status --short
else
    pass "Working directory clean"
fi

# Check we're on the right branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$CURRENT_BRANCH" == "dev" || "$CURRENT_BRANCH" == "main" ]]; then
    pass "On branch: $CURRENT_BRANCH"
else
    warn "On branch '$CURRENT_BRANCH' (expected 'dev' or 'main')"
fi

# Check if up to date with remote.
# NOTE on --verify: `git rev-parse <ref>` without --verify echoes the input
# ref to stdout AND returns non-zero when the ref can't be resolved, so the
# naive form `$(git rev-parse "origin/$CURRENT_BRANCH" 2>/dev/null || echo "none")`
# produces the multi-line string "origin/<branch>\nnone" on a brand-new
# branch (e.g., fresh `release/vX.Y.Z` during `prepare-release`). That
# string satisfies neither `== "none"` nor `git merge-base --is-ancestor`,
# so the check falls through to the generic `fail` branch and blocks the
# release gate on a false positive. `--verify "<ref>^{commit}"` makes
# rev-parse emit nothing and exit non-zero on an unknown ref, so the
# fallback branch is the only thing the command substitution captures.
git fetch origin --quiet
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse --verify "origin/$CURRENT_BRANCH^{commit}" 2>/dev/null || echo "none")
if [[ "$LOCAL" == "$REMOTE" ]]; then
    pass "Branch up to date with origin"
elif [[ "$REMOTE" == "none" ]]; then
    warn "No remote tracking branch (expected for a fresh feature or release branch)"
elif git merge-base --is-ancestor "$REMOTE" "$LOCAL" 2>/dev/null; then
    warn "Branch is ahead of origin (unpushed commits — expected during prepare-release)"
else
    fail "Branch not in sync with origin (pull or push needed)"
fi

# ─────────────────────────────────────────────────────────────
section "2. Version Sync Across Packages"
# ─────────────────────────────────────────────────────────────

# Extract version from core package (source of truth)
CORE_PYPROJECT="packages/hypergumbo-core/pyproject.toml"
if [[ ! -f "$CORE_PYPROJECT" ]]; then
    CORE_PYPROJECT="pyproject.toml"  # Fallback for pre-2.0
fi

VERSION=$(grep -E '^version\s*=' "$CORE_PYPROJECT" | head -1 | sed 's/.*"\(.*\)".*/\1/')
if [[ -n "$VERSION" ]]; then
    pass "Core version: $VERSION"
else
    fail "Could not extract version from $CORE_PYPROJECT"
fi

# Check all packages have the same version
for pkg in "${PACKAGES[@]}"; do
    pyproject="$pkg/pyproject.toml"
    if [[ -f "$pyproject" ]]; then
        PKG_VERSION=$(grep -E '^version\s*=' "$pyproject" | head -1 | sed 's/.*"\(.*\)".*/\1/')
        if [[ "$PKG_VERSION" == "$VERSION" ]]; then
            pass "$pkg: v$PKG_VERSION"
        else
            fail "$pkg: v$PKG_VERSION (expected v$VERSION)"
        fi
    fi
done

# Check CHANGELOG.md exists and has entry for this version
if [[ -f "CHANGELOG.md" ]]; then
    if grep -q "## \[$VERSION\]" CHANGELOG.md; then
        pass "CHANGELOG.md has entry for v$VERSION"
    elif grep -q "## \[Unreleased\]" CHANGELOG.md; then
        if $FIX_MODE; then
            warn "CHANGELOG.md has Unreleased section (would update in --fix mode)"
        else
            fail "CHANGELOG.md has Unreleased but no entry for v$VERSION"
            echo "    Run with --fix to update, or manually add ## [$VERSION] - $(date +%Y-%m-%d)"
        fi
    else
        fail "CHANGELOG.md missing entry for v$VERSION"
    fi
else
    fail "CHANGELOG.md not found"
fi

# Check version doesn't already have a git tag
if git rev-parse "v$VERSION" >/dev/null 2>&1; then
    fail "Tag v$VERSION already exists"
else
    pass "Tag v$VERSION is available"
fi

# ─────────────────────────────────────────────────────────────
section "2b. Tracker Version Consistency"
# ─────────────────────────────────────────────────────────────

# Tracker is independently versioned (NOT required to match main version)
TRACKER_PYPROJECT="packages/hypergumbo-tracker/pyproject.toml"
TRACKER_INIT="packages/hypergumbo-tracker/src/hypergumbo_tracker/__init__.py"
if [[ -f "$TRACKER_PYPROJECT" ]]; then
    TRACKER_PYPROJECT_VER=$(grep -E '^version\s*=' "$TRACKER_PYPROJECT" | head -1 | sed 's/.*"\(.*\)".*/\1/')
    if [[ -f "$TRACKER_INIT" ]] && grep -q "__version__" "$TRACKER_INIT"; then
        TRACKER_INIT_VER=$(grep "^__version__" "$TRACKER_INIT" | sed 's/.*"\(.*\)".*/\1/')
        if [[ "$TRACKER_PYPROJECT_VER" == "$TRACKER_INIT_VER" ]]; then
            pass "Tracker version consistent: $TRACKER_PYPROJECT_VER (pyproject.toml == __init__.py)"
        else
            fail "Tracker version mismatch: pyproject.toml=$TRACKER_PYPROJECT_VER, __init__.py=$TRACKER_INIT_VER"
        fi
    else
        pass "Tracker version: $TRACKER_PYPROJECT_VER (no __init__.py version to check)"
    fi
else
    warn "hypergumbo-tracker package not found"
fi

# ─────────────────────────────────────────────────────────────
section "3. Dependencies & Security"
# ─────────────────────────────────────────────────────────────

# Check for known vulnerabilities
echo "  Running pip-audit..."
if pip-audit 2>/dev/null; then
    pass "No known vulnerabilities in dependencies"
else
    AUDIT_OUTPUT=$(pip-audit 2>&1 || true)
    if echo "$AUDIT_OUTPUT" | grep -q "found [1-9]"; then
        fail "Vulnerabilities detected (run 'pip-audit' for details)"
    else
        pass "No known vulnerabilities (some packages not on PyPI)"
    fi
fi

# Check for secrets
echo "  Scanning for secrets..."
if command -v gitleaks &>/dev/null; then
    if gitleaks detect --source . --no-git --no-banner 2>/dev/null; then
        pass "No secrets detected (gitleaks)"
    else
        fail "Potential secrets detected (run 'gitleaks detect' for details)"
    fi
elif command -v trufflehog &>/dev/null; then
    if trufflehog filesystem . --no-update --quiet 2>/dev/null; then
        pass "No secrets detected (trufflehog)"
    else
        fail "Potential secrets detected"
    fi
else
    warn "No secret scanner installed (install gitleaks or trufflehog)"
fi

# Security linting
echo "  Running Bandit..."
if bandit -r src/ packages/*/src/ -c pyproject.toml --quiet 2>/dev/null; then
    pass "Security linting passed (Bandit)"
else
    fail "Security issues detected (run 'bandit -r src/' for details)"
fi

# ─────────────────────────────────────────────────────────────
section "4. Code Quality"
# ─────────────────────────────────────────────────────────────

# Linting
echo "  Running Ruff..."
if ruff check packages/*/src packages/*/tests tests/ --quiet 2>/dev/null; then
    pass "Linting passed (Ruff)"
else
    fail "Linting issues detected (run 'ruff check packages/*/src packages/*/tests tests/')"
fi

# Type checking (if configured)
if command -v mypy &>/dev/null && [[ -f "mypy.ini" || -f "pyproject.toml" ]]; then
    echo "  Running mypy..."
    if mypy src/ --quiet 2>/dev/null; then
        pass "Type checking passed (mypy)"
    else
        warn "Type checking issues (run 'mypy src/')"
    fi
fi

# ─────────────────────────────────────────────────────────────
section "5. Test Suite"
# ─────────────────────────────────────────────────────────────

# Run tests with coverage — call pytest directly, matching the way the
# three sibling authoritative full-suite runners (`full-suite.yml`,
# `nightly.yml`, `release.yml`) already invoke pytest. release-check is
# architecturally parallel to those workflows: it is a gate, not part of
# the dev feedback loop, and therefore does not route through the
# smart-test pytest wrapper. That wrapper (a) is designed to select only
# affected tests and (b) writes a targeted manifest as a side effect — both
# appropriate for the dev loop, neither appropriate for a release gate.
#
# Coverage paths are sourced from scripts/lib/cov-paths.sh so that adding
# a new released package updates this gate in a single edit.
#
# Previously this block read:
#   pytest --full --cov-fail-under=100 --quiet 2>/dev/null
# That routed through smart-test; silenced stderr (violating the norm
# codified by commit 72b7f1fd5 for smart-test's own slice stderr capture);
# and surfaced "Tests failed or coverage < 100%" with a stale
# `.ci/pytest-output.log` as the only artifact when things went wrong.
# The new form captures full output to a dedicated log that the failure
# message names, so the next agent or human does not have to re-run a
# 15-minute suite to learn which line is uncovered.
# shellcheck source=lib/cov-paths.sh
source "$(dirname "$0")/lib/cov-paths.sh"
RELEASE_CHECK_PYTEST_LOG=".ci/release-check-pytest.log"
echo "  Running pytest with coverage (full suite)..."
echo "    log: $RELEASE_CHECK_PYTEST_LOG"
if python -m pytest packages/*/tests/ \
        "${COV_PATHS_ALL[@]}" \
        -n auto \
        --cov-fail-under=100 \
        >"$RELEASE_CHECK_PYTEST_LOG" 2>&1; then
    pass "All tests passed with 100% coverage"
else
    fail "Tests failed or coverage < 100% (see $RELEASE_CHECK_PYTEST_LOG)"
fi

# ─────────────────────────────────────────────────────────────
section "6. Build Verification (All Packages)"
# ─────────────────────────────────────────────────────────────

# Test that all packages build
echo "  Building all packages..."
rm -rf dist/ build/ *.egg-info

BUILD_FAILED=0
for pkg in "${PACKAGES[@]}"; do
    if [[ -f "$pkg/pyproject.toml" ]]; then
        echo "    Building $pkg..."
        if pip wheel "$pkg" --no-deps --wheel-dir dist/ --quiet 2>/dev/null; then
            PKG_NAME=$(basename "$pkg")
            PKG_NAME_UNDER="${PKG_NAME//-/_}"
            WHEEL=$(ls dist/*"$PKG_NAME_UNDER"*.whl 2>/dev/null | head -1 || echo "")
            if [[ -n "$WHEEL" ]]; then
                pass "  Built: $(basename "$WHEEL")"
            else
                fail "  Wheel not created for $pkg"
                BUILD_FAILED=1
            fi
        else
            fail "  Build failed for $pkg"
            BUILD_FAILED=1
        fi
    fi
done

if [[ $BUILD_FAILED -eq 0 ]]; then
    pass "All main packages build successfully"
fi

# Build tracker separately (independent version)
if [[ -f "packages/hypergumbo-tracker/pyproject.toml" ]]; then
    echo "    Building packages/hypergumbo-tracker..."
    if pip wheel "packages/hypergumbo-tracker" --no-deps --wheel-dir dist/ --quiet 2>/dev/null; then
        TRACKER_WHEEL=$(ls dist/*hypergumbo_tracker*.whl 2>/dev/null | head -1 || echo "")
        if [[ -n "$TRACKER_WHEEL" ]]; then
            pass "  Built: $(basename "$TRACKER_WHEEL")"
        else
            fail "  Wheel not created for hypergumbo-tracker"
        fi
    else
        fail "  Build failed for hypergumbo-tracker"
    fi
fi

# Verify wheels can be installed
echo "  Verifying wheel installation order..."
# Install in dependency order: core -> lang packages -> meta
INSTALL_ORDER=(
    "packages/hypergumbo-core"
    "packages/hypergumbo-lang-mainstream"
    "packages/hypergumbo-lang-common"
    "packages/hypergumbo-lang-extended1"
    "packages/hypergumbo-lang-rust-analyzer"
    "packages/hypergumbo"
)
for pkg in "${INSTALL_ORDER[@]}"; do
    PKG_NAME=$(basename "$pkg")
    WHEEL=$(ls dist/*"${PKG_NAME//-/_}"*.whl 2>/dev/null | head -1 || echo "")
    if [[ -n "$WHEEL" ]]; then
        if pip install "$WHEEL" --quiet --dry-run 2>/dev/null; then
            pass "  $PKG_NAME can be installed"
        else
            warn "  $PKG_NAME installation check failed (may be pip version issue)"
        fi
    fi
done

# Verify tracker wheel can be installed
TRACKER_WHEEL=$(ls dist/*hypergumbo_tracker*.whl 2>/dev/null | head -1 || echo "")
if [[ -n "$TRACKER_WHEEL" ]]; then
    if pip install "$TRACKER_WHEEL" --quiet --dry-run 2>/dev/null; then
        pass "  hypergumbo-tracker can be installed"
    else
        warn "  hypergumbo-tracker installation check failed (may be pip version issue)"
    fi
fi

# ─────────────────────────────────────────────────────────────
section "7. Documentation"
# ─────────────────────────────────────────────────────────────

# Check generated files are up to date
if [[ -x "./scripts/generate-schema" ]]; then
    if ./scripts/generate-schema --check 2>/dev/null; then
        pass "Schema is up to date"
    else
        fail "Schema needs regeneration (run './scripts/generate-schema')"
    fi
fi

if [[ -x "./scripts/generate-architecture" ]]; then
    if ./scripts/generate-architecture --check 2>/dev/null; then
        pass "Architecture docs up to date"
    else
        fail "Architecture docs need regeneration"
    fi
fi

# ─────────────────────────────────────────────────────────────
section "8. License Compliance"
# ─────────────────────────────────────────────────────────────

# Check dependency licenses (if pip-licenses available)
if command -v pip-licenses &>/dev/null; then
    echo "  Checking dependency licenses..."
    PROBLEMATIC="GPL;AGPL;SSPL;BUSL"
    if pip-licenses --format=csv 2>/dev/null | grep -qiE "$PROBLEMATIC"; then
        warn "Some dependencies have copyleft licenses (review manually)"
        pip-licenses --format=markdown | grep -iE "$PROBLEMATIC" || true
    else
        pass "No problematic licenses detected"
    fi
else
    warn "pip-licenses not installed (run 'pip install pip-licenses' for license audit)"
fi

# ─────────────────────────────────────────────────────────────
section "Summary"
# ─────────────────────────────────────────────────────────────

echo ""
if [[ $FAILED -eq 0 ]]; then
    echo -e "${GREEN}╔════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   All checks passed! Ready to release  ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════╝${NC}"
    if [[ $WARNINGS -gt 0 ]]; then
        echo -e "${YELLOW}($WARNINGS warnings - review recommended)${NC}"
    fi
    echo ""
    echo "Packages to release:"
    for pkg in "${PACKAGES[@]}"; do
        echo "  - $(basename "$pkg") v$VERSION"
    done
    if [[ -f "$TRACKER_PYPROJECT" ]]; then
        echo "  - hypergumbo-tracker v$TRACKER_PYPROJECT_VER (independent version)"
    fi
    echo ""
    echo "Next steps:"
    echo "  1. Review CHANGELOG.md"
    echo "  2. Run: ./scripts/prepare-release $VERSION"
    exit 0
else
    echo -e "${RED}╔════════════════════════════════════════╗${NC}"
    echo -e "${RED}║   $FAILED check(s) failed - not ready     ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════╝${NC}"
    echo ""
    echo "Fix the issues above before releasing."
    exit 1
fi

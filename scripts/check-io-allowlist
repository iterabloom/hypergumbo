#: Method names matched on ANY receiver whose type is unknown. Chosen to be
#: distinctive: a name on this list is overwhelmingly a filesystem / network /
#: loader method in practice. The resulting false positives (a domain object
#: with its own ``.unlink()``) are reviewed in the allowlist, which is the
#: conservative direction. Generic names (``write``, ``send``, ``replace``,
#: ``open``-without-mode, ``load``, ``run``, ``extract``) are deliberately
#: absent; see "WHAT IT CANNOT SEE" in the module docstring.
METHOD_NAMES: dict[str, str] = {
    "write_text": "fs_write", "write_bytes": "fs_write", "unlink": "fs_write",
    "mkdir": "fs_write", "rmdir": "fs_write", "chmod": "fs_write",
    "lchmod": "fs_write", "touch": "fs_write", "symlink_to": "fs_write",

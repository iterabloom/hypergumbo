#: Callables counted only when their first argument is not a string literal.
DYNAMIC_NAME: dict[str, str] = {
    "importlib.import_module": "dynamic_import",
    "builtins.__import__": "dynamic_import",
}

#: ``yaml.load``-family: not counted when the Loader is a ``*SafeLoader``.
YAML_LOADER_ARG = {"yaml.load": 1, "yaml.load_all": 1}

#: Third-party modules where ANY call is a site (references are not).

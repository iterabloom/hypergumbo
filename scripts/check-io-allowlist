    "subprocess_exec": "process", "subprocess_shell": "process",
    "dlopen": "native", "exec_module": "dynamic_import",
    "load_module": "dynamic_import",
}

#: Ambiguous method names counted only on a syntactic ``Path(...)`` receiver.

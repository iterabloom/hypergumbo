_WRITE_MODE_CHARS = set("wax+")

# ---------------------------------------------------------------------------
# Allowlist vocabulary. A zone says WHERE an effect lands (fs) or what the
# capability serves (process/network/...). ``analysed_repo`` exists so that a
# write into the repository being analysed -- forbidden by ADR-0047 ruling 9
# -- can be RECORDED honestly, and it always requires a ``finding``.
# ---------------------------------------------------------------------------

ZONES: dict[str, str] = {
    "user_cache": "$XDG_CACHE_HOME/hypergumbo (fingerprinted caches, models)",
    "user_out": "a path the user named (--out, --output, -o)",
    "user_config": "$XDG_CONFIG_HOME/hypergumbo (catalogue home, channels)",
    "user_state": "$XDG_STATE_HOME/hypergumbo (trust grants, recorded answers)",
    "developer_checkout": "~/hypergumbo, a hypergumbo checkout (ADR-0047 r9 offer)",
    "tmp_artifact": "the system temp dir, removed after use",
    "install_artifact": "~/.local/bin and other install targets",
    "repo_inspection": "read-only launches against the analysed repo",
    "install": "package/toolchain installers (pip, rustup) and downloads",
    "analyser_backend": "an external analyser indexing the target repo",
    "dev_zone": "development tooling: tracker store, forge API, git push",
    "dev_ui": "the tracker's local web/TUI interface",
    "in_process": "no effect outside this interpreter",
    "analysed_repo": "INSIDE the analysed repository (ADR-0047 r9: forbidden)",
}
#: Zones whose entry must carry a ``finding`` (tracker id).
ZONES_REQUIRING_FINDING = {"analysed_repo"}
#: Families whose entries must name the launched program / remote.
FAMILIES_REQUIRING_TARGET = {"process"}

REQUIRED_FIELDS = ("zone", "purpose", "commands")
INHERITABLE = ("zone", "purpose", "commands", "target", "finding")
SITE_FIELDS = ("function", "primitive", "family", "count", "zone", "target",
               "commands", "purpose", "finding", "note")


# ---------------------------------------------------------------------------
# Scanner
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Site:
    """One occurrence of a risky primitive in source."""

    module: str
    function: str
    primitive: str
    family: str
    line: int
    package: str = ""

    @property
    def key(self) -> tuple[str, str, str]:
        return (self.module, self.function, self.primitive)


def _alias_table(tree: ast.AST) -> dict[str, set[str]]:
    table: dict[str, set[str]] = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.asname:
                    table.setdefault(alias.asname, set()).add(alias.name)
                else:
                    head = alias.name.split(".")[0]
                    table.setdefault(head, set()).add(head)
        elif isinstance(node, ast.ImportFrom):
            base = "." * node.level + (node.module or "")
            for alias in node.names:
                if alias.name == "*":
                    continue
                local = alias.asname or alias.name
                table.setdefault(local, set()).add(f"{base}.{alias.name}"
                                                   if base else alias.name)
    return table


def _chain(node: ast.AST) -> list[str] | None:
    """``a.b.c`` -> ['a', 'b', 'c']; None if the chain is not names-only."""
    parts: list[str] = []
    while isinstance(node, ast.Attribute):
        parts.append(node.attr)
        node = node.value
    if isinstance(node, ast.Name):
        parts.append(node.id)
        return parts[::-1]
    return None


def _str_literal(node: ast.AST | None) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    return None


def _arg(call: ast.Call, index: int, name: str) -> tuple[bool, ast.AST | None]:
    """(present, node) for positional ``index`` or keyword ``name``."""
    for kw in call.keywords:
        if kw.arg == name:
            return True, kw.value
    if len(call.args) > index and not isinstance(call.args[index], ast.Starred):
        return True, call.args[index]
    if any(isinstance(a, ast.Starred) for a in call.args) or any(
            kw.arg is None for kw in call.keywords):
        return True, None  # *args / **kwargs: unknown, be conservative
    return False, None


def _is_readonly_sqlite_uri(call: ast.Call) -> bool:
    """``sqlite3.connect(f"file:{p}?mode=ro", uri=True)`` cannot create or
    modify the file. The literal text of the URI (constant parts of an
    f-string included) must say ``mode=ro`` and ``uri`` must be literal True."""
    present, node = _arg(call, 0, "database")
    if isinstance(node, ast.JoinedStr):
        text = "".join(v.value for v in node.values
                       if isinstance(v, ast.Constant) and isinstance(v.value, str))
    else:
        text = _str_literal(node) or ""
    uri = next((kw.value for kw in call.keywords if kw.arg == "uri"), None)
    return ("mode=ro" in text and isinstance(uri, ast.Constant)
            and uri.value is True)


def _mode_suffix(call: ast.Call, index: int, default: str) -> str | None:
    """'[w]' for a write mode, '[?]' for a non-literal mode, None for read."""
    present, node = _arg(call, index, "mode")
    if not present:
        mode = default
    else:
        lit = _str_literal(node)
        if lit is None:
            return "[?]"
        mode = lit
    return "[w]" if _WRITE_MODE_CHARS & set(mode) else None


class _Scanner(ast.NodeVisitor):
    def __init__(self, module: str, package: str, aliases: dict[str, set[str]]):
        self.module = module
        self.package = package
        self.aliases = aliases
        self.stack: list[str] = []
        self.sites: list[Site] = []
        self._consumed: set[int] = set()

    # -- scope bookkeeping --------------------------------------------------

    def visit_ClassDef(self, node: ast.ClassDef) -> None:
        for expr in [*node.decorator_list, *node.bases,
                     *(k.value for k in node.keywords)]:
            self.visit(expr)
        self.stack.append(node.name)
        for stmt in node.body:
            self.visit(stmt)
        self.stack.pop()

    def _visit_function(self, node: ast.FunctionDef | ast.AsyncFunctionDef) -> None:
        # Decorators and defaults belong to the ENCLOSING scope; annotations
        # are not capabilities and are skipped.
        for expr in node.decorator_list:
            self.visit(expr)
        args = node.args
        for default in [*args.defaults, *(d for d in args.kw_defaults if d)]:
            self.visit(default)
        self.stack.append(node.name)
        for stmt in node.body:
            self.visit(stmt)
        self.stack.pop()

    visit_FunctionDef = _visit_function
    visit_AsyncFunctionDef = _visit_function

    def visit_AnnAssign(self, node: ast.AnnAssign) -> None:
        self.visit(node.target)
        if node.value is not None:
            self.visit(node.value)

    # -- resolution -----------------------------------------------------------

    def _resolve(self, node: ast.AST) -> set[str]:
        parts = _chain(node)
        if parts is None:
            return set()
        head, rest = parts[0], parts[1:]
        targets = self.aliases.get(head) or {f"builtins.{head}"}
        return {".".join([t, *rest]) for t in targets}

    def _emit(self, node: ast.AST, primitive: str, family: str) -> None:
        self.sites.append(Site(
            module=self.module,
            function=".".join(self.stack) or "<module>",
            primitive=primitive, family=family,
            line=getattr(node, "lineno", 0), package=self.package,
        ))

    def _classify_call(self, call: ast.Call, name: str) -> tuple[str, str] | None:
        if name in OPEN_LIKE:
            idx, default = OPEN_LIKE[name]
            suffix = _mode_suffix(call, idx, default)
            return (name + suffix, "fs_write") if suffix else None
        if name in DYNAMIC_NAME:
            present, node = _arg(call, 0, "name")
            if present and _str_literal(node) is not None:
                return None
            return name + "[dynamic]", DYNAMIC_NAME[name]
        if name in YAML_LOADER_ARG:
            present, node = _arg(call, YAML_LOADER_ARG[name], "Loader")
            parts = _chain(node) if node is not None else None
            if present and parts and parts[-1].endswith("SafeLoader"):
                return None
            return name, PRIMITIVES[name]
        if name == "sqlite3.connect" and _is_readonly_sqlite_uri(call):
            return None
        if name in PRIMITIVES:
            return name, PRIMITIVES[name]
        head = name.split(".")[0]
        if head in PREFIX_MODULES:
            return name, PREFIX_MODULES[head]
        return None

    def visit_Call(self, node: ast.Call) -> None:
        func = node.func
        matched = False
        for name in sorted(self._resolve(func)):
            hit = self._classify_call(node, name)
            if name in PRIMITIVES or name in OPEN_LIKE or name in DYNAMIC_NAME:
                matched = True  # classified (even when refined to "not a site")
            if hit:
                self._emit(node, *hit)
                matched = True
                break
        if matched:
            self._consumed.add(id(func))
        elif isinstance(func, ast.Attribute):
            attr = func.attr
            receiver = func.value
            if attr == "open":
                suffix = _mode_suffix(node, 0, "r")
                if suffix:
                    self._emit(node, "*.open" + suffix, "fs_write")
            elif attr in METHOD_NAMES:
                self._emit(node, f"*.{attr}", METHOD_NAMES[attr])
            elif attr in PATH_ONLY_METHODS and isinstance(receiver, ast.Call) and (
                    self._resolve(receiver.func) & PATH_CONSTRUCTORS):
                self._emit(node, f"pathlib.Path().{attr}", PATH_ONLY_METHODS[attr])
            self._consumed.add(id(func))
            # The receiver may itself be/contain a site: Path(x), socket.socket()
            self.visit(receiver)
            for arg in [*node.args, *(k.value for k in node.keywords)]:
                self.visit(arg)
            return
        if not matched:
            self._consumed.add(id(func))
            if not isinstance(func, ast.Name):
                self.visit(func)
        for arg in [*node.args, *(k.value for k in node.keywords)]:
            self.visit(arg)

    def _visit_reference(self, node: ast.Name | ast.Attribute) -> None:
        if id(node) in self._consumed or not isinstance(node.ctx, ast.Load):
            return
        for name in sorted(self._resolve(node)):
            if name in PRIMITIVES:
                self._emit(node, name, PRIMITIVES[name])
                return
            if name in OPEN_LIKE:  # handed to a callback: mode unknowable
                self._emit(node, name + "[?]", "fs_write")
                return
        if isinstance(node, ast.Attribute):
            self.visit(node.value)

    def visit_Name(self, node: ast.Name) -> None:
        self._visit_reference(node)

    def visit_Attribute(self, node: ast.Attribute) -> None:
        self._visit_reference(node)


def scan_source(source: str, module: str, package: str = "") -> list[Site]:
    """Every risky-primitive site in one module's source."""
    tree = ast.parse(source)
    scanner = _Scanner(module, package, _alias_table(tree))
    scanner.visit(tree)
    return sorted(scanner.sites, key=lambda s: (s.line, s.primitive))


def module_name_for(path: Path, root: Path) -> tuple[str, str]:
    """``packages/<pkg>/src/a/b.py`` -> (``<pkg>``, ``a.b``)."""
    rel = path.relative_to(root / "packages")
    package = rel.parts[0]
    parts = list(rel.parts[2:])
    parts[-1] = parts[-1][:-3]
    if parts[-1] == "__init__":
        parts.pop()
    return package, ".".join(parts)


def scan_tree(root: Path) -> list[Site]:
    """Scan ``packages/*/src/**/*.py`` under ``root``."""
    sites: list[Site] = []
    for path in sorted(root.glob("packages/*/src/**/*.py")):
        package, module = module_name_for(path, root)
        sites.extend(scan_source(path.read_text(encoding="utf-8"), module, package))
    return sites


# ---------------------------------------------------------------------------
# Allowlist
# ---------------------------------------------------------------------------


class AllowlistError(ValueError):
    """The allowlist file is structurally invalid."""


@dataclass
class Allowlist:
    #: key -> effective entry (module defaults already merged in)
    entries: dict[tuple[str, str, str], dict[str, Any]] = field(default_factory=dict)
    #: module -> module-level defaults, as written
    module_defaults: dict[str, dict[str, Any]] = field(default_factory=dict)
    #: key -> the site entry as written (without inherited fields)
    raw: dict[tuple[str, str, str], dict[str, Any]] = field(default_factory=dict)


def parse_allowlist(doc: Any) -> Allowlist:
    if not isinstance(doc, dict) or doc.get("version") != 1:
        raise AllowlistError("allowlist must be a mapping with 'version: 1'")
    modules = doc.get("modules")
    if not isinstance(modules, dict):
        raise AllowlistError("'modules' must be a mapping of module -> block")
    out = Allowlist()
    for module, block in modules.items():
        if not isinstance(block, dict) or not isinstance(block.get("sites"), list):
            raise AllowlistError(f"{module}: block must be a mapping with 'sites'")
        defaults = {k: v for k, v in block.items() if k != "sites"}
        out.module_defaults[module] = defaults
        for site in block["sites"]:
            if not isinstance(site, dict) or not all(
                    isinstance(site.get(k), str) for k in ("function", "primitive")):
                raise AllowlistError(
                    f"{module}: every site needs string 'function' and 'primitive'")
            key = (module, site["function"], site["primitive"])
            if key in out.entries:
                raise AllowlistError(f"duplicate entry {key}")
            merged = {k: defaults[k] for k in INHERITABLE if k in defaults}
            merged.update(site)
            out.entries[key] = merged
            out.raw[key] = dict(site)
    return out


def load_allowlist(path: Path) -> Allowlist:
    with path.open(encoding="utf-8") as fh:
        return parse_allowlist(yaml.load(fh, Loader=yaml.SafeLoader))


def _review_problems(entry: dict[str, Any]) -> list[str]:
    problems = []
    for name in REQUIRED_FIELDS:
        value = entry.get(name)
        if not value or value == TODO or (isinstance(value, list) and (
                TODO in value or not all(isinstance(v, str) and v for v in value))):
            problems.append(f"'{name}' missing or TODO")
    zone = entry.get("zone")
    if zone and zone != TODO and zone not in ZONES:
        problems.append(f"zone '{zone}' is not one of {sorted(ZONES)}")
    if zone in ZONES_REQUIRING_FINDING and not entry.get("finding"):
        problems.append(f"zone '{zone}' requires a 'finding' (tracker id)")
    if entry.get("family") in FAMILIES_REQUIRING_TARGET and (
            not entry.get("target") or entry.get("target") == TODO):
        problems.append("process entries must name the launched 'target'")
    return problems


@dataclass
class Report:
    new: list[tuple[tuple[str, str, str], list[Site]]] = field(default_factory=list)
    stale: list[tuple[str, str, str]] = field(default_factory=list)
    recount: list[tuple[tuple[str, str, str], int, list[Site]]] = field(default_factory=list)
    incomplete: list[tuple[tuple[str, str, str], list[str]]] = field(default_factory=list)
    allow_counts: dict[tuple[str, str, str], int] = field(default_factory=dict)

    @property
    def ok(self) -> bool:
        return not (self.new or self.stale or self.recount or self.incomplete)

    def render(self) -> str:
        if self.ok:
            return ""
        out: list[str] = []
        if self.new:
            out.append(f"NEW — {len(self.new)} unlisted site key(s). Review each and add "
                       f"it to the allowlist under its module:")
            for (module, function, primitive), sites in self.new:
                lines = ", ".join(str(s.line) for s in sites)
                out.append(f"  {module}:  function: {function}  primitive: {primitive}"
                           f"  family: {sites[0].family}  count: {len(sites)}"
                           f"   (line {lines})")
        if self.stale:
            out.append(f"STALE — {len(self.stale)} allowlist entr(y/ies) with no site. "
                       f"Remove:")
            for module, function, primitive in self.stale:
                out.append(f"  {module}:  function: {function}  primitive: {primitive}")
        if self.recount:
            out.append(f"COUNT — {len(self.recount)} entr(y/ies) whose site count "
                       f"changed. Re-review and update 'count':")
            for (module, function, primitive), was, sites in self.recount:
                lines = ", ".join(str(s.line) for s in sites)
                out.append(f"  {module}:  function: {function}  primitive: {primitive}"
                           f"  count {was} -> {len(sites)}   (line {lines})")
        if self.incomplete:
            out.append(f"INCOMPLETE — {len(self.incomplete)} entr(y/ies) not reviewed:")
            for (module, function, primitive), problems in self.incomplete:
                out.append(f"  {module}:  function: {function}  primitive: {primitive}"
                           f"  -> {'; '.join(problems)}")
        out.append("")
        out.append("`scripts/check-io-allowlist --update` rewrites the allowlist with "
                   "counts refreshed, stale entries removed and new entries added as "
                   "TODO; then fill in zone/purpose/commands (and target for process "
                   "entries) for every TODO. A site that writes into the analysed "
                   "repo, or launches a program outside ADR-0016's launch list, is a "
                   "finding: file it and record `finding: <tracker id>`.")
        return "\n".join(out)


def _group(sites: Iterable[Site]) -> dict[tuple[str, str, str], list[Site]]:
    grouped: dict[tuple[str, str, str], list[Site]] = {}
    for site in sites:
        grouped.setdefault(site.key, []).append(site)
    return grouped


def compare(sites: Iterable[Site], allow: Allowlist) -> Report:
    observed = _group(sites)
    report = Report()
    for key in sorted(observed):
        found = observed[key]
        entry = allow.entries.get(key)
        if entry is None:
            report.new.append((key, found))
            continue
        if entry.get("count") != len(found):
            report.recount.append((key, entry.get("count"), found))
    for key in sorted(allow.entries):
        entry = allow.entries[key]
        if key not in observed:
            report.stale.append(key)
            continue
        problems = _review_problems(entry)
        if problems:
            report.incomplete.append((key, problems))
    return report


def updated_document(sites: Iterable[Site], allow: Allowlist) -> dict[str, Any]:
    """The allowlist rewritten against ``sites``, review data preserved."""
    observed = _group(sites)
    modules: dict[str, dict[str, Any]] = {}
    for key in sorted(observed):
        module, function, primitive = key
        found = observed[key]
        block = modules.setdefault(module, dict(allow.module_defaults.get(module, {})))
        block.setdefault("sites", [])
        entry = dict(allow.raw.get(key, {}))
        entry.update(function=function, primitive=primitive,
                     family=found[0].family, count=len(found))
        if key not in allow.raw:
            for name in REQUIRED_FIELDS:
                if name not in block:
                    entry[name] = [TODO] if name == "commands" else TODO
            if found[0].family in FAMILIES_REQUIRING_TARGET and "target" not in block:
                entry["target"] = TODO
        ordered = {k: entry[k] for k in SITE_FIELDS if k in entry}
        ordered.update({k: v for k, v in entry.items() if k not in ordered})
        block["sites"].append(ordered)
    return {"version": 1, "modules": modules}


HEADER = """\
# SPDX-License-Identifier: AGPL-3.0-or-later
# Reviewed allowlist of every risky I/O primitive call site in packages/*/src.
# Gate: scripts/check-io-allowlist (WI-vumum) -- read its docstring for what
# it can and cannot see. Regenerate counts/keys with `--update`, then REVIEW:
# every entry's zone / purpose / commands (and target, for process entries)
# is a human statement, and a TODO keeps CI red.
#
# Key: (module, function, primitive) + count. A module block's
# zone/purpose/commands/target are defaults its sites inherit.
# Zones: user_cache user_out user_config user_state developer_checkout
#        tmp_artifact install_artifact repo_inspection install analyser_backend
#        dev_zone dev_ui in_process; analysed_repo is always a finding
#        (ADR-0047 ruling 9). The script's ZONES table defines each.
# `finding: <tracker id>` marks a site that is a known problem, not a blessing.
#
# Command shorthands used below:
#   <analysis>   any `hypergumbo` subcommand that builds or loads an analysis:
#                sketch survey slice search routes explain symbols compact
#                test-coverage dead-code-maybe repeat-finder io-boundaries
#                verify-claims backend-agreement
#   <any>        after ANY `hypergumbo` subcommand (cli.main)
#   tracker:X    `hypergumbo-tracker X` (alias htrac / scripts/tracker)
#   library      no caller anywhere in packages/*/src; reachable only by
#                importing the function
#   scripts/X    repository development tooling, not the installed CLI
"""


def render_summary(sites: list[Site], allow: Allowlist) -> str:
    """Counts by family x package (sites), and by allowlisted zone / finding."""
    packages = sorted({s.package for s in sites})
    families = sorted({s.family for s in sites})
    lines = ["family".ljust(16) + "".join(p.replace("hypergumbo-", "")[:14].rjust(15)
                                          for p in packages) + "total".rjust(8)]
    for fam in families:
        row = [sum(1 for s in sites if s.family == fam and s.package == p)
               for p in packages]
        lines.append(fam.ljust(16) + "".join(str(n).rjust(15) for n in row)
                     + str(sum(row)).rjust(8))
    lines.append("")
    zones: dict[str, int] = {}
    findings: dict[str, int] = {}
    for key, found in _group(sites).items():
        entry = allow.entries.get(key, {})
        zone = str(entry.get("zone", "(unlisted)"))
        zones[zone] = zones.get(zone, 0) + len(found)
        if entry.get("finding"):
            findings[entry["finding"]] = findings.get(entry["finding"], 0) + len(found)
    lines.append("sites by zone: " + ", ".join(f"{z} {n}" for z, n in sorted(zones.items())))
    lines.append("sites carrying a finding: " + (", ".join(
        f"{f} {n}" for f, n in sorted(findings.items())) or "none"))
    return "\n".join(lines)


class _NoAliasDumper(yaml.SafeDumper):
    """Shared lists (module defaults reused across blocks) must be written out
    in full: ``&id001`` / ``*id001`` anchors make a reviewed file unreadable."""

    def ignore_aliases(self, data: Any) -> bool:
        return True


def write_allowlist(path: Path, doc: dict[str, Any]) -> None:
    body = yaml.dump(doc, Dumper=_NoAliasDumper, sort_keys=False, width=88,
                     allow_unicode=True)
    path.write_text(HEADER + body, encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--root", type=Path, default=REPO_ROOT)
    parser.add_argument("--allowlist", type=Path, default=None)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--list", action="store_true",
                      help="print every site with its line number")
    mode.add_argument("--summary", action="store_true",
                      help="site counts by family x package, and by zone")
    mode.add_argument("--update", action="store_true",
                      help="rewrite the allowlist (new entries become TODO)")
    args = parser.parse_args(argv)
    allow_path = args.allowlist or args.root / "docs" / "hypergumbo.io-allowlist.yaml"

    try:
        sites = scan_tree(args.root)
    except SyntaxError as exc:
        print(f"check-io-allowlist: cannot parse {exc.filename}: {exc} — "
              f"INFRASTRUCTURE (exit 2)", file=sys.stderr)
        return 2

    if args.list:
        for s in sites:
            print(f"{s.package}\t{s.module}:{s.line}\t{s.function}\t{s.family}"
                  f"\t{s.primitive}")
        return 0

    if args.summary:
        allow = load_allowlist(allow_path) if allow_path.exists() else Allowlist()
        print(render_summary(sites, allow))
        return 0

    if args.update:
        allow = load_allowlist(allow_path) if allow_path.exists() else Allowlist()
        write_allowlist(allow_path, updated_document(sites, allow))
        print(f"check-io-allowlist: wrote {allow_path}", file=sys.stderr)

    try:
        allow = load_allowlist(allow_path)
    except (OSError, yaml.YAMLError, AllowlistError) as exc:
        print(f"check-io-allowlist: cannot load {allow_path}: {exc} — "
              f"INFRASTRUCTURE (exit 2)", file=sys.stderr)
        return 2

    report = compare(sites, allow)
    if report.ok:
        print(f"check-io-allowlist: OK — {len(sites)} site(s) in "
              f"{len(allow.entries)} reviewed entr(y/ies).", file=sys.stderr)
        return 0
    print(report.render())
    return 1


if __name__ == "__main__":  # pragma: no cover - exercised via main() in tests
    sys.exit(main())

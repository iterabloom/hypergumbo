#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Regenerate the audited-IO-surface section of SECURITY.md.

Reads ``docs/hypergumbo.claims.yaml`` and the project-local catalog at
``docs/hypergumbo-self-catalog/`` to produce a deterministic
human-readable summary of hypergumbo's safety claims. The output is
written into SECURITY.md between sentinel comment markers; the
hand-written vulnerability-reporting policy below the sentinels is
preserved verbatim.

Determinism contract: same inputs → byte-identical output. Run twice
in a row to confirm. The script is operator-driven; it does not run
on commit.

Usage::

    scripts/generate-security-md           # rewrite SECURITY.md in place
    scripts/generate-security-md --check   # exit 1 if SECURITY.md would change
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import yaml


REPO_ROOT = Path(__file__).resolve().parent.parent
CLAIMS_PATH = REPO_ROOT / "docs" / "hypergumbo.claims.yaml"
SECURITY_PATH = REPO_ROOT / "SECURITY.md"

BEGIN_MARKER = "<!-- BEGIN generated by scripts/generate-security-md -->"
END_MARKER = "<!-- END generated -->"


EXPECTED_VERDICTS_PATH = REPO_ROOT / "docs" / "hypergumbo.claims.expected.json"

# How the measured verdicts reach this document. The snapshot is the SAME file
# `scripts/check-self-claims` diffs the live run against, so the prose here and
# the gate cannot disagree: changing one without the other fails CI.
#
# WHY THIS EXISTS. This section used to assert that regressions "fail the gate"
# while no workflow referenced verify-claims at all, and it drifted until it
# asserted the OPPOSITE of what the tool reports about this very repository --
# "runtime CLI subcommands do not shell out", against 1101 reported flows and a
# canary that caught `git` executed 28 times by `sketch`. Prose describing
# machine-checkable facts has to be GENERATED from those facts.

_BADGE = {
    "violated": "\u26a0 **CURRENTLY VIOLATED** \u2014 ",
    "inconclusive": "**INCONCLUSIVE** (the analysis could not see enough "
                    "to confirm) \u2014 ",
    "confirmed": "\u2713 confirmed \u2014 ",
    # INV-pojib. An unknown verdict badges as "" here, which renders a caveated
    # claim indistinguishable from a confirmed one in the very document whose
    # job is to not overstate what was verified. Registered when the fourth
    # verdict value was added rather than left to be discovered.
    "confirmed_with_caveats": "\u2713 confirmed WITH CAVEATS (rests on an "
                              "entry this repository supplied about itself) "
                              "\u2014 ",
}


def _verdict_badge(verdict: str | None) -> str:
    """Prefix a claim with the verdict actually measured for it."""
    return _BADGE.get(verdict or "", "")


def _load_expected_verdicts() -> dict[str, str]:
    """Read the committed verdict snapshot; empty when absent."""
    if not EXPECTED_VERDICTS_PATH.is_file():
        return {}
    return json.loads(EXPECTED_VERDICTS_PATH.read_text())


def _render_measured_status(verdicts: dict[str, str]) -> list[str]:
    """The headline: what the tool actually reports, not what we intend."""
    if not verdicts:
        return []
    counts: dict[str, int] = {}
    for verdict in verdicts.values():
        counts[verdict] = counts.get(verdict, 0) + 1
    lines = [
        "**Read the claims below as CLAIMS UNDER TEST, not as assurances.** "
        "They state what each entry-point category is *intended* to do. What "
        "the analysis actually reports is:",
        "",
        "| verdict | count | meaning |",
        "|---|---|---|",
        f"| **violated** | {counts.get('violated', 0)} | the tool found flows "
        f"contradicting the claim |",
        f"| **inconclusive** | {counts.get('inconclusive', 0)} | the analysis "
        f"could not see enough to confirm |",
        f"| **confirmed** | {counts.get('confirmed', 0)} | checked and held |",
    ]
    # Rendered only when non-zero, so a verdict this repository does not
    # currently produce does not add a permanent zero row. The three above are
    # the standing vocabulary; this one is conditional (INV-pojib).
    if counts.get("confirmed_with_caveats", 0):
        lines.append(
            f"| **confirmed_with_caveats** | "
            f"{counts['confirmed_with_caveats']} | held, but on the strength "
            f"of an entry this repository supplied about itself |"
        )
    lines += [
        "",
        "The ``inconclusive`` verdicts are not near-misses. This repository "
        "contains code in languages with no taint catalogue, so the analysis "
        "declines to confirm rather than reporting silence as safety. A "
        "``confirmed`` verdict requires every code-bearing language present "
        "to be analysable.",
        "",
        "**A ``violated`` verdict from this tool is trustworthy; a "
        "``confirmed`` one means \u201cfound nothing, having looked at what "
        "it could see\u201d.** What it can see is bounded by the known "
        "limitations at the end of this section.",
        "",
    ]
    return lines


def _render_claims_section(
    claims_data: dict, verdicts: dict[str, str],
) -> list[str]:
    """Render the audited-IO-surface section from claims + measured verdicts."""
    lines: list[str] = []
    lines.append("## Audited IO Surface")
    lines.append("")
    lines.append(
        "Hypergumbo's safety claims are checked by running hypergumbo "
        "against its own source: ``hypergumbo verify-claims . --claims "
        "docs/hypergumbo.claims.yaml``, gated in CI by "
        "``scripts/check-self-claims``."
    )
    lines.append("")
    lines.extend(_render_measured_status(verdicts))

    claims = claims_data.get("claims", [])
    if not claims:
        lines.append("(no claims declared)")
        lines.append("")
        return lines

    # Group claims by source taint label
    by_source: dict[str, list[dict]] = {}
    for c in claims:
        tf = c.get("constraint", {}).get("taint_flow", {})
        source = tf.get("source_taint", "")
        by_source.setdefault(source, []).append(c)

    for source in sorted(by_source):
        lines.append(f"### Entry-point category: ``{source}``")
        lines.append("")
        prohibited = sorted(
            c["constraint"]["taint_flow"]["prohibited_sink_zone"]
            for c in by_source[source]
        )
        if prohibited:
            lines.append("Prohibited zones (claim: zero unsanitized reach):")
            lines.append("")
            for zone in prohibited:
                lines.append(f"- ``{zone}``")
            lines.append("")
        for c in by_source[source]:
            cid = c["id"]
            text = c["text"].strip()
            badge = _verdict_badge(verdicts.get(cid))
            lines.append(f"**{cid}** — {badge}{text}")
            lines.append("")

    lines.append("### Three-Layer Catalog Discipline")
    lines.append("")
    lines.append(
        "Hypergumbo's analysis is layered to keep the audit honest "
        "without overcommitting the tool to third-party-library coverage:"
    )
    lines.append("")
    lines.append(
        "1. **Built-in stdlib catalogs** "
        "(``packages/hypergumbo-core/src/hypergumbo_core/io_primitives/``). "
        "Hypergumbo-the-tool's responsibility — stdlib IO primitives per "
        "language. Shipped to PyPI users."
    )
    lines.append("")
    lines.append(
        "2. **Project-local catalog mechanism** — the "
        "``--taint-sources`` / ``--taint-sinks`` / ``--taint-sanitizers`` "
        "CLI flags and the ``extra_catalogs:`` key in claims YAML let any "
        "user declare per-project rules. This is the customization point."
    )
    lines.append("")
    lines.append(
        "3. **Hypergumbo's own project-local catalog** "
        "(``docs/hypergumbo-self-catalog/``). One specific *use* of layer 2 "
        "for this repo's self-audit. **Not shipped to PyPI users** — they "
        "don't inherit these declarations. The same mechanism is available "
        "to them for their own dependencies."
    )
    lines.append("")
    lines.append(
        "We do NOT recursively audit third-party dependency internals "
        "(pyyaml, tree-sitter, huggingface_hub, etc.). Trust your pinned "
        "dependency versions the same way you trust any ``pip install``."
    )
    lines.append("")

    lines.append("### Recommended: wrapper-function discipline for path-bounded claims")
    lines.append("")
    lines.append(
        "Hypergumbo's structural taint analysis matches sinks by callee "
        "name, not by argument value. Two ``open(path, \"w\")`` call sites "
        "are indistinguishable even when one writes to a cache directory "
        "and the other to a user-supplied path. To verify path-bounded "
        "claims, hypergumbo's own source code routes every write through "
        "a named wrapper in ``hypergumbo_core.safety_zones``: "
        "``cache_write`` / ``user_out_write`` / ``tmp_artifact_write`` / "
        "``install_artifact_copy`` / etc. Each wrapper has a distinct "
        "callee name, so the project-local catalog can declare each one "
        "in its own safety zone."
    )
    lines.append("")
    lines.append(
        "**This pattern works in any language hypergumbo supports.** "
        "Go: ``func WriteCache(path, data)``. Rust: ``fn write_cache(...)``. "
        "Java: ``class SafeIO { public static void writeCache(...) }``. "
        "The call-graph BFS is language-agnostic; only the discipline is "
        "per-project. If you want path-bounded claims for your own code, "
        "adopt the wrapper-function pattern and declare your wrappers in "
        "your project-local catalog."
    )
    lines.append("")

    lines.append("### Verification")
    lines.append("")
    lines.append("Re-run the audit locally:")
    lines.append("")
    lines.append("```")
    lines.append("hypergumbo verify-claims --claims docs/hypergumbo.claims.yaml .")
    lines.append("```")
    lines.append("")
    lines.append(
        "Each claim verifies that no unsanitized data from the source "
        "entry-point category reaches the prohibited safety zone. A "
        "regression that adds a network call to a runtime CLI handler "
        "(or routes a write outside the safety_zones wrappers) fails "
        "the gate."
    )
    lines.append("")

    lines.append("### Known limitations")
    lines.append("")
    lines.append(
        "Short-name sink matching is necessarily over-approximate at "
        "receivers the DDG cannot resolve — call-RHS bindings "
        "(``x = requests.Session(); x.get(...)``), parameter receivers, "
        "and closure captures. At those sites verify-claims may report "
        "findings on common method names "
        "(``.get`` / ``.run`` / ``.replace`` / ``.write``) "
        "that reach generic primitives the wrappers don't cover. Treat "
        "these as documented overapproximation rather than genuine "
        "safety regressions."
    )
    lines.append("")
    lines.append(
        "**This paragraph used to end \u201cthe load-bearing claims "
        "(dev-zone unreachability from runtime CLI, install zones not "
        "reached from runtime CLI) verify cleanly\u201d. They do not** "
        "\u2014 both are ``inconclusive``, not confirmed, because this "
        "repository contains code the taint analysis has no catalogue for."
    )
    lines.append("")
    lines.append(
        "Two further limitations bound EVERY ``confirmed`` verdict this "
        "tool emits, here or in a user's repository. ``pathlib.Path`` "
        "method calls are invisible to the I/O catalogue \u2014 a "
        "receiver-typing gap, so the most common way Python writes a file "
        "registers as no I/O boundary at all. And a language that emits "
        "even ONE call edge passes the coverage check while the rest of "
        "its call structure may be unanalysable: Kotlin emits one and "
        "misses roughly 95% of its catalogued sinks."
    )
    lines.append("")
    lines.append(
        "The surface above is narrower than it was: the post-DDG IR "
        "refinement pass (``hypergumbo_core.taint_refine``) rewrites "
        "``python:external:0-0:NAME:unresolved`` dsts to a module-resolved "
        "form (e.g., ``python:os.environ:0-0:NAME:unresolved``) when the "
        "data-dependence graph can prove what the receiver was bound to "
        "— typically receivers bound by file-scope imports or by local "
        "assignment to a module attribute. Sink-matching then runs "
        "against the resolved module, so the ``external``-module "
        "exemption only applies to the residual unresolvable cases above."
    )
    lines.append("")
    lines.append(
        "Hypergumbo's own mutating callsites (``shutil.rmtree`` for "
        "cache eviction and grammar-scaffold reset, ``Path.chmod`` for "
        "post-install ``+x``, ``Path.unlink`` for uninstall) route "
        "through tightening wrappers in ``hypergumbo_core.safety_zones`` "
        "(``cache_rmtree`` / ``tmp_artifact_rmtree`` / "
        "``install_artifact_chmod`` / ``install_artifact_unlink``) so "
        "the structural pass gets a distinct, zone-tagged callee per "
        "site. The wrapper discipline and the refinement pass are "
        "complementary: the refinement narrows the residual surface "
        "across the codebase generally; the wrappers eliminate it "
        "deterministically at hypergumbo's own mutation sites."
    )
    lines.append("")
    return lines


def _render_full_generated_block(claims_data: dict) -> str:
    """Build the complete content between sentinel markers."""
    lines = [BEGIN_MARKER, ""]
    lines.extend(_render_claims_section(claims_data, _load_expected_verdicts()))
    lines.append(END_MARKER)
    return "\n".join(lines)


def _splice_into_security_md(existing: str, generated_block: str) -> str:
    """Replace existing sentinel-bracketed block in SECURITY.md.

    If no sentinel markers exist yet, prepend the generated block after
    the SPDX comment + ``# Security Policy`` heading (the natural "audit
    summary goes at the top" position), leaving the rest of the file
    (vulnerability-reporting policy, scope, etc.) untouched.
    """
    if BEGIN_MARKER in existing and END_MARKER in existing:
        before = existing.split(BEGIN_MARKER, 1)[0]
        after = existing.split(END_MARKER, 1)[1]
        return before + generated_block + after

    # First-time insert: after the H1 title.
    title_idx = existing.find("# Security Policy")
    if title_idx == -1:  # pragma: no cover - SECURITY.md must have the title
        return generated_block + "\n\n" + existing
    title_end = existing.find("\n", title_idx)
    insertion_point = title_end + 1
    return (
        existing[:insertion_point]
        + "\n"
        + generated_block
        + "\n\n"
        + existing[insertion_point:].lstrip("\n")
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Regenerate the audited-IO-surface section of SECURITY.md "
            "from the claims YAML."
        ),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Exit non-zero if SECURITY.md would change. CI-friendly.",
    )
    args = parser.parse_args()

    if not CLAIMS_PATH.is_file():
        print(f"ERROR: claims file not found at {CLAIMS_PATH}", file=sys.stderr)
        return 1
    if not SECURITY_PATH.is_file():
        print(f"ERROR: SECURITY.md not found at {SECURITY_PATH}", file=sys.stderr)
        return 1

    claims_data = yaml.safe_load(CLAIMS_PATH.read_text(encoding="utf-8")) or {}
    generated_block = _render_full_generated_block(claims_data)
    existing = SECURITY_PATH.read_text(encoding="utf-8")
    updated = _splice_into_security_md(existing, generated_block)

    if updated == existing:
        if args.check:
            print("OK: SECURITY.md is up to date.")
            return 0
        print("(no changes)")
        return 0

    if args.check:
        print(
            "DRIFT: SECURITY.md needs regeneration via "
            "scripts/generate-security-md",
            file=sys.stderr,
        )
        return 1

    SECURITY_PATH.write_text(updated, encoding="utf-8")
    try:
        display_path = SECURITY_PATH.relative_to(REPO_ROOT)
    except ValueError:
        # Test fixtures (under /tmp) live outside REPO_ROOT — fall back
        # to the absolute path for the success line.
        display_path = SECURITY_PATH
    print(f"Rewrote {display_path}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

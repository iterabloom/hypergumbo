#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Generate ``docs/concept-axes.md`` — a human-readable by-axis view
of the canonical edge-type registry.

The schema (``docs/schema.json``) carries axis annotations under the
``x-axis-of-values`` extension keyword on ``Edge.type``, but reading
schema.json by eye doesn't surface the axis structure — the values
appear in registry order, not grouped by axis. This script reads
``hypergumbo_core.edge_types.EDGE_TYPES`` directly and emits a
markdown doc grouped by axis (relationship / endpoint_shape /
pending_classification per ADR-0023), so a human skimming the
codebase's typing ontology can see what each axis contains at a
glance.

Companion to ``scripts/generate-schema``. Both are auto-generated;
both have a ``--check`` mode for CI/pre-commit freshness gating.

Usage:
    ./scripts/generate-concept-axes              # Write docs/concept-axes.md
    ./scripts/generate-concept-axes --check      # Verify the doc is current
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Iterable


REPO_ROOT = Path(__file__).resolve().parent.parent

# Add hypergumbo-core src to sys.path so we can import the registry
# without requiring an editable install.
sys.path.insert(0, str(REPO_ROOT / "packages" / "hypergumbo-core" / "src"))

from hypergumbo_core.edge_types import (  # noqa: E402
    AXIS_ENDPOINT_SHAPE,
    AXIS_PENDING,
    AXIS_RELATIONSHIP,
    EDGE_TYPES,
    EdgeTypeSpec,
)
from hypergumbo_core.symbol_kinds import (  # noqa: E402
    AXIS_LANGUAGE_CONSTRUCT,
    AXIS_PENDING as KIND_AXIS_PENDING,
    SYMBOL_KINDS,
    SymbolKindSpec,
)
from hypergumbo_core.evidence_types import (  # noqa: E402
    AXIS_INFERENCE_PATHWAY,
    AXIS_PENDING as EVIDENCE_AXIS_PENDING,
    EVIDENCE_TYPES,
    EvidenceTypeSpec,
)
from hypergumbo_core.io_boundary_types import (
    AXIS_DATA_CROSSING,
    AXIS_DEFERRED_CROSSING,
    AXIS_OPACITY,
    AXIS_SPECULATIVE,
    IO_BOUNDARY_TYPES,
    IoBoundarySpec,
)
from hypergumbo_core.module_key_axis import (
    AXIS_CALL_SITE_PROPERTY,
    AXIS_OWNER_PATH,
    AXIS_PENDING as MODULE_KEY_AXIS_PENDING,
    AXIS_UNCERTAINTY,
    MODULE_KEY_AXIOM,
    MODULE_KEY_NOTIONS,
)


# Edge.type section ordering (most-canonical first). Each entry:
# axis-id, heading, preamble paragraph.
_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_RELATIONSHIP,
        "`relationship` — ADR-0023 compliant",
        "Values that name the relationship the edge expresses between "
        "src and dst. Per ADR-0023, this is the only axis a new "
        "`edge_type` value should occupy.",
    ),
    (
        AXIS_ENDPOINT_SHAPE,
        "`endpoint_shape` — deprecation candidates per ADR-0023 §6",
        "Values whose meaning is leaked into the type label even though "
        "it is captured by `src.kind` / `dst.kind` / language metadata. "
        "Migration plan in ADR-0023 §6 folds these back into "
        "relationship-shaped names with kind/language metadata on the "
        "endpoint nodes.",
    ),
    (
        AXIS_PENDING,
        "`pending_classification` — per-family audit pending per ADR-0023 §5",
        "Values deferred to per-family audit. Some may be genuinely "
        "distinct relationships; others are protocol-conditional "
        "duplicates of a more general relationship. Verdicts arrive with "
        "each family's audit.",
    ),
)


# Edge.evidence_type section ordering. Mirrors _SECTIONS in shape;
# entries describe the per-axis preamble for ADR-0028's three sections.
_EVIDENCE_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_INFERENCE_PATHWAY,
        "`inference_pathway` — ADR-0028 compliant",
        "Values that name the inference pathway by which the analyzer "
        "concluded this edge exists. Per ADR-0028, this is the only axis "
        "a new `Edge.evidence_type` value should occupy. Resolution "
        "status moves to the new sibling `Edge.is_resolved`; framework-"
        "specific dispatch conventions move to `Edge.meta`.",
    ),
    (
        EVIDENCE_AXIS_PENDING,
        "`pending_classification` — per-cluster audit pending per ADR-0028",
        "Values deferred to per-cluster audit-findings docs at "
        "`docs/audits/<NN>-<topic>.md`. Each cluster's audit decides "
        "between fold-to-Cluster-A vs separate-axis declaration vs "
        "producer-side drop.",
    ),
)


# Symbol.kind section ordering. Mirrors _SECTIONS in shape; entries
# describe the per-axis preamble for ADR-0027's three sections.
_KIND_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_LANGUAGE_CONSTRUCT,
        "`language_construct` — ADR-0027 compliant",
        "Values that name the source-language syntactic construct the "
        "symbol represents. Per ADR-0027, this is the only axis a new "
        "`Symbol.kind` value should occupy.",
    ),
    (
        KIND_AXIS_PENDING,
        "`pending_classification` — per-cluster audit pending per ADR-0027 §\"Migration\"",
        "Values deferred to per-cluster audit-findings docs at "
        "`docs/audits/<NN>-<topic>.md`. Includes the file-shape entities "
        "(Cluster B), apex/peer overloads (Cluster C), build/config-shape "
        "entities (Cluster G), and the long-tail domain vocabulary "
        "(Cluster H). Each cluster's audit decides between fold-to-"
        "Cluster-A vs separate-axis declaration vs producer-side drop.",
    ),
)


# io_boundary section ordering (ADR-0050). Mirrors _SECTIONS in shape.
# Headline membership is NOT a section: it cuts across this partition
# (subprocess is opaque AND counts in the headline), so it lives as
# per-value metadata on the spec.
_IO_BOUNDARY_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_DATA_CROSSING,
        "`data_crossing` — ADR-0050 compliant",
        "Values that name what data crosses the process boundary at this "
        "call site, and in which direction. Per ADR-0050 this is the only "
        "axis a new catalogue-declarable boundary should occupy.",
    ),
    (
        AXIS_OPACITY,
        "`opacity` — control left this process",
        "The call is correctly classified and the analysis cannot see past "
        "it, so it does not license \"I looked and found nothing\". Split by "
        "channel: `subprocess` is catalogue-declared, `command_launch` is "
        "producer-stamped, and each is reachable through exactly one of "
        "them.",
    ),
    (
        AXIS_DEFERRED_CROSSING,
        "`deferred_crossing` — disclosed, never minted (ADR-0049)",
        "The call ARRANGES a crossing it does not itself perform — exactly "
        "what the axiom's second clause excludes from `data_crossing`, "
        "which is why it is a section rather than a violation. Each value "
        "shadows the data boundary it makes unexaminable.",
    ),
    (
        AXIS_SPECULATIVE,
        "`speculative` — synthesised uncertainty",
        "Not a classification but an admission that the call could not be "
        "matched. Declarable by no catalogue, and excluded from the "
        "`total_io_edges` headline.",
    ),
)


# module-key section ordering (ADR-0051). A STRUCTURAL-POLICY axis: the
# rows below are the axis's NOTIONS, not its legal field values, which
# are unenumerable (every package on every index is legal).
_MODULE_KEY_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_OWNER_PATH,
        "`owner_path` — ADR-0051 compliant",
        "Notions that name where the callee is DEFINED. A type belongs "
        "here alongside a namespace: a method-shaped primitive is "
        "unaddressable without its owning type, and the catalogues have "
        "always spelled it that way.",
    ),
    (
        AXIS_CALL_SITE_PROPERTY,
        "`call_site_property` — belongs on the call site, not in the key",
        "Notions that name the CALL SITE rather than the definition. The "
        "same primitive reached through a differently-named variable gets "
        "a different key, which is the defect. Correct home is "
        "`Edge.meta`, where the receiver's type is already stamped.",
    ),
    (
        AXIS_UNCERTAINTY,
        "`uncertainty` — honest admissions, not identities",
        "The analyzer genuinely does not know which module, and says so. "
        "Non-conformant as an identity while being the right answer to "
        "the question; these want their own field rather than removal.",
    ),
    (
        MODULE_KEY_AXIS_PENDING,
        "`pending_classification` — per-value audit pending",
        "Genuinely contested. Ruling these in the axis declaration would "
        "be the undisciplined move the axis exists to prevent; verdicts "
        "arrive with each value's audit-findings document.",
    ),
)


_HEADER = """\
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!-- AUTO-GENERATED — do not edit manually.
     Regenerate with: ./scripts/generate-concept-axes
     Sources of truth:
       packages/hypergumbo-core/src/hypergumbo_core/edge_types.py
       packages/hypergumbo-core/src/hypergumbo_core/symbol_kinds.py
       packages/hypergumbo-core/src/hypergumbo_core/evidence_types.py -->

# Concept Axes

Typing axes maintained in hypergumbo's survey. Each axis names a
dimension along which a multi-value field's values must be classified.
New axes are introduced via ADR following ADR-0024's four-part
declaration template (axis name, axiom, consumer pattern, enforcement);
ADR-0023 (Edge.type) is the worked example, and ADR-0027 (Symbol.kind)
is the second instantiation.

The current axes apply to `Edge.type`, `Symbol.kind`, and
`Edge.evidence_type`. Other multi-value fields (`supply_chain.tier`,
etc.) will be added here as their axes are formally declared.

## Why this doc exists

`docs/schema.json` carries the same axis information under the
`x-axis-of-values` extension keyword, but reading the schema by eye
doesn't surface the axis structure — values appear in registry order,
not grouped by axis. This doc is the human-readable view; the schema
remains the machine-readable source of truth for downstream consumers.

The Fundamental Concept Audit playbook
(`.agent/agent_playbooks_protocols_sops_skills/what-if-we-dont-know-what-the-fuck-we-are-talking-about-audit-aka-fundamental-concept-audit.md`)
nominates an axis from this list each release cycle for a deliberate
re-audit, complementing the commit-count cadence hook.

## Downstream consumers

If you consume hypergumbo's behavior-map JSON output and your code
filters or weights edges by `edge_type`, see
[`docs/migrating-edge-types.md`](migrating-edge-types.md) for the
rename table, the meta-key vocabulary, and migration patterns.

The values currently in the `endpoint_shape` section below (under
`Edge.type` axes and `Symbol.kind` axes both) are deprecation
candidates whose producers still emit them. Each is scheduled for
migration to a canonical relationship-axis (or language_construct-axis)
name plus an `edge.meta` (or `Symbol.meta["framework_role"]`) payload
— see the per-ADR migration guides for the per-value fold targets.
Each value's producer-side migration ships as its own per-family
subset, with bakeoff validation, then a `SCHEMA_VERSION` minor bump
removes the value from the registry. Values already removed at
`SCHEMA_VERSION` 0.4.0 do NOT appear here; this section is the
remaining backlog.

## `Edge.type` axes
"""


_EVIDENCE_HEADER = """\

## `Edge.evidence_type` axes

Per ADR-0028, `Edge.evidence_type` names the inference pathway by which
the analyzer concluded this edge exists. Properties of the dst's
resolvedness move to the new sibling field `Edge.is_resolved`;
framework-specific dispatch conventions and call-construct surface
forms move to `Edge.meta`. The audit at WI-turin-pajuk classified the
~210 distinct `Edge.evidence_type` values currently in production into
four clusters; this section lays out the three axes (Cluster A on
`inference_pathway`; Clusters B / C / D on `endpoint_shape`
deprecation; long-tail or new clusters on `pending_classification`
until per-cluster audit-findings docs ship).
"""


_KIND_HEADER = """\

## `Symbol.kind` axes

Per ADR-0027, `Symbol.kind` names the source-language syntactic
construct the symbol represents. Properties derivable from edges or
framework metadata are queried from those structures rather than
smuggled into the kind label. The audit at WI-dumiz-bikul classified
the 192 distinct `Symbol.kind` values currently in production into
eight clusters; this section lays out the three axes (Cluster A on
`language_construct`; Clusters D, E, plus `component_ref` from F on
`endpoint_shape` deprecation; Clusters B, C, G, H on
`pending_classification` until per-cluster audit-findings docs ship).
"""

_IO_BOUNDARY_HEADER = """\

---

## `io_boundary` — the I/O-boundary axis (ADR-0050)

**Axiom.** A boundary value names *what data crosses the process boundary at
this call site, in which direction* — not what the program is thereby arranged
to do later.

Six consumers branch on this vocabulary (`AUTO_SOURCE_LABEL_MAP`,
`OPAQUE_BOUNDARIES`, `_DISCLOSED_ONLY_BOUNDARIES`, `DEFERRED_CROSSING_SHADOWS`,
`verify-claims`' claim validation, and the CLI's `--io-boundary` filter), which
is why it is registry-backed rather than a documented enumeration. Two
properties are carried per value rather than as sections, because both cut
across the axis partition: whether a catalogue may declare the value
(`_parse_catalog` iterates exactly the declarable names) and whether it counts
in the `total_io_edges` headline (`subprocess` is opaque *and* counted).
"""

_MODULE_KEY_HEADER = """\

---

## `module_key` — the module-key axis (ADR-0051)

**Axiom.** """ + MODULE_KEY_AXIOM + """

One fact with two homes by design — `IoPrimitive.module` on the catalogue side
and `ExternalRef.module_path` on the edge side — paired by
`io_boundary._module_matches`.

This is a **structural-policy** axis, not a registry of values: module names
cannot be enumerated, so what is declared is the set of *notions* a slot may
carry. `ExternalRef.module_path` previously declared `# axis: free-text` with
the justification "consumers display/lookup, never branch on the value itself",
which `_module_matches` contradicts — it infers type-vs-sub-package from
capitalisation. The lint accepted it because a free-text justification must be
*present*, not *true*.
"""


def _confidence_annotation(spec: object) -> str:
    """Render a spec's seeded detection-reliability, if it has one.

    Only ``EvidenceTypeSpec`` carries ``base_confidence`` (ADR-0039) — the
    edge-type and symbol-kind registries have no confidence axis — so this
    reads defensively and returns ``""`` for them. An *unseeded* pathway
    also renders nothing: ``derive_confidence`` returns ``None`` there and
    the producer keeps its own literal, so there is no derived value to
    document (WI-limom).
    """
    base = getattr(spec, "base_confidence", None)
    if base is None:
        return ""
    unresolved = getattr(spec, "base_confidence_unresolved", None)
    if unresolved is None:
        return f" _(derived confidence {base:.2f})_"
    return (
        f" _(derived confidence {base:.2f}; {unresolved:.2f} when unresolved)_"
    )


def _format_axis_section(
    heading: str, preamble: str, specs: Iterable[object],
) -> str:
    lines = [f"### {heading}", "", preamble, ""]
    bullets = sorted(specs, key=lambda s: s.name)  # type: ignore[attr-defined]
    if not bullets:
        lines.append("_(empty — no values currently classified on this axis)_")
        lines.append("")
        return "\n".join(lines)
    for spec in bullets:
        lines.append(
            f"- **`{spec.name}`** — {spec.description}"  # type: ignore[attr-defined]
            f"{_confidence_annotation(spec)}",
        )
    lines.append("")
    return "\n".join(lines)


def _render_axis_sections(
    specs: Iterable[object],
    section_table: tuple[tuple[str, str, str], ...],
    section_table_name: str,
) -> list[str]:
    """Render one field's per-axis sections, plus a guard for undocumented axes.

    EXTRACTED AT THE FOURTH COPY. Edge.edge_type, Symbol.kind and
    Edge.evidence_type each open-coded this block; ADR-0050's io-boundary axis
    would have been the fourth, and the blocks had already begun to diverge in
    whitespace and in the wording of their own guard message. The guard is the
    part worth having in one place: it surfaces a registry axis that has no
    documented section, so a future axis addition cannot silently drop out of
    the generated doc.
    """
    by_axis: dict[str, list[object]] = {}
    for spec in specs:
        by_axis.setdefault(spec.axis, []).append(spec)  # type: ignore[attr-defined]
    out = [
        _format_axis_section(heading, preamble, by_axis.get(axis_id, []))
        for axis_id, heading, preamble in section_table
    ]
    known = {axis_id for axis_id, _, _ in section_table}
    for axis_id, axis_specs in sorted(by_axis.items()):
        if axis_id in known:
            continue
        out.append(  # pragma: no cover — defensive
            _format_axis_section(
                f"`{axis_id}` — undocumented axis",
                "This axis appears in the registry but has no documented "
                "section in scripts/generate-concept-axes. Add an entry to "
                f"`{section_table_name}` describing the axis and its "
                "rationale.",
                axis_specs,
            ),
        )
    return out


def _format_confidence_table() -> str:
    """Render the ADR-0039 R5 Stage-B per-pathway confidence projection.

    This is the generated counterpart to spec §12's prose: the spec
    explains *how* `Edge.confidence` is derived, this table is the
    machine-projected *what*, so the two can never drift (the freshness
    gate is `generate-concept-axes --check`, already wired into
    pre-commit and verify-generated). WI-limom deferred exactly this
    rather than hand-transcribing a drift-prone table.
    """
    seeded = [e for e in EVIDENCE_TYPES if e.base_confidence is not None]
    unseeded = sorted(
        e.name for e in EVIDENCE_TYPES if e.base_confidence is None
    )
    conditioned = sorted(
        (e for e in seeded if e.base_confidence_unresolved is not None),
        key=lambda e: e.name,
    )

    by_value: dict[float, list[str]] = {}
    for spec in seeded:
        assert spec.base_confidence is not None  # narrowed by the filter above
        by_value.setdefault(spec.base_confidence, []).append(spec.name)

    lines = [
        "### Derived confidence — `base_confidence` projection (ADR-0039)",
        "",
        "`Edge.create` derives `Edge.confidence` from the edge's "
        "`evidence_type` via `derive_confidence(evidence_type, is_resolved)` "
        "— detection *reliability*, not ranking prominence (that lives on "
        "`rank_score`). Values sit in the analyzer/linker band "
        "**0.30–0.95**; 1.0 is a reserved ceiling, since no detection "
        "method is certain. See "
        "[spec §12](hypergumbo-spec.md#12-confidence-scoring) for the model "
        "and [ADR-0039](adr/0039-confidence-separation.md) for the ruling.",
        "",
        f"**{len(seeded)} of {len(EVIDENCE_TYPES)} pathways are seeded.** "
        "Each base is the edge-weighted modal confidence that pathway's "
        "producers historically hardcoded, so the migration off literal "
        "`confidence=` sites preserved the dominant cohort and collapsed "
        "per-emitter outliers onto one canonical value.",
        "",
        "| Derived confidence | Pathways |",
        "|---|---|",
    ]
    for value in sorted(by_value, reverse=True):
        names = ", ".join(f"`{n}`" for n in sorted(by_value[value]))
        lines.append(f"| **{value:.2f}** | {names} |")
    lines.append("")

    lines.extend([
        "**`is_resolved`-conditioned pathways.** Two call pathways are "
        "multimodal — a name-resolved call is more reliable than an "
        "unresolved one, so they carry a second, lower base that "
        "`derive_confidence` selects when `is_resolved=False`:",
        "",
        "| Pathway | Resolved | Unresolved |",
        "|---|---|---|",
    ])
    for spec in conditioned:
        assert spec.base_confidence is not None
        assert spec.base_confidence_unresolved is not None
        lines.append(
            f"| `{spec.name}` | {spec.base_confidence:.2f} "
            f"| {spec.base_confidence_unresolved:.2f} |",
        )
    lines.append("")

    lines.extend([
        f"**Unseeded ({len(unseeded)}).** `derive_confidence` returns "
        "`None` for these, so the producer keeps whatever literal it "
        "emits and `confidence_source` stays `emitter_constant`. That is "
        "the honest state, not a gap to paper over: an unseeded pathway "
        "has no measured modal cohort to seed from. Seeding one is a "
        "producer-side migration (the ADR-0039 ruling-1 shape), not a "
        "documentation change.",
        "",
        "<details><summary>Unseeded pathways</summary>",
        "",
        ", ".join(f"`{n}`" for n in unseeded),
        "",
        "</details>",
        "",
    ])
    return "\n".join(lines)


def render() -> str:
    """Render the markdown body from ``EDGE_TYPES`` and ``SYMBOL_KINDS``."""
    sections: list[str] = [_HEADER]

    # Edge.type sections.
    sections.extend(_render_axis_sections(EDGE_TYPES, _SECTIONS, "_SECTIONS"))

    # Symbol.kind sections.
    sections.append(_KIND_HEADER)
    sections.extend(
        _render_axis_sections(SYMBOL_KINDS, _KIND_SECTIONS, "_KIND_SECTIONS"),
    )

    # Edge.evidence_type sections.
    sections.append(_EVIDENCE_HEADER)
    sections.extend(
        _render_axis_sections(
            EVIDENCE_TYPES, _EVIDENCE_SECTIONS, "_EVIDENCE_SECTIONS",
        ),
    )
    sections.append(_format_confidence_table())

    # io_boundary sections (ADR-0050).
    sections.append(_IO_BOUNDARY_HEADER)
    sections.extend(
        _render_axis_sections(
            IO_BOUNDARY_TYPES, _IO_BOUNDARY_SECTIONS, "_IO_BOUNDARY_SECTIONS",
        ),
    )

    # module-key sections (ADR-0051).
    sections.append(_MODULE_KEY_HEADER)
    sections.extend(
        _render_axis_sections(
            MODULE_KEY_NOTIONS, _MODULE_KEY_SECTIONS, "_MODULE_KEY_SECTIONS",
        ),
    )

    return "\n".join(sections).rstrip() + "\n"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Generate or check docs/concept-axes.md (a human-readable "
            "by-axis view of the canonical edge-type registry)."
        ),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help=(
            "Verify the on-disk doc matches what the generator would "
            "produce; exit 1 if stale. Used in pre-commit / CI."
        ),
    )
    args = parser.parse_args(argv)

    output_path = REPO_ROOT / "docs" / "concept-axes.md"
    rendered = render()

    if args.check:
        if not output_path.exists():
            print(
                f"ERROR: {output_path.relative_to(REPO_ROOT)} does not exist",
                file=sys.stderr,
            )
            print(
                "Run: ./scripts/generate-concept-axes",
                file=sys.stderr,
            )
            return 1
        on_disk = output_path.read_text()
        if on_disk != rendered:
            print(
                f"ERROR: {output_path.relative_to(REPO_ROOT)} is out of date",
                file=sys.stderr,
            )
            print(
                "Run: ./scripts/generate-concept-axes",
                file=sys.stderr,
            )
            return 1
        print(f"OK: {output_path.relative_to(REPO_ROOT)} is up-to-date")
        return 0

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(rendered)
    print(f"Generated {output_path.relative_to(REPO_ROOT)}")
    return 0


if __name__ == "__main__":  # pragma: no cover
    sys.exit(main())

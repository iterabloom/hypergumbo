#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Generate ``docs/concept-axes.md`` — a human-readable by-axis view
of the canonical edge-type registry.

The schema (``docs/schema.json``) carries axis annotations under the
``x-axis-of-values`` extension keyword on ``Edge.type``, but reading
schema.json by eye doesn't surface the axis structure — the values
appear in registry order, not grouped by axis. This script reads
``hypergumbo_core.edge_types.EDGE_TYPES`` directly and emits a
markdown doc grouped by axis (relationship / endpoint_shape /
pending_classification per ADR-0023), so a human skimming the
codebase's typing ontology can see what each axis contains at a
glance.

Companion to ``scripts/generate-schema``. Both are auto-generated;
both have a ``--check`` mode for CI/pre-commit freshness gating.

Usage:
    ./scripts/generate-concept-axes              # Write docs/concept-axes.md
    ./scripts/generate-concept-axes --check      # Verify the doc is current
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Iterable


REPO_ROOT = Path(__file__).resolve().parent.parent

# Add hypergumbo-core src to sys.path so we can import the registry
# without requiring an editable install.
sys.path.insert(0, str(REPO_ROOT / "packages" / "hypergumbo-core" / "src"))

from hypergumbo_core.edge_types import (  # noqa: E402
    AXIS_ENDPOINT_SHAPE,
    AXIS_PENDING,
    AXIS_RELATIONSHIP,
    EDGE_TYPES,
    EdgeTypeSpec,
)
from hypergumbo_core.symbol_kinds import (  # noqa: E402
    AXIS_LANGUAGE_CONSTRUCT,
    AXIS_PENDING as KIND_AXIS_PENDING,
    SYMBOL_KINDS,
    SymbolKindSpec,
)
from hypergumbo_core.evidence_types import (  # noqa: E402
    AXIS_ENDPOINT_SHAPE as EVIDENCE_AXIS_ENDPOINT_SHAPE,
    AXIS_INFERENCE_PATHWAY,
    AXIS_PENDING as EVIDENCE_AXIS_PENDING,
    EVIDENCE_TYPES,
    EvidenceTypeSpec,
)


# Edge.type section ordering (most-canonical first). Each entry:
# axis-id, heading, preamble paragraph.
_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_RELATIONSHIP,
        "`relationship` — ADR-0023 compliant",
        "Values that name the relationship the edge expresses between "
        "src and dst. Per ADR-0023, this is the only axis a new "
        "`edge_type` value should occupy.",
    ),
    (
        AXIS_ENDPOINT_SHAPE,
        "`endpoint_shape` — deprecation candidates per ADR-0023 §6",
        "Values whose meaning is leaked into the type label even though "
        "it is captured by `src.kind` / `dst.kind` / language metadata. "
        "Migration plan in ADR-0023 §6 folds these back into "
        "relationship-shaped names with kind/language metadata on the "
        "endpoint nodes.",
    ),
    (
        AXIS_PENDING,
        "`pending_classification` — per-family audit pending per ADR-0023 §5",
        "Values deferred to per-family audit. Some may be genuinely "
        "distinct relationships; others are protocol-conditional "
        "duplicates of a more general relationship. Verdicts arrive with "
        "each family's audit.",
    ),
)


# Edge.evidence_type section ordering. Mirrors _SECTIONS in shape;
# entries describe the per-axis preamble for ADR-0028's three sections.
_EVIDENCE_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_INFERENCE_PATHWAY,
        "`inference_pathway` — ADR-0028 compliant",
        "Values that name the inference pathway by which the analyzer "
        "concluded this edge exists. Per ADR-0028, this is the only axis "
        "a new `Edge.evidence_type` value should occupy. Resolution "
        "status moves to the new sibling `Edge.is_resolved`; framework-"
        "specific dispatch conventions move to `Edge.meta`.",
    ),
    (
        EVIDENCE_AXIS_ENDPOINT_SHAPE,
        "`endpoint_shape` — deprecation candidates per ADR-0028",
        "Values whose meaning is leaked into the evidence label even "
        "though it is captured by `Edge.is_resolved` (Cluster B "
        "`*_unresolved` resolution-status leakage), `Edge.meta` "
        "(Cluster C framework-dispatch conventions; Cluster D call-"
        "construct surface forms). Migration plan in ADR-0028 §"
        "\"Detailed analysis: per-cluster fold targets\" folds these "
        "back into a canonical inference label plus the appropriate "
        "sibling.",
    ),
    (
        EVIDENCE_AXIS_PENDING,
        "`pending_classification` — per-cluster audit pending per ADR-0028",
        "Values deferred to per-cluster audit-findings docs at "
        "`docs/audits/<NN>-<topic>.md`. Each cluster's audit decides "
        "between fold-to-Cluster-A vs separate-axis declaration vs "
        "producer-side drop.",
    ),
)


# Symbol.kind section ordering. Mirrors _SECTIONS in shape; entries
# describe the per-axis preamble for ADR-0027's three sections.
_KIND_SECTIONS: tuple[tuple[str, str, str], ...] = (
    (
        AXIS_LANGUAGE_CONSTRUCT,
        "`language_construct` — ADR-0027 compliant",
        "Values that name the source-language syntactic construct the "
        "symbol represents. Per ADR-0027, this is the only axis a new "
        "`Symbol.kind` value should occupy.",
    ),
    (
        KIND_AXIS_PENDING,
        "`pending_classification` — per-cluster audit pending per ADR-0027 §\"Migration\"",
        "Values deferred to per-cluster audit-findings docs at "
        "`docs/audits/<NN>-<topic>.md`. Includes the file-shape entities "
        "(Cluster B), apex/peer overloads (Cluster C), build/config-shape "
        "entities (Cluster G), and the long-tail domain vocabulary "
        "(Cluster H). Each cluster's audit decides between fold-to-"
        "Cluster-A vs separate-axis declaration vs producer-side drop.",
    ),
)


_HEADER = """\
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!-- AUTO-GENERATED — do not edit manually.
     Regenerate with: ./scripts/generate-concept-axes
     Sources of truth:
       packages/hypergumbo-core/src/hypergumbo_core/edge_types.py
       packages/hypergumbo-core/src/hypergumbo_core/symbol_kinds.py
       packages/hypergumbo-core/src/hypergumbo_core/evidence_types.py -->

# Concept Axes

Typing axes maintained in hypergumbo's behavior map. Each axis names a
dimension along which a multi-value field's values must be classified.
New axes are introduced via ADR following ADR-0024's four-part
declaration template (axis name, axiom, consumer pattern, enforcement);
ADR-0023 (Edge.type) is the worked example, and ADR-0027 (Symbol.kind)
is the second instantiation.

The current axes apply to `Edge.type`, `Symbol.kind`, and
`Edge.evidence_type`. Other multi-value fields (`supply_chain.tier`,
etc.) will be added here as their axes are formally declared.

## Why this doc exists

`docs/schema.json` carries the same axis information under the
`x-axis-of-values` extension keyword, but reading the schema by eye
doesn't surface the axis structure — values appear in registry order,
not grouped by axis. This doc is the human-readable view; the schema
remains the machine-readable source of truth for downstream consumers.

The Fundamental Concept Audit playbook
(`.agent/agent_playbooks_protocols_sops_skills/what-if-we-dont-know-what-the-fuck-we-are-talking-about-audit-aka-fundamental-concept-audit.md`)
nominates an axis from this list each release cycle for a deliberate
re-audit, complementing the commit-count cadence hook.

## Downstream consumers

If you consume hypergumbo's behavior-map JSON output and your code
filters or weights edges by `edge_type`, see
[`docs/migrating-edge-types.md`](migrating-edge-types.md) for the
rename table, the meta-key vocabulary, and migration patterns.

The values currently in the `endpoint_shape` section below (under
`Edge.type` axes and `Symbol.kind` axes both) are deprecation
candidates whose producers still emit them. Each is scheduled for
migration to a canonical relationship-axis (or language_construct-axis)
name plus an `edge.meta` (or `Symbol.meta["framework_role"]`) payload
— see the per-ADR migration guides for the per-value fold targets.
Each value's producer-side migration ships as its own per-family
subset, with bakeoff validation, then a `SCHEMA_VERSION` minor bump
removes the value from the registry. Values already removed at
`SCHEMA_VERSION` 0.4.0 do NOT appear here; this section is the
remaining backlog.

## `Edge.type` axes
"""


_EVIDENCE_HEADER = """\

## `Edge.evidence_type` axes

Per ADR-0028, `Edge.evidence_type` names the inference pathway by which
the analyzer concluded this edge exists. Properties of the dst's
resolvedness move to the new sibling field `Edge.is_resolved`;
framework-specific dispatch conventions and call-construct surface
forms move to `Edge.meta`. The audit at WI-turin-pajuk classified the
~210 distinct `Edge.evidence_type` values currently in production into
four clusters; this section lays out the three axes (Cluster A on
`inference_pathway`; Clusters B / C / D on `endpoint_shape`
deprecation; long-tail or new clusters on `pending_classification`
until per-cluster audit-findings docs ship).
"""


_KIND_HEADER = """\

## `Symbol.kind` axes

Per ADR-0027, `Symbol.kind` names the source-language syntactic
construct the symbol represents. Properties derivable from edges or
framework metadata are queried from those structures rather than
smuggled into the kind label. The audit at WI-dumiz-bikul classified
the 192 distinct `Symbol.kind` values currently in production into
eight clusters; this section lays out the three axes (Cluster A on
`language_construct`; Clusters D, E, plus `component_ref` from F on
`endpoint_shape` deprecation; Clusters B, C, G, H on
`pending_classification` until per-cluster audit-findings docs ship).
"""


def _format_axis_section(
    heading: str, preamble: str, specs: Iterable[object],
) -> str:
    lines = [f"### {heading}", "", preamble, ""]
    bullets = sorted(specs, key=lambda s: s.name)  # type: ignore[attr-defined]
    if not bullets:
        lines.append("_(empty — no values currently classified on this axis)_")
        lines.append("")
        return "\n".join(lines)
    for spec in bullets:
        lines.append(
            f"- **`{spec.name}`** — {spec.description}",  # type: ignore[attr-defined]
        )
    lines.append("")
    return "\n".join(lines)


def render() -> str:
    """Render the markdown body from ``EDGE_TYPES`` and ``SYMBOL_KINDS``."""
    sections: list[str] = [_HEADER]

    # Edge.type sections.
    edge_by_axis: dict[str, list[EdgeTypeSpec]] = {}
    for spec in EDGE_TYPES:
        edge_by_axis.setdefault(spec.axis, []).append(spec)
    for axis_id, heading, preamble in _SECTIONS:
        sections.append(
            _format_axis_section(heading, preamble, edge_by_axis.get(axis_id, [])),
        )
    # Surface any Edge.type axis values that are NOT in _SECTIONS — guards
    # against future axis additions silently dropping out of the doc.
    known_edge_axes = {axis_id for axis_id, _, _ in _SECTIONS}
    for axis_id, specs in sorted(edge_by_axis.items()):
        if axis_id in known_edge_axes:
            continue
        sections.append(  # pragma: no cover — defensive
            _format_axis_section(
                f"`{axis_id}` — undocumented axis",
                "This axis appears in the registry but has no documented "
                "section in scripts/generate-concept-axes. Add an entry "
                "to `_SECTIONS` describing the axis and its rationale.",
                specs,
            ),
        )

    # Symbol.kind sections.
    sections.append(_KIND_HEADER)
    kind_by_axis: dict[str, list[SymbolKindSpec]] = {}
    for kspec in SYMBOL_KINDS:
        kind_by_axis.setdefault(kspec.axis, []).append(kspec)
    for axis_id, heading, preamble in _KIND_SECTIONS:
        sections.append(
            _format_axis_section(heading, preamble, kind_by_axis.get(axis_id, [])),
        )
    known_kind_axes = {axis_id for axis_id, _, _ in _KIND_SECTIONS}
    for axis_id, specs in sorted(kind_by_axis.items()):
        if axis_id in known_kind_axes:
            continue
        sections.append(  # pragma: no cover — defensive
            _format_axis_section(
                f"`{axis_id}` — undocumented axis",
                "This axis appears in the registry but has no documented "
                "section in scripts/generate-concept-axes. Add an entry "
                "to `_KIND_SECTIONS` describing the axis and its rationale.",
                specs,
            ),
        )

    # Edge.evidence_type sections.
    sections.append(_EVIDENCE_HEADER)
    evidence_by_axis: dict[str, list[EvidenceTypeSpec]] = {}
    for espec in EVIDENCE_TYPES:
        evidence_by_axis.setdefault(espec.axis, []).append(espec)
    for axis_id, heading, preamble in _EVIDENCE_SECTIONS:
        sections.append(
            _format_axis_section(
                heading, preamble, evidence_by_axis.get(axis_id, []),
            ),
        )
    known_evidence_axes = {axis_id for axis_id, _, _ in _EVIDENCE_SECTIONS}
    for axis_id, specs in sorted(evidence_by_axis.items()):
        if axis_id in known_evidence_axes:
            continue
        sections.append(  # pragma: no cover — defensive
            _format_axis_section(
                f"`{axis_id}` — undocumented axis",
                "This axis appears in the registry but has no documented "
                "section in scripts/generate-concept-axes. Add an entry "
                "to `_EVIDENCE_SECTIONS` describing the axis and its "
                "rationale.",
                specs,
            ),
        )

    return "\n".join(sections).rstrip() + "\n"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Generate or check docs/concept-axes.md (a human-readable "
            "by-axis view of the canonical edge-type registry)."
        ),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help=(
            "Verify the on-disk doc matches what the generator would "
            "produce; exit 1 if stale. Used in pre-commit / CI."
        ),
    )
    args = parser.parse_args(argv)

    output_path = REPO_ROOT / "docs" / "concept-axes.md"
    rendered = render()

    if args.check:
        if not output_path.exists():
            print(
                f"ERROR: {output_path.relative_to(REPO_ROOT)} does not exist",
                file=sys.stderr,
            )
            print(
                "Run: ./scripts/generate-concept-axes",
                file=sys.stderr,
            )
            return 1
        on_disk = output_path.read_text()
        if on_disk != rendered:
            print(
                f"ERROR: {output_path.relative_to(REPO_ROOT)} is out of date",
                file=sys.stderr,
            )
            print(
                "Run: ./scripts/generate-concept-axes",
                file=sys.stderr,
            )
            return 1
        print(f"OK: {output_path.relative_to(REPO_ROOT)} is up-to-date")
        return 0

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(rendered)
    print(f"Generated {output_path.relative_to(REPO_ROOT)}")
    return 0


if __name__ == "__main__":  # pragma: no cover
    sys.exit(main())

#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Module-docstring drift checker — co-change scan over .py source trees.

This script implements the mechanical passes of the stratum-6
docstring-staleness audit (see
``.agent/agent_playbooks_protocols_sops_skills/docstring-staleness-audit-playbook.md``).
It produces a ranked candidate list of files where the module
docstring is likely to have drifted from the surrounding code.

Three sub-checks are available:

1. **Co-change scan** (default, ``--co-change``). For each ``.py``
   file under ``packages/*/src/``, AST-parse to find the module
   docstring extent (``node.lineno..node.end_lineno`` — explicitly
   NOT line 1, which is occupied by the SPDX header on every file
   and would conflate the SPDX mass-edit with docstring edits),
   then ``git blame`` both regions. Flag files where the body has
   moved on and the docstring hasn't.

   "Hasn't" is measured two ways, and the second exists because the
   first decays. ``delta_days = ds_age - body_age`` is only
   meaningful while the docstring's date can still move; where a
   mass commit PINNED it, delta grows with wall clock alone and the
   ``>= 90`` threshold degenerates into "was this touched
   recently". That is not hypothetical — the ``ds=2026-02-19``
   cohort could not fire at ANY body age on 2026-05-15 and fired
   for anything touched within 89 days by 2026-08-18, taking the
   flagged count from 28 to 87 with nothing having drifted. So the
   day arm is applied ONLY to rows whose floor commit is particular
   to them, and the primary metric is
   ``body_commits_since_ds`` — how many commits have landed on the
   body since anyone touched the docstring — which counts commits
   rather than days and so does not move with the calendar.

   Each row discloses what dates it: the floor commit, the share of
   the docstring that commit owns, and how many OTHER docstrings it
   floors. Those are facts, not verdicts. The scan deliberately
   does NOT try to decide whether a floor commit "counted as a
   review" and skip past it if not: measured on this corpus, the
   ADR-3bbb convention stamp owns a median 1 line (2%) of the
   docstrings it floors and a genuine staleness-audit fix owns 2
   lines (4%), so no threshold on size or file-count separates a
   stamp nobody read from the most careful reading those files ever
   had. Guessing would be actively harmful: it would classify every
   prior audit's own fix commits as sweeps, making each audit blind
   the next one to exactly the files it had just verified.

2. **Tracker-ID cross-ref** (``--tracker-refs``). Extract ``WI-`` /
   ``INV-`` / ``BUG-`` IDs from docstrings and inline comments,
   cross-reference each against ``scripts/tracker --json show <ID>``
   to learn its status. Flag references that frame done /
   satisfied / wont_do items as "deferred", "not yet", "future",
   "will land".

3. **Phase-marker grep** (``--phase-markers``). Plain regex over
   docstrings + comments for strings like ``Two-pass``,
   ``Phase 2b``, ``Slice B``, ``not yet implemented``,
   ``deferred to``, ``arrives in``, ``will ship``, ``TODO`` /
   ``FIXME`` / ``XXX``. Intersection with the closed-tracker-ID
   set from check #2 is the highest-signal subset.

``--all`` runs all three. Default scope is ``packages/*/src``; pass
positional path arguments to narrow.

The semantic-review step (the fourth pass in the playbook) cannot
be a script — it needs LLM judgment per file. This script produces
the candidate pool the semantic step operates on.

Exit codes
----------
- 0: no candidates flagged
- 1: candidates flagged (drift suspected, review recommended)
- 2: usage / configuration error

Usage
-----
Run with no args to do a co-change scan over the default scope::

    scripts/check-docstring-drift

Pass ``--all`` to run all three sub-checks, ``--json`` for
machine-readable output, ``--window`` / ``--min-delta`` /
``--min-body-commits`` to tune co-change thresholds.
"""
from __future__ import annotations

import argparse
import ast
import datetime as dt
import json
import os
import pathlib
import re
import subprocess
import sys


# Default co-change thresholds (calibrated against the 2026-05-15
# stratum-6 audit on hypergumbo itself; see the playbook for the
# calibration story).
DEFAULT_BODY_AGE_DAYS = 120
DEFAULT_MIN_DELTA_DAYS = 90

# A commit that is the youngest edit to at least this many DIFFERENT module
# docstrings is treated as a mass sweep rather than as a review. Three such
# commits exist in this repo's history and between them they floored 55 of 87
# flagged files on 2026-08-18: the ADR-0010 monorepo reorg (blame follows the
# move), the Phase-4 TreeSitterAnalyzer migration (~70 analyzers stamped with
# identical "two-pass orchestration" boilerplate), and the ADR-3bbb subcategory
# sweep (one line prepended to 45 linker docstrings). 8 is well above the
# largest genuine multi-file docstring edit observed and well below all three.
SWEEP_MIN_FILES = 8

# A floor commit owning at most this share of a docstring did not rewrite it.
# Reported, never acted on. Measured 2026-08-18: the ADR-3bbb convention stamp
# owns a median 2% of the docstrings it floors; the 2026-06-19 staleness-audit
# fix -- a genuine line-by-line review -- owns 4%. Neither share nor co-floor
# count separates a stamp from a review, so this is one of three facts a human
# weighs, not a classifier. Auto-skipping on it would make each audit blind the
# next one to the very files it had just verified.
STAMP_MAX_SHARE = 0.10

# Commits that landed on the body since the docstring was last touched.
# Clock-independent, unlike --min-delta days: `delta = ds_age - body_age` grows
# on its own whenever ds is pinned, so the day threshold decays into "was this
# touched recently" (the ds=2026-02-19 cohort could not fire at ANY body age on
# 2026-05-15 and fired for anything within 89 days by 2026-08-18 -- 28 flags
# became 87 with nothing drifting). A file qualifies on EITHER metric.
DEFAULT_MIN_BODY_COMMITS = 15

DEFAULT_SCOPE = ("packages/hypergumbo-core/src",
                 "packages/hypergumbo-lang-mainstream/src",
                 "packages/hypergumbo-lang-common/src",
                 "packages/hypergumbo-lang-extended1/src",
                 "packages/hypergumbo-lang-rust-analyzer/src",
                 "packages/hypergumbo-tracker/src")

TRACKER_ID_RE = re.compile(r"\b(WI|INV|BUG)-[a-z0-9]+(?:-[a-z]+){0,7}")

# Phrases that frame work as still-pending; intersected with closed
# tracker IDs in --phase-markers mode.  Case-insensitive.
PHASE_MARKER_RE = re.compile(
    r"\b(Slice [A-Z]|Phase [0-9]\w*"
    r"|not yet (?:implemented|wired|shipped|ready|supported|invoked|hooked)"
    r"|arrives in (?:Slice|Phase|WI)"
    r"|will (?:ship|land|arrive)"
    r"|once .{0,30}? (?:lands|ships)"
    r"|when .{0,30}? (?:lands|ships)"
    r"|deferred to"
    r"|TODO|FIXME|XXX)\b",
    re.IGNORECASE,
)


# ---------------------------------------------------------------------------
# Co-change scan
# ---------------------------------------------------------------------------


def docstring_lines(path: str) -> tuple[int, int] | None:
    """Return ``(start, end)`` lines of the module-level docstring, 1-indexed.

    Returns ``None`` if the file has no module-level docstring.
    """
    try:
        src = pathlib.Path(path).read_text()
        tree = ast.parse(src)
    except (OSError, SyntaxError, UnicodeDecodeError):
        return None
    if not tree.body:
        return None
    node = tree.body[0]
    if (
        isinstance(node, ast.Expr)
        and isinstance(node.value, ast.Constant)
        and isinstance(node.value.value, str)
    ):
        return node.lineno, node.end_lineno
    return None


def file_line_count(path: str) -> int:
    """Return the number of lines in ``path``."""
    with open(path, "rb") as f:
        return sum(1 for _ in f)


def blame_lines(path: str, start: int, end: int) -> list[tuple[int, str]]:
    """Return ``(committer_time, sha)`` for each blamed line in ``start..end``.

    The sha is what makes sweep detection possible: a timestamp alone cannot
    distinguish "someone reviewed this docstring" from "a 45-file compliance
    sweep prepended one line to it".
    """
    if start > end:
        return []
    try:
        out = subprocess.check_output(
            ["git", "blame", "-L", f"{start},{end}", "--porcelain", path],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return []
    result: list[tuple[int, str]] = []
    sha: str | None = None
    for line in out.splitlines():
        # A porcelain header line is "<sha> <orig-lineno> <final-lineno> [n]".
        if len(line) >= 40 and line[:40].isalnum() and " " in line:
            candidate = line.split()[0]
            if len(candidate) == 40:
                sha = candidate
        elif line.startswith("committer-time ") and sha is not None:
            result.append((int(line.split()[1]), sha))
    return result


def youngest_commit_ts(path: str, start: int, end: int) -> int | None:
    """Return the youngest committer-time in lines ``start..end`` of ``path``."""
    blamed = blame_lines(path, start, end)
    return max((t for t, _ in blamed), default=None)


def iter_python_files(scope_dirs: tuple[str, ...]) -> list[str]:
    """Yield .py files under each scope directory, skipping caches."""
    result: list[str] = []
    for d in scope_dirs:
        if not os.path.isdir(d):
            continue
        for dp, _, fn in os.walk(d):
            if "__pycache__" in dp or "/.venv/" in dp:
                continue
            for f in fn:
                if f.endswith(".py"):
                    result.append(os.path.join(dp, f))
    return sorted(result)


def floor_facts(
    blamed: list[tuple[int, str]], cofloor_counts: dict[str, int]
) -> dict:
    """Report FACTS about what dates a docstring. No inference about intent.

    An earlier version of this function tried to decide whether the floor
    commit "counted as a review" and to look past it when it did not. That
    cannot be done from blame, and the measurement says so plainly: the
    ADR-3bbb convention sweep owns a median of 1 docstring line (2%), and the
    2026-06-19 staleness-audit fix — a genuine line-by-line review — owns a
    median of 2 lines (4%). One is a stamp nobody read; the other is the most
    careful reading those files have ever had. They are the same size, and
    they touch a similar number of files, so neither ownership share nor
    corpus-wide co-floor count separates them.

    Guessing would be worse than not guessing: classifying an audit's own fix
    commits as sweeps makes every audit blind the next one to exactly the
    files it just verified. So this function reports three observable
    quantities and leaves the judgement to the semantic-review step, which is
    where the playbook already puts judgement:

    - ``ds_floor_sha`` — which commit last touched the docstring at all.
    - ``ds_floor_share`` — what fraction of the docstring's lines it owns. A
      1-of-43 share means whatever it did, it did not rewrite this docstring.
    - ``ds_floor_cofloors`` — how many OTHER module docstrings the same commit
      floors. High values mean the date is systematic across the corpus rather
      than particular to this file; that is worth seeing, not worth acting on
      automatically.
    """
    if not blamed:
        return {"ds_ts": None, "ds_floor_sha": None,
                "ds_floor_share": 0.0, "ds_floor_cofloors": 0}
    ts, sha = max(blamed, key=lambda tc: tc[0])
    owned = sum(1 for _, c in blamed if c == sha)
    return {
        "ds_ts": ts,
        "ds_floor_sha": sha,
        "ds_floor_share": owned / len(blamed),
        "ds_floor_cofloors": cofloor_counts.get(sha, 1) - 1,
    }


def count_body_commits_since(path: str, since_ts: int) -> int:
    """Commits touching *path* since *since_ts* — the non-decaying metric.

    ``delta_days = ds_age - body_age`` decays into meaninglessness whenever
    ``ds`` is pinned: the docstring date stops moving, wall clock keeps going,
    so delta grows on its own and the ``>= 90`` threshold degenerates into
    "was this file touched recently". Concretely, the ``ds=2026-02-19`` cohort
    could not fire at ANY body age on 2026-05-15 (ds_age was 85) and fires for
    anything touched within 89 days by 2026-08-18 — 28 flags became 87 with no
    docstring drifting in between.

    Counting COMMITS instead of DAYS removes the clock from the numerator. "17
    commits have landed on this file since anyone touched its docstring" means
    the same thing next year as it does today.
    """
    try:
        out = subprocess.check_output(
            ["git", "log", "--format=%H", f"--since=@{since_ts}", "--", path],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return 0
    return len([ln for ln in out.splitlines() if ln.strip()])


def partition_rows(
    rows: list[dict], *, window_days: int, min_delta_days: int,
    min_body_commits: int, now_ts: int
) -> dict:
    """Split rows into ``flagged`` and ``pinned``.

    ``pinned`` collects rows whose docstring date is shared with many other
    files AND whose floor commit owns almost none of the docstring — the shape
    a convention stamp leaves. Those are reported in their own bucket rather
    than dropped, because an unreviewed file is not a clean file, and rather
    than silently re-dated, because the measurement above shows that call
    cannot be made mechanically.
    """
    flagged: list[dict] = []
    pinned: list[dict] = []
    for r in rows:
        body_age = (now_ts - r["body_ts"]) // 86400
        ds_age = (now_ts - r["ds_ts"]) // 86400
        r = dict(r, body_age_days=body_age, ds_age_days=ds_age,
                 delta_days=ds_age - body_age)
        if body_age > window_days:
            continue
        # The day arm is only trustworthy where the docstring date is NOT
        # pinned. Pinning is the whole decay mechanism: a ds that stops moving
        # while the clock runs makes delta grow on its own, so on a pinned row
        # `delta >= 90` eventually means nothing but "touched recently". Where
        # the floor is particular to this file, delta means what it says.
        pinned_floor = r.get("ds_floor_cofloors", 0) >= SWEEP_MIN_FILES
        by_days = r["delta_days"] >= min_delta_days and not pinned_floor
        by_commits = r.get("body_commits_since_ds", 0) >= min_body_commits
        if not (by_days or by_commits):
            continue
        # Which arm fired is itself a disclosure: the day arm decays with wall
        # clock whenever ds is pinned, so a "days"-only row is weaker evidence
        # than a "commits" row and the reviewer should be able to see that
        # without recomputing it.
        r["flag_reason"] = ("both" if by_days and by_commits
                            else "commits" if by_commits else "days")
        is_pinned = (r.get("ds_floor_cofloors", 0) >= SWEEP_MIN_FILES
                     and r.get("ds_floor_share", 1.0) <= STAMP_MAX_SHARE)
        (pinned if is_pinned else flagged).append(r)
    for bucket in (flagged, pinned):
        bucket.sort(key=lambda x: x.get("body_commits_since_ds", 0), reverse=True)
    return {"flagged": flagged, "pinned": pinned}


def co_change_scan(
    scope_dirs: tuple[str, ...],
    *,
    window_days: int,
    min_delta_days: int,
    min_body_commits: int = DEFAULT_MIN_BODY_COMMITS,
    now_ts: int | None = None,
) -> dict:
    """Return flagged / pinned co-change results with floor disclosure.

    Two passes: pass 1 blames every docstring and records its floor commit;
    pass 2 counts how many docstrings each commit floors, so a row can report
    whether its date is particular to it or shared across the corpus. That
    count is a disclosure, not a filter -- see floor_facts().
    """
    if now_ts is None:
        now_ts = int(dt.datetime.now().timestamp())
    raw: list[dict] = []
    skipped_no_docstring = 0
    skipped_no_body = 0
    for p in iter_python_files(scope_dirs):
        ds = docstring_lines(p)
        if ds is None:
            skipped_no_docstring += 1
            continue
        ds_start, ds_end = ds
        total = file_line_count(p)
        body_start = ds_end + 1
        if body_start > total:
            skipped_no_body += 1
            continue
        ds_blame = blame_lines(p, ds_start, ds_end)
        body_ts = youngest_commit_ts(p, body_start, total)
        if not ds_blame or body_ts is None:
            continue
        raw.append({"path": p, "ds_end": ds_end, "ds_blame": ds_blame,
                    "body_ts": body_ts})

    cofloor: dict[str, int] = {}
    for r in raw:
        sha = max(r["ds_blame"], key=lambda tc: tc[0])[1]
        cofloor[sha] = cofloor.get(sha, 0) + 1

    rows: list[dict] = []
    for r in raw:
        facts = floor_facts(r["ds_blame"], cofloor)
        rows.append({
            "path": r["path"],
            "ds_end": r["ds_end"],
            "body_ts": r["body_ts"],
            "body_commits_since_ds": count_body_commits_since(
                r["path"], facts["ds_ts"]),
            **facts,
        })

    part = partition_rows(rows, window_days=window_days,
                          min_delta_days=min_delta_days,
                          min_body_commits=min_body_commits, now_ts=now_ts)
    for r in rows:
        r["body_age_days"] = (now_ts - r["body_ts"]) // 86400
        r["ds_age_days"] = (now_ts - r["ds_ts"]) // 86400
        r["delta_days"] = r["ds_age_days"] - r["body_age_days"]
    rows.sort(key=lambda r: r["body_commits_since_ds"], reverse=True)
    return {
        "scanned": len(rows),
        "skipped_no_docstring": skipped_no_docstring,
        "skipped_no_body": skipped_no_body,
        "window_days": window_days,
        "min_delta_days": min_delta_days,
        "min_body_commits": min_body_commits,
        "mass_floor_commits": {k: v for k, v in cofloor.items()
                               if v >= SWEEP_MIN_FILES},
        "flagged": part["flagged"],
        "pinned": part["pinned"],
        "rows": rows,
    }


# ---------------------------------------------------------------------------
# Tracker-ID cross-ref
# ---------------------------------------------------------------------------


def extract_tracker_ids(scope_dirs: tuple[str, ...]) -> dict[str, list[tuple[str, int]]]:
    """Map each unique tracker-ID prefix to a list of (path, line) hits."""
    hits: dict[str, list[tuple[str, int]]] = {}
    for p in iter_python_files(scope_dirs):
        try:
            with open(p, encoding="utf-8") as f:
                for lineno, line in enumerate(f, start=1):
                    for m in TRACKER_ID_RE.finditer(line):
                        hits.setdefault(m.group(0), []).append((p, lineno))
        except (OSError, UnicodeDecodeError):
            continue
    return hits


def tracker_status(tracker_id: str, repo_root: str) -> tuple[str | None, str | None]:
    """Return ``(status, title)`` for *tracker_id* via ``scripts/tracker``."""
    tracker_script = os.path.join(repo_root, "scripts", "tracker")
    if not os.path.isfile(tracker_script):
        return None, None
    try:
        out = subprocess.check_output(
            [tracker_script, "--json", "show", tracker_id],
            cwd=repo_root,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return None, None
    try:
        d = json.loads(out)
    except json.JSONDecodeError:
        return None, None
    return d.get("status"), d.get("title")


# Statuses that mean "the work is done / decided not to do", so a
# docstring referring to the ID as future-tense is suspicious.
CLOSED_STATUSES = {"done", "satisfied", "wont_do"}


# Words near a tracker-ID hit that indicate a forward-looking framing.
# (Conservative — keeps false positives manageable.)
FORWARD_FRAMING_RE = re.compile(
    r"\b(deferred|pending|future|upcoming|when .{0,30}? (?:lands|ships)"
    r"|once .{0,30}? (?:lands|ships)|will (?:land|ship|arrive)"
    r"|not yet|arrives in|TODO|FIXME)\b",
    re.IGNORECASE,
)


def cross_reference_tracker(
    hits: dict[str, list[tuple[str, int]]],
    repo_root: str,
) -> list[dict]:
    """For each tracker-ID hit, look up status and flag forward-framed refs."""
    flagged: list[dict] = []
    cache: dict[str, tuple[str | None, str | None]] = {}
    for tid, locations in hits.items():
        if tid not in cache:
            cache[tid] = tracker_status(tid, repo_root)
        status, title = cache[tid]
        if status not in CLOSED_STATUSES:
            continue
        # For each location, inspect the line context for a forward-framing word.
        for path, lineno in locations:
            try:
                with open(path, encoding="utf-8") as f:
                    lines = f.readlines()
            except (OSError, UnicodeDecodeError):
                continue
            start = max(0, lineno - 2)
            end = min(len(lines), lineno + 1)
            context = "".join(lines[start:end])
            if FORWARD_FRAMING_RE.search(context):
                flagged.append({
                    "tracker_id": tid,
                    "status": status,
                    "title": title,
                    "path": path,
                    "line": lineno,
                    "context": context.strip(),
                })
    return flagged


# ---------------------------------------------------------------------------
# Phase-marker grep
# ---------------------------------------------------------------------------


def phase_marker_grep(scope_dirs: tuple[str, ...]) -> list[dict]:
    """Return phase-marker hits across the scope directories."""
    results: list[dict] = []
    for p in iter_python_files(scope_dirs):
        try:
            with open(p, encoding="utf-8") as f:
                for lineno, line in enumerate(f, start=1):
                    m = PHASE_MARKER_RE.search(line)
                    if m:
                        results.append({
                            "path": p,
                            "line": lineno,
                            "marker": m.group(0),
                            "text": line.rstrip(),
                        })
        except (OSError, UnicodeDecodeError):
            continue
    return results


# ---------------------------------------------------------------------------
# Report formatting
# ---------------------------------------------------------------------------


def _fmt_row(r: dict) -> str:
    """One co-change row. Surfaces the floor commit so it is seen, not inferred."""
    ds_date = dt.datetime.fromtimestamp(r["ds_ts"]).strftime("%Y-%m-%d")
    body_date = dt.datetime.fromtimestamp(r["body_ts"]).strftime("%Y-%m-%d")
    floor = (r.get("ds_floor_sha") or "")[:10]
    return (
        f"{r['body_commits_since_ds']:>4} commits  "
        f"{r['delta_days']:>4}d  body={r['body_age_days']:>3}d  "
        f"ds={ds_date}  body={body_date}  "
        f"ds@{floor}[{r.get('ds_floor_share', 0):.0%}/"
        f"+{r.get('ds_floor_cofloors', 0)}]  "
        f"[{r.get('flag_reason', '-'):>7}]  {r['path']}"
    )


def format_co_change_text(report: dict, top_n: int = 0) -> str:
    """Human-readable co-change report."""
    lines: list[str] = []
    lines.append(
        f"# Co-change scan ({report['scanned']} files; "
        f"skipped {report['skipped_no_docstring']} w/o docstring, "
        f"{report['skipped_no_body']} all-docstring)"
    )
    lines.append(
        f"# Flag when body_age <= {report['window_days']} AND "
        f"(delta >= {report['min_delta_days']}d OR "
        f">= {report['min_body_commits']} body commits since the docstring)"
    )
    lines.append(
        "# [commits] = flagged by the clock-independent arm. [days] = by the "
        "day-delta arm ONLY,"
    )
    lines.append(
        "# which inflates on its own whenever the docstring date is pinned -- "
        "weaker evidence."
    )
    lines.append(
        "# Columns: <body commits since ds> <delta> body=<age> "
        "ds@<floor commit>[<share of docstring it owns>/+<other docstrings "
        "it floors>]"
    )
    mass = report.get("mass_floor_commits") or {}
    if mass:
        lines.append(
            f"# {len(mass)} commits floor >= {SWEEP_MIN_FILES} docstrings each. "
            "A shared floor may be a"
        )
        lines.append(
            "# mechanical stamp OR a deliberate audit fix -- blame cannot tell "
            "them apart"
        )
        lines.append(
            "# (measured: a convention stamp owns 2% of a docstring, a real "
            "audit fix 4%), so"
        )
        lines.append("# these are disclosed, never auto-skipped:")
        for sha, n in sorted(mass.items(), key=lambda kv: -kv[1]):
            subj = commit_subject(sha)
            lines.append(f"#   {sha[:10]}  floors {n:>3}  {subj[:72]}")
    lines.append("")
    lines.append(f"## Flagged: {len(report['flagged'])} files")
    lines.append("")
    for r in report["flagged"]:
        lines.append(_fmt_row(r))
    if report.get("pinned"):
        lines.append("")
        lines.append(
            f"## Pinned-date: {len(report['pinned'])} files  (floor commit owns "
            f"<= {STAMP_MAX_SHARE:.0%} of the docstring and floors "
            f">= {SWEEP_MIN_FILES} others)"
        )
        lines.append(
            "## The date is systematic, not particular. NOT 'clean' -- "
            "unreviewed, not verified."
        )
        lines.append("")
        for r in report["pinned"]:
            lines.append(_fmt_row(r))
    if top_n > 0 and report["rows"]:
        lines.append("")
        lines.append(f"## Top {min(top_n, len(report['rows']))} by body commits")
        lines.append("")
        for r in report["rows"][:top_n]:
            lines.append(_fmt_row(r))
    return "\n".join(lines)


def commit_subject(sha: str) -> str:
    """Return the one-line subject of *sha*, or "" if unavailable."""
    try:
        return subprocess.check_output(
            ["git", "show", "-s", "--format=%s", sha],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
    except subprocess.CalledProcessError:
        return ""


def format_tracker_text(flagged: list[dict]) -> str:
    """Human-readable tracker-ref report."""
    if not flagged:
        return "## Tracker-ref cross-ref: no forward-framed closed-ID refs found"
    lines = [f"## Tracker-ref cross-ref: {len(flagged)} forward-framed refs"
             " to closed items", ""]
    for hit in flagged:
        lines.append(
            f"  {hit['tracker_id']} ({hit['status']}): {hit['path']}:{hit['line']}"
        )
        lines.append(f"    {hit['context']}")
        lines.append("")
    return "\n".join(lines)


def format_phase_marker_text(hits: list[dict]) -> str:
    """Human-readable phase-marker report (summary only)."""
    lines = [f"## Phase-marker grep: {len(hits)} hits (review against tracker IDs)",
             ""]
    for h in hits[:30]:
        lines.append(f"  {h['path']}:{h['line']}  [{h['marker']}]")
    if len(hits) > 30:
        lines.append(f"  ...and {len(hits) - 30} more")
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def _repo_root() -> str:
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            text=True,
        ).strip()
    except subprocess.CalledProcessError:
        return os.getcwd()


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="check-docstring-drift",
        description="Module-docstring drift checker (stratum-6 staleness audit, "
        "mechanical passes).",
    )
    parser.add_argument(
        "paths", nargs="*",
        help="Optional directories to scan (default: packages/*/src).",
    )
    parser.add_argument(
        "--co-change", action="store_true",
        help="Run the co-change scan (default if no mode flag is passed).",
    )
    parser.add_argument(
        "--tracker-refs", action="store_true",
        help="Cross-reference tracker IDs in docstrings against tracker status.",
    )
    parser.add_argument(
        "--phase-markers", action="store_true",
        help="Grep for phase / pending markers in docstrings + comments.",
    )
    parser.add_argument(
        "--all", action="store_true",
        help="Run all three sub-checks.",
    )
    parser.add_argument(
        "--window", type=int, default=DEFAULT_BODY_AGE_DAYS,
        help=f"Body-age window in days for co-change "
        f"(default: {DEFAULT_BODY_AGE_DAYS}).",
    )
    parser.add_argument(
        "--min-delta", type=int, default=DEFAULT_MIN_DELTA_DAYS,
        help=f"Minimum delta in days to flag for co-change "
        f"(default: {DEFAULT_MIN_DELTA_DAYS}).",
    )
    parser.add_argument(
        "--min-body-commits", type=int, default=DEFAULT_MIN_BODY_COMMITS,
        help=f"Flag when at least this many commits have touched the body "
        f"since the docstring was last touched. Clock-independent, unlike "
        f"--min-delta (default: {DEFAULT_MIN_BODY_COMMITS}).",
    )
    parser.add_argument(
        "--top", type=int, default=30,
        help="Show top-N rows by delta in addition to the flagged set "
        "(default: 30; 0 disables).",
    )
    parser.add_argument(
        "--json", action="store_true",
        help="Emit a machine-readable JSON report instead of text.",
    )
    args = parser.parse_args()

    # If no mode flag, default to --co-change.
    if not (args.co_change or args.tracker_refs or args.phase_markers or args.all):
        args.co_change = True
    if args.all:
        args.co_change = True
        args.tracker_refs = True
        args.phase_markers = True

    repo_root = _repo_root()
    scope: tuple[str, ...]
    if args.paths:
        scope = tuple(args.paths)
    else:
        scope = tuple(os.path.join(repo_root, p) for p in DEFAULT_SCOPE)

    report: dict = {}
    exit_code = 0

    if args.co_change:
        report["co_change"] = co_change_scan(
            scope,
            window_days=args.window,
            min_delta_days=args.min_delta,
            min_body_commits=args.min_body_commits,
        )
        cc = report["co_change"]
        if cc["flagged"] or cc["pinned"]:
            exit_code = 1

    if args.tracker_refs:
        hits = extract_tracker_ids(scope)
        report["tracker_refs"] = cross_reference_tracker(hits, repo_root)
        if report["tracker_refs"]:
            exit_code = 1

    if args.phase_markers:
        report["phase_markers"] = phase_marker_grep(scope)
        if report["phase_markers"]:
            # Don't fail solely on phase markers — too noisy.
            pass

    if args.json:
        print(json.dumps(report, indent=2, default=str))
        return exit_code

    sections = []
    if args.co_change:
        sections.append(format_co_change_text(report["co_change"], args.top))
    if args.tracker_refs:
        sections.append(format_tracker_text(report["tracker_refs"]))
    if args.phase_markers:
        sections.append(format_phase_marker_text(report["phase_markers"]))
    print("\n\n".join(sections))
    return exit_code


if __name__ == "__main__":
    sys.exit(main())

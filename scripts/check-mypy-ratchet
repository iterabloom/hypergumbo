#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Whole-tree mypy strict ratchet (WI-rokup, Decision D13, INV-zogud).

INV-zogud's clean-state target is ``mypy <repo>`` under the strict +
pyright-resonant config in ``[tool.mypy]`` producing zero errors. This
script measures that surface and ratchets it shrink-only against a
committed baseline in ``.ci/mypy-strict-baseline.json``.

Why a single WHOLE-TREE invocation, not the per-package loop the CI job
used before: mypy run per-package (``mypy packages/X/src/X``) cannot
follow imports into a sibling package — the editable install is
mypy-invisible — so it resolves every cross-package symbol to ``Any``.
That both INVENTS phantom errors (e.g. ``untyped-decorator`` on every
analyzer, because the ``@register_analyzer`` it imports reads as ``Any``)
and HIDES real ones (``arg-type`` mismatches whose callee lives in another
package). Passing every ``packages/*/src/<pkg>`` root in one invocation
lets cross-package imports resolve to real types — which is what
INV-zogud's ``mypy <repo>`` means. htrac-frontend (JS/TS, no Python src)
is excluded, matching ``[tool.mypy] exclude``.

The baseline records the total and a per-error-code breakdown. The ratchet
is shrink-only: it fails if the total grows, if any error code's count
grows, or if a NEW error code appears. It never requires a code to shrink
(that is the incremental grind the ramp performs), only that it not grow.

Modes:

* ``--mode=warning`` (default) — report current vs baseline and any
  regression to stderr, but exit 0 regardless. This is the non-blocking
  rung the CI mypy job uses today.
* ``--mode=strict`` — exit 1 on any regression (total up, a code up, or a
  new code). WI-rabum flips the CI job to this once the surface is drained
  enough to gate merges.
* ``--update-baseline`` — overwrite the baseline with the current run.
  Use after a PR intentionally reduces the surface (lowering the numbers)
  or after an owner-approved config change to the enabled error codes.

Test/override flags:

* ``--input FILE`` — read raw mypy output from FILE instead of running
  mypy (so the ratchet logic is testable without a real type-check run).
* ``--baseline FILE`` — use FILE as the baseline instead of the default
  ``.ci/mypy-strict-baseline.json``.

Exit codes:
    0 — no regression (or ``--mode=warning``, or ``--update-baseline``).
    1 — a regression, in ``--mode=strict``.
    2 — infrastructure error (mypy missing, no source roots found, or the
        output could not be reconciled with mypy's own tally — see below).
        Never blocks: an infra failure is not a type regression.

FAIL-OPEN INCIDENT, 2026-08-05 — why the parse is reconciled against mypy's
own tally line. With ``FORCE_COLOR`` in the environment (agent harnesses set
it), mypy colorizes stdout even when it is a pipe; the trailing ``[code]``
anchor then matches nothing, and this script reported ``whole-tree strict
errors = 0 (baseline 672, delta -672)`` with exit 0 — a fail-OPEN that also
*recommended* ``--update-baseline``, which would have written total 0 and
permanently disabled INV-zogud's only gate. Three defences now stack:

* ``_run_mypy`` passes ``--no-color-output`` and scrubs the colour-forcing
  env vars, so the live path cannot produce colour in the first place;
* ANSI escapes are stripped before parsing, so colorized input (e.g. an
  ``--input`` capture from a colour terminal) is READ rather than refused;
* default-deny reconciliation (the structural fix): a verdict is rendered
  only when the parsed count agrees with mypy's own ``Found N errors``
  tally, or a ``Success`` line accompanies a parsed count of zero.
  Everything else — truncated output, a crashed run's empty stdout, a
  format change that defeats the regex — exits 2. A parse the tally cannot
  vouch for is a broken instrument, and a broken instrument must never
  report progress (the failure read as a 672-error SHRINK, which is the
  most seductive possible lie a shrink-only gate can tell).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess  # nosec B404 - runs mypy on our own source tree, no untrusted input
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_BASELINE_PATH = REPO_ROOT / ".ci" / "mypy-strict-baseline.json"

# ``error: ... [code]`` — the trailing bracketed code is the category.
_ERROR_RE = re.compile(r": error: .*\[([a-z-]+)\]\s*$")

# SGR sequences (``ESC [ ... m`` and friends) plus the ``ESC ( B`` charset
# reset mypy emits after each styled token. Stripped before parsing so a
# colorized capture is readable; the live path additionally forbids colour
# at the source (see ``_run_mypy``).
_ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]|\x1b\([0-9A-Za-z]")

# mypy's own closing tally. Singular and plural both occur.
_TALLY_RE = re.compile(r"^Found (\d+) errors? in ", re.MULTILINE)
_SUCCESS_RE = re.compile(r"^Success: no issues found", re.MULTILINE)

# Env vars that force colour onto a non-tty pipe. FORCE_COLOR is the one
# that bit (agent harnesses export it); the others are its relatives.
_COLOR_FORCING_ENV = ("FORCE_COLOR", "MYPY_FORCE_COLOR", "CLICOLOR_FORCE")


def _source_roots() -> list[Path]:
    """Every ``packages/*/src/<pkg>`` directory except htrac-frontend / eggs."""
    roots: list[Path] = []
    for pkg_src in sorted(REPO_ROOT.glob("packages/*/src/*/")):
        parts = str(pkg_src)
        if "htrac-frontend" in parts or ".egg-info" in parts:
            continue
        if not pkg_src.is_dir():
            continue  # pragma: no cover — glob only yields dirs
        roots.append(pkg_src)
    return roots


def _run_mypy(roots: list[Path]) -> str:
    """Run whole-tree mypy and return its stdout.

    Colour is forbidden at the source: ``--no-color-output`` on the argv AND
    the colour-forcing env vars scrubbed from the child environment. Belt and
    braces deliberately — either alone suffices today, but the reconciliation
    gate downstream is what guarantees that any future colour route fails
    LOUD (exit 2) instead of open (a parsed 0 reported as a shrink).
    """
    cmd = [
        sys.executable, "-m", "mypy", "--no-color-output",
        *[str(r) for r in roots],
    ]
    env = {k: v for k, v in os.environ.items() if k not in _COLOR_FORCING_ENV}
    try:
        # nosec B603 - fixed argv (python -m mypy on our own source roots), no shell.
        proc = subprocess.run(  # noqa: S603
            cmd, capture_output=True, text=True, cwd=REPO_ROOT, env=env
        )
    except FileNotFoundError:  # pragma: no cover — mypy absent in the env
        print("check-mypy-ratchet: mypy is not installed", file=sys.stderr)
        sys.exit(2)
    return proc.stdout


def _require_reconciled_tally(text: str, counted: int) -> None:
    """Refuse to render a verdict the output itself cannot vouch for.

    Default-deny (L54): enumerate the two readable shapes and exit 2 on
    everything else. The permitted cases are exactly:

    * a ``Found N errors`` tally whose N equals the parsed count, or
    * a ``Success: no issues found`` line with a parsed count of zero.

    Everything else — empty stdout from a crashed run, truncated output, a
    format or colour change that defeats ``_ERROR_RE``, a Success line
    contradicting parsed errors — is an INSTRUMENT failure, not a surface
    reading. It must never be compared against the baseline in either
    direction: reading it as growth would block on nothing, and reading it
    as a shrink (the 2026-08-05 incident) invites ``--update-baseline`` to
    disable the gate permanently.
    """
    tally = _TALLY_RE.search(text)
    if tally:
        declared = int(tally.group(1))
        if declared == counted:
            return
        print(
            f"check-mypy-ratchet: PARSE FAILURE — mypy's own tally says "
            f"{declared} error(s) but the parser counted {counted}. The "
            f"instrument is broken (output format change? partial ANSI?); "
            f"refusing to render a verdict from it.",
            file=sys.stderr,
        )
        sys.exit(2)
    if _SUCCESS_RE.search(text):
        if counted == 0:
            return
        print(
            "check-mypy-ratchet: PARSE FAILURE — output carries a Success "
            f"line AND {counted} parsed error(s); refusing to pick a side.",
            file=sys.stderr,
        )
        sys.exit(2)
    print(
        "check-mypy-ratchet: PARSE FAILURE — output has neither a "
        "'Found N errors' tally nor a 'Success' line (empty stdout from a "
        "crashed run? truncated capture?); refusing to read it as a surface "
        f"of {counted}.",
        file=sys.stderr,
    )
    sys.exit(2)


def _count_errors(text: str) -> Counter[str]:
    """Count mypy errors per trailing bracketed ``[code]``."""
    counts: Counter[str] = Counter()
    for line in text.splitlines():
        m = _ERROR_RE.search(line)
        if m:
            counts[m.group(1)] += 1
    return counts


def _mypy_version() -> str | None:
    """Version of the mypy that produces (or produced) these counts.

    WI-rabum: the instrument is part of the measurement. A shrink-only
    baseline is only meaningful against a FIXED mypy — a categorisation change
    between releases moves counts with no code change at all, and the ratchet
    would render that as several unrelated error codes "growing", which is
    both wrong and the most confusing possible way to fail.

    Returns None when mypy is not importable, in which case the version is
    neither recorded nor checked. That is a real degradation and is reported
    rather than silently tolerated, but it does not break a run that would
    otherwise work.
    """
    try:
        import mypy.version
    except ImportError:  # pragma: no cover - mypy is a hard dev dependency
        return None
    return str(mypy.version.__version__)


def _load_baseline(path: Path) -> dict:
    if not path.exists():
        print(
            f"check-mypy-ratchet: no baseline at {path} — run --update-baseline first",
            file=sys.stderr,
        )
        sys.exit(2)
    try:
        return json.loads(path.read_text())
    except ValueError as exc:
        print(f"check-mypy-ratchet: baseline invalid: {exc}", file=sys.stderr)
        sys.exit(2)


def _save_baseline(path: Path, counts: Counter[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    body = {
        "_comment": (
            "Whole-tree `mypy <repo>` strict surface, shrink-only ratchet "
            "(WI-rokup / INV-zogud). Regenerate with "
            "`scripts/check-mypy-ratchet --update-baseline`. The ramp lowers "
            "these numbers; they must never grow (see check-mypy-ratchet). "
            "`mypy_version` records the instrument these counts were measured "
            "with — comparing them against a different mypy is not a ratchet "
            "reading, so a mismatch is reported and blocks in --mode=strict."
        ),
        "total": sum(counts.values()),
        "by_code": dict(sorted(counts.items())),
    }
    version = _mypy_version()
    if version is not None:
        body["mypy_version"] = version
    else:  # pragma: no cover - mypy is a hard dev dependency
        print(
            "check-mypy-ratchet: mypy not importable — baseline written WITHOUT "
            "a version; the instrument check is disabled for it.",
            file=sys.stderr,
        )
    path.write_text(json.dumps(body, indent=2) + "\n")


def main() -> None:
    parser = argparse.ArgumentParser(description="Whole-tree mypy strict ratchet.")
    parser.add_argument(
        "--mode",
        choices=("warning", "strict"),
        default="warning",
        help="warning (report, exit 0) or strict (exit 1 on regression).",
    )
    parser.add_argument(
        "--update-baseline",
        action="store_true",
        help="Overwrite the baseline with the current run and exit 0.",
    )
    parser.add_argument(
        "--input",
        type=Path,
        default=None,
        help="Read raw mypy output from FILE instead of running mypy (testing).",
    )
    parser.add_argument(
        "--baseline",
        type=Path,
        default=DEFAULT_BASELINE_PATH,
        help="Baseline file to read/write (default .ci/mypy-strict-baseline.json).",
    )
    args = parser.parse_args()

    if args.input is not None:
        raw = args.input.read_text()
    else:
        roots = _source_roots()
        if not roots:  # pragma: no cover — packaging breakage only
            print("check-mypy-ratchet: no packages/*/src roots found", file=sys.stderr)
            sys.exit(2)
        raw = _run_mypy(roots)

    # Strip ANSI first so a colorized capture is READ; then refuse any
    # output the parse cannot reconcile with mypy's own tally. The
    # reconciliation runs before --update-baseline on purpose: the incident's
    # sharpest edge was that unparseable output did not just misreport, it
    # recommended baselining the misreading.
    raw = _ANSI_RE.sub("", raw)
    current = _count_errors(raw)
    cur_total = sum(current.values())
    _require_reconciled_tally(raw, cur_total)

    if args.update_baseline:
        _save_baseline(args.baseline, current)
        print(f"check-mypy-ratchet: baseline updated — total {cur_total}")
        sys.exit(0)

    baseline = _load_baseline(args.baseline)
    base_total = int(baseline.get("total", 0))
    base_by_code: dict[str, int] = dict(baseline.get("by_code", {}))

    # WI-rabum: the instrument check, BEFORE any count comparison. A baseline
    # written by a different mypy cannot be compared against this run — a
    # release that recategorises errors moves the numbers with no code change,
    # so both "regression" and "shrink" verdicts would be fabrications. Note
    # this blocks even when the counts went DOWN: a shrink measured by a
    # different instrument is not evidence of progress, and banking it as one
    # would ratify tooling drift as a drain (the shrink-only baseline may only
    # ratchet down for REASONS, not by accident).
    base_version = baseline.get("mypy_version")
    live_version = _mypy_version()
    if base_version and live_version and base_version != live_version:
        print(
            "check-mypy-ratchet: INSTRUMENT MISMATCH — baseline was measured "
            f"with mypy {base_version}, this run uses mypy {live_version}. "
            "The counts are not comparable. Re-measure with "
            "`scripts/check-mypy-ratchet --update-baseline` in the same change "
            "that bumps mypy, so the delta you read afterwards is code and not "
            "tooling.",
            file=sys.stderr,
        )
        if args.mode == "strict":
            sys.exit(1)
        print(
            "check-mypy-ratchet: mode=warning — not blocking on the mismatch, "
            "but the numbers below mean nothing until the baseline is remeasured.",
            file=sys.stderr,
        )

    grown = {
        code: (n, base_by_code.get(code, 0))
        for code, n in current.items()
        if n > base_by_code.get(code, 0)
    }

    print(
        f"check-mypy-ratchet: whole-tree strict errors = {cur_total} "
        f"(baseline {base_total}, delta {cur_total - base_total:+d})"
    )
    if cur_total < base_total and not grown:
        print(
            "check-mypy-ratchet: surface shrank — run --update-baseline to "
            "lock in the progress."
        )

    if grown:
        print("check-mypy-ratchet: REGRESSION — these codes grew:", file=sys.stderr)
        for code, (now, was) in sorted(grown.items()):
            new = " (new code)" if was == 0 else ""
            print(f"  {code}: {was} -> {now}{new}", file=sys.stderr)
        if args.mode == "strict":
            sys.exit(1)
        print(
            "check-mypy-ratchet: mode=warning — not blocking (WI-rabum flips "
            "this to --mode=strict).",
            file=sys.stderr,
        )
    sys.exit(0)


if __name__ == "__main__":
    main()

#!/bin/bash
# smart-test: Run only tests affected by changed files
#
# Uses hypergumbo's reverse slice to find tests that depend on changed files.
# Generates a manifest at .ci/affected-tests.txt for CI validation.
#
# Falls back to full test suite when:
#   - No stable hypergumbo installed
#   - Core infrastructure files changed (sketch.py, slice.py, etc.)
#   - No changes detected (runs all tests as sanity check)
#
# Usage:
#   ./scripts/smart-test              # Run affected tests, generate manifest
#   ./scripts/smart-test --full       # Run all tests
#   ./scripts/smart-test --verbose    # Show selection reasoning
#   ./scripts/smart-test --manifest   # Generate manifest only (no test run)
#   ./scripts/smart-test --background # Kick off full suite in background

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# Signal that we're running through smart-test (ADR-0010)
# This prevents infinite recursion when the pytest wrapper calls smart-test
# and smart-test subsequently calls pytest.
export SMART_TEST_ACTIVE=1

# Manifest location (committed with PR for CI validation)
MANIFEST_DIR=".ci"
MANIFEST_FILE="$MANIFEST_DIR/affected-tests.txt"

# Parse args
FULL_RUN=false
VERBOSE=false
MANIFEST_ONLY=false
BACKGROUND=false
PYTEST_ARGS=()

for arg in "$@"; do
    case $arg in
        --full) FULL_RUN=true ;;
        --verbose) VERBOSE=true ;;
        --manifest) MANIFEST_ONLY=true ;;
        --background) BACKGROUND=true ;;
        -*) PYTEST_ARGS+=("$arg") ;;
        *) PYTEST_ARGS+=("$arg") ;;
    esac
done

# Files that trigger full test suite when changed
# These are core infrastructure that affects test selection itself
CORE_INFRA_FILES=(
    "packages/hypergumbo-core/src/hypergumbo_core/sketch.py"
    "packages/hypergumbo-core/src/hypergumbo_core/slice.py"
    "packages/hypergumbo-core/src/hypergumbo_core/cli.py"
    "packages/hypergumbo-core/src/hypergumbo_core/ir.py"
    "packages/hypergumbo-core/src/hypergumbo_core/analyze/all_analyzers.py"
    "packages/hypergumbo-core/src/hypergumbo_core/analyze/base.py"
    "packages/hypergumbo-core/src/hypergumbo_core/linkers/registry.py"
)

# Coverage paths for the modular package structure
COV_PATHS=(
    "--cov=packages/hypergumbo-core/src"
    "--cov=packages/hypergumbo-lang-mainstream/src"
    "--cov=packages/hypergumbo-lang-common/src"
    "--cov=packages/hypergumbo-lang-extended1/src"
)

log() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo "[smart-test] $*" >&2
    fi
}

run_full_suite() {
    local reason="${1:-}"
    if [[ -n "$reason" ]]; then
        log "Running full test suite: $reason"
    fi

    # Write manifest indicating full suite
    mkdir -p "$MANIFEST_DIR"
    echo "# Full test suite required: $reason" > "$MANIFEST_FILE"
    echo "# Generated by smart-test at $(date -Iseconds)" >> "$MANIFEST_FILE"
    find packages/*/tests -name 'test_*.py' -type f | sort >> "$MANIFEST_FILE"

    if [[ "$MANIFEST_ONLY" == "true" ]]; then
        echo "Manifest written to $MANIFEST_FILE (full suite)"
        exit 0
    fi

    exec pytest packages/*/tests/ -n 2 "${COV_PATHS[@]}" "${PYTEST_ARGS[@]}"
}

kick_off_background_suite() {
    LOCK=".git/FULL_SUITE_RUNNING"
    if [[ -f "$LOCK" ]]; then
        log "Full suite already running (lock file exists), skipping"
        return 0
    fi

    echo $$ > "$LOCK"
    log "Starting full suite in background..."

    (
        pytest packages/*/tests/ -n 2 "${COV_PATHS[@]}" --cov-fail-under=100 > .ci/full-suite.log 2>&1
        STATUS=$?
        rm -f "$LOCK"
        if [[ $STATUS -ne 0 ]]; then
            echo "[smart-test] Background full suite FAILED - check .ci/full-suite.log" >&2
            # Could add notification here (notify-send, etc.)
        else
            echo "[smart-test] Background full suite passed" >&2
        fi
    ) &

    echo "Full suite started in background (PID: $!)"
}

# Handle --background flag
if [[ "$BACKGROUND" == "true" ]]; then
    kick_off_background_suite
    exit 0
fi

# Handle --full flag
if [[ "$FULL_RUN" == "true" ]]; then
    run_full_suite "explicit --full flag"
fi

# Check for stable hypergumbo installation
# IMPORTANT: Use stable release, not the version under test (bootstrap safety)
STABLE_HG=""
if [[ -x "$HOME/.local/bin/hypergumbo" ]]; then
    STABLE_HG="$HOME/.local/bin/hypergumbo"
elif command -v hypergumbo &> /dev/null; then
    # Check it's not the dev version
    HG_PATH=$(command -v hypergumbo)
    if [[ "$HG_PATH" != *".venv"* ]]; then
        STABLE_HG="$HG_PATH"
    fi
fi

if [[ -z "$STABLE_HG" ]]; then
    run_full_suite "no stable hypergumbo found (install with: pipx install hypergumbo)"
fi

log "Using stable hypergumbo: $STABLE_HG"

# Get changed files since merge-base with dev
BASE_BRANCH="${BASE_BRANCH:-origin/dev}"
MERGE_BASE=$(git merge-base HEAD "$BASE_BRANCH" 2>/dev/null || echo "HEAD~1")
CHANGED_FILES=$(git diff --name-only "$MERGE_BASE"..HEAD 2>/dev/null || echo "")

if [[ -z "$CHANGED_FILES" ]]; then
    run_full_suite "no changed files detected"
fi

log "Changed files since $MERGE_BASE:"
if [[ "$VERBOSE" == "true" ]]; then
    echo "$CHANGED_FILES" | sed 's/^/  /' >&2
fi

# Check if any core infra files changed
for core_file in "${CORE_INFRA_FILES[@]}"; do
    if echo "$CHANGED_FILES" | grep -qF "$core_file"; then
        run_full_suite "core infrastructure changed: $core_file"
    fi
done

# Write changed files to temp file for slice query
CHANGED_FILE_LIST=$(mktemp)
echo "$CHANGED_FILES" > "$CHANGED_FILE_LIST"
trap "rm -f $CHANGED_FILE_LIST" EXIT

# Use hypergumbo slice --files to find dependent files
log "Running reverse slice to find affected files..."
SLICE_OUTPUT=$(mktemp)
trap "rm -f $CHANGED_FILE_LIST $SLICE_OUTPUT" EXIT

if ! $STABLE_HG slice --files "$CHANGED_FILE_LIST" --output "$SLICE_OUTPUT" 2>/dev/null; then
    run_full_suite "slice command failed"
fi

# Filter to only test files in package directories
AFFECTED_TESTS=$(grep -E 'packages/.*/tests/test_.*\.py$' "$SLICE_OUTPUT" 2>/dev/null | sort -u || echo "")

if [[ -z "$AFFECTED_TESTS" ]]; then
    run_full_suite "no test files in slice result"
fi

# Count affected tests
TEST_COUNT=$(echo "$AFFECTED_TESTS" | wc -l)
log "Found $TEST_COUNT affected test files"

if [[ "$VERBOSE" == "true" ]]; then
    echo "$AFFECTED_TESTS" | sed 's/^/  /' >&2
fi

# Write manifest
mkdir -p "$MANIFEST_DIR"
{
    echo "# Affected tests manifest"
    echo "# Generated by smart-test at $(date -Iseconds)"
    echo "# Base: $MERGE_BASE"
    echo "# Changed files: $(echo "$CHANGED_FILES" | wc -l)"
    echo "# Affected tests: $TEST_COUNT"
    echo "#"
    echo "$AFFECTED_TESTS"
} > "$MANIFEST_FILE"

log "Manifest written to $MANIFEST_FILE"

if [[ "$MANIFEST_ONLY" == "true" ]]; then
    echo "Manifest written to $MANIFEST_FILE ($TEST_COUNT test files)"
    cat "$MANIFEST_FILE"
    exit 0
fi

# Run only affected tests
echo "Running $TEST_COUNT affected test files (use --full for complete suite)"
# shellcheck disable=SC2086
exec pytest $AFFECTED_TESTS "${COV_PATHS[@]}" "${PYTEST_ARGS[@]}"

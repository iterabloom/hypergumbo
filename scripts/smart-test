#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# smart-test: Run only tests affected by changed files
#
# Uses hypergumbo's reverse slice to find tests that depend on changed files.
# Generates a manifest at .ci/affected-tests.txt for CI validation.
#
# COVERAGE SCOPING:
# - Affected-only mode: Measures coverage for ONLY changed source files
# - Full mode: Measures coverage for ALL source files across all packages
#
# BASELINE:
# - Uses "last-green-sha" marker from badges branch (last CI run at 100%)
# - Falls back to merge-base with dev if marker unavailable
#
# Falls back to full test suite when:
#   - No stable hypergumbo installed
#   - Core infrastructure files changed (sketch.py, slice.py, etc.)
#   - No changes detected (runs all tests as sanity check)
#
# OUTPUT: By default, shows only a compact summary (test result + coverage gaps).
# Full pytest output is saved to .ci/pytest-output.log for debugging.
#
# Usage:
#   ./scripts/smart-test              # Run affected tests, show compact summary
#   ./scripts/smart-test --full       # Run all tests
#   ./scripts/smart-test --raw        # Stream full pytest output (no summary)
#   ./scripts/smart-test --verbose    # Show selection reasoning
#   ./scripts/smart-test --manifest   # Generate manifest only (no test run)
#   ./scripts/smart-test --background # Kick off full suite in background

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# ── Flock guard: prevent concurrent smart-test invocations ──
# Two parallel pytest -n auto runs consume all CPU cores and may flake xdist.
# Uses OS-managed file-descriptor lock — auto-released if process crashes.
LOCKFILE=".ci/.smart-test.lock"
mkdir -p .ci
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    holder=$(cat "$LOCKFILE.pid" 2>/dev/null || echo "unknown")
    echo "ERROR: Another smart-test is already running (PID $holder)." >&2
    echo "Refusing to start a second instance — two parallel pytest -n auto" >&2
    echo "runs consume all CPU cores and may flake xdist." >&2
    echo "" >&2
    echo "Either:" >&2
    echo "  1. Wait for the notification from the first run, OR" >&2
    echo "  2. kill $holder to abort it first, then re-run smart-test." >&2
    exit 1
fi
echo $$ > "$LOCKFILE.pid"
_cleanup_lock() { rm -f "$LOCKFILE.pid"; }
trap _cleanup_lock EXIT

# Signal that we're running through smart-test (ADR-0010)
# This prevents infinite recursion when the pytest wrapper calls smart-test
# and smart-test subsequently calls pytest.
export SMART_TEST_ACTIVE=1

# Manifest location (committed with PR for CI validation)
MANIFEST_DIR=".ci"
MANIFEST_FILE="$MANIFEST_DIR/affected-tests.txt"

# Parse args
FULL_RUN=false
VERBOSE=false
MANIFEST_ONLY=false
BACKGROUND=false
RAW_OUTPUT=false
PYTEST_ARGS=()
HAS_EXPLICIT_TESTS=false

# Smart-test mode tracking (used by summarize_pytest_output)
# Coverage-directed selection runs in SHADOW by default: it reports what it
# would have chosen and changes nothing. Opt out with --no-select-shadow.
SELECT_SHADOW=true

# PHASE 2 (WI-kuliv): the same selection is also UNIONED into the local run set.
# Kept as a separate switch from the shadow because they answer different
# questions and fail differently. Shadow is evidence and must keep accruing even
# when the union is off; the union acts, so it is the one worth being able to
# disable in isolation when a run looks wrong. Opt out with --no-select-union.
SELECT_UNION=true

# PHASE 3 (WI-bolot): NARROWING, and the default is the opposite of the other
# two for a reason. Phase 2 can only add tests, so its worst case is wasted
# time; narrowing REMOVES them, and between full runs the index can be short a
# test that covers part of a changed file. Opt in per run with --narrow.
SELECT_NARROW=false

# LOCAL ONLY — NEVER IN CI. Three independent reasons, any one sufficient:
#
#   1. CI IS THE GATE. This selector is an accelerator whose whole safety story
#      is "it can only add tests, and something else runs everything anyway".
#      That story collapses the moment it has any influence on the gate.
#   2. THE INDEX IS LOCAL STATE. It lives out-of-repo in ~/hypergumbo_lab_notebook
#      alongside test_timings.json, so in CI it would be COLD on every run:
#      nothing selected, every test that ran counted as a miss. Those phantom
#      misses go into the Phase 1 evidence, whose exit criterion COUNTS misses.
#      CI would silently manufacture the failure signal we are trying to measure.
#   3. IT COSTS REAL TIME. The post-run update re-hashes every measured file to
#      fold contexts in — pointless work on a machine that discards the result.
#
# As of 2026-08-14 this guard is defense in depth rather than load-bearing: no
# Woodpecker step invokes scripts/smart-test (CI drives pytest directly from the
# committed .ci/affected-tests.txt manifest with SMART_TEST_ACTIVE=1), and CI
# builds its own COV_PATHS without --cov-context. Both are accidents of the
# current CI design, and a future rewiring would activate this silently. Hence
# an explicit guard rather than a comment saying it cannot happen.
#
# The union (Phase 2) is off in CI for reason 1 and reason 2 above, and reason 1
# applies to it MORE strongly than to the shadow: the shadow only reports, while
# the union changes what runs. A cold index in CI would simply add nothing, so
# the failure would be silent rather than loud — which is precisely why it is
# guarded rather than left to work out harmlessly.
#
# HG_SELECT_SHADOW=1 forces it on, for deliberately exercising the wiring.
if [[ -n "${CI:-}" ]] && [[ "${HG_SELECT_SHADOW:-}" != "1" ]]; then
    SELECT_SHADOW=false
    SELECT_UNION=false
fi

SMART_TEST_MODE="full"
TARGETED_TEST_COUNT=0
TARGETED_SOURCE_COUNT=0

for arg in "$@"; do
    case $arg in
        --full) FULL_RUN=true ;;
        --no-select-shadow) SELECT_SHADOW=false ;;
        --no-select-union) SELECT_UNION=false ;;
        --narrow) SELECT_NARROW=true ;;
        --verbose) VERBOSE=true ;;
        --manifest) MANIFEST_ONLY=true ;;
        --background) BACKGROUND=true ;;
        --raw) RAW_OUTPUT=true ;;

        -*) PYTEST_ARGS+=("$arg") ;;
        *)
            PYTEST_ARGS+=("$arg")
            # Detect explicit test targets (paths containing .py or tests/)
            if [[ "$arg" == *.py* ]] || [[ "$arg" == *tests/* ]]; then
                HAS_EXPLICIT_TESTS=true
            fi
            ;;
    esac
done

# NARROWING IS OFF IN CI UNCONDITIONALLY, and this guard sits AFTER argument
# parsing on purpose — the shadow/union guards run before it and can be placed
# earlier because no flag turns those ON. `--narrow` does, so a guard above the
# parse loop would be overridden by the flag it exists to override. Not even
# HG_SELECT_SHADOW re-enables this: reason 1 above (CI IS THE GATE) is absolute
# for an operation that REMOVES tests, and that escape hatch exists to exercise
# wiring, not to let a selector shrink the merge gate.
if [[ -n "${CI:-}" ]]; then
    SELECT_NARROW=false
fi

# Auto-add -n auto for parallel execution unless:
# 1. Already specified (-n is in PYTEST_ARGS)
# 2. Running inside a container (where CPU detection may be unreliable)
is_in_container() {
    [[ -f /.dockerenv ]] || [[ -f /run/.containerenv ]] || grep -qE '(docker|lxc|containerd)' /proc/1/cgroup 2>/dev/null
}

HAS_N_FLAG=false
for arg in "${PYTEST_ARGS[@]}"; do
    if [[ "$arg" == "-n" ]] || [[ "$arg" == -n* ]]; then
        HAS_N_FLAG=true
        break
    fi
done

if [[ "$HAS_N_FLAG" == "false" ]] && ! is_in_container; then
    # Memory-aware parallelism: each pytest worker can use ~2 GB during
    # analysis-heavy tests.  Cap workers so total doesn't exceed available
    # memory minus 2 GB headroom for OS/other processes.
    NCPU=$(nproc 2>/dev/null || echo 4)
    AVAIL_MB=999999
    if [[ -f /proc/meminfo ]]; then
        AVAIL_MB=$(awk '/^MemAvailable:/ { printf "%d", $2/1024 }' /proc/meminfo)
    fi
    HEADROOM_MB=2048
    PER_WORKER_MB=2048
    MAX_WORKERS=$(( (AVAIL_MB - HEADROOM_MB) / PER_WORKER_MB ))
    # Clamp to [1, NCPU]
    [[ $MAX_WORKERS -lt 1 ]] && MAX_WORKERS=1
    [[ $MAX_WORKERS -gt $NCPU ]] && MAX_WORKERS=$NCPU

    if [[ $MAX_WORKERS -lt $NCPU ]]; then
        [[ "$VERBOSE" == "true" ]] && echo "[smart-test] Memory-aware: capping workers to $MAX_WORKERS (${AVAIL_MB} MB available, ${NCPU} CPUs)" >&2
        PYTEST_ARGS+=("-n" "$MAX_WORKERS")
    else
        [[ "$VERBOSE" == "true" ]] && echo "[smart-test] Auto-adding -n auto for parallel execution (not in container)" >&2
        PYTEST_ARGS+=("-n" "auto")
    fi
fi

# ── Gate 0: the mypy strict ratchet, BEFORE anything else ──
#
# WHY THIS IS FIRST, AND WHY IT REFUSES TO RUN TESTS.
#
# INV-zogud's ratchet is shrink-only: an error code may fall and may never
# grow. It was described in AGENTS.md and in the Wave-5 notebooks as
# "BLOCKING", and on the pipeline that actually gates merges it was not —
# .woodpecker ran it at --mode=warning, which reports and exits 0. Nothing ran
# it locally at all: not .githooks/pre-commit, not pre-push, not auto-pr, not
# the documented pre-commit checklist. So the only signal an agent ever got
# about growing the strict surface was one it had to go looking for.
#
# The measured cost of that: dev drifted 672 -> 682 across sixty commits
# touching 24 source files, and one of the ten new errors reported a LIVE
# isinstance guard as "always true" — draining it the obvious way would have
# deleted a guard whose own comment three lines up explains why it exists.
# That is the same shape that once took the whole-tree ratchet to a CLEAN
# 832 -> 789 on a rewrite deleting 43 live guards.
#
# Hence: run it first, and on a regression do NOT run pytest. Testing a tree
# whose type contracts have already regressed produces a green result that
# means less than it appears to, and "I will fix mypy after the tests pass"
# is how a two-line drift becomes a ten-error one.
#
# EXIT-CODE POLICY follows check-mypy-ratchet's own documented contract:
#   1 — regression, or an instrument mismatch (the baseline was measured with
#       a different mypy, so the counts are not comparable and the gate cannot
#       do its job). BLOCKS.
#   2 — infrastructure error (mypy missing, no source roots). WARNS and
#       continues: "an infra failure is not a type regression".
#
# HG_SKIP_MYPY_GATE exists for the ratchet's OWN test suite, which must be
# able to run without recursion. It is not a workaround for a red ratchet.
if [[ "${HG_SKIP_MYPY_GATE:-}" != "1" ]]; then
    echo "Checking mypy strict ratchet (INV-zogud) before running tests..."
    MYPY_GATE_LOG="$REPO_ROOT/.ci/mypy-gate.log"
    mkdir -p "$REPO_ROOT/.ci" 2>/dev/null || true
    set +e
    "$REPO_ROOT/scripts/check-mypy-ratchet" --mode=strict > "$MYPY_GATE_LOG" 2>&1
    MYPY_GATE_RC=$?
    set -e
    if [[ $MYPY_GATE_RC -eq 1 ]]; then
        cat "$MYPY_GATE_LOG" >&2
        cat >&2 <<'MYPYBLOCK'

════════════════════════════════════════════════════════════════════════
  MYPY RATCHET VIOLATED — pytest was NOT run, and MUST NOT be run.
════════════════════════════════════════════════════════════════════════

  Fix the type regression above before running any tests.

  THIS APPLIES EVEN IF YOU DID NOT CAUSE IT.

  "Not my change" is not an exit. The ratchet is shrink-only, so whoever
  observes the breach owns it — and a breach that every agent in turn
  declines to own is precisely how ten errors accumulated across sixty
  commits with nothing stopping them. If you inherited this, you are the
  one who found it; fix it, and say so in your PR.

  Do NOT run `python -m pytest` or `pytest` directly to get around this
  gate. Do NOT set HG_SKIP_MYPY_GATE, which exists only so the ratchet's
  own tests can run without recursing.

  Diagnose:  ./scripts/check-mypy-ratchet          (per-code deltas)
             python3 -m mypy packages/*/src/*/     (the errors themselves)

  Do NOT "fix" this by raising .ci/mypy-strict-baseline.json. A shrink-only
  baseline may only ratchet DOWN; raising it to accept a breach ratifies
  the drift and destroys the only record of what the surface used to be.

MYPYBLOCK
        exit 1
    elif [[ $MYPY_GATE_RC -eq 2 ]]; then
        echo "  ⚠ mypy ratchet could not run (infrastructure, exit 2) — continuing." >&2
        sed 's/^/    /' "$MYPY_GATE_LOG" >&2 || true
    else
        echo "  ✓ mypy ratchet clean"
    fi
fi

# Output file for full pytest log
PYTEST_LOG="$REPO_ROOT/.ci/pytest-output.log"

# Coverage paths for the modular package structure
COV_PATHS=(
    "--cov=packages/hypergumbo-core/src"
    "--cov=packages/hypergumbo-lang-mainstream/src"
    "--cov=packages/hypergumbo-lang-common/src"
    "--cov=packages/hypergumbo-lang-extended1/src"
    "--cov=packages/hypergumbo-lang-rust-analyzer/src"
)

# Detect if embedding dependencies are available
# If either sentence-transformers or onnxruntime is missing, use reduced
# coverage config that excludes embedding-dependent code
if python3 -c "import sentence_transformers" 2>/dev/null && \
   python3 -c "import onnxruntime" 2>/dev/null; then
    EMBEDDINGS_AVAILABLE=true
else
    EMBEDDINGS_AVAILABLE=false
    COV_PATHS+=("--cov-config=.coveragerc.no-embeddings")
fi

log() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo "[smart-test] $*" >&2
    fi
}

# WI-morud follow-up: write a self-contained diagnostic bundle when the
# slice path falls back to full-suite. Captures the data we lose on the
# happy path (slice command line, exit code, duration, stdout summary,
# stderr) so the next time fallback fires organically we can see what
# went wrong without having to repro. Overwrites each fallback (no ring
# buffer); intentional to keep the file path stable for grep / `cat`.
write_fallback_diagnostic() {
    local reason="$1"
    local slice_cmd="${2:-<not captured>}"
    local slice_exit="${3:-<not captured>}"
    local slice_duration_s="${4:-<not captured>}"
    local slice_stdout_path="${5:-}"
    local slice_stderr_path="${6:-}"
    local changed_files_path="${7:-}"
    local diag_file="$MANIFEST_DIR/smart-test-fallback.log"

    mkdir -p "$MANIFEST_DIR" 2>/dev/null || return 0
    {
        echo "# smart-test slice fallback diagnostic"
        echo "# timestamp: $(date -Iseconds 2>/dev/null || echo unknown)"
        echo "# reason: $reason"
        echo "# stable_hg_path: ${STABLE_HG:-<unset>}"
        if [[ -n "${STABLE_HG:-}" ]] && command -v "$STABLE_HG" >/dev/null 2>&1; then
            echo "# stable_hg_version: $($STABLE_HG --version 2>&1 | head -1)"
        else
            echo "# stable_hg_version: <not invokable>"
        fi
        echo "# slice_cmd: $slice_cmd"
        echo "# slice_exit_code: $slice_exit"
        echo "# slice_duration_s: $slice_duration_s"
        if [[ -n "$slice_stdout_path" && -f "$slice_stdout_path" ]]; then
            local stdout_lines
            stdout_lines=$(wc -l < "$slice_stdout_path" 2>/dev/null || echo "?")
            echo "# slice_stdout_lines: $stdout_lines"
        else
            echo "# slice_stdout_lines: <not captured>"
        fi
        echo ""
        echo "## changed_files"
        if [[ -n "$changed_files_path" && -f "$changed_files_path" ]]; then
            cat "$changed_files_path"
        else
            echo "<not captured>"
        fi
        echo ""
        echo "## slice_stdout (first 50 lines)"
        if [[ -n "$slice_stdout_path" && -f "$slice_stdout_path" ]]; then
            head -50 "$slice_stdout_path"
        else
            echo "<not captured>"
        fi
        echo ""
        echo "## slice_stderr (full)"
        if [[ -n "$slice_stderr_path" && -f "$slice_stderr_path" ]]; then
            cat "$slice_stderr_path"
        else
            echo "<not captured>"
        fi
    } > "$diag_file" 2>/dev/null || return 0

    echo "[smart-test] slice fallback — diagnostic: $diag_file" >&2
}

# Get baseline commit for comparison
# Tries to fetch last-green-sha from badges branch (last CI run at 100%)
# Falls back to merge-base with dev if unavailable
get_baseline() {
    local base_branch="${1:-origin/dev}"

    # WI-hajif: the failover-aware baseline (WI-tolil / INV-bifud) is retired
    # along with the self-hosted-Forgejo failover — origin is now the only
    # authoritative remote, so there is no second remote to re-anchor onto.

    # WI-kalub (Step 1a/1d): anchor the per-PR baseline on the MERGE-BASE with the
    # authoritative dev — i.e. the branch's OWN changes. We deliberately do NOT
    # consult the last-green-sha marker. It is routinely tens of commits stale
    # (its full-suite write side only fires on an all-packages-exactly-100% run,
    # and its codeberg push no-ops under failover), and anchoring on a stale
    # marker inflates the changed set with already-merged files whose full test
    # sets the affected slice does not select — the root cause of BOTH the
    # false-red scoped-coverage failures AND the ~whole-suite-every-PR runtime.
    # Branch-own files are guaranteed to be exercised by the affected slice;
    # whole-codebase coverage is enforced separately (full-suite --cov-fail-under
    # teeth + nightly), not by the per-PR scoped gate.
    local merge_base
    merge_base=$(git merge-base HEAD "$base_branch" 2>/dev/null || echo "HEAD~1")
    log "Baseline (branch-own, merge-base with $base_branch): $merge_base"
    echo "$merge_base"
}

# Build coverage paths for affected-only mode
# Returns --cov arguments for the package source directories containing changed files
# Also returns --cov-fail-under=100 since we're scoping to affected packages
build_affected_cov_paths() {
    local changed_files="$1"

    # Filter to source files only (not tests, not configs)
    local source_files
    source_files=$(echo "$changed_files" | grep -E '^packages/.*/src/.*\.py$' || echo "")

    if [[ -z "$source_files" ]]; then
        log "No source files in changes, using full coverage"
        echo "FULL"
        return
    fi

    # Extract unique package source directories (e.g., packages/hypergumbo-core/src)
    local pkg_dirs
    pkg_dirs=$(echo "$source_files" | sed 's|^\(packages/[^/]*/src\)/.*|\1|' | sort -u)

    local cov_paths=()
    local pkg_count=0
    while IFS= read -r pkg_dir; do
        [[ -z "$pkg_dir" ]] && continue
        cov_paths+=("--cov=$pkg_dir")
        ((pkg_count++))
    done <<< "$pkg_dirs"

    # Count actual changed source files for logging
    local file_count
    file_count=$(echo "$source_files" | wc -l)

    log "Scoping coverage to $pkg_count package(s) containing $file_count changed source file(s)"
    echo "${cov_paths[*]}"
}

# Summarize pytest output to show only what matters:
# - Test result (passed/failed count)
# - Failed tests with tracebacks
# - Coverage gaps (files with < 100%)
# - Coverage total
summarize_pytest_output() {
    local logfile="$1"
    local exit_code="$2"

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Extract and show the result line (e.g., "=== 5770 passed, 79 warnings in 275.79s ===")
    # WI-kalub: `|| true` so a non-matching log (e.g. still colorized under an
    # exotic color source) can never abort smart-test under `set -e + pipefail` —
    # the exit code must reflect the tests, not a summary formatting mismatch.
    local result_line
    result_line=$(grep -E "^=+ .*(passed|failed|error).* =+$" "$logfile" | tail -1 || true)
    if [[ -n "$result_line" ]]; then
        if [[ "$exit_code" -eq 0 ]]; then
            echo "✅ $result_line"
        else
            echo "❌ $result_line"
        fi
    fi

    # Show failed tests (if any)
    local failures
    failures=$(grep -E "^FAILED " "$logfile" || true)
    if [[ -n "$failures" ]]; then
        echo ""
        echo "FAILED TESTS:"
        echo "$failures"
        echo ""
        # Show short tracebacks for failures
        # Extract from "FAILURES" section to next "=" line
        sed -n '/^=* FAILURES =*/,/^=.*=$/p' "$logfile" | head -100
    fi

    # Show coverage gaps (files with missing lines)
    echo ""
    echo "COVERAGE:"
    # Match lines like: packages/.../file.py    191      1    99%   78
    # Where there's a non-zero miss count (column 2 after filename)
    local coverage_gaps
    coverage_gaps=$(grep -E "^packages/.*\s+[0-9]+\s+[1-9][0-9]*\s+[0-9]+%\s+[0-9]" "$logfile" || true)
    if [[ -n "$coverage_gaps" ]]; then
        echo "$coverage_gaps"
    else
        echo "  (all files at 100%)"
    fi

    # Show TOTAL line
    local total_line
    total_line=$(grep "^TOTAL" "$logfile" || true)
    if [[ -n "$total_line" ]]; then
        echo "$total_line"
    fi

    # Show coverage pass/fail
    local cov_result
    cov_result=$(grep -E "(Required test coverage|FAIL Required)" "$logfile" || true)
    if [[ -n "$cov_result" ]]; then
        echo "$cov_result"
    fi

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Full output: $logfile"
    if [[ "$SMART_TEST_MODE" == "targeted" ]]; then
        echo "Targeted run ($TARGETED_TEST_COUNT test files, $TARGETED_SOURCE_COUNT changed sources). Full suite runs in CI after merge; running it now would be wasteful."
    fi
    echo ""
}

# Run pytest and show summary (or raw output if --raw)
JUNIT_XML="$MANIFEST_DIR/pytest-results.xml"

# Fold this run's per-test coverage contexts into the selection index.
# ONE definition, called from every path that runs pytest — the --full branch
# exits immediately after its own run_pytest, so an inline copy at the targeted
# call site silently skipped full runs entirely: no last_full_run_sha marker and
# no unmeasured population, which are exactly what full runs exist to record.
# (Third time today that one fact with two homes drifted; hence a function.)
#
# $1 == "full" marks complete coverage scope. That flag is load-bearing, not
# cosmetic: "ran and produced nothing" is only a meaningful claim when coverage
# was watching everything, and the targeted path scopes --cov to changed files.
fold_selection_index() {
    [[ "$SELECT_SHADOW" == "true" ]] || return 0
    [[ -f "$REPO_ROOT/.coverage" ]] || return 0
    local full_flag=()
    # ${1:-} not $1: called with no argument on the targeted path, and
    # `set -u` makes a bare $1 an unbound-variable abort AFTER the suite
    # has already passed -- a green run reported as a failure.
    [[ "${1:-}" == "full" ]] && full_flag=(--full)
    "$REPO_ROOT/scripts/coverage-select" --repo-root "$REPO_ROOT" \
        --junit "$JUNIT_XML" update \
        --coverage-db "$REPO_ROOT/.coverage" \
        --sha "$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)" \
        "${full_flag[@]}" || true
}

run_pytest() {
    local test_targets="$1"
    shift
    local extra_args=("$@")

    mkdir -p "$MANIFEST_DIR"

    # Pin rootdir so --cov-context node ids are ALWAYS repo-relative.
    # pytest derives node ids from rootdir, and rootdir depends on the args:
    # a run confined to one package resolves to that package (several carry
    # [tool.pytest.ini_options]) and yields `tests/test_x.py::test_y`, while a
    # run spanning packages yields `packages/<pkg>/tests/test_x.py::test_y`.
    # Two spellings of one test fragment the selection index into rows that
    # never join — the same failure class as the `|setup` context suffix.
    # Verified: pinning rootdir does NOT change ini discovery (pytest still
    # reports `configfile: packages/hypergumbo-core/pyproject.toml`), so
    # per-package filterwarnings and asyncio settings still apply.
    # ALWAYS ON, and applied HERE rather than in COV_PATHS because COV_PATHS
    # is REBUILT FROM SCRATCH on the targeted path -- `COV_PATHS=($AFFECTED_COV)`
    # near "Running N affected test files with scoped coverage" -- which silently
    # discarded this flag. Measured before the move: a full run recorded 20,519
    # contexts while an ordinary no-args run recorded ONE, empty. That is the
    # common local path, so the incremental index would have starved on exactly
    # the runs it depends on while unit tests stayed green.
    #
    # run_pytest is the single chokepoint every invocation passes through, so no
    # future array rebuild can drop it again.
    #
    # "test" is the context SOURCE, not a scope: it is the only value pytest-cov
    # accepts ("Dynamic contexts to use. 'test' for now.") and means "label each
    # context with the test that produced it". Contexts carry `|setup`/`|run`/
    # `|teardown` suffixes; a raw join against test ids matches NOTHING, so
    # callers go through selection_index / coverage_census, which strip them.
    #
    # COST, measured 2026-08-14: full suite 966s WITH contexts vs 983s without,
    # i.e. no measurable tax (the ~18% figure did not reproduce).
    # ${REPO_ROOT:-$PWD}: test_smart_test_coverage_gate.py EXTRACTS this
    # function and drives it in isolation under `set -u`, so a bare
    # $REPO_ROOT is an unbound variable there and took the harness down.
    extra_args=("--rootdir=${REPO_ROOT:-$PWD}" "--cov-context=test" "${extra_args[@]}")

    if [[ "$RAW_OUTPUT" == "true" ]]; then
        # Stream output directly (old behavior)
        # shellcheck disable=SC2086
        exec pytest $test_targets "${COV_PATHS[@]}" --junit-xml="$JUNIT_XML" "${extra_args[@]}"
    else
        # Capture output, then summarize
        echo "Running tests... (output saved to $PYTEST_LOG)"
        # shellcheck disable=SC2086
        # Use || true to prevent set -e from exiting on test failure.
        # WI-kalub: neutralize FORCE_COLOR / COLORTERM so the captured $PYTEST_LOG
        # is PLAIN TEXT. A FORCE_COLOR dev shell otherwise makes pytest colorize
        # even this redirected file; the summary line then begins with an ANSI
        # escape, so summarize's anchored `^=+ …` result-line grep (and the
        # `^FAILED` re-derivation grep) fail to match — the unguarded result-line
        # grep aborts smart-test under `set -e + pipefail` with a false exit 1 on a
        # GREEN run. CI has no FORCE_COLOR, so this only bit the local dev loop;
        # neutralizing here aligns local with CI.
        # INV-vilag: capture pytest's OWN exit code as the primary signal.
        # The previous form was `… || true` + `exit_code=${PIPESTATUS[0]}`, but
        # after `cmd || true` PIPESTATUS reflects the `true`, so exit_code was
        # ALWAYS 0 and pytest's real status was discarded. The re-derivation below
        # then had to reconstruct the verdict from the log — and could not, for
        # runs where modules fail to COLLECT: pytest prints `ERROR …` / `N errors`
        # (never `FAILED `) alongside `N passed`, which satisfies neither failure
        # clause. run_pytest returned 0, so the caller's `TEST_EXIT -eq 0` gate
        # computed the scoped coverage verdict over a run whose erroring modules
        # never imported, and smart-test exited 0 printing "✅ … N passed, 3 errors".
        local exit_code=0
        env -u FORCE_COLOR -u COLORTERM pytest $test_targets "${COV_PATHS[@]}" --junit-xml="$JUNIT_XML" "${extra_args[@]}" > "$PYTEST_LOG" 2>&1 || exit_code=$?
        # Corrective re-derivation: these may only ESCALATE to failure, never
        # de-escalate to success. An affirmative-green clause (`N passed` && !
        # `N failed` -> 0) used to live here; it was a no-op while exit_code
        # started at 0, and would actively mask a real non-zero status now that it
        # does not. Deleted rather than repaired — it is the WI-kalub "latent
        # landmine" the comment there predicted.
        if grep -q "FAIL Required test coverage" "$PYTEST_LOG"; then
            exit_code=1
        elif grep -qE "^FAILED " "$PYTEST_LOG"; then
            exit_code=1
        fi
        summarize_pytest_output "$PYTEST_LOG" "$exit_code"

        # Ingest test timings into leaderboard (non-fatal)
        if [[ -f "$JUNIT_XML" ]]; then
            SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
            "$SCRIPT_DIR/test-leaderboard" ingest "$JUNIT_XML" 2>/dev/null || true
        fi

        return $exit_code
    fi
}

run_full_suite() {
    local reason="${1:-}"
    local changed_files="${2:-}"  # Optional: changed files to include in manifest

    if [[ -n "$reason" ]]; then
        log "Running full test suite: $reason"
    fi

    # Extract source files from changed files (if provided)
    local source_files=""
    if [[ -n "$changed_files" ]]; then
        source_files=$(echo "$changed_files" | grep -E '^packages/.*/src/.*\.py$' || echo "")
    fi

    # Write manifest indicating full suite (with section markers for CI compatibility)
    mkdir -p "$MANIFEST_DIR"
    {
        echo "# Test selection manifest"
        echo "# Generated by smart-test at $(date -Iseconds)"
        echo "# Mode: full-suite"
        echo "# Reason: $reason"
        echo "#"
        echo "# === CHANGED_SOURCE_FILES ==="
        if [[ -n "$source_files" ]]; then
            echo "$source_files"
        fi
        echo "# === SELECTED_TESTS ==="
        # Include both test_*.py and BRANCHES_test_*.py (branch coverage tests)
        find packages/*/tests \( -name 'test_*.py' -o -name 'BRANCHES_test_*.py' \) -type f | sort
    } > "$MANIFEST_FILE"

    if [[ "$MANIFEST_ONLY" == "true" ]]; then
        echo "Manifest written to $MANIFEST_FILE (full suite)"
        exit 0
    fi

    run_pytest "packages/*/tests/" -n 2 "${PYTEST_ARGS[@]}"
    exit $?
}

kick_off_background_suite() {
    LOCK=".git/FULL_SUITE_RUNNING"
    if [[ -f "$LOCK" ]]; then
        log "Full suite already running (lock file exists), skipping"
        return 0
    fi

    echo $$ > "$LOCK"
    log "Starting full suite in background..."

    (
        pytest packages/*/tests/ -n 2 "${COV_PATHS[@]}" --cov-fail-under=100 > .ci/full-suite.log 2>&1
        STATUS=$?
        rm -f "$LOCK"
        if [[ $STATUS -ne 0 ]]; then
            echo "[smart-test] Background full suite FAILED - check .ci/full-suite.log" >&2
            # Could add notification here (notify-send, etc.)
        else
            echo "[smart-test] Background full suite passed" >&2
        fi
    ) &

    echo "Full suite started in background (PID: $!)"
}

# Handle --background flag
if [[ "$BACKGROUND" == "true" ]]; then
    kick_off_background_suite
    exit 0
fi

# Handle explicit test targets: skip the slice when the caller already
# specified which tests to run (e.g. pytest test_tui.py::TestFoo -x).
# The slice computes a behavior map of the entire codebase, which is
# expensive and pointless when the test selection is already known.
if [[ "$HAS_EXPLICIT_TESTS" == "true" ]]; then
    log "Explicit test targets detected — skipping slice"

    # Still write a manifest so CI knows what happened
    mkdir -p "$MANIFEST_DIR"
    {
        echo "# Test selection manifest"
        echo "# Generated by smart-test at $(date -Iseconds)"
        echo "# Mode: explicit"
        echo "# Reason: caller specified test targets directly"
        echo "#"
        echo "# === CHANGED_SOURCE_FILES ==="
        echo "# === SELECTED_TESTS ==="
        echo "# (explicit — see pytest args)"
    } > "$MANIFEST_FILE"

    # Run pytest with the caller's args (test paths are already in PYTEST_ARGS)
    run_pytest "" "${PYTEST_ARGS[@]}"
    exit $?
fi

# Check for stable hypergumbo installation
# IMPORTANT: Use stable release, not the version under test (bootstrap safety)
STABLE_HG=""
if [[ -x "$HOME/.local/bin/hypergumbo" ]]; then
    STABLE_HG="$HOME/.local/bin/hypergumbo"
elif command -v hypergumbo &> /dev/null; then
    # Check it's not the dev version
    HG_PATH=$(command -v hypergumbo)
    if [[ "$HG_PATH" != *".venv"* ]]; then
        STABLE_HG="$HG_PATH"
    fi
fi

if [[ -z "$STABLE_HG" ]]; then
    run_full_suite "no stable hypergumbo found (install with: pipx install hypergumbo)"
fi

log "Using stable hypergumbo: $STABLE_HG"

# Get baseline commit (last-green-sha or merge-base fallback)
BASE_BRANCH="${BASE_BRANCH:-origin/dev}"
BASELINE=$(get_baseline "$BASE_BRANCH")

# Get changes from all sources:
# 1. Committed: changes between BASELINE and HEAD
# 2. Staged: changes in the index (git add'd but not committed)
# 3. Unstaged: modified files in working directory (not yet git add'd)
# This ensures we detect changes regardless of when pytest runs in the workflow
COMMITTED_CHANGES=$(git diff --name-only "$BASELINE"..HEAD 2>/dev/null || echo "")
STAGED_CHANGES=$(git diff --name-only --cached 2>/dev/null || echo "")
UNSTAGED_CHANGES=$(git diff --name-only 2>/dev/null || echo "")

# INV-kinin: the three git-diff calls above cannot see UNTRACKED files, so a
# brand-new test file was invisible to selection until committed — the sole
# coverer of a new branch could be dropped while its siblings ran, and the
# gate reported the changed source green with the missing lines being
# exactly what that file covers. Scoped to the test/source surfaces:
# pending tracker .ops files are untracked by design almost continuously
# and must not leak in (they would fire the top-level fallback every run).
UNTRACKED_CHANGES=$(git ls-files --others --exclude-standard 2>/dev/null | grep -E '^(packages/|tests/|scripts/|\.githooks/|\.agent/hooks/)' || echo "")

# Combine and deduplicate
CHANGED_FILES=$(printf "%s\n%s\n%s\n%s" "$COMMITTED_CHANGES" "$STAGED_CHANGES" "$UNSTAGED_CHANGES" "$UNTRACKED_CHANGES" | sort -u | grep -v '^$' || echo "")

# If no changes detected, run full suite
# (This also writes a full-suite manifest, which CI will reject - that's intentional
# as it signals something is wrong with the baseline/change detection)
if [[ -z "$CHANGED_FILES" ]]; then
    run_full_suite "no changed files detected"
fi

log "Changed files since $BASELINE:"
if [[ "$VERBOSE" == "true" ]]; then
    echo "$CHANGED_FILES" | sed 's/^/  /' >&2
fi

# Write changed files to temp file for slice query.
# WI-zufij: `hypergumbo slice --files` only reaches packages/*/src/** (see the
# WI-jozan comment below). Passing NON-source paths (docs/*, .ci/*,
# .agent/**/*.ops, CHANGELOG.md, cadence json) is both useless to the slice AND
# fatal to it (`Error: Input file not found: None`), which forced a full-suite
# fallback that the pre-commit "Test manifest" check correctly rejects — blocking
# any PR that co-changes source + generated docs. Filter the slice input to the
# sliceable source set; top-level sources (scripts/, .agent/hooks/_shared) are
# folded into AFFECTED_TESTS separately via TOP_LEVEL_MAP_HELPER, not the slice,
# so nothing is lost. The unfiltered $CHANGED_FILES stays authoritative for the
# CHANGED_SOURCE_FILES / manifest bookkeeping below.
CHANGED_FILE_LIST=$(mktemp)
echo "$CHANGED_FILES" | grep -E '^packages/.*/src/.*\.py$' > "$CHANGED_FILE_LIST" || true
trap "rm -f $CHANGED_FILE_LIST" EXIT

# Use hypergumbo slice --files to find dependent files
log "Running reverse slice to find affected files..."
SLICE_OUTPUT=$(mktemp)
SLICE_STDERR=$(mktemp)
trap "rm -f $CHANGED_FILE_LIST $SLICE_OUTPUT $SLICE_STDERR" EXIT

# WI-morud follow-up: capture slice timing + exit code so write_fallback_diagnostic
# can record them on either fallback path.
SLICE_CMD="$STABLE_HG slice --files $CHANGED_FILE_LIST --output $SLICE_OUTPUT"
SLICE_START_S=$SECONDS
# WI-tolil: `set -euo pipefail` would abort the WHOLE script HERE on a non-zero
# slice exit — before SLICE_EXIT is captured and before the slice-failure
# fallback below (run_full_suite) can run — swallowing the failure silently
# (empty exit, no .ci/pytest-output.log, zero tests run; an agent/CI then
# believes tests passed). Capture the real exit via `||` so the fallback is
# reachable. The `|| SLICE_EXIT=$?` idiom is not subject to `set -e`.
SLICE_EXIT=0
if [[ -s "$CHANGED_FILE_LIST" ]]; then
    $STABLE_HG slice --files "$CHANGED_FILE_LIST" --output "$SLICE_OUTPUT" 2>"$SLICE_STDERR" || SLICE_EXIT=$?
else
    # WI-zufij: no sliceable source file changed (a test-only / docs-only PR, or
    # one whose only changes are non-source paths the filter above dropped).
    # Running the slice on an empty seed would do a full-repo analysis for a
    # guaranteed-empty result; skip it. SLICE_OUTPUT stays empty and the
    # "no affected tests" handling below routes to the TDD test-only / no-source
    # paths (which already check CHANGED_TEST_FILES / CHANGED_SOURCE_FILES).
    : > "$SLICE_OUTPUT"
fi
SLICE_DURATION_S=$((SECONDS - SLICE_START_S))

if [[ $SLICE_EXIT -ne 0 ]]; then
    if [[ -s "$SLICE_STDERR" ]]; then
        log "Slice stderr: $(cat "$SLICE_STDERR")"
    fi
    write_fallback_diagnostic "slice command failed" "$SLICE_CMD" "$SLICE_EXIT" \
        "$SLICE_DURATION_S" "$SLICE_OUTPUT" "$SLICE_STDERR" "$CHANGED_FILE_LIST"
    run_full_suite "slice command failed" "$CHANGED_FILES"
fi

# Filter to only test files in package directories
# Convert absolute paths to relative (slice may output absolute paths)
# Matches test_*.py and BRANCHES_test_*.py (for branch coverage tests)
AFFECTED_TESTS=$(grep -E 'packages/.*/tests/(test_|BRANCHES_test_).*\.py$' "$SLICE_OUTPUT" 2>/dev/null | \
    sed "s|^$REPO_ROOT/||" | sort -u || echo "")

# WI-jozan: fold top-level source → top-level test matches into AFFECTED_TESTS.
# hypergumbo slice --files only reaches packages/*/src/** — it does not know
# about .agent/hooks/_shared/*.py or scripts/*. Without this fold, a PR that
# only touches top-level infrastructure would produce an empty manifest and
# ci.yml would silently skip pytest. The helper's output is filename-matched
# ("tests/test_<basename>.py"), so false negatives for sub-directory helpers
# are acceptable (they still get full-suite coverage under WI-javan's
# test-agent-infra job).
TOP_LEVEL_MAP_HELPER="$REPO_ROOT/.agent/hooks/_shared/top_level_test_map.py"
TOP_LEVEL_TESTS=""
if [[ -f "$TOP_LEVEL_MAP_HELPER" ]] && command -v python3 &>/dev/null; then
    TOP_LEVEL_TESTS=$(echo "$CHANGED_FILES" | python3 "$TOP_LEVEL_MAP_HELPER" "$REPO_ROOT" 2>/dev/null || echo "")
fi
if [[ -n "$TOP_LEVEL_TESTS" ]]; then
    AFFECTED_TESTS=$(printf '%s\n%s\n' "$AFFECTED_TESTS" "$TOP_LEVEL_TESTS" | sed '/^$/d' | sort -u)
fi

# A test file you edited always runs.  Root-level tests/ counts here as well
# as packages/*/tests/: omitting it meant a PR touching ONLY root tests
# selected nothing and ci.yml skipped pytest, so a new top-level test could
# merge having never run in CI -- green locally, vacuous in the gate.  The
# reverse-slice cannot rescue those; it walks packages/*/src/**.
#
# Unioned here rather than left to the TDD-mode fallback below, because that
# fallback only fires when NOTHING else was selected.  A change that edits a
# root test AND touches any mapped source would otherwise have the source's
# tests selected and the edited test silently dropped.
CHANGED_TEST_FILES=$(echo "$CHANGED_FILES" | grep -E '^(packages/.*/tests/(test_|BRANCHES_test_)|tests/test_).*\.py$' || echo "")
if [[ -n "$CHANGED_TEST_FILES" ]]; then
    AFFECTED_TESTS=$(printf '%s\n%s\n' "$AFFECTED_TESTS" "$CHANGED_TEST_FILES" | sed '/^$/d' | sort -u)
fi

# INV-kinin: a fixture edit changes a gate's INPUTS without running the
# gate — the import-graph slice cannot see data files, so a change confined
# to tests/fixtures/** selected nothing and ci.yml skipped pytest. Fixture
# changes select their OWNING suite: the package's tests, or the root suite
# for root fixtures.
CHANGED_FIXTURE_FILES=$(echo "$CHANGED_FILES" | grep -E '^(tests/fixtures/|packages/[^/]+/tests/fixtures/)' || echo "")
if [[ -n "$CHANGED_FIXTURE_FILES" ]]; then
    FIXTURE_TESTS=""
    while IFS= read -r fx; do
        [[ -z "$fx" ]] && continue
        if [[ "$fx" == tests/fixtures/* ]]; then
            FIXTURE_TESTS+="$(cd "$REPO_ROOT" && ls tests/test_*.py 2>/dev/null || true)"$'\n'
        else
            pkg_tests="${fx%%/fixtures/*}"
            FIXTURE_TESTS+="$(cd "$REPO_ROOT" && ls "$pkg_tests"/test_*.py "$pkg_tests"/BRANCHES_test_*.py 2>/dev/null || true)"$'\n'
        fi
    done <<< "$CHANGED_FIXTURE_FILES"
    if [[ -n "$(echo "$FIXTURE_TESTS" | sed '/^$/d')" ]]; then
        log "Fixture changes select their owning suite (INV-kinin)"
        AFFECTED_TESTS=$(printf '%s\n%s\n' "$AFFECTED_TESTS" "$FIXTURE_TESTS" | sed '/^$/d' | sort -u)
    fi
fi

# Check if any Python source files changed (drives the version-only and
# no-affected-tests branches below).
CHANGED_SOURCE_FILES=$(echo "$CHANGED_FILES" | grep -E '^packages/.*/src/.*\.py$' || echo "")

# INV-lizor: the top-level executable surface — scripts/ at any depth,
# .githooks/, .agent/hooks/ — is exactly where the per-PR gate was
# structurally blind. Vendor hook dirs and .githooks are deliberately not
# name-mapped (top_level_test_map.py records both decisions), so any
# changed file here the map cannot reach gets the conservative treatment:
# union the whole root suite, disclosed. Over-select, never under-select.
CHANGED_TOP_LEVEL_SOURCES=$(echo "$CHANGED_FILES" | grep -E '^(scripts/|\.githooks/|\.agent/hooks/)' || echo "")
UNMAPPED_TOP_LEVEL=""
if [[ -n "$CHANGED_TOP_LEVEL_SOURCES" ]]; then
    if [[ -f "$TOP_LEVEL_MAP_HELPER" ]] && command -v python3 &>/dev/null; then
        while IFS= read -r tls; do
            [[ -z "$tls" ]] && continue
            if [[ -z "$(echo "$tls" | python3 "$TOP_LEVEL_MAP_HELPER" "$REPO_ROOT" 2>/dev/null)" ]]; then
                UNMAPPED_TOP_LEVEL+="$tls"$'\n'
            fi
        done <<< "$CHANGED_TOP_LEVEL_SOURCES"
    else
        # No helper to judge with — treat every top-level change as unmapped.
        UNMAPPED_TOP_LEVEL="$CHANGED_TOP_LEVEL_SOURCES"
    fi
fi
if [[ -n "$(echo "$UNMAPPED_TOP_LEVEL" | sed '/^$/d')" ]]; then
    log "Top-level sources with no mapped test — unioning the root suite:"
    log "$(echo "$UNMAPPED_TOP_LEVEL" | sed '/^$/d;s/^/  /')"
    ROOT_SUITE=$(cd "$REPO_ROOT" && ls tests/test_*.py 2>/dev/null || echo "")
    AFFECTED_TESTS=$(printf '%s\n%s\n' "$AFFECTED_TESTS" "$ROOT_SUITE" | sed '/^$/d' | sort -u)
fi

if [[ -z "$AFFECTED_TESTS" ]]; then
    # No affected tests found. Check why:
    if [[ -z "$CHANGED_SOURCE_FILES" ]]; then
        # No Python source files changed. CHANGED_TEST_FILES was computed
        # above (TDD Red phase: test written before implementation exists);
        # reaching here with it non-empty is not possible, since the union
        # above would have populated AFFECTED_TESTS -- the branch is kept so
        # the TDD-mode log line still fires if that union is ever narrowed.
        if [[ -n "$CHANGED_TEST_FILES" ]]; then
            # TDD mode: test files changed but no source files to slice from.
            # Run the changed test files directly.
            AFFECTED_TESTS="$CHANGED_TEST_FILES"
            log "TDD mode: running changed test files (no source files to slice from)"
        else
            # Nothing test-relevant changed: no package source, no tests, no
            # fixtures, and every top-level source (if any) was mapped —
            # only docs/configs remain. Write a targeted manifest with 0
            # tests - CI will skip pytest. The wording is deliberate: the
            # old "no Python source files changed" printed even when source
            # HAD changed (INV-lizor), which made the blindness read as a
            # legitimate skip.
            log "No test-relevant files changed - writing empty targeted manifest"
            mkdir -p "$MANIFEST_DIR"
            {
                echo "# Test selection manifest"
                echo "# Generated by smart-test at $(date -Iseconds)"
                echo "# Mode: targeted"
                echo "# Baseline: $BASELINE"
                echo "# Reason: no test-relevant files changed (docs/config only)"
                echo "# Changed files: $(echo "$CHANGED_FILES" | wc -l)"
                echo "# Changed source files: 0"
                echo "# Selected tests: 0"
                echo "#"
                echo "# === CHANGED_SOURCE_FILES ==="
                echo "# === SELECTED_TESTS ==="
            } > "$MANIFEST_FILE"

            if [[ "$MANIFEST_ONLY" == "true" ]]; then
                echo "Manifest written to $MANIFEST_FILE (0 tests - no Python source changed)"
                cat "$MANIFEST_FILE"
                exit 0
            fi

            echo "No test-relevant files changed (docs/config only) - skipping tests"
            exit 0
        fi
    else
        # Python source files changed but slice found no dependent tests.
        # Check if this is a version-only change (__init__.py with only __version__).
        # This is the normal case for release commits — no need for full suite.
        VERSION_ONLY=true
        while IFS= read -r src_file; do
            [[ -z "$src_file" ]] && continue
            basename_f=$(basename "$src_file")
            if [[ "$basename_f" != "__init__.py" ]]; then
                VERSION_ONLY=false
                break
            fi
            # Check if the diff is only __version__ changes
            if ! git diff "$BASELINE" -- "$src_file" | grep -qE '^\+.*' 2>/dev/null || \
               git diff "$BASELINE" -- "$src_file" | grep -E '^\+[^+]' | grep -qvE '__version__|^$' 2>/dev/null; then
                VERSION_ONLY=false
                break
            fi
        done <<< "$CHANGED_SOURCE_FILES"

        if $VERSION_ONLY; then
            # Version-only __init__.py changes (e.g., release commits).
            # Pick one lightweight test per affected package to satisfy CI's
            # per-package sanity check without running the full suite.
            log "Version-only __init__.py changes — writing targeted manifest"
            AFFECTED_PACKAGES=$(echo "$CHANGED_SOURCE_FILES" | sed -n 's|^packages/\([^/]*\)/.*|\1|p' | sort -u)
            SELECTED_TESTS=""
            for pkg in $AFFECTED_PACKAGES; do
                # Grab the first (alphabetically) test file in the package.
                # NOTE: `find … | sort | head -1` under `set -o pipefail`
                # (line 32) exits this script with code 141 (SIGPIPE): `head
                # -1` closes stdin after the first line, `sort` receives
                # SIGPIPE on its remaining output, and pipefail propagates
                # that failure to the enclosing `$(…)` — killing the whole
                # smart-test invocation before the manifest is written. That
                # trips every time this VERSION_ONLY branch runs (the only
                # call site where `find` produces a non-trivial number of
                # matches before `head` cuts in), which is every release
                # commit, which is why prepare-release kept reporting
                # "Manifest generation skipped (no stable hypergumbo?)" from
                # auto-pr's elif-fallthrough at scripts/auto-pr:1000.
                # readarray avoids the pipe-to-head entirely: the
                # process-substitution feeds into readarray without any
                # outer pipeline that pipefail can kill.
                readarray -t _tests < <(find "packages/$pkg/tests" -name 'test_*.py' -type f 2>/dev/null | sort)
                first_test="${_tests[0]:-}"
                if [[ -n "$first_test" ]]; then
                    SELECTED_TESTS="${SELECTED_TESTS}${first_test}"$'\n'
                fi
            done
            SELECTED_TESTS=$(echo "$SELECTED_TESTS" | sed '/^$/d')
            TEST_COUNT=$(echo "$SELECTED_TESTS" | grep -c . || echo 0)

            mkdir -p "$MANIFEST_DIR"
            {
                echo "# Test selection manifest"
                echo "# Generated by smart-test at $(date -Iseconds)"
                echo "# Mode: targeted"
                echo "# Baseline: $BASELINE"
                echo "# Reason: version-only __init__.py changes"
                echo "# Changed files: $(echo "$CHANGED_FILES" | wc -l)"
                echo "# Changed source files: $(echo "$CHANGED_SOURCE_FILES" | grep -c . || echo 0)"
                echo "# Selected tests: $TEST_COUNT"
                echo "#"
                echo "# === CHANGED_SOURCE_FILES ==="
                echo "$CHANGED_SOURCE_FILES"
                echo "# === SELECTED_TESTS ==="
                if [[ -n "$SELECTED_TESTS" ]]; then
                    echo "$SELECTED_TESTS"
                fi
            } > "$MANIFEST_FILE"

            if [[ "$MANIFEST_ONLY" == "true" ]]; then
                echo "Manifest written to $MANIFEST_FILE ($TEST_COUNT tests - version only)"
                cat "$MANIFEST_FILE"
                exit 0
            fi

            AFFECTED_TESTS="$SELECTED_TESTS"
            # Fall through to normal test execution below
        else
            # Non-trivial source changes but slice found no dependent tests
            # This is unusual - fall back to full suite
            write_fallback_diagnostic "no test files in slice result" "$SLICE_CMD" \
                "$SLICE_EXIT" "$SLICE_DURATION_S" "$SLICE_OUTPUT" "$SLICE_STDERR" \
                "$CHANGED_FILE_LIST"
            run_full_suite "no test files in slice result" "$CHANGED_FILES"
        fi
    fi
fi

# Per-package coverage fallback: CI runs each packages/<P>/ in isolation and
# its manifest sanity check requires ≥1 test under packages/<P>/tests/ for
# every package whose source changed. The reverse-slice resolves tests via
# transitive imports, so when a package's only changed source is __init__.py
# (the version bump pattern at every release) and no test imports __init__
# directly, the slice correctly returns zero matches for that package — but
# the sanity check still expects ≥1. The helper below appends the
# alphabetically-first test from any unrepresented affected package's
# tests/ directory. Same lightweight-test rule the version-only branch
# above already uses.
PER_PKG_HELPER="$REPO_ROOT/scripts/per_package_fallback.py"
if [[ -f "$PER_PKG_HELPER" ]] && command -v python3 &>/dev/null && [[ -n "$CHANGED_SOURCE_FILES" ]]; then
    PER_PKG_TESTS_FILE=$(mktemp)
    echo "$AFFECTED_TESTS" > "$PER_PKG_TESTS_FILE"
    PER_PKG_FALLBACKS=$(echo "$CHANGED_SOURCE_FILES" | python3 "$PER_PKG_HELPER" "$REPO_ROOT" --tests-file "$PER_PKG_TESTS_FILE" 2>/dev/null || echo "")
    rm -f "$PER_PKG_TESTS_FILE"
    if [[ -n "$PER_PKG_FALLBACKS" ]]; then
        log "Per-package coverage fallback adding: $(echo "$PER_PKG_FALLBACKS" | tr '\n' ' ')"
        AFFECTED_TESTS=$(printf '%s\n%s\n' "$AFFECTED_TESTS" "$PER_PKG_FALLBACKS" | sed '/^$/d' | sort -u)
    fi
fi

# Coverage-only dependency augmentation (WI-zaziz): some tests COVER a source
# file through the analysis pipeline without a direct import edge, so the
# import-based reverse slice under-selects them — producing a false <100% on
# CI's changed-file coverage gate (e.g. test_polyglot_call_site_coverage.py is
# the sole cover of java.py's static-import ExternalRef branch and imports no
# java.py). A checked-in declarative map (.ci/coverage-only-deps.txt) names
# these source→covering-test pairs so they are always included. Because this
# runs INSIDE smart-test, the manifest auto-pr regenerates via
# `smart-test --manifest` includes them too, so the fix persists across the
# commit-diff-driven regeneration (the manual-add workaround did not).
COV_DEPS_HELPER="$REPO_ROOT/scripts/coverage_only_deps.py"
COV_DEPS_MAP="$REPO_ROOT/.ci/coverage-only-deps.txt"
if [[ -f "$COV_DEPS_HELPER" && -f "$COV_DEPS_MAP" ]] && command -v python3 &>/dev/null && [[ -n "$CHANGED_SOURCE_FILES" ]]; then
    COV_DEPS_TESTS_FILE=$(mktemp)
    echo "$AFFECTED_TESTS" > "$COV_DEPS_TESTS_FILE"
    COV_DEPS_ADDS=$(echo "$CHANGED_SOURCE_FILES" | python3 "$COV_DEPS_HELPER" "$REPO_ROOT" --map "$COV_DEPS_MAP" --tests-file "$COV_DEPS_TESTS_FILE" 2>/dev/null || echo "")
    rm -f "$COV_DEPS_TESTS_FILE"
    if [[ -n "$COV_DEPS_ADDS" ]]; then
        log "Coverage-only dependency augmentation adding: $(echo "$COV_DEPS_ADDS" | tr '\n' ' ')"
        AFFECTED_TESTS=$(printf '%s\n%s\n' "$AFFECTED_TESTS" "$COV_DEPS_ADDS" | sed '/^$/d' | sort -u)
    fi
fi

# ─── THE MANIFEST SET AND THE LOCAL RUN SET PART COMPANY HERE ──────────────
#
# Owner decision, 2026-08-16 (option A on WI-kuliv / WI-bolot). Until now these
# were one variable, and that coupling is not local: `.woodpecker/woodpecker.yml`
# says "the committed .ci/affected-tests.txt manifest drives it", so whatever
# this script selects is what the MERGE-GATING CI runs. Coverage-directed
# selection is specified as local-only — WI-kuliv says "Remains local-only. CI
# never invokes scripts/smart-test", which is literally true and misleading in
# effect: CI does not invoke this script, it CONSUMES ITS OUTPUT. Phase 2 unions
# coverage-selected tests in and Phase 3 narrows; with one variable, Phase 2
# would silently make CI slower and Phase 3 would silently narrow the merge gate.
#
# So: everything ABOVE this line is the static import-graph slice plus its
# declarative augmentations, and that is what the manifest publishes. Everything
# BELOW may widen or narrow `AFFECTED_TESTS` for THIS machine only. The two are
# byte-identical today — no phase has landed — which is the point: the seam is
# cut before there is anything to misuse it.
#
# Pinned by packages/hypergumbo-core/tests/test_smart_test_manifest_split.py,
# because a future edit that "simplifies" these back into one variable would
# reintroduce the coupling silently and pass every existing test.
MANIFEST_TESTS="$AFFECTED_TESTS"
MANIFEST_TEST_COUNT=$(echo "$MANIFEST_TESTS" | wc -l)

# ── Coverage-directed selection, PHASE 2: UNION (WI-kuliv) ───────────────────
# BELOW THE SEAM ON PURPOSE. This widens the LOCAL run only; the manifest above
# is already snapshotted, so the merge-gating CI keeps today's static selection.
# Landing this above the seam would have added ~44 test files per informative
# run to what CI runs — slower gate AND slower local run, invisible in any test.
#
# ADDITIVE, NEVER SUBTRACTIVE. This is the property the whole phase rests on and
# the reason it precedes any narrowing: a union cannot drop a test, so the worst
# case is wasted time. Narrowing is Phase 3 (WI-bolot) and gets its own evidence.
#
# WHY IT IS WORTH THE TIME IT COSTS. The justification is not speed — Phase 2
# makes local runs SLOWER. It is that coverage sees runtime dependencies the
# static import graph cannot: the shadow log's 10 observations added tests on 7
# of them, e.g. selecting test_cli_explain.py for a change to
# edge_types.find_edge_type because `explain` looks edge types up at runtime and
# imports nothing. That is a correctness improvement that happens to be fast
# later, and it stands even if Phase 3 never lands.
#
# IT MUST NEVER FAIL THE RUN IT IS WIDENING. `|| true` here, the helper catches
# broadly and exits 0, and its output is filtered to files that exist — the index
# is persistent and remembers tests that have since been renamed away, which
# pytest would treat as a collection error rather than a skip.
if [[ "$SELECT_UNION" == "true" ]] && [[ -n "$CHANGED_FILES" ]]; then
    _union_changed=$(mktemp)
    echo "$CHANGED_FILES" | grep -E '\.py$' > "$_union_changed" || true
    COVERAGE_UNION_ADDS=$("$REPO_ROOT/scripts/coverage-select" \
        --repo-root "$REPO_ROOT" select \
        --changed-files "$_union_changed" \
        --base "${BASELINE:-HEAD}" 2>/dev/null || echo "")
    rm -f "$_union_changed"
    # Report only what the static selectors did NOT already have, so the log
    # line is the phase's actual contribution rather than its overlap.
    if [[ -n "$COVERAGE_UNION_ADDS" ]]; then
        COVERAGE_UNION_NEW=$(comm -13 \
            <(echo "$AFFECTED_TESTS" | sed '/^$/d' | sort -u) \
            <(echo "$COVERAGE_UNION_ADDS" | sed '/^$/d' | sort -u))
        if [[ -n "$COVERAGE_UNION_NEW" ]]; then
            log "Coverage-directed union adding $(echo "$COVERAGE_UNION_NEW" | wc -l) file(s): $(echo "$COVERAGE_UNION_NEW" | tr '\n' ' ')"
            AFFECTED_TESTS=$(printf '%s\n%s\n' "$AFFECTED_TESTS" "$COVERAGE_UNION_NEW" | sed '/^$/d' | sort -u)
        fi
    fi
fi

# ── Coverage-directed selection, PHASE 3: NARROW (WI-bolot) ──────────────────
# OPT-IN, never the default, never in CI — the item's own constraint, and the
# right one: this is the first operation in the family that can REMOVE a test.
# Below the seam like the union, so the committed manifest is untouched.
#
# WHY IT IS NOT DEFAULT-ON EVEN THOUGH THE RULES ARE SOUND. The index knows
# "tests I have OBSERVED executing block B", which is a subset of "tests that
# execute B" until every test has run since B appeared. Between full runs the
# keep set can therefore be short a test that covers part of a changed file, and
# the whole-file coverage gate below would report that as a coverage regression
# when it is really a stale index. Opt-in means whoever accepts that accepts it
# knowingly.
#
# MEASURED CEILING, so nobody expects more of this than it can give
# (scripts/measure-narrowing-headroom.py): across the timed suite only 55.3% of
# wall-clock is index-speakable at all — the other 44.7% is unmeasured or unseen
# and is kept unconditionally. On a small change the run set is already ~20s of
# tests, so the saving is seconds; the win is on large selections.
if [[ "$SELECT_NARROW" == "true" ]] && [[ -n "$CHANGED_FILES" ]]; then
    _nar_changed=$(mktemp); _nar_run=$(mktemp)
    echo "$CHANGED_FILES" | grep -E '\.py$' > "$_nar_changed" || true
    echo "$AFFECTED_TESTS" | sed '/^$/d' > "$_nar_run" || true
    NARROWED=$("$REPO_ROOT/scripts/coverage-select" \
        --repo-root "$REPO_ROOT" ${VERBOSE:+--verbose} narrow \
        --changed-files "$_nar_changed" --run-set "$_nar_run" \
        --base "${BASELINE:-HEAD}" || echo "")
    rm -f "$_nar_changed" "$_nar_run"
    # A failed or refusing narrow prints the run set back unchanged; an EMPTY
    # answer means the helper died, and then the run set must stand rather than
    # collapse to nothing (pytest exits 5 — green — on an empty collection).
    if [[ -n "$NARROWED" ]]; then
        AFFECTED_TESTS=$(echo "$NARROWED" | sed '/^$/d' | sort -u)
    fi
fi

# Count affected tests
TEST_COUNT=$(echo "$AFFECTED_TESTS" | wc -l)
log "Found $TEST_COUNT affected test files"

if [[ "$VERBOSE" == "true" ]]; then
    echo "$AFFECTED_TESTS" | sed 's/^/  /' >&2
fi

# CHANGED_SOURCE_FILES already computed above (before the empty-tests check)
SOURCE_COUNT=$(echo "$CHANGED_SOURCE_FILES" | grep -c . || echo 0)

# Write manifest
mkdir -p "$MANIFEST_DIR"
{
    echo "# Test selection manifest"
    echo "# Generated by smart-test at $(date -Iseconds)"
    echo "# Mode: targeted"
    echo "# Baseline: $BASELINE"
    echo "# Changed files: $(echo "$CHANGED_FILES" | wc -l)"
    echo "# Changed source files: $SOURCE_COUNT"
    echo "# Selected tests: $MANIFEST_TEST_COUNT"
    echo "#"
    echo "# === CHANGED_SOURCE_FILES ==="
    if [[ -n "$CHANGED_SOURCE_FILES" ]]; then
        echo "$CHANGED_SOURCE_FILES"
    fi
    echo "# === SELECTED_TESTS ==="
    echo "$MANIFEST_TESTS"
} > "$MANIFEST_FILE"

log "Manifest written to $MANIFEST_FILE"

if [[ "$MANIFEST_ONLY" == "true" ]]; then
    echo "Manifest written to $MANIFEST_FILE ($TEST_COUNT test files)"
    cat "$MANIFEST_FILE"
    exit 0
fi

# Handle --full flag: run all tests locally, but manifest already written above is targeted
# This is for local testing when you want to verify the full suite passes
if [[ "$FULL_RUN" == "true" ]]; then
    log "Running full test suite locally (--full flag)"
    echo "Running full test suite (manifest written with $TEST_COUNT targeted tests for CI)"
    run_pytest "packages/*/tests/" -n 2 "${PYTEST_ARGS[@]}"
    _full_rc=$?
    fold_selection_index full
    exit $_full_rc
fi

# Build scoped coverage for affected source files only
AFFECTED_COV=$(build_affected_cov_paths "$CHANGED_FILES")

if [[ "$AFFECTED_COV" == "FULL" ]]; then
    # No source files changed (maybe only tests or configs)
    # Fall back to full coverage paths but still run only affected tests
    log "No source files changed, using full coverage scope"
    SMART_TEST_MODE="targeted"
    TARGETED_TEST_COUNT=$TEST_COUNT
    TARGETED_SOURCE_COUNT=0
    echo "Running $TEST_COUNT affected test files (use --full for complete suite)"
    run_pytest "$AFFECTED_TESTS" "${PYTEST_ARGS[@]}"
    exit $?
fi

# CHANGED_SOURCE_FILES already computed above for manifest

# Set targeted mode for summary message
SMART_TEST_MODE="targeted"
TARGETED_TEST_COUNT=$TEST_COUNT
TARGETED_SOURCE_COUNT=$SOURCE_COUNT

# Run affected tests with scoped coverage
echo "Running $TEST_COUNT affected test files with scoped coverage"
echo "  (enforcing 100% coverage for changed source files only)"

# Override COV_PATHS with affected-only paths
# shellcheck disable=SC2206
COV_PATHS=($AFFECTED_COV)

# Suppress pytest-cov's terminal report - we'll show targeted coverage below
# The misleading package-level percentage (e.g., "4%") is noise when running
# a subset of tests. Only the targeted file-level check matters.
COV_PATHS+=("--cov-report=")

# Add no-embeddings config if needed
if [[ "$EMBEDDINGS_AVAILABLE" == "false" ]]; then
    COV_PATHS+=("--cov-config=.coveragerc.no-embeddings")
fi

# Strip --cov-fail-under from PYTEST_ARGS when running scoped mode
# We'll do our own scoped coverage check below instead of using pytest-cov's
# total coverage check (which would fail when running only affected tests)
SCOPED_PYTEST_ARGS=()
for arg in "${PYTEST_ARGS[@]}"; do
    if [[ ! "$arg" =~ ^--cov-fail-under ]]; then
        SCOPED_PYTEST_ARGS+=("$arg")
    fi
done

# Estimate wall-clock time from test timing data (non-fatal, informational)
TIMINGS_PATH="$HOME/hypergumbo_lab_notebook/test_timings.json"
if [[ -f "$TIMINGS_PATH" ]]; then
    # Sum mean durations of slow tests (>100ms) in affected files, divide by CPU count
    ETA=$(python3 -c "
import json, os, sys
try:
    timings = json.load(open('$TIMINGS_PATH'))
    affected = set('''$AFFECTED_TESTS'''.split())
    total = 0.0
    for tid, info in timings.items():
        # Extract test file path from pytest node ID (path::Class::method)
        tfile = tid.split('::')[0]
        if tfile not in affected:
            continue
        runs = info.get('runs', [])
        if not runs:
            continue
        mean = sum(r['seconds'] for r in runs) / len(runs)
        total += mean
    cpus = os.cpu_count() or 1
    wall = total / cpus
    if wall >= 60:
        print(f'~{wall/60:.0f}m @ {cpus} CPUs')
    elif wall >= 1:
        print(f'~{wall:.0f}s @ {cpus} CPUs')
except Exception:
    pass
" 2>/dev/null)
    if [[ -n "$ETA" ]]; then
        echo "  (estimated wall time: $ETA)"
    fi
fi

# Run tests and collect coverage (don't enforce threshold yet)
run_pytest "$AFFECTED_TESTS" "${SCOPED_PYTEST_ARGS[@]}"
TEST_EXIT=$?

# ── Coverage-directed selection, SHADOW PHASE ────────────────────────────────
# Reports what a coverage-driven selector WOULD have chosen and never acts on it.
#
# ORDER IS LOAD-BEARING: AFTER the suite, BEFORE fold_selection_index.
#   - after pytest, because the comparison needs THIS run's junit. Running it
#     first read the PREVIOUS run's report, so the join collapsed to 0% and the
#     failure set belonged to a different commit -- an observation attributing
#     the wrong failures to the wrong change.
#   - before fold_selection_index, because that is the only thing that mutates
#     the index. Selecting with knowledge gained from the very run being
#     evaluated would make every observation look perfect.
#
# It must never fail the run it is shadowing: `|| true` here, and the helper
# itself catches broadly and exits 0. A selector that reddens the suite it is
# measuring gets switched off, and then there is no evidence at all.
#
# IT COMPARES AGAINST `MANIFEST_TESTS`, NOT `AFFECTED_TESTS`, and that is not a
# detail. Once Phase 2 unions coverage's picks INTO the local run set, comparing
# against the local run set asks "did coverage select anything the run set —
# which now contains coverage's selection — was missing?", whose answer is 0 by
# construction. EXTRA_FROM_COVERAGE is precisely WI-kuliv's own justification
# metric (7 of the first 10 observations added a test), so the phase would have
# silently destroyed the ability to keep measuring itself, and the resulting
# flatline would have read as "coverage stopped finding anything".
# `MANIFEST_TESTS` is the pre-union set — the static slice plus its declarative
# augmentations — which is exactly what the first 10 observations were compared
# against, so the time series stays continuous across the phase boundary.
if [[ "$SELECT_SHADOW" == "true" ]] && [[ -n "$CHANGED_FILES" ]]; then
    _sel_changed=$(mktemp); _sel_actual=$(mktemp)
    echo "$CHANGED_FILES" | grep -E '\.py$' > "$_sel_changed" || true
    echo "$MANIFEST_TESTS" | sed '/^$/d' > "$_sel_actual" || true
    "$REPO_ROOT/scripts/coverage-select" --repo-root "$REPO_ROOT" \
        --junit "$JUNIT_XML" shadow \
        --changed-files "$_sel_changed" --actual-tests "$_sel_actual" \
        --base "${BASELINE:-HEAD}" \
        --sha "$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)" \
        --json "$MANIFEST_DIR/selection-shadow.json" || true
    rm -f "$_sel_changed" "$_sel_actual"
fi

fold_selection_index

# If tests passed, check coverage for just the changed source files
if [[ $TEST_EXIT -eq 0 ]] && [[ -n "$CHANGED_SOURCE_FILES" ]]; then
    echo ""
    echo "Checking 100% coverage for changed source files..."

    # Skip auto-generated files (e.g. scripts/build-scip-proto output under
    # */scip/_generated/). --include bypasses coverage omit lists, so we
    # have to filter here too.
    COVERABLE_CHANGED_FILES=$(echo "$CHANGED_SOURCE_FILES" | grep -v '/_generated/' || echo "")
    if [[ -z "$COVERABLE_CHANGED_FILES" ]]; then
        _cov_verdict="✅ No coverable changed source files (all are auto-generated)"
        echo "$_cov_verdict"; echo "$_cov_verdict" >> "$PYTEST_LOG"
        exit 0
    fi

    # Build --include pattern for changed files
    INCLUDE_PATTERN=$(echo "$COVERABLE_CHANGED_FILES" | tr '\n' ',' | sed 's/,$//')

    # Run the scoped coverage report and DISTINGUISH three outcomes (WI-kalub
    # Step 1c) instead of collapsing them all into a false-red:
    #   rc 0                       -> every included changed file at 100%   (PASS)
    #   "No data to report" (rc 1) -> the affected-test slice did not exercise
    #       these files (e.g. subprocess-only coverage). With the branch-own
    #       baseline (Step 1a/1d) the changed files are normally exercised, but a
    #       subprocess-only file legitimately has no data. This is NOT a coverage
    #       regression — do not false-red; whole-codebase 100% is enforced by the
    #       full-suite teeth + nightly.                                     (WARN)
    #   real <100% (rc 2)          -> a changed file is genuinely under-covered (FAIL)
    # The `if coverage …; then … elif … else` form keeps this `set -e`-safe (the
    # condition consumes coverage's non-zero exit). Verdicts are also appended to
    # $PYTEST_LOG (Step 1e) so the captured .ci/pytest-output.log carries the
    # scoped signal, not just smart-test's stdout.
    _cov_out=$(mktemp)
    if coverage report --include="$INCLUDE_PATTERN" --fail-under=100 > "$_cov_out" 2>&1; then
        _cov_verdict="✅ All changed source files are at 100% coverage"
        echo "$_cov_verdict"; echo "$_cov_verdict" >> "$PYTEST_LOG"
    elif grep -q "No data to report" "$_cov_out"; then
        _cov_verdict="⚠️  No coverage data for changed source files under the affected-test slice (not exercised, e.g. subprocess-only) — not gating; full-suite + nightly enforce whole-codebase 100%."
        echo "$_cov_verdict"; echo "$_cov_verdict" >> "$PYTEST_LOG"
    else
        {
            echo ""
            echo "❌ Changed source files are not at 100% coverage:"
            cat "$_cov_out"
            echo "Run the full suite to see overall coverage: pytest --full"
        } | tee -a "$PYTEST_LOG"
        rm -f "$_cov_out"
        exit 1
    fi
    rm -f "$_cov_out"
fi

exit $TEST_EXIT


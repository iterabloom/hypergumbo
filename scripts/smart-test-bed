#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Score smart-test's selectors on a small repo, in seconds (WI-damom).

WHY A SECOND REPO. Iterating a selector against this one is slow and noisy:
~30k tests, a comment-only change to a hub module selects ~800 test files, and
the selection index carries history no test controls. The bed under
``tests/fixtures/smart-test-bed/`` holds one of each selection scenario in two
small packages laid out like this repo (``packages/<pkg>/src``,
``packages/<pkg>/tests``, root ``tests/``), so the REAL ``scripts/smart-test``
runs against it unmodified, in its target mode (``SMART_TEST_TARGET_ROOT``).
Its files are stored with a ``.in`` suffix so nothing here collects, lints or
analyses them as this repo's own code; materializing strips it.

WHAT ONE EDIT COSTS. Each edit gets a fresh copy of the bed committed as the
base, then:

  1. ``smart-test --full`` on the clean tree runs the bed's suite with
     per-test coverage contexts and folds them into a FRESH selection index
     (out of the bed, so it is never a change). Fresh on purpose: an index
     with history no scenario controls is the noise this exists to remove.
  2. The edit is applied to the working tree and ``smart-test --manifest
     --narrow`` computes one selection. ``SMART_TEST_SELECTION_OUT`` hands back
     all four stages: the MANIFEST (static slice plus its declarative
     unions, what CI runs), PROSE (the manifest after the prose-only rule,
     which drops the tests a comment-or-docstring change cannot affect), the
     UNION (plus coverage's picks, WI-kuliv), and the NARROWED local run set
     (WI-bolot). Each later stage starts from the one before it. A run that exits early (a
     full-suite fallback, nothing to run) writes no stages, and every
     selector is then read from the manifest, which is what such a run
     actually executes.
  3. The ORACLE. ``mutate`` edits: every block the edit changed
     (hypergumbo_core.block_hash digests, the selection index's own unit)
     gets a ``raise`` as its first statement, every changed data file is
     corrupted, and the bed's suite runs. A test that passed on the base and
     does not pass now executes changed code: it is MUST-select, a sound
     floor rather than a guess. ``text`` edits change no behaviour, so the
     mutation is skipped and only the edited tree's own failures count.
     Either way MUST adds readers.yaml's readers of every touched file and
     the edit's hand-written ``must``.

SCORING is per test FILE, smart-test's unit. ``dropped`` = MUST files the
selector left out, never acceptable; ``extra`` = selected files outside MUST,
the cost; ``should_not`` = selected files from the edit's hand-written list of
tests with no path to the change.

NOT CHECKED HERE. Whether the bed resembles this repo's real change mix. It
holds one of each shape, so totals over edits are not a forecast of savings
on real PRs; they compare selectors on the same shapes.

Usage:
    scripts/smart-test-bed run [all|manifest|prose|union|narrow] [--edit NAME]...
                               [--jobs N] [--json FILE] [--keep]
    scripts/smart-test-bed materialize DIR      # a committed bed to poke at
    scripts/smart-test-bed list                 # the edits

Needs the dev environment active (pytest, pytest-cov, coverage on PATH) and a
stable hypergumbo where smart-test looks for one.
"""
from __future__ import annotations

import argparse
import ast
import concurrent.futures
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent.parent
BED = REPO / "tests" / "fixtures" / "smart-test-bed"
SMART_TEST = REPO / "scripts" / "smart-test"
SELECTORS = ("manifest", "prose", "union", "narrow")
STAGE_FILES = {"manifest": "manifest.txt", "prose": "after-prose.txt",
               "union": "after-union.txt", "narrow": "local.txt"}
TEST_ROOTS = ("packages/bed-core/tests", "packages/bed-app/tests", "tests")

sys.path.insert(0, str(REPO / "packages" / "hypergumbo-core" / "src"))
from hypergumbo_core.block_hash import MODULE_BLOCK, Block, blocks_for_source  # noqa: E402

GITIGNORE = "__pycache__/\n.pytest_cache/\n.coverage*\n.ci/\n"
MUTANT = 'raise RuntimeError("smart-test-bed mutant: {where}")'


class BedError(RuntimeError):
    """The bed or an edit is malformed; the scores would mean nothing."""


@dataclass
class Score:
    edit: str
    mode: str
    must: list[str]
    selected: dict[str, list[str]]
    should_not: list[str]
    must_tests: list[str] = field(default_factory=list)
    #: The local run set in the order smart-test would hand it to pytest.
    run_order: list[str] = field(default_factory=list)


def load_edits(bed: Path = BED) -> list[dict]:
    return yaml.safe_load((bed / "edits.yaml").read_text())


def load_readers(bed: Path = BED) -> dict[str, list[str]]:
    return yaml.safe_load((bed / "readers.yaml").read_text())


def _git(root: Path, *args: str) -> str:
    return subprocess.run(["git", *args], cwd=root, check=True,
                          capture_output=True, text=True).stdout


def materialize(dest: Path, bed: Path = BED) -> Path:
    """Copy tree/ to ``dest`` without the .in suffix, and commit it as base."""
    tree = bed / "tree"
    for src in sorted(tree.rglob("*.in")):
        out = dest / src.relative_to(tree).with_suffix("")
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, out)
    (dest / ".gitignore").write_text(GITIGNORE)
    _git(dest, "init", "-q", "-b", "dev")
    _git(dest, "add", "-A")
    _git(dest, "-c", "user.name=smart-test-bed",
         "-c", "user.email=bed@example.invalid", "commit", "-qm", "base")
    return dest


def apply_edit(root: Path, edit: dict) -> list[str]:
    """Apply ``edit``'s ops to the working tree; return the touched paths."""
    touched: list[str] = []
    for op in edit["ops"]:
        rel = op["file"]
        path = root / rel
        touched.append(rel)
        if op.get("delete"):
            path.unlink()
        elif "write" in op:
            path.write_text(op["write"])
        elif "append" in op:
            path.write_text(path.read_text() + op["append"])
        else:
            text = path.read_text()
            if text.count(op["old"]) != 1:
                raise BedError(f"{edit['name']}: `old` occurs "
                               f"{text.count(op['old'])} times in {rel}")
            path.write_text(text.replace(op["old"], op["new"]))
    return touched


def changed_blocks(path: str, base: str | None, new: str) -> list[Block]:
    """Blocks of ``new`` whose digest differs from ``base`` or is new there."""
    before = {b.name: b.digest for b in blocks_for_source(path, base)} if base else {}
    return [b for b in blocks_for_source(path, new) if before.get(b.name) != b.digest]


def _is_preamble(stmt: ast.stmt, index: int) -> bool:
    docstring = (index == 0 and isinstance(stmt, ast.Expr)
                 and isinstance(stmt.value, ast.Constant)
                 and isinstance(stmt.value.value, str))
    future = isinstance(stmt, ast.ImportFrom) and stmt.module == "__future__"
    return docstring or future


def _body_of(tree: ast.Module, block: Block) -> tuple[list[ast.stmt], int]:
    """The statement list ``block`` owns, and the line its header ends on."""
    if block.name == MODULE_BLOCK:
        return tree.body, 0
    for node in ast.walk(tree):
        if (isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
                and node.body[0].lineno == block.first_line):
            return node.body, node.lineno
    raise BedError(f"no AST node owns block {block.name} at line {block.first_line}")


def mutate_source(path: str, source: str, blocks: list[Block]) -> str:
    """``source`` with a ``raise`` heading each of ``blocks``' own statements.

    It goes before the first statement that is not a docstring or a
    ``__future__`` import, so ``__doc__`` survives and the module still
    compiles; after the last statement when there is no such statement. A body
    on its header's line has nowhere to put it, and is refused.
    """
    tree = ast.parse(source)
    lines = source.splitlines(keepends=True)
    inserts: list[tuple[int, str]] = []
    for block in blocks:
        body, header = _body_of(tree, block)
        rest = [s for i, s in enumerate(body) if not _is_preamble(s, i)]
        if rest:
            target = rest[0]
            starts = [target.lineno] + [d.lineno for d in getattr(target, "decorator_list", [])]
            at, indent = min(starts) - 1, target.col_offset
        elif body:
            at, indent = body[-1].end_lineno or body[-1].lineno, body[-1].col_offset
        else:
            at, indent = len(lines), 0
        if header and at < header:
            raise BedError(f"{path}:{block.name}: one-line body, cannot mutate")
        where = f"{path}:{block.name}"
        inserts.append((at, " " * indent + MUTANT.format(where=where) + "\n"))
    for at, text in sorted(inserts, reverse=True):
        lines.insert(at, text)
    return "".join(lines)


def mutate(root: Path, touched: list[str]) -> None:
    """Make every changed block raise and every changed data file unreadable."""
    for rel in touched:
        path = root / rel
        if not path.exists():
            continue
        if rel.endswith(".py"):
            base = subprocess.run(["git", "show", f"HEAD:{rel}"], cwd=root,
                                  capture_output=True, text=True)
            before = base.stdout if base.returncode == 0 else None
            blocks = changed_blocks(rel, before, path.read_text())
            path.write_text(mutate_source(rel, path.read_text(), blocks))
        else:
            path.write_text("smart-test-bed mutant: corrupted data\n")


def _clean_env() -> dict[str, str]:
    env = {k: v for k, v in os.environ.items()
           if k not in ("CI", "PYTEST_ADDOPTS", "SMART_TEST_ACTIVE")}
    return env


def passing_tests(root: Path) -> set[str]:
    """Node ids that PASS on the tree at ``root``; collection errors pass none."""
    done = subprocess.run(
        [sys.executable, "-m", "pytest", "-q", "-rA", "-p", "no:cacheprovider",
         "--continue-on-collection-errors", "-o", "addopts=", *TEST_ROOTS],
        cwd=root, capture_output=True, text=True, env=_clean_env())
    return {line.split()[1] for line in done.stdout.splitlines()
            if line.startswith("PASSED ")}


def _glob_regex(pattern: str) -> re.Pattern[str]:
    out = re.escape(pattern).replace(r"\*\*/", "(?:.*/)?").replace(r"\*", "[^/]*")
    return re.compile(out + "$")


def readers_of(touched: list[str], readers: dict[str, list[str]]) -> set[str]:
    return {test for test, globs in readers.items()
            for rel in touched for g in globs if _glob_regex(g).match(rel)}


def run_smart_test(root: Path, index: Path, *args: str) -> subprocess.CompletedProcess:
    env = _clean_env()
    env.update(SMART_TEST_TARGET_ROOT=str(root), BASE_BRANCH="HEAD",
               HG_SELECTION_INDEX=str(index),
               HG_SELECTION_LOG=str(index.with_suffix(".jsonl")),
               SMART_TEST_SELECTION_OUT=str(root / ".ci" / "selection"))
    return subprocess.run([str(SMART_TEST), *args, "-n0"], cwd=root,
                          capture_output=True, text=True, env=env)


def read_manifest(root: Path) -> tuple[str, list[str]]:
    text = (root / ".ci" / "affected-tests.txt").read_text()
    mode = re.search(r"^# Mode: (\S+)", text, re.MULTILINE)
    tests = text.split("# === SELECTED_TESTS ===", 1)[1]
    return (mode.group(1) if mode else "unknown",
            sorted(t for t in tests.split() if not t.startswith("#")))


def score_edit(edit: dict, readers: dict[str, list[str]], work: Path) -> Score:
    root = materialize(work / "bed")
    index = work / "index.sqlite"
    base = run_smart_test(root, index, "--full")
    if base.returncode != 0:
        raise BedError(f"{edit['name']}: the base bed is not green:\n{base.stdout[-2000:]}")
    if not index.exists():
        raise BedError(f"{edit['name']}: smart-test --full built no index at {index}")
    base_pass = passing_tests(root)

    touched = apply_edit(root, edit)
    sel = run_smart_test(root, index, "--manifest", "--narrow")
    if sel.returncode != 0:
        raise BedError(f"{edit['name']}: smart-test --manifest failed:\n{sel.stderr[-2000:]}")
    mode, manifest = read_manifest(root)
    stages = root / ".ci" / "selection"
    selected = {}
    for name in SELECTORS:
        stage = stages / STAGE_FILES[name]
        selected[name] = sorted(stage.read_text().split()) if stage.exists() else manifest
    order_file = stages / "run-order.txt"
    run_order = order_file.read_text().split() if order_file.exists() else []

    if edit.get("oracle", "mutate") == "mutate":
        mutate(root, touched)
    broken = sorted(base_pass - passing_tests(root))
    must = ({t.split("::")[0] for t in broken} | readers_of(touched, readers)
            | set(edit.get("must", [])))
    return Score(edit=edit["name"], mode=mode, must=sorted(must),
                 selected=selected, should_not=sorted(edit.get("should_not", [])),
                 must_tests=broken, run_order=run_order)


def run(edits: list[dict], jobs: int, keep: bool) -> list[Score]:
    readers = load_readers()
    top = Path(tempfile.mkdtemp(prefix="smart-test-bed-"))
    try:
        def one(edit: dict) -> Score:
            work = top / edit["name"]
            work.mkdir()
            return score_edit(edit, readers, work)
        with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
            return list(pool.map(one, edits))
    finally:
        if keep:
            print(f"kept: {top}", file=sys.stderr)
        else:
            shutil.rmtree(top, ignore_errors=True)


def first_must_rank(order: list[str], must: list[str]) -> int | None:
    """1-based position in ``order`` of the first test an edit can break."""
    wanted = set(must)
    return next((i for i, test in enumerate(order, 1) if test in wanted), None)


def order_table(scores: list[Score]) -> str:
    """Where the first MUST test runs: sorted by path (the old order) against
    smart-test's failure-first order, over the same local run set."""
    rows = ["run order: position of the first MUST-select test",
            f"{'edit':<22}{'run set':>8}{'by path':>9}{'failure-first':>15}"]
    for s in scores:
        if not s.run_order:
            continue
        old = first_must_rank(sorted(s.run_order), s.must)
        new = first_must_rank(s.run_order, s.must)
        rows.append(f"{s.edit:<22}{len(s.run_order):>8}{old or '-':>9}{new or '-':>15}")
    return "\n".join(rows)


def table(scores: list[Score], selector: str) -> str:
    rows = [f"selector: {selector}",
            f"{'edit':<22}{'mode':<12}{'must':>5}{'sel':>5}{'dropped':>9}"
            f"{'extra':>7}{'should_not':>12}"]
    drops = []
    for s in scores:
        chosen = set(s.selected[selector])
        dropped = sorted(set(s.must) - chosen)
        rows.append(f"{s.edit:<22}{s.mode:<12}{len(s.must):>5}{len(chosen):>5}"
                    f"{len(dropped):>9}{len(chosen - set(s.must)):>7}"
                    f"{len(chosen & set(s.should_not)):>12}")
        drops += [f"  {s.edit}: {d}" for d in dropped]
    rows.append("DROPPED MUST-SELECT (never acceptable):" if drops else
                "DROPPED MUST-SELECT: none")
    return "\n".join(rows + drops)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("selector", nargs="?", default="all", choices=("all", *SELECTORS))
    r.add_argument("--edit", action="append", default=[])
    r.add_argument("--jobs", type=int, default=min(8, os.cpu_count() or 1))
    r.add_argument("--json", default=None)
    r.add_argument("--keep", action="store_true")
    m = sub.add_parser("materialize")
    m.add_argument("dest")
    sub.add_parser("list")
    args = parser.parse_args(argv)

    edits = load_edits()
    if args.cmd == "list":
        for e in edits:
            print(f"{e['name']:<22}{e.get('oracle', 'mutate')}")
        return 0
    if args.cmd == "materialize":
        dest = Path(args.dest)
        dest.mkdir(parents=True, exist_ok=False)
        print(materialize(dest))
        return 0
    if args.edit:
        unknown = set(args.edit) - {e["name"] for e in edits}
        if unknown:
            parser.error(f"unknown edit(s): {sorted(unknown)}")
        edits = [e for e in edits if e["name"] in args.edit]
    try:
        scores = run(edits, args.jobs, args.keep)
    except BedError as exc:
        print(f"smart-test-bed: {exc}", file=sys.stderr)
        return 2
    chosen = SELECTORS if args.selector == "all" else (args.selector,)
    print("\n\n".join([*(table(scores, s) for s in chosen), order_table(scores)]))
    if args.json:
        Path(args.json).write_text(json.dumps([s.__dict__ for s in scores], indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

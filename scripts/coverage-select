#: Out-of-repo by default, like test_timings.json: this is rewritten on every
#: run and must never dirty the working tree.
DEFAULT_INDEX = Path(
    os.environ.get("HG_SELECTION_INDEX",
                   Path.home() / "hypergumbo_lab_notebook" / "selection_index.sqlite")
)

#: APPEND-ONLY, and out-of-repo for the same reason as the index. The
#: observations are a forward-only time series: a per-run file that the next
#: run overwrites would accumulate no evidence, and a lost run is lost
#: permanently.
DEFAULT_LOG = Path(
    os.environ.get("HG_SELECTION_LOG",
                   Path.home() / "hypergumbo_lab_notebook" / "selection_observations.jsonl")
)


_NOTEBOOK = Path.home() / "hypergumbo_lab_notebook"

#: The stale-graph shadow's observations and the run records. Out-of-repo and append-only, like DEFAULT_LOG.
DEFAULT_STALE_LOG = Path(os.environ.get(
    "HG_STALE_GRAPH_LOG", _NOTEBOOK / "stale_graph_observations.jsonl"))
DEFAULT_RUNS = Path(os.environ.get("HG_RUN_RECORDS", _NOTEBOOK / "run_records.jsonl"))

#: A package source file, as the reverse slice is seeded with one.
_SLICED_SOURCE_PATH = re.compile(r"^packages/.*/src/.*\.py$")

#: Untracked files that count as part of a change: the surfaces smart-test's
#: own change detection reads (INV-kinin). Pending tracker ops never do.
_CHANGE_SURFACE = re.compile(r"^(packages/|tests/|scripts/|\.githooks/|\.agent/hooks/)")


def _lines(path: str | None) -> list[str]:
    if not path or not Path(path).exists():
        return []
    return [ln.strip() for ln in Path(path).read_text().splitlines() if ln.strip()]


def cmd_update(args: argparse.Namespace) -> int:
    root = Path(args.repo_root).resolve()
    ran = None
    if args.junit and Path(args.junit).exists():
        ran = ran_tests_from_junit(Path(args.junit), root)
    conn = open_index(Path(args.index))
    count = "SELECT COUNT(*) FROM unmeasured_test"
    before = conn.execute(count).fetchone()[0]
    # Which tests used which shared fixture: read before fold_run (below)
    # removes the record. No record directory leaves it None, and the fold
    # then stores shared-work rows as code run under no test.
    reads = Path(args.source_reads) if args.source_reads else None
    shared = update_from_run(
        conn, Path(args.coverage_db),
        ran_tests=ran, git_sha=args.sha, full_run=args.full, repo_root=root,
        scope_complete=args.scope_complete,
        shared_users=shared_work_used(reads) if reads is not None and reads.is_dir() else None,
    )
    if shared.contexts and (args.full or args.verbose or shared.unused):
        # Said whenever a context went unused: its code is then held back
        # from narrowing, and a run where that happens to all of them looks
        # like any other.
        print(f"[coverage-select] shared work: {shared.contexts} fixture context(s) "
              f"with measured code; {shared.inheriting_tests} test(s) given their rows; "
              f"{len(shared.unused)} context(s) no test is recorded using"
              + (f" ({', '.join(shared.unused[:3])}"
                 f"{', ...' if len(shared.unused) > 3 else ''})" if shared.unused else ""),
              file=sys.stderr)
    if args.full:
        # Said on every full run, the only run that rewrites the list: it is
        # what keeps narrowing from dropping a test coverage cannot see into,
        # and it once fell from 6,916 to 227 with nothing printed anywhere.
        print(f"[coverage-select] full run: coverage cannot speak for "
              f"{conn.execute(count).fetchone()[0]} test(s) (their own call ran no "
              f"measured code); {before} before this run", file=sys.stderr)
    # After the coverage fold, not before: a full run resets both, and the
    # prose-only rule reads the two together.
    if args.source_reads and Path(args.source_reads).is_dir():
        stored = fold_run(conn, Path(args.source_reads), root, full_run=args.full,
                          skip=_failed(args, root))
        _forget(Path(args.source_reads))
        if args.verbose:
            print(f"[coverage-select] stored source reads for {stored} tests",
                  file=sys.stderr)
    conn.close()
    if args.verbose:
        print(f"[coverage-select] indexed {len(ran or ())} ran tests", file=sys.stderr)
    return 0


def _failed(args: argparse.Namespace, root: Path) -> set[str]:
    if args.junit and Path(args.junit).exists():
        return failed_tests_from_junit(Path(args.junit), root)
    return set()


def cmd_fold_reads(args: argparse.Namespace) -> int:
    """Store a run's read record and nothing else, then remove the record
    files. For a RED run, whose coverage is not folded into the index, and
    for the record a KILLED run left behind.

    The record names the tests that failed and they are not stored; a junit
    report, when there is one, names them again.
    """
    root = Path(args.repo_root).resolve()
    reads = Path(args.source_reads)
    if not any(reads.glob("*.json")):
        return 0
    conn = open_index(Path(args.index))
    stored = fold_run(conn, reads, root, skip=_failed(args, root))
    conn.close()
    _forget(reads)
    if args.verbose or args.announce:
        print(f"[coverage-select] stored the read record of {stored} test(s)",
              file=sys.stderr)
    return 0


def _forget(reads: Path) -> None:
    """Remove record files that have been stored, so that what is left in the
    directory is always a record nobody stored yet."""
    for part in reads.glob("*.json"):
        part.unlink(missing_ok=True)


def _base_source(root: Path, base: str, rel: str) -> str | None:
    """Contents of ``rel`` at commit ``base``, or None if it did not exist.

    Change detection is GIT's job. The index stores block -> tests and nothing
    about what the tree used to look like: it is rewritten after every run, so
    using its digests as the baseline would compare the working tree against
    itself and select nothing.
    """
    done = subprocess.run(["git", "-C", str(root), "show", f"{base}:{rel}"],
                          capture_output=True, text=True)
    return done.stdout if done.returncode == 0 else None


def cmd_shadow(args: argparse.Namespace) -> int:
    root = Path(args.repo_root).resolve()
    changed = _lines(args.changed_files)
    if not changed:
        return 0
    base_sources = {
        str(root / c): _base_source(root, args.base, c) for c in changed
    }
    conn = open_index(Path(args.index))
    selection = select_tests(conn, base_sources)
    known = failed = None
    if args.junit and Path(args.junit).exists():
        known = ran_tests_from_junit(Path(args.junit), root)
        failed = failed_tests_from_junit(Path(args.junit), root)
    # Index paths are absolute; smart-test speaks repo-relative. Rebase before
    # comparing or every file differs and the report is pure noise.
    rebased = rebase_to_repo(selection.tests, root)
    report = compare(
        type(selection)(
            tests=frozenset(rebased),
            changed_blocks=selection.changed_blocks,
            new_blocks=selection.new_blocks,
            unknown_paths=selection.unknown_paths,
            unmeasured=selection.unmeasured,
            missing_paths=selection.missing_paths,
        ),
        actual_files=_lines(args.actual_tests),
        known_tests=known,
        failed=failed,
        changed_files=[str(root / c) for c in changed],
    )
    conn.close()
    if args.json:
        Path(args.json).write_text(json.dumps({
            "changed_files": sorted(changed),
            "coverage_tests": sorted(report.coverage_tests),
            "coverage_files": sorted(report.coverage_files),
            "actual_files": sorted(report.actual_files),
            "missed_by_coverage": sorted(report.missed_by_coverage),
            "extra_from_coverage": sorted(report.extra_from_coverage),
            "new_blocks": report.new_blocks,
            "unknown_paths": sorted(report.unknown_paths),
            "missing_paths": sorted(report.missing_paths),
            "unmeasured": report.unmeasured,
            "join_rate": report.join_rate,
            "trustworthy": report.trustworthy,
        }, indent=2))
    append_observation(Path(args.log), report, sha=args.sha or "unknown")
    print("[coverage-select] SHADOW — reporting only, nothing acted on",
          file=sys.stderr)
    print(report.summary(), file=sys.stderr)
    return 0


def cmd_select(args: argparse.Namespace) -> int:
    """Print repo-relative test FILES coverage selects, one per line.

    HOW THIS DIFFERS FROM ``shadow``, given both compute the same selection:
    shadow needs THIS run's junit, so it can only run after pytest and can only
    report. A caller that intends to widen the run set needs the same answer
    BEFORE pytest, with no junit in existence yet. Hence a second entry point
    over one shared selection, rather than a flag on the first.

    The output is filtered to files that exist (``selectable_test_files``): the
    index is persistent and remembers renamed or deleted tests, and pytest
    treats a missing path as a collection error. Stdout is the interface —
    diagnostics go to stderr — and an empty selection prints nothing, which
    unions to a no-op.
    """
    root = Path(args.repo_root).resolve()
    changed = _lines(args.changed_files)
    if not changed:
        return 0
    base_sources = {
        str(root / c): _base_source(root, args.base, c) for c in changed
    }
    conn = open_index(Path(args.index))
    selection = select_tests(conn, base_sources)
    conn.close()
    files = selectable_test_files(selection.tests, root)
    for f in sorted(files):
        print(f)
    if args.verbose:
        print(f"[coverage-select] select: {len(files)} file(s) from "
              f"{len(selection.tests)} node id(s)", file=sys.stderr)
    return 0


def cmd_narrow(args: argparse.Namespace) -> int:
    """Print the run set with safely-irrelevant test files REMOVED.

    Reads the current run set on ``--run-set`` and prints what survives, one
    file per line (history: WI-bolot). Refusals go to stderr and the run set is
    echoed back UNCHANGED, so a caller can pipe unconditionally.

    HOW THIS DIFFERS FROM `select`, since both consult the same index. `select`
    answers "what does coverage think is relevant" and is unioned IN. `narrow`
    answers "which of these can I prove is irrelevant" and takes things OUT,
    which is a strictly stronger claim and carries the three rules in
    :mod:`hypergumbo_core.selection_index` — drop only with positive evidence,
    keep the whole file-touch set (the local coverage gate is whole-file, not
    changed-lines), and refuse outright on an unknown coverable source or a
    missing changed file.

    POSITIVE EVIDENCE is ``droppable_test_files``: the test file's latest run
    in this checkout measured every package, the changed source files among
    them, and left rows for each of its tests. A file with rows from a run
    that measured less is kept, and the count of such files is printed.
    """
    root = Path(args.repo_root).resolve()
    run_set = _lines(args.run_set)
    if not run_set:
        return 0
    changed = _lines(args.changed_files)
    if not changed:
        for f in run_set:
            print(f)
        return 0

    abs_changed = [str(root / c) for c in changed]
    base_sources = {
        p: _base_source(root, args.base, c)
        for p, c in zip(abs_changed, changed, strict=True)
    }
    conn = open_index(Path(args.index))
    selection = select_tests(conn, base_sources)
    keep = (touching_test_files(conn, abs_changed, root)
            | selectable_test_files(selection.tests, root))
    droppable = droppable_test_files(conn, root, abs_changed)
    result: Narrowing = narrow_run_set(
        run_set,
        keep=keep,
        droppable=droppable,
        forbidden=narrowing_blockers(selection, root),
        changed=changed,
    )
    # Files with rows, none on the change, that stay because their latest run
    # does not vouch for that silence.
    uninformed = ((speakable_test_files(conn, root) - droppable)
                  & frozenset(run_set)) - keep - frozenset(changed)
    conn.close()

    for f in sorted(result.kept):
        print(f)
    if result.refusal:
        print(f"[coverage-select] narrow REFUSED: {result.refusal}",
              file=sys.stderr)
    else:
        held = (f"; kept {len(uninformed)} more whose latest run did not "
                "measure the change with every package measured"
                if uninformed else "")
        print(f"[coverage-select] narrow: {len(run_set)} -> "
              f"{len(result.kept)} file(s), dropped {len(result.dropped)}{held}",
              file=sys.stderr)
        if args.verbose:
            for f in sorted(result.dropped):
                print(f"    - {f}", file=sys.stderr)
    return 0


def _read(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None


#: Every test file smart-test can select: the full suite's roots, flat.
_TEST_FILE = r"^(packages/[^/]+/tests/(test_|BRANCHES_test_)[^/]*\.py|tests/test_[^/]*\.py)$"


def cmd_prose_select(args: argparse.Namespace) -> int:
    """Write the prose-only changed files to ``--files-out`` and the test
    files they select to ``--tests-out``, one path per line.

    An empty ``--files-out`` means "no prose-only file"; NO file means the
    rule did not answer (it refused, or this command failed), and the caller
    must then select for every changed file by its usual means.
    """
    root = Path(args.repo_root).resolve()
    conn = open_index(Path(args.index))
    refusal = global_refusal(conn)
    if refusal:
        print(f"[coverage-select] prose-only rule off: {refusal}", file=sys.stderr)
        conn.close()
        return 0
    changed = {
        rel: (_base_source(root, args.base, rel), _read(root / rel))
        for rel in _lines(args.changed_files) if rel.endswith(".py")
    }
    listed = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z", "--cached", "--others",
         "--exclude-standard"], capture_output=True, text=True, check=True).stdout
    universe = [rel for rel in listed.split("\0")
                if re.match(_TEST_FILE, rel) and (root / rel).is_file()]
    result = select_for_prose(conn, root, changed, universe)
    conn.close()
    for rel, why in sorted(result.rejected.items()):
        print(f"[coverage-select] prose-only but not eligible: {rel} ({why})",
              file=sys.stderr)
    if result.files:
        why_counts: dict[str, int] = {}
        for why in result.tests.values():
            # "reads <what>" and "starts a process (<what>)" vary per test file.
            key = why.split(" (")[0] if why.startswith("starts") else \
                "reads a changed file, docstring or line number" \
                if why.startswith("reads ") else why
            why_counts[key] = why_counts.get(key, 0) + 1
        print(f"[coverage-select] prose-only: {len(result.files)} file(s) select "
              f"{len(result.tests)} of {len(universe)} test file(s)", file=sys.stderr)
        for key, count in sorted(why_counts.items(), key=lambda kv: (-kv[1], kv[0])):
            print(f"    {count:5d}  {key}", file=sys.stderr)
        if args.verbose:
            for f, why in sorted(result.tests.items()):
                print(f"    {f}: {why}", file=sys.stderr)
    Path(args.tests_out).write_text("".join(f"{f}\n" for f in sorted(result.tests)))
    Path(args.files_out).write_text("".join(f"{f}\n" for f in sorted(result.files)))
    return 0


def cmd_readers(args: argparse.Namespace) -> int:
    """Print the test FILES recorded reading a changed file as data, one per
    line (``prose_only.tests_reading``).

    For a CODE change. A test that checks source files by reading them from
    disk imports none of them, so the import-graph slice does not select it;
    smart-test unions this answer into the manifest. Files that no longer
    exist are left out: the record is persistent and pytest treats a missing
    path as a collection error. An empty answer prints nothing.
    """
    root = Path(args.repo_root).resolve()
    changed = [c for c in _lines(args.changed_files) if c.endswith(".py")]
    if not changed:
        return 0
    conn = open_index(Path(args.index))
    found = tests_reading(conn, changed)
    conn.close()
    files = sorted(f for f in found if (root / f).is_file())
    for f in files:
        print(f)
    if args.verbose:
        for f in files:
            print(f"[coverage-select] readers: {f} reads {found[f]}",
                  file=sys.stderr)
    return 0


def cmd_import_closure(args: argparse.Namespace) -> int:
    """Print the test FILES whose imports reach a changed source file whose
    IMPORT-TIME code changed (a module or class body, or a function the index
    saw run under no test's context), one per line.

    The call-edge slice lists a module that imports the changed file but
    reaches a test of that module only through a call into the changed file.
    A constant read, a module attribute read and a value computed at import
    are not calls, so such a test was left out of the manifest
    (:mod:`hypergumbo_core.import_closure` has the case and the cost).
    smart-test unions this answer in.

    The graph is read from the working tree: every Python file git tracks or
    would track. A changed body of a function that runs only inside tests is
    not a trigger; the slice and the coverage record select for it. An empty
    answer prints nothing.
    """
    root = Path(args.repo_root).resolve()
    changed = [c for c in _lines(args.changed_files) if c.endswith(".py")]
    if not changed:
        return 0
    base_sources = {str(root / c): _base_source(root, args.base, c) for c in changed}
    # With the index: a changed function it saw run at import is import-time
    # code too, and an import inside such a function is an edge of the graph.
    # Without one, the kinds of block and the import statements alone decide.
    at_import: dict[str, frozenset[str]] = {}
    if Path(args.index).exists():
        with contextlib.closing(open_index(Path(args.index))) as conn:
            hit = import_time_changed_sources(base_sources, root, conn)
            prefix = f"{root}/"
            at_import = {path[len(prefix):]: names
                         for path, names in functions_run_at_import(conn).items()
                         if path.startswith(prefix)}
    else:
        hit = import_time_changed_sources(base_sources, root)
    if not hit:
        return 0
    listed = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z", "--cached", "--others",
         "--exclude-standard", "--", "*.py"],
        capture_output=True, text=True, check=True).stdout
    sources = {rel: text for rel in listed.split("\0")
               if rel and (text := _read(root / rel)) is not None}
    graph = build_import_graph(sources, gone=[h for h in hit if h not in sources],
                               at_import=at_import)
    tests = sorted(f for f in graph.dependents(hit) if re.match(_TEST_FILE, f))
    for f in tests:
        print(f)
    print(f"[coverage-select] import-closure: {len(hit)} file(s) with changed "
          f"import-time code are loaded by {len(tests)} test file(s)",
          file=sys.stderr)
    if args.verbose:
        for h in hit:
            mine = sum(1 for f in graph.dependents([h]) if re.match(_TEST_FILE, f))
            print(f"    {mine:5d}  {h}", file=sys.stderr)
    return 0


def cmd_report(args: argparse.Namespace) -> int:
    """Print the accrued evidence and the phase's verdict."""
    ev = evaluate(load_observations(Path(args.log)))
    print(f"[coverage-select] evidence from {args.log}")
    print(ev.summary())
    return 0


def _git(root: Path, *argv: str, ok: tuple[int, ...] = (0,)) -> bytes | None:
    """stdout of one git command in ``root``; None when it did not succeed."""
    done = subprocess.run(["git", "-C", str(root), *argv],  # noqa: S603, S607
                          capture_output=True)
    return done.stdout if done.returncode in ok else None


def _git_lines(root: Path, *argv: str) -> list[str]:
    out = _git(root, *argv)
    return [ln for ln in (out or b"").decode("utf-8", "replace").splitlines() if ln]


def _now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _head(root: Path) -> str:
    return "".join(_git_lines(root, "rev-parse", "HEAD")) or "unknown"


def _uncommitted(root: Path) -> tuple[list[str], list[str]]:
    """(tracked files that differ from HEAD, untracked files that are part of
    a change). Tracker ``.ops`` files are pending almost always and are no
    part of what a test run is about."""
    tracked = [f for f in _git_lines(root, "diff", "--name-only", "HEAD")
               if not f.endswith(".ops")]
    untracked = [f for f in _git_lines(root, "ls-files", "--others", "--exclude-standard")
                 if _CHANGE_SURFACE.match(f) and not f.endswith(".ops")]
    return tracked, untracked


def cmd_stale_record(args: argparse.Namespace) -> int:
    """Store one row of the stale-graph log and keep the fresh graph.

    The comparison is with what ``graph-select`` WOULD have answered from the
    graphs stored before this one (same analyzer build, another tree): the
    selection smart-test acts on when it does not analyse. A test file the
    fresh walk names, that selection lacks and the change did not edit is a
    miss of the stored graph, and one is enough to disqualify it.
    """
    root = Path(args.repo_root).resolve()
    changed = _lines(args.changed_files)
    head = _head(root)
    fresh_survey = Path(args.fresh_survey) if args.fresh_survey else None
    graph: dict[str, object] | None = None
    stale: frozenset[str] | None = None
    why = args.why
    stale_seconds: float | None = None
    if fresh_survey is not None:
        started = time.monotonic()
        try:
            stored = _select_from_stored(
                root, Path(args.index), changed, build=fresh_survey.parent.name,
                exclude_tree=fresh_survey.parent.parent.name,
                max_age=args.max_age, max_extra_tests=args.max_extra_tests)
        except Exception as exc:
            why = f"the selection from the stored graph failed: {type(exc).__name__}: {exc}"
        else:
            if stored.selection is not None and stored.code == 0:
                stale = sliced_test_files(stored.selection.files, str(root))
                stale_seconds = round(time.monotonic() - started, 1)
                graph = _graph_facts(stored)
            else:
                why = stored.reason
    row = stale_graph_row(
        fresh=sliced_test_files(_lines(args.fresh_out), str(root)),
        stale=stale,
        edited_tests=sliced_test_files(changed, str(root)),
        head=head, at=_now(),
        changed_source=sliceable_sources(changed),
        graph=graph, why_no_comparison=why,
        fresh_seconds=args.fresh_seconds, stale_seconds=stale_seconds,
    )
    append_stale_graph_observation(Path(args.stale_log), row)
    if fresh_survey is not None:
        # The survey is evicted from the cache within hours; its rows stay.
        # Stored AFTER the comparison, which must not meet its own graph.
        _report_stored(_store_graph_rows(
            Path(args.index), fresh_survey, head=head,
            git_tree=_tree_of(root, head), dirty_files=_dirty_files(root)))
    lost = row["fresh_only_unedited"]
    if row["stale"] is None:
        print(f"[coverage-select] stale-graph shadow: no comparison ({why})",
              file=sys.stderr)
    elif lost:
        print(f"[coverage-select] STORED GRAPH LOST {len(lost)} TEST FILE(S) the fresh "
              f"walk names and this change did not edit: {', '.join(lost[:5])}",
              file=sys.stderr)
    else:
        print(f"[coverage-select] stale-graph shadow: a stored graph "
              f"{graph['age_commits'] if graph else '?'} commit(s) old named every unedited "
              f"test file the fresh walk named ({len(row['fresh'])} fresh, "
              f"{len(row['stale'])} from the stored graph)", file=sys.stderr)
    return 0


#: graph-walk's exit codes. A caller ACTS on this command's output, so "there
#: was nothing to walk" and "the walk failed" must never look like "the walk
#: found nothing": 0 is the only code that comes with an answer.
WALK_NO_GRAPH = 3
WALK_FAILED = 4
#: graph-select's two more: a stored graph exists and may not answer.
SELECT_ADDED_FILE = 5
SELECT_TOO_FAR_BEHIND = 6

#: The oldest stored graph smart-test selects from, in commits: the largest
#: age at which a stored graph was compared with a fresh one and lost no test
#: file (the plan's step 1b). Owner ruling, 2026-11-17.
MAX_GRAPH_AGE = 93
#: Test files that only OTHER people's changes since the graph reach. Past
#: this many, a fresh analysis is the cheaper answer: each such file runs in
#: the pull request's CI as well as here.
MAX_EXTRA_TESTS = 150
#: How far back HEAD's history is read for a commit with a graph's tree.
_HISTORY = 500


def _git_z(root: Path, *argv: str) -> list[str]:
    """The NUL-separated names a git command prints; a failed command raises:
    a list git could not give must not read as an empty list."""
    done = subprocess.run(["git", "-C", str(root), *argv],  # noqa: S603, S607
                          capture_output=True)
    if done.returncode != 0:
        raise RuntimeError(f"git {' '.join(argv[:2])} failed: "
                           f"{done.stderr.decode('utf-8', 'replace').strip()[:200]}")
    return [name for name in done.stdout.decode("utf-8", "replace").split("\0") if name]


def _git_knows(root: Path, name: str) -> bool:
    return _git(root, "cat-file", "-e", name) is not None


def _graph_age(root: Path, graph: graph_rows.StoredGraph) -> int | None:
    """Commits HEAD has since the graph's commit. When that commit is gone (a
    branch commit rewritten by a rebase merge), the distance back to the commit
    of HEAD's history that has the graph's TREE. None when neither is found."""
    if _git_knows(root, f"{graph.head}^{{commit}}"):
        count = _git_lines(root, "rev-list", "--count", f"{graph.head}..HEAD")
        return int(count[0]) if count and count[0].isdigit() else None
    trees = _git_lines(root, "log", f"-n{_HISTORY}", "--format=%T", "HEAD")
    return trees.index(graph.git_tree) if graph.git_tree in trees else None


def _added_lines(root: Path, tree: str, tracked: list[str],
                 untracked: list[str]) -> dict[str, str]:
    """For each changed file, the text of the lines added to it since ``tree``
    (the whole text of a file that is not tracked)."""
    lines: dict[str, list[str]] = {}
    if tracked:
        diff = _git(root, "diff", "-U0", "--no-color", "--no-renames", tree, "--", *tracked)
        current = None
        for line in (diff or b"").decode("utf-8", "replace").splitlines():
            if line.startswith("+++ "):
                current = line[6:] if line.startswith("+++ b/") else None
            elif line.startswith("+") and current is not None:
                lines.setdefault(current, []).append(line[1:])
    out = {name: "\n".join(body) for name, body in lines.items()}
    for name in untracked:
        text = _read(root / name)
        if text is not None:
            out[name] = text
    return out


@dataclass(frozen=True)
class _FromStored:
    """What the stored graphs answer for this tree. ``code`` is graph-select's
    exit code; only 0 comes with a selection to act on."""

    code: int
    reason: str | None
    graph: graph_rows.StoredGraph | None = None
    age: int | None = None
    selection: graph_select.Selection | None = None


def _select_from_stored(
    root: Path, index: Path, changed: list[str], *, build: str | None,
    max_age: int, max_extra_tests: int, exclude_tree: str | None = None,
) -> _FromStored:
    """Pick the newest usable stored graph and select from it for the current
    tree (hypergumbo_core/graph_select.py says what is seeded and why).

    Usable: of ``build`` when one is given, not of ``exclude_tree``, with a
    tree git still has, and at most ``max_age`` commits old.
    """
    if not index.exists():
        return _FromStored(WALK_NO_GRAPH, "no index, so no stored graph")
    with contextlib.closing(open_index(index)) as conn:
        graph_rows.ensure_schema(conn)
        passed_over: list[str] = []
        chosen: graph_rows.StoredGraph | None = None
        age: int | None = None
        for graph in graph_rows.stored_graphs(conn):
            if build is not None and graph.build != build:
                passed_over.append(f"graph {graph.id} is from another analyzer build")
            elif exclude_tree is not None and graph.tree == exclude_tree:
                passed_over.append(f"graph {graph.id} is of this very tree")
            elif graph.git_tree is None or not _git_knows(root, f"{graph.git_tree}^{{tree}}"):
                passed_over.append(f"graph {graph.id}: git does not have its tree")
            else:
                age = _graph_age(root, graph)
                if age is None:
                    passed_over.append(f"graph {graph.id}: its age is not known")
                elif age > max_age:
                    passed_over.append(f"graph {graph.id} is {age} commits old (limit {max_age})")
                else:
                    chosen = graph
                    break
        if chosen is None or chosen.git_tree is None:
            return _FromStored(WALK_NO_GRAPH, "no usable stored graph"
                               + (": " + "; ".join(passed_over) if passed_over else ""))
        tracked = [name for name in _git_z(root, "diff", "--name-only", "--no-renames", "-z",
                                           chosen.git_tree) if not name.endswith(".ops")]
        untracked = [name for name in _git_z(root, "ls-files", "--others",
                                             "--exclude-standard", "-z")
                     if not name.endswith(".ops")]
        differing = sorted({*tracked, *untracked, *chosen.dirty_files})
        in_tree = set(_git_z(root, "ls-tree", "-r", "--name-only", "-z", chosen.git_tree))
        # Added since the graph: not in its tree, not among the files that were
        # uncommitted when it was made (the analysis saw those), and here now.
        added = [name for name in sorted({*differing, *changed})
                 if name not in in_tree and name not in chosen.dirty_files
                 and (root / name).is_file()]
        lines = (_added_lines(root, chosen.git_tree, tracked, untracked)
                 if any(not graph_select.is_test_file(name) for name in added) else {})
        selection = graph_select.select(
            conn, chosen.id, changed=changed, differing=differing,
            added=graph_select.judge_added(added, lines))
    verdict, why = graph_select.verdict(selection, max_extra_tests=max_extra_tests)
    code = {graph_select.Verdict.USE: 0,
            graph_select.Verdict.ADDED_FILE: SELECT_ADDED_FILE,
            graph_select.Verdict.TOO_FAR_BEHIND: SELECT_TOO_FAR_BEHIND}[verdict]
    return _FromStored(code, why, chosen, age, selection)


def _graph_facts(stored: _FromStored) -> dict[str, object]:
    """What a log row or a report says about the graph a selection came from."""
    graph, selection = stored.graph, stored.selection
    return {
        "id": graph.id if graph else None,
        "head": graph.head if graph else None,
        "git_tree": graph.git_tree if graph else None,
        "build": graph.build if graph else None,
        "age_commits": stored.age,
        "dirty": bool(graph.dirty_files) if graph else None,
        "seeds": len(selection.seeds) if selection else None,
        "extra_seeds": len(selection.extra_seeds) if selection else None,
        "extra_test_files": len(selection.extra_test_files) if selection else None,
        "added_tests": list(selection.added.run_themselves) if selection else None,
        "added_mentioned": [list(pair) for pair in selection.added.mentioned] if selection else None,
    }


def _selection_line(stored: _FromStored) -> str:
    """One line saying which graph answered and what its age cost."""
    graph, selection = stored.graph, stored.selection
    if graph is None or selection is None:
        return "no stored graph answered"
    return (f"stored graph {graph.id} of {graph.head[:9]}, {stored.age} commit(s) old: "
            f"{len(selection.seeds)} seed file(s), {len(selection.extra_seeds)} of them not "
            f"this change's, reaching {len(selection.extra_test_files)} test file(s) this "
            f"change does not; {len(selection.files)} file(s) named")


def cmd_graph_select(args: argparse.Namespace) -> int:
    """Exit 0 with ``--output`` written and one line about the graph on
    stdout; any other code with nothing written and the reason on stderr. Like
    graph-walk it never degrades to exit 0."""
    root = Path(args.repo_root).resolve()
    try:
        changed = [ln.strip() for ln in Path(args.changed_files).read_text(
            encoding="utf-8").splitlines()
            if ln.strip() and not ln.strip().startswith("#")]
        stored = _select_from_stored(
            root, Path(args.index), changed, build=args.build, max_age=args.max_age,
            max_extra_tests=args.max_extra_tests)
        if args.report:
            Path(args.report).write_text(json.dumps(
                {"code": stored.code, "reason": stored.reason, **_graph_facts(stored)},
                sort_keys=True) + "\n", encoding="utf-8")
        if stored.code != 0 or stored.selection is None:
            print(f"[coverage-select] graph-select: {stored.reason}", file=sys.stderr)
            return stored.code or WALK_FAILED
        Path(args.output).write_text(
            "".join(f"{name}\n" for name in stored.selection.files), encoding="utf-8")
        print(_selection_line(stored))
        return 0
    except Exception as exc:
        print(f"[coverage-select] graph-select FAILED: {type(exc).__name__}: {exc}",
              file=sys.stderr)
        return WALK_FAILED




def _dirty_files(root: Path) -> list[str]:
    """Every file of the working tree that differs from HEAD: changed and not
    committed, or not tracked (and not ignored). Pending tracker ops excepted.
    Unlike :func:`_uncommitted` this does not stop at the surfaces a change is
    read from: it says which TREE an analysis saw."""
    names = set(_git_lines(root, "diff", "--name-only", "HEAD"))
    names.update(_git_lines(root, "ls-files", "--others", "--exclude-standard"))
    return sorted(name for name in names if not name.endswith(".ops"))


def _tree_of(root: Path, commit: str) -> str | None:
    """The id of ``commit``'s tree; None when git does not know the commit."""
    out = _git_lines(root, "rev-parse", "--verify", "--quiet", f"{commit}^{{tree}}")
    return out[0] if out else None


#: How long a store waits for another process that is writing the index.
STORE_WAIT_SECONDS = 120.0


def _store_graph_rows(index: Path, survey: Path, *, head: str, git_tree: str | None,
                      dirty_files: list[str]) -> graph_rows.StoredGraph | None:
    """Store ``survey``'s graph as rows in ``index``. None when the file holds
    no graph (no node and edge lists): the index is then not opened at all.

    The graph is named as the survey cache names it: the survey sits in
    ``.../<tree state>/<analyzer identity>/survey.json``."""
    loaded = json.loads(survey.read_text(encoding="utf-8"))
    if not (isinstance(loaded, dict) and isinstance(loaded.get("nodes"), list)
            and isinstance(loaded.get("edges"), list)):
        return None
    nodes, edges = graph_rows.survey_graph(loaded)
    # Another checkout's run, or a rebuild, may be storing a graph at this
    # moment, and a store holds the write lock for seconds: wait for it. The
    # wait has to start with the connection, whose opening already writes.
    with contextlib.closing(open_index(index, timeout=STORE_WAIT_SECONDS)) as conn:
        graph_rows.ensure_schema(conn)
        stored = graph_rows.store_graph(
            conn, nodes=nodes, edges=edges, tree=survey.parent.parent.name,
            build=survey.parent.name, head=head, git_tree=git_tree,
            dirty_files=dirty_files, at=_now())
        conn.commit()
    return stored


def _report_stored(stored: graph_rows.StoredGraph | None) -> None:
    if stored is None:
        print("[coverage-select] graph rows: the survey holds no node and edge lists; "
              "nothing stored", file=sys.stderr)
    else:
        print(f"[coverage-select] graph rows: stored graph {stored.id} "
              f"({stored.nodes} nodes, {stored.edges} edges, head {stored.head[:9]}"
              f"{_dirt(stored)})", file=sys.stderr)


def _dirt(graph: graph_rows.StoredGraph) -> str:
    count = len(graph.dirty_files)
    return f", and {count} file(s) not in that commit" if count else ""


def _described(root: Path, graph: graph_rows.StoredGraph) -> str:
    age = _graph_age(root, graph)
    return (f"graph {graph.id}: head {graph.head[:9]}{_dirt(graph)}, "
            f"{'age not known' if age is None else f'{age} commit(s) old'}, "
            f"build {graph.build}, {graph.nodes} nodes, {graph.edges} edges, stored {graph.at}")


def cmd_graph_store(args: argparse.Namespace) -> int:
    root = Path(args.repo_root).resolve()
    head = args.head or _head(root)
    stored = _store_graph_rows(
        Path(args.index), Path(args.survey), head=head, git_tree=_tree_of(root, head),
        dirty_files=_dirty_files(root) if args.head is None else _lines(args.dirty_files))
    _report_stored(stored)
    return 0 if stored is not None else 1


def cmd_graph_walk(args: argparse.Namespace) -> int:
    """Exit 0 with ``--output`` written, WALK_NO_GRAPH with nothing written,
    or WALK_FAILED. It never falls through to main()'s "degrade to silence":
    silence here would read as "no test depends on this change"."""
    root = Path(args.repo_root).resolve()
    try:
        # Read here and not with _lines(): that helper reads a missing list as
        # an empty one, and "no list" must not become "nothing changed".
        changed = [ln.strip() for ln in Path(args.changed_files).read_text(
            encoding="utf-8").splitlines()
            if ln.strip() and not ln.strip().startswith("#")]  # as `slice --files` reads it
        if not Path(args.index).exists():
            print("[coverage-select] graph-walk: no index, so no stored graph",
                  file=sys.stderr)
            return WALK_NO_GRAPH
        with contextlib.closing(open_index(Path(args.index))) as conn:
            graph_rows.ensure_schema(conn)
            if args.graph is not None:
                graph = next((g for g in graph_rows.stored_graphs(conn)
                              if g.id == args.graph), None)
            else:
                graph = graph_rows.newest_graph(conn, build=args.build)
            if graph is None:
                print("[coverage-select] graph-walk: no stored graph"
                      + (f" with id {args.graph}" if args.graph is not None else "")
                      + (f" from build {args.build}" if args.build else ""),
                      file=sys.stderr)
                return WALK_NO_GRAPH
            files = graph_rows.walk(conn, graph.id, changed, max_hops=args.max_hops)
        Path(args.output).write_text("".join(f"{name}\n" for name in files), encoding="utf-8")
        print(f"[coverage-select] graph-walk: {len(files)} file(s) from "
              f"{_described(root, graph)}", file=sys.stderr)
        return 0
    except Exception as exc:
        print(f"[coverage-select] graph-walk FAILED: {type(exc).__name__}: {exc}",
              file=sys.stderr)
        return WALK_FAILED


#: Where a rebuild keeps its checkout, its private survey cache, its lock, its
#: pid and its log. Real disk on purpose: /tmp is memory on some machines, and
#: the survey alone is some 350 MB beside an analysis that needs 4 GB.
DEFAULT_REBUILD_DIR = Path(os.environ.get(
    "HG_GRAPH_REBUILD_DIR",
    Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "hypergumbo-graph-rebuild"))
#: The analysis peaks near 4.2 GB; below this much free memory it is not started.
REBUILD_MIN_FREE_MB = 6000


def _free_mb() -> int | None:
    """MemAvailable in MB; None where /proc/meminfo does not say."""
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    return None


def _test_run_pid(root: Path) -> int | None:
    """The pid of a smart-test running in ``root``, from the pid file it keeps
    beside its lock; None when there is none or the process is gone. Read, not
    locked: taking smart-test's own lock to look would refuse a run that
    starts in that instant."""
    try:
        pid = int((root / ".ci" / ".smart-test.lock.pid").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None
    return pid if _alive(pid) else None


def _alive(pid: int) -> bool:
    """Whether process ``pid`` is still running. A process that has ended and
    not yet been collected by its parent (a zombie) still answers a signal;
    it is over, and waiting for it could last as long as its parent does."""
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        # The field after the parenthesised command name is the state.
        state = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").rsplit(")", 1)[1].split()[0]
    except (OSError, IndexError):
        return True
    return state != "Z"


def _terminated(_signum: int, _frame: object) -> None:
    raise SystemExit(143)


def cmd_graph_rebuild(args: argparse.Namespace) -> int:
    """:func:`_graph_rebuild`, with every failure it did not foresee written to
    its log and returned as exit 1. Left to main(), which turns any exception
    into exit 0 for the commands that ride on a test run, a rebuild that
    stored nothing would look like one that had."""
    work = Path(args.work_dir)
    work.mkdir(parents=True, exist_ok=True)

    def say(message: str) -> None:
        with open(work / "rebuild.log", "a", encoding="utf-8") as log:
            log.write(f"{_now()} {message}\n")
        print(f"[coverage-select] graph-rebuild: {message}", file=sys.stderr)

    try:
        return _graph_rebuild(args, work, say)
    except Exception as exc:
        say(f"failed: {type(exc).__name__}: {exc}")
        return 1


def _graph_rebuild(args: argparse.Namespace, work: Path, say) -> int:
    """Analyse ``--commit`` and store its graph, unless that graph is stored.

    WHY A COMMIT AND NOT THE WORKING TREE. smart-test selects from a stored
    graph by seeding every file that differs between the graph's tree and the
    current one, so a graph of the branch's BASELINE commit (its merge-base
    with dev) differs from the branch by the branch's own change and nothing
    else: the selection is exact. A graph of an edited working tree is of a
    tree nobody will be on again.

    HOW. A detached checkout of the commit (``git worktree``, hooks off) in
    the rebuild directory; the installed hypergumbo's slice there, with a
    survey cache of its own so that its one survey is found and removed; the
    rows stored under the commit, with no uncommitted files.

    IT GIVES WAY. One rebuild at a time (a lock). It waits for the process
    ``--after-pid`` to be gone (the smart-test that started it) and ``--settle``
    seconds more, then does not start while a smart-test run holds the checkout or
    memory is short, and smart-test stops it when a run starts: SIGTERM ends
    the analysis and removes the checkout. Nothing is lost but the time; the
    next run starts it again.

    Exit 0 when the graph is stored or was already, 1 when it could not be
    made, 2 when it gave way or was stopped. Every outcome is one line in
    ``rebuild.log`` in the rebuild directory.
    """
    root = Path(args.repo_root).resolve()
    resolved = _git_lines(root, "rev-parse", "--verify", "--quiet", f"{args.commit}^{{commit}}")
    tree = _tree_of(root, resolved[0]) if resolved else None
    if not resolved or tree is None:
        say(f"git does not know the commit {args.commit}")
        return 1
    commit = resolved[0]
    if Path(args.index).exists():
        with contextlib.closing(open_index(Path(args.index))) as conn:
            graph_rows.ensure_schema(conn)
            have = next((g for g in graph_rows.stored_graphs(conn)
                         if g.git_tree == tree and not g.dirty_files
                         and (args.build is None or g.build == args.build)), None)
        if have is not None:
            say(f"the graph of {commit[:9]} is stored already (graph {have.id})")
            return 0

    lock = os.open(work / "rebuild.lock", os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock)
        say("another rebuild is running")
        return 2
    pid_file = work / "rebuild.pid"
    checkout, cache = work / "tree", work / "cache"
    child: subprocess.Popen[bytes] | None = None

    def clear() -> None:
        """Remove the checkout and the private cache, whoever left them.

        No ``git worktree prune``: that drops the registration of EVERY
        worktree whose directory is missing at that moment, and the
        repository's other worktrees are not this command's to judge.
        ``worktree remove`` drops this checkout's own registration whether
        or not its directory is still there (git 2.43)."""
        _git(root, "worktree", "remove", "--force", str(checkout))
        shutil.rmtree(checkout, ignore_errors=True)
        shutil.rmtree(cache, ignore_errors=True)

    signal.signal(signal.SIGTERM, _terminated)
    started = time.monotonic()
    try:
        pid_file.write_text(f"{os.getpid()}\n", encoding="utf-8")
        while args.after_pid is not None and _alive(args.after_pid):
            time.sleep(1.0)
        time.sleep(args.settle)
        running = _test_run_pid(root)
        if running is not None:
            say(f"not started: a test run (pid {running}) has the checkout")
            return 2
        free = _free_mb()
        if free is not None and free < args.min_free_mb:
            say(f"not started: {free} MB of memory free, {args.min_free_mb} needed")
            return 2
        clear()
        added = subprocess.run(  # noqa: S603
            ["git", "-C", str(root), "-c", "core.hooksPath=/dev/null",  # noqa: S607
             "worktree", "add", "--detach", "--quiet", str(checkout), commit],
            capture_output=True)
        if added.returncode != 0:
            say(f"no checkout of {commit[:9]}: "
                f"{added.stderr.decode('utf-8', 'replace').strip()[:200]}")
            return 1
        tracked = _git_z(root, "ls-tree", "-r", "--name-only", "-z", commit)
        seed = next((name for name in tracked if _SLICED_SOURCE_PATH.match(name)),
                    tracked[0] if tracked else None)
        if seed is None:
            say(f"the commit {commit[:9]} holds no file")
            return 1
        (work / "seed.txt").write_text(f"{seed}\n", encoding="utf-8")
        # The installed hypergumbo must run its OWN code. A run in a worktree
        # pins PYTHONPATH to the worktree's sources, the installed command
        # inherits it, and it then analyses with the code under test under
        # another analyzer build's name.
        environment = {
            **os.environ, "XDG_CACHE_HOME": str(cache), "HF_HUB_OFFLINE": "1",
            "HF_HOME": os.environ.get("HF_HOME") or str(Path(os.environ.get(
                "XDG_CACHE_HOME", Path.home() / ".cache")) / "huggingface")}
        environment.pop("PYTHONPATH", None)
        minimal = ["--minimal"] if "--minimal" in subprocess.run(  # noqa: S603
            [args.hg, "slice", "--help"], capture_output=True, text=True,
            env=environment).stdout else []
        with open(work / "analysis.log", "wb") as analysis_log:
            child = subprocess.Popen(  # noqa: S603
                [args.hg, "slice", "--files", str(work / "seed.txt"), *minimal,
                 "--output", str(work / "slice.out")],
                cwd=str(checkout), env=environment, stdout=analysis_log,
                stderr=subprocess.STDOUT)
            code = child.wait()
        child = None
        if code != 0:
            say(f"the analysis of {commit[:9]} failed (exit {code}); see {work / 'analysis.log'}")
            return 1
        surveys = sorted(cache.glob("hypergumbo/*/results/*/*/survey.json"))
        if len(surveys) != 1:
            say(f"the analysis of {commit[:9]} left {len(surveys)} surveys; exactly 1 is its graph")
            return 1
        stored = _store_graph_rows(Path(args.index), surveys[0], head=commit, git_tree=tree,
                                   dirty_files=[])
        if stored is None:
            say(f"the survey of {commit[:9]} holds no node and edge lists")
            return 1
        say(f"stored graph {stored.id} of {commit[:9]} ({stored.nodes} nodes, {stored.edges} "
            f"edges, build {stored.build}) in {time.monotonic() - started:.0f} s")
        return 0
    except SystemExit:
        say(f"stopped after {time.monotonic() - started:.0f} s: a test run has the machine")
        return 2
    finally:
        if child is not None and child.poll() is None:
            child.terminate()
            child.wait()
        clear()
        pid_file.unlink(missing_ok=True)
        os.close(lock)


def cmd_graph_list(args: argparse.Namespace) -> int:
    root = Path(args.repo_root).resolve()
    if not Path(args.index).exists():
        print("no index: no stored graph")
        return 0
    with contextlib.closing(open_index(Path(args.index))) as conn:
        graph_rows.ensure_schema(conn)
        graphs = graph_rows.stored_graphs(conn)
    for graph in graphs:
        print(_described(root, graph))
    if not graphs:
        print("no stored graph")
    return 0


def cmd_wall_report(args: argparse.Namespace) -> int:
    """Print the run's wall time against the local target (wall_time.py).
    smart-test hands in the seconds it timed around its own steps."""
    parts = {"the type gate": args.gate, args.selection_name: args.selection,
             "the tests": args.tests}
    times = junit_times(Path(args.junit)) if args.junit else None
    print(wall_report(total=args.total, parts=parts, tests=times))
    return 0


def cmd_statement_bar(args: argparse.Namespace) -> int:
    """Print the by-statement selector's bar, counted from the run records.
    Exit 0 when it is met, 1 when it is not (yet, or because of a miss)."""
    bar = evaluate_statement_bar(load_observations(Path(args.runs)))
    print(f"[coverage-select] the by-statement selector's bar, from {args.runs}")
    print(bar.summary())
    return 0 if bar.verdict == "met" else 1


def cmd_stale_report(args: argparse.Namespace) -> int:
    """Print the accrued stale-graph evidence and its verdict."""
    ev = evaluate_stale_graph(load_observations(Path(args.stale_log)))
    print(f"[coverage-select] stale-graph evidence from {args.stale_log}")
    print(ev.summary())
    return 0


def _by_statement_facts(root: Path, index: Path, base: str, changed: list[str],
                        failed: set[str] | None) -> dict[str, object] | None:
    """What the by-statement selector would have selected for this change,
    from the index as it stands NOW (the caller has not folded this run into
    it yet), and what that would have cost the run's failed tests.

    ``failed_not_selected`` is the result that counts against the selector: a
    test that reached a changed function, FAILED, and would have been left
    out. A failed test that reached no changed function is no business of a
    selector that only narrows "reached a changed function".
    """
    sources = [name for name in changed if _SLICED_SOURCE_PATH.match(name)]
    if not sources or not index.exists():
        return None
    base_sources = {str(root / name): _base_source(root, base, name) for name in sources}
    with contextlib.closing(open_index(index)) as conn:
        chosen = select_by_statement(conn, base_sources)
    tests = rebase_to_repo(chosen.tests, root)
    by_block = rebase_to_repo(chosen.by_block, root)
    facts: dict[str, object] = {
        "changed_blocks": len(chosen.answers),
        "answers": dict(sorted(collections.Counter(chosen.answers.values()).items())),
        "import_time_blocks": len(chosen.import_time),
        # Not zero: the index has never seen that many of the changed blocks,
        # and "tests" is then not every test the change needs.
        "unknown_blocks": len(chosen.unknown),
        "tests": len(tests),
        "by_block": len(by_block),
        "failed_reaching_a_changed_block": None,
        # The failed tests the selector could have left out: they reached a
        # function it narrowed. A run counts toward the selector's bar only
        # when this is not empty (coverage-select statement-bar).
        "failed_reaching_a_narrowed_block": None,
        "failed_not_selected": None,
        # Changed files the selector has no rule for (anything that is not
        # package source): it says nothing about the tests they need.
        "files_not_judged": sorted(set(changed) - set(sources)),
    }
    if failed is not None:
        narrowed = rebase_to_repo(chosen.narrowed, root)
        facts["failed_reaching_a_changed_block"] = sorted(failed & by_block)
        facts["failed_reaching_a_narrowed_block"] = sorted(failed & narrowed)
        facts["failed_not_selected"] = sorted((failed & by_block) - tests)
    return facts


def cmd_run_record(args: argparse.Namespace) -> int:
    root = Path(args.repo_root).resolve()
    head = _head(root)
    base = "".join(_git_lines(root, "merge-base", "HEAD", args.base_branch)) or "unknown"
    tracked, untracked = _uncommitted(root)
    committed = [f for f in _git_lines(root, "diff", "--name-only", f"{base}..HEAD")
                 if not f.endswith(".ops")]
    patch = b""
    if tracked:
        patch += _git(root, "diff", "--binary", "HEAD", "--", *tracked) or b""
    for path in untracked:
        # rc 1 is git's "the two differ", which a new file always does.
        patch += _git(root, "diff", "--binary", "--no-index", "--", "/dev/null", path,
                      ok=(0, 1)) or b""
    snapshot = store_snapshot(Path(args.runs).with_suffix(".d"), patch) if patch else None
    ran = failed = None
    if args.junit and Path(args.junit).exists():
        ran = ran_tests_from_junit(Path(args.junit), root)
        failed = failed_tests_from_junit(Path(args.junit), root)
    changed_files = sorted({*committed, *tracked, *untracked})
    try:
        by_statement = _by_statement_facts(root, Path(args.index), base, changed_files, failed)
    except Exception as exc:
        # The record of the run matters more than this one field of it.
        by_statement = {"error": f"{type(exc).__name__}: {exc}"}
    append_run_record(
        Path(args.runs), at=_now(), kind=args.kind, head=head, base=base,
        changed_files=changed_files,
        snapshot=snapshot,
        ran_files=None if ran is None else {t.split("::")[0] for t in ran},
        tests_ran=None if ran is None else len(ran),
        failed=failed, exit_code=args.exit, by_statement=by_statement,
    )
    return 0


def cmd_line_tests(args: argparse.Namespace) -> int:
    """Print what the index records about who ran one line
    (``selection_index.tests_of_line``). ``FILE`` is resolved against the
    current directory, as the index stores absolute paths."""
    file_part, _, line_part = args.where.rpartition(":")
    conn = open_index(Path(args.index))
    answer = tests_of_line(conn, str(Path(file_part).resolve()), int(line_part))
    conn.close()
    print(json.dumps(answer.as_dict(), indent=2) if args.json else answer.describe())
    return 0


def cmd_line_records(args: argparse.Namespace) -> int:
    """Print how much of the index has statement records."""
    conn = open_index(Path(args.index))
    print(record_counts(conn).describe())
    conn.close()
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", default=".")
    parser.add_argument("--index", default=str(DEFAULT_INDEX))
    parser.add_argument("--junit", default=None)
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--log", default=str(DEFAULT_LOG))
    parser.add_argument("--stale-log", default=str(DEFAULT_STALE_LOG))
    parser.add_argument("--runs", default=str(DEFAULT_RUNS))
    sub = parser.add_subparsers(dest="cmd", required=True)

    up = sub.add_parser("update")
    up.add_argument("--coverage-db", required=True)
    up.add_argument("--sha", default=None)
    up.add_argument("--full", action="store_true")
    up.add_argument("--scope-complete", action="store_true",
                    help="coverage measured every package of the checkout in "
                         "this run; without it the run's tests cannot be "
                         "narrowed away later")
    up.add_argument("--source-reads", default=None,
                    help="directory of pytest_source_reads output to store")
    up.set_defaults(func=cmd_update)

    fr = sub.add_parser("fold-reads")
    fr.add_argument("--source-reads", required=True)
    fr.add_argument("--announce", action="store_true",
                    help="say how many tests were stored")
    fr.set_defaults(func=cmd_fold_reads)

    sh = sub.add_parser("shadow")
    sh.add_argument("--changed-files", default=None)
    sh.add_argument("--base", default="HEAD",
                    help="git ref the working tree is diffed against")
    sh.add_argument("--actual-tests", default=None)
    sh.add_argument("--json", default=None)
    sh.add_argument("--sha", default=None,
                    help="commit the observation is attributed to")
    sh.set_defaults(func=cmd_shadow)

    se = sub.add_parser("select")
    se.add_argument("--changed-files", default=None)
    se.add_argument("--base", default="HEAD",
                    help="git ref the working tree is diffed against")
    se.set_defaults(func=cmd_select)

    nw = sub.add_parser("narrow")
    nw.add_argument("--changed-files", default=None)
    nw.add_argument("--run-set", default=None,
                    help="the run set to shrink, one file per line")
    nw.add_argument("--base", default="HEAD",
                    help="git ref the working tree is diffed against")
    nw.set_defaults(func=cmd_narrow)

    ps = sub.add_parser("prose-select")
    ps.add_argument("--changed-files", default=None)
    ps.add_argument("--base", default="HEAD",
                    help="git ref the working tree is diffed against")
    ps.add_argument("--files-out", required=True)
    ps.add_argument("--tests-out", required=True)
    ps.set_defaults(func=cmd_prose_select)

    rd = sub.add_parser("readers")
    rd.add_argument("--changed-files", default=None)
    rd.set_defaults(func=cmd_readers)

    ic = sub.add_parser("import-closure")
    ic.add_argument("--changed-files", default=None)
    ic.add_argument("--base", default="HEAD",
                    help="git ref the working tree is diffed against")
    ic.set_defaults(func=cmd_import_closure)

    rp = sub.add_parser("report")
    rp.set_defaults(func=cmd_report)

    sr = sub.add_parser("stale-record")
    sr.add_argument("--changed-files", default=None)
    sr.add_argument("--fresh-out", required=True,
                    help="the fresh slice's output file")
    sr.add_argument("--fresh-survey", default=None,
                    help="the survey the fresh slice wrote; registered as a graph")
    sr.add_argument("--fresh-seconds", type=float, default=None)
    sr.add_argument("--max-age", type=int, default=MAX_GRAPH_AGE)
    sr.add_argument("--max-extra-tests", type=int, default=MAX_EXTRA_TESTS)
    sr.add_argument("--why", default=None,
                    help="why no comparison was made, when none was")
    sr.set_defaults(func=cmd_stale_record)

    sub.add_parser("stale-report").set_defaults(func=cmd_stale_report)
    sub.add_parser("statement-bar").set_defaults(func=cmd_statement_bar)
    wr = sub.add_parser("wall-report")
    wr.add_argument("--total", type=float, required=True, help="wall seconds since the run began")
    wr.add_argument("--gate", type=float, default=0.0, help="seconds in the type gate")
    wr.add_argument("--selection", type=float, default=0.0,
                    help="seconds in the analysis or the walk of a stored graph")
    wr.add_argument("--selection-name", default="the analysis",
                    help="what --selection timed, as the line should call it")
    wr.add_argument("--tests", type=float, default=0.0, help="wall seconds pytest took")
    wr.set_defaults(func=cmd_wall_report)

    rr = sub.add_parser("run-record")
    rr.add_argument("--kind", required=True,
                    help="how the tests were chosen: selected, explicit or full")
    rr.add_argument("--exit", type=int, default=None)
    rr.add_argument("--base-branch", default="origin/dev")
    rr.set_defaults(func=cmd_run_record)

    gs = sub.add_parser("graph-store")
    gs.add_argument("--survey", required=True,
                    help="a survey.json as the cache files it: "
                         ".../<tree state>/<analyzer identity>/survey.json")
    gs.add_argument("--head", default=None,
                    help="the commit the survey was made from (default: HEAD, and "
                         "the working tree says which files differed from it)")
    gs.add_argument("--dirty-files", default=None,
                    help="with --head: a list of the files that differed from that "
                         "commit when the survey was made (default: none did)")
    gs.set_defaults(func=cmd_graph_store)

    gw = sub.add_parser("graph-walk")
    gw.add_argument("--changed-files", required=True)
    gw.add_argument("--output", required=True)
    gw.add_argument("--graph", type=int, default=None,
                    help="the id of the stored graph to walk (default: the newest)")
    gw.add_argument("--build", default=None,
                    help="walk the newest graph of this analyzer build only")
    gw.add_argument("--max-hops", type=int, default=graph_rows.MAX_HOPS)
    gw.set_defaults(func=cmd_graph_walk)

    gsel = sub.add_parser("graph-select")
    gsel.add_argument("--changed-files", required=True,
                      help="the change's own files, one per line")
    gsel.add_argument("--output", required=True)
    gsel.add_argument("--build", default=None,
                      help="select from graphs of this analyzer build only")
    gsel.add_argument("--max-age", type=int, default=MAX_GRAPH_AGE,
                      help="the oldest graph to select from, in commits")
    gsel.add_argument("--max-extra-tests", type=int, default=MAX_EXTRA_TESTS,
                      help="refuse a graph whose age adds more test files than this")
    gsel.add_argument("--report", default=None,
                      help="write what was decided, as JSON, whatever the exit code")
    gsel.set_defaults(func=cmd_graph_select)

    sub.add_parser("graph-list").set_defaults(func=cmd_graph_list)

    gr = sub.add_parser("graph-rebuild")
    gr.add_argument("--commit", required=True, help="the commit to analyse")
    gr.add_argument("--hg", required=True, help="the installed hypergumbo to analyse with")
    gr.add_argument("--build", default=None,
                    help="that hypergumbo's analyzer build: a stored graph of the "
                         "commit from another build does not count as stored")
    gr.add_argument("--work-dir", default=str(DEFAULT_REBUILD_DIR))
    gr.add_argument("--settle", type=float, default=60.0,
                    help="seconds to wait before starting, so runs that follow "
                         "one another do not each start an analysis")
    gr.add_argument("--after-pid", type=int, default=None,
                    help="wait for this process to be gone first")
    gr.add_argument("--min-free-mb", type=int, default=REBUILD_MIN_FREE_MB)
    gr.set_defaults(func=cmd_graph_rebuild)

    lt = sub.add_parser("line-tests")
    lt.add_argument("where", metavar="FILE:LINE")
    lt.add_argument("--json", action="store_true")
    lt.set_defaults(func=cmd_line_tests)

    lr = sub.add_parser("line-records")
    lr.set_defaults(func=cmd_line_records)

    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except Exception as exc:
        # NEVER fail the run this is shadowing. A broken selector must degrade
        # to silence, not to a red suite.
        print(f"[coverage-select] non-fatal: {type(exc).__name__}: {exc}",
              file=sys.stderr)
        return 0


if __name__ == "__main__":
    raise SystemExit(main())

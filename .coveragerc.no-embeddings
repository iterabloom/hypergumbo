# Coverage configuration for when embedding dependencies are unavailable.
# This excludes embedding-specific code that cannot be executed without
# the optional sentence-transformers or onnxruntime/tokenizers dependencies.

[run]
# Omit embedding modules - they require sentence-transformers or onnxruntime.
# The scip_pb2.py omit has to be repeated here because passing
# `--cov-config=.coveragerc.no-embeddings` makes coverage.py read ONLY this
# file — the `[tool.coverage.run] omit` list in pyproject.toml is ignored when
# this config is active (nightly.yml does so when sentence-transformers is
# unavailable, which is always the case in the Python-matrix containers).
omit =
    */sketch_embeddings.py
    */_embedding_data.py
    */__main__.py
    */embeddings.py
    */scip/_generated/scip_pb2.py

[report]
# Exclude lines containing these patterns (embedding-related conditionals)
exclude_also =
    # Functions that require sentence-transformers
    def _extract_config_embedding
    def _extract_config_hybrid
    def _discover_config_files_embedding
    def _collect_config_content_with_discovery
    def _collect_config_content
    def _get_repo_languages
    def _compute_log_sample_size
    def _compute_stride
    def _build_context_chunk
    def _is_low_quality_chunk
    def _is_config_excluded_path
    # Embedding mode branches
    if mode == ConfigExtractionMode.EMBEDDING
    elif mode == ConfigExtractionMode.HYBRID
    # File header handling (only reached via embedding output)
    if.*has_file_headers
    for file_header, file_lines in file_sections
    # Sketch: semantic similarity ranking (requires sentence-transformers)
    if.*_has_sentence_transformers
    # Tracker: ONNX-based embedding dedup (requires onnxruntime + tokenizers)
    def _check_embedding_duplicates

{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": ".agent/hooks/cursor/stop.sh",
        "type": "command"
      },
      {
        "command": ".agent/hooks/cursor/stop-transcript.sh",
        "type": "command",
        "timeout": 30
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".agent/hooks/cursor/after-agent-response-transcript.sh",
        "type": "command",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": ".agent/hooks/cursor/post-tool-use-transcript.sh",
        "type": "command",
        "timeout": 30
      }
    ]
  }
}

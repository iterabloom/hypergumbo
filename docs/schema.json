            "signal_receiver",
            "template_calls",
            "uses_mixin",
            "uses_vocabulary",
            "resolver_implements",
            "resolver_for_type",
            "openapi_implements",
            "implements_rpc"
          ],
          "x-axis-of-values": {
            "calls": "relationship",
            "imports": "relationship",
            "instantiates": "relationship",
            "extends": "relationship",
            "implements": "relationship",
            "contains": "relationship",
            "uses": "relationship",

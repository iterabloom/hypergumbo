            "provider": "language_construct",
            "local": "language_construct",
            "style_block": "language_construct",
            "permission": "language_construct",
            "keyframes": "language_construct",
            "media": "language_construct",
            "font_face": "language_construct",
            "class_selector": "language_construct",
            "id_selector": "language_construct",
            "rule_set": "language_construct",
            "subdirectory": "language_construct",
            "table": "language_construct",
            "table_array": "language_construct",

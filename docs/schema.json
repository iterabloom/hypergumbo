        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number where relationship occurs"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence score"
        },
        "origin": {
          "type": "string",
          "description": "Analysis pass that created this edge"
        },
        "origin_run_id": {
          "type": "string",
          "description": "Unique execution ID"
        },
        "origin_run_signature": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Run signature for cache keying"
        },
        "is_resolved": {
          "type": "boolean",
          "default": true,
          "description": "Whether the dst symbol was resolved at analysis time. Per ADR-0028, this sibling field captures what the Cluster B `*_unresolved` evidence_type values previously smuggled into the inference label. Default True (the ~90% case); Phase 3 producers explicitly set False for the Cluster B fold targets."
        },
        "dst_ref": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "lang": {
                  "type": "string"
                },
                "module_path": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "lang",
                "module_path",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured identity for the dst endpoint when it points at an external symbol (stdlib, dependency, unresolved external). Per WI-tihup, this is the canonical source of truth for external-target identity \u2014 the legacy `dst` string field is built from the same ExternalRef and stays populated alongside for back-compat with consumers that haven't migrated. None when dst points at an in-repo Symbol (whose `dst` field is a real Symbol ID)."
        },
        "derived_from": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Symbol (or Edge) IDs the producer consumed to construct this Edge (INV-rukor). Populated by linkers; null for analyzer-originated edges."
        },
        "quality": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Quality assessment"
        },
        "meta": {
          "type": "object",
          "description": "Edge metadata including evidence",
          "properties": {
            "evidence_type": {
              "type": "string",
              "description": "Inference pathway by which the analyzer concluded this edge exists. Per ADR-0028, the canonical axiom is 'Edge.evidence_type names the inference pathway by which the analyzer concluded this edge exists.' The x-axis-of-values map documents the canonical registry from packages/hypergumbo-core/src/hypergumbo_core/evidence_types.py::EVIDENCE_TYPES. The schema enum is intentionally open (type: string without enum constraint) until Phase 4b producer migrations land per-cluster \u2014 current production includes dynamic f-string emits (websocket.py, di_resolution.py, inheritance.py) that produce values outside the static registry. The L3 producer-coherence linter gates literal additions; the open enum honestly reflects the producer-side leak the ADR is fixing.",
              "x-axis-of-values": {
                "ast_annotation": "inference_pathway",
                "ast_attribute": "inference_pathway",
                "ast_call": "inference_pathway",
                "ast_call_direct": "inference_pathway",

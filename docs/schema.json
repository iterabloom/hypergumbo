    "AnalysisRun": {
      "type": "object",
      "description": "Provenance tracking for an analysis pass",
      "properties": {
        "execution_id": {
          "type": "string",
          "description": "Unique run identifier (uuid)"
        },
        "run_signature": {
          "type": "string",
          "description": "Deterministic config hash"
        },
        "repo_fingerprint": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Git state hash for cache invalidation"
        },
        "pass": {
          "type": "string",
          "description": "Analysis pass identifier"
        },
        "version": {
          "type": "string",
          "description": "Hypergumbo version"
        },
        "toolchain": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "config_fingerprint": {
          "type": "string"
        },
        "files_analyzed": {
          "type": "integer"
        },
        "files_skipped": {
          "type": "integer"
        },
        "skipped_passes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer"
        }
      },
      "required": [
        "execution_id",
        "pass",
        "version"
      ]
    },
    "Entrypoint": {
      "type": "object",
      "description": "A detected program entrypoint (main function, CLI verb, HTTP route, etc.). Produced by `detect_entrypoints()`.",
      "properties": {
        "symbol_id": {
          "type": "string",
          "description": "ID of the Symbol that is the entrypoint"
        },
        "kind": {
          "type": "string",
          "description": "Entrypoint category \u2014 e.g. main_function, cli_command, http_route, framework_handler"
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for the entrypoint"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Detection confidence"
        }
      },
      "required": [
        "symbol_id",
        "kind"
      ]
    },
    "UsageContext": {
      "type": "object",
      "description": "Concept-tagged usage site (per ADR-0003-ext usage_context_patterns) \u2014 e.g. a Flask `@app.route` call or a Django ORM filter.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable hash ID for this usage site"
        },
        "context_name": {
          "type": "string",
          "description": "Name of the function/decorator/sentinel at this site (e.g. 'Route', 'session.query')"
        },
        "kind": {
          "type": "string",
          "description": "Usage kind \u2014 call, data_value, export, macro"
        },
        "path": {
          "type": "string",
          "description": "Source file path (relative to repo root)"
        },
        "position": {
          "type": "string",
          "description": "Position descriptor \u2014 e.g. args[0], view_func, default (per ADR-0003-ext positional vocabulary)"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "symbol_ref": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved Symbol ID if available, otherwise null"
        },
        "metadata": {
          "type": "object",
          "description": "Per-pattern metadata payload (e.g. {route_path, methods, view_name} for a Flask route)"
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "UsagePatternSpec": {
      "type": "object",
      "description": "Specification for matching usage contexts (call-based frameworks)",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Regex pattern to match context kind (call, data_value, export, macro)"
        },
        "name": {
          "type": "string",
          "description": "Regex pattern to match context_name (function called, var defined, etc.)"
        },
        "position": {
          "type": "string",
          "description": "Regex pattern to match position (args[1], :get, default, etc.)"
        }
      },
      "additionalProperties": false
    },
    "Pattern": {
      "type": "object",
      "description": "A pattern to match against symbol metadata or usage contexts",
      "properties": {
        "concept": {
          "type": "string",
          "description": "The concept type this pattern identifies (route, model, task, etc.)"
        },
        "decorator": {
          "type": "string",
          "description": "Regex pattern to match against decorator names"
        },
        "base_class": {
          "type": "string",
          "description": "Regex pattern to match against base class names"
        },
        "parent_base_class": {
          "type": "string",
          "description": "Regex pattern to match parent class's base classes (for methods)"
        },
        "method_name": {
          "type": "string",
          "description": "Regex pattern to match method name (last part of qualified name)"
        },
        "symbol_name": {
          "type": "string",
          "description": "Regex pattern to match symbol name directly"
        },
        "language": {
          "type": "string",
          "description": "Regex pattern to filter by symbol's language"
        },
        "annotation": {
          "type": "string",
          "description": "Regex pattern to match against Java annotations"
        },
        "parameter_type": {
          "type": "string",
          "description": "Regex pattern to match against parameter types"
        },
        "symbol_kind": {
          "type": "string",
          "description": "Regex pattern to match against symbol kind field"
        },
        "extract_path": {
          "type": "string",
          "description": "JSONPath-like expression to extract route path from metadata"
        },
        "extract_method": {
          "type": "string",
          "description": "How to derive HTTP method (decorator_suffix, kwargs.methods, etc.)"
        },
        "prefix_from_parent": {
          "type": "string",
          "description": "Concept name to look up on parent class for path prefix (v1.3.x)"
        },
        "usage": {
          "$ref": "#/$defs/UsagePatternSpec",
          "description": "UsagePatternSpec for matching against UsageContext records"
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Dict of extraction expressions for usage-based patterns"
        }
      },
      "required": [
        "concept"
      ],
      "additionalProperties": false
    },
    "FrameworkPatternDef": {
      "type": "object",
      "description": "Framework pattern definition (YAML file structure)",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique framework identifier (e.g., 'fastapi', 'spring')"
        },
        "language": {
          "type": "string",
          "description": "Primary language for this framework"
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pattern"
          },
          "description": "List of patterns to match"
        },
        "linkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Linkers that should be activated when this framework is detected"
        }
      },
      "required": [
        "id",
        "language",
        "patterns"
      ],
      "additionalProperties": false
    }
  }
}

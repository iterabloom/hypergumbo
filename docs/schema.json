            "slot": "language_construct",
            "template": "language_construct",
            "directive": "language_construct",
            "declaration": "language_construct",
            "keyword": "language_construct",
            "export": "language_construct",
            "import": "language_construct",
            "reference": "language_construct",
            "component": "language_construct",
            "view": "language_construct",
            "file": "language_construct",
